// The frame — the kit's EditorialShell: a centred wordmark, the shelves either side, the header floating over the
// home page's photograph and settling on white everywhere else.

using Osysharp.Shop;

app.DefaultCulture = "sv-SE";

[Layout]
[AllowAnonymous]
component Shop() {
  string visitId = Visitor.Id;
  live var bag = Bag.Include(b => b.Lines).SingleOrDefault(b => b.VisitId == visitId);
  live var inBag = bag == null ? 0 : bag.Lines.Sum(l => l.Quantity);

  action OpenBag() { Navigation.Go("/bag"); }

  render {
    var chrome = new AppChrome {
      Product = "Vall",
      Home = "/",
      Nav = [
        new NavItem { Label = "New in", To = "/shop", Exact = true },
        new NavItem { Label = "Clothing", To = "/shop/clothing" },
        new NavItem { Label = "Shoes", To = "/shop/shoes" },
        new NavItem { Label = "Accessories", To = "/shop/accessories" },
        new NavItem { Label = "Sale", To = "/sale" },
      ],
    };
    EditorialShell(chrome) {
      ShopVisitSync();
      Outlet(retain: 8);
      slot promo { StorePromo(DemoNotice()); }
      slot actions { ShopAccountButton(); Button(inBag == 0 ? "Bag" : $"Bag ({inBag})", onPress: OpenBag); }
      slot footer {
        EditorialFooter(chrome, blurb: "A small Stockholm shop for a few good pieces a season — clothing, shoes and accessories chosen to be worn for years.",
                        note: "A demo built in Osy#. Vall is a fictional shop · Photography via Pexels");
        Box(px: 6, pb: 6) { ShopPolicyLinks(); }
      }
    }
  }
}

/// A page's content column — generous side margins that shrink on a phone.
[Composable]
component Section() {
  variants { base { W = "100%"; MaxW = "1440px"; Mx = "auto"; Px = 5; Laptop { Px = 10; } } }
  render { Box { Slot; } }
}
