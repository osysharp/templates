using Osysharp.Shop;

// The shop's desk — bookmark /staff/orders; signed out, it sends you to sign in and back. Sign in, see every order, mark a transfer received, call a reservation off. A tool, so it
// gets a frame of its own — the storefront's bag and hero have no business here — in the same dark, same type.

[Layout]
[AllowAnonymous]
component StaffDesk() {
  render {
    Stack(gap: 0, minH: Length.Screen, bg: Colors.Bg, color: Colors.OnBg) {
      Row(justify: Justify.Between, align: Align.Center, gap: 4, px: 6, py: 4, borderBW: 1, border: Colors.Border,
          wrap: Wrapping.Wrap, role: UiRole.Banner, label: "Shop desk") {
        Row(gap: 3, align: Align.Baseline) {
          Text("Andra Varvet", fontFamily: Font.Display, fontSize: "22px", letterSpacing: "0.3em");
          Text("shop desk", fontFamily: Font.Mono, fontSize: FontSize.Label, color: Colors.TextMuted);
        }
        Row(gap: 5) {
          Link(href: "/staff/orders", label: "Orders") { Text("Orders", color: Colors.TextSecondary); }
          Link(href: "/staff/desk", label: "Desk") { Text("Desk", color: Colors.TextSecondary); }
          Link(href: "/", label: "The shop") { Text("The shop →", color: Colors.Primary); }
        }
      }
      Box(grow: 1, role: UiRole.Main, label: "Desk") { Outlet(); }
    }
  }
}

[Title("Workshop sign-in — Andra Varvet")]
[Page("/staff")]
[Layout(StaffDesk)]
[Render(CSR)]
[AllowAnonymous]
component StaffSignIn() {
  string email = "";
  string password = "";
  string problem = "";

  action Submit() {
    problem = "";
    var ticket = ShopLogin(email, password);
    if (ticket == "") { problem = "That email and password do not match a staff account."; }
    // SignIn goes on to where the person was headed — the desk they were sent here from.
    else { Session.SignIn(ticket); }
  }

  render {
    Row(justify: Justify.Center, px: 5, py: 20) {
      Stack(gap: 5, w: "100%", maxW: "420px") {
        Text("Sign in", fontFamily: Font.Display, fontSize: FontSize.Hero, fontWeight: FontWeight.Semibold, lineHeight: "1");
        Field("Email", value: email, type: "email", onEnter: Submit);
        Field("Password", value: password, type: "password", onEnter: Submit);
        if (problem != "") { Text(problem, role: UiRole.Alert, color: "#F2C4A6"); }
        Button("Sign in", onPress: Submit, tone: Tone.Primary, size: Size.Lg);
      }
    }
  }
}

[Title("Orders — Andra Varvet")]
[Page("/staff/orders")]
[Layout(StaffDesk)]
[Render(CSR)]
[Authorize(IsShopStaff)]
component StaffOrders() {
  live var orders = Order.Include(o => o.Lines).Include(o => o.Contact).OrderByDescending(o => o.PlacedAt).ToList();
  Order cancelling = null;
  Order refunding = null;
  string reason = "";
  string problem = "";

  action Received(Order order) { MarkPaid(order, "Bank transfer"); }
  action AskCancel(Order order) { cancelling = order; reason = ""; problem = ""; }
  action KeepIt() { cancelling = null; refunding = null; }
  action AskRefund(Order order) { refunding = order; reason = ""; problem = ""; }
  action ConfirmRefund() {
    try { RefundOrder(refunding, reason, true); refunding = null; }
    catch (Exception ex) { problem = ex.Message; }
  }
  action ConfirmCancel() {
    try { CancelOrder(cancelling, reason); cancelling = null; }
    catch (Exception ex) { problem = ex.Message; }
  }

  render {
    Stack(gap: 0, px: 6, py: 10, maxW: "1200px") {
      Row(justify: Justify.Between, align: Align.End, pb: 6) {
        Text("Orders", fontFamily: Font.Display, fontSize: FontSize.Hero, fontWeight: FontWeight.Semibold, lineHeight: "1");
        Text($"{orders.Count(o => o.Status == OrderStatus.Reserved)} waiting for payment", fontFamily: Font.Mono,
             fontSize: FontSize.Label, color: Colors.TextMuted);
      }
      if (orders.Count == 0) {
        Text("No orders yet.", color: Colors.TextMuted, py: 8);
      }
      if (orders.Count > 0) { DeskHeader(); }
      foreach (var order in orders) {
        OrderRow(order, () => Received(order), () => AskCancel(order), () => AskRefund(order));
      }
    }
    if (cancelling != null) {
      Dialog($"Cancel {cancelling.Reference}?", onDismiss: KeepIt,
             subtitle: "The reservation ends and its pieces go back on sale. The customer is not told automatically.") {
        Stack(gap: 4) {
          Field("Reason", value: reason, placeholder: "Customer changed their mind",
                hint: "Kept on the order, for whoever reads it next.");
          if (problem != "") { Text(problem, role: UiRole.Alert, color: "#F2C4A6"); }
          Row(gap: 3, justify: Justify.End) {
            Button("Keep it", onPress: KeepIt);
            Button("Cancel order", onPress: ConfirmCancel, tone: Tone.Danger);
          }
        }
      }
    }
    if (refunding != null) {
      Dialog($"Refund {refunding.Reference}?", onDismiss: KeepIt,
             subtitle: refunding.PaidWith == "Card"
               ? $"{PriceText(refunding.Total)} goes back to the card it came from, through Stripe, and the pieces go back on sale."
               : $"Recorded as refunded and the pieces go back on sale. Return the {PriceText(refunding.Total)} transfer yourself.") {
        Stack(gap: 4) {
          Field("Reason", value: reason, placeholder: "Customer returned it",
                hint: "Kept on the order, for whoever reads it next.");
          if (problem != "") { Text(problem, role: UiRole.Alert, color: "#F2C4A6"); }
          Row(gap: 3, justify: Justify.End) {
            Button("Keep it", onPress: KeepIt);
            Button($"Refund {PriceText(refunding.Total)}", onPress: ConfirmRefund, tone: Tone.Danger);
          }
        }
      }
    }
  }
}

/// The desk's columns — ONE template for the header and every row, with a FIXED actions column. Each row is its own
/// grid, and an `auto` last column sized itself to that row's buttons, so every row divided the width differently and
/// no column lined up (a row with "Refund…", one with "Cancel…" and one with no button at all each put "Total" in a
/// different place).
string DeskColumns() {
  return "minmax(0, 1.1fr) minmax(0, 1.6fr) minmax(0, 1.6fr) minmax(0, 0.8fr) 300px";
}

/// The column names, on the same template as the rows.
[Composable]
component DeskHeader() {
  render {
    Box(display: Display.Grid, cols: DeskColumns(), gap: 5, pb: 3) {
      DeskLabel("Order");
      DeskLabel("Customer");
      DeskLabel("Items");
      DeskLabel("Total");
      Box(decorative: true) { }
    }
  }
}

[Composable]
component DeskLabel(string text) {
  render { Text(text, fontFamily: Font.Mono, fontSize: FontSize.Label, color: Colors.TextMuted, letterSpacing: "0.04em"); }
}

/// One order on the desk: reference and date, who, what, how much, where it stands — and what can be done to it.
[Composable]
component OrderRow(Order order, Action onReceived, Action onCancel, Action onRefund) {
  render {
    Box(display: Display.Grid, cols: DeskColumns(), gap: 5,
        align: Align.Center, py: 4, borderTW: 1, border: Colors.Border, label: order.Reference) {
      Stack(gap: 1) {
        Text(order.Reference, fontFamily: Font.Mono);
        Text(order.PlacedAt.ToString("d MMM, HH:mm"), fontSize: FontSize.Label, color: Colors.TextMuted);
      }
      Stack(gap: 1, minW: "0") {
        foreach (var c in order.Contact) {
          Text(c.Name);
          Text(c.Email, fontSize: FontSize.Label, color: Colors.TextMuted);
        }
      }
      Stack(gap: 1, minW: "0") {
        foreach (var line in order.Lines) { Text(line.VariantLabel == null ? line.ProductName : $"{line.ProductName} · {line.VariantLabel}"); }
        Text($"{order.Payment.Label} · {order.Fulfilment.Label}", fontSize: FontSize.Label, color: Colors.TextMuted);
        if (order.CancelReason != null) { Text(order.CancelReason, fontSize: FontSize.Label, color: Colors.TextMuted); }
        if (order.RefundReason != null) { Text(order.RefundReason, fontSize: FontSize.Label, color: Colors.TextMuted); }
        if (order.RefundProblem != null) { Text(order.RefundProblem, fontSize: FontSize.Label, color: "#F2C4A6"); }
      }
      Stack(gap: 1) {
        Text(PriceText(order.Total), fontFamily: Font.Mono);
        StatusTag(order.Status);
      }
      Row(gap: 2, justify: Justify.End) {
        if (order.Status == OrderStatus.Reserved) {
          if (order.Payment != Payment.Card) { Button("Transfer received", onPress: onReceived); }
          Button("Cancel…", onPress: onCancel);
        }
        // A refund that was requested but never reached Stripe can be pressed again — it refunds once.
        if (order.Status == OrderStatus.Paid || order.Status == OrderStatus.RefundRequested) { Button("Refund…", onPress: onRefund); }
      }
    }
  }
}

[Composable]
component StatusTag(OrderStatus status) {
  render {
    Text(status.Label, fontFamily: Font.Mono, fontSize: FontSize.Label, letterSpacing: "0.04em",
         color: status == OrderStatus.Paid ? Colors.Primary
              : status == OrderStatus.Reserved ? "#E8C07C"
              : status == OrderStatus.Refunded ? "#C9A0DC"
              : status == OrderStatus.RefundRequested || status == OrderStatus.RefundProcessing ? "#E8C07C"
              : Colors.TextMuted);
  }
}

[Title("Desk — Andra Varvet")]
[Page("/staff/desk")]
[Layout(StaffDesk)]
[Render(CSR)]
[Authorize(IsShopStaff)]
component StaffDeskHome() {
  render {
    Stack(gap: 0, px: 6, py: 10, maxW: "1200px") { ShopDesk(); }
  }
}
