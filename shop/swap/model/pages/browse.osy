using Osysharp.Shop;

// Finding things and the small print: the kit's search, sale shelf and policy pages in this store's frame.

[Title("Search — Andra Varvet")]
[Page("/search")]
[Layout(Shop)]
[AllowAnonymous]
component SearchPage() {
  render { AccountRoom() { Stack(gap: 6) { PageTitle("Search"); ShopSearchPage(productPrefix: "/p/"); } } }
}

[Title("Sale — Andra Varvet")]
[Page("/sale")]
[Layout(Shop)]
[AllowAnonymous]
component SalePage() {
  render { AccountRoom() { Stack(gap: 6) { PageTitle("Sale"); ShopSearchPage(productPrefix: "/p/", onlySale: true); } } }
}

[Title("Terms of sale — Andra Varvet")]
[Page("/terms")]
[Layout(Shop)]
[AllowAnonymous]
component TermsPage() { render { AccountRoom() { ShopPolicy("terms"); } } }

[Title("Privacy — Andra Varvet")]
[Page("/privacy")]
[Layout(Shop)]
[AllowAnonymous]
component PrivacyPage() { render { AccountRoom() { ShopPolicy("privacy"); } } }

[Title("Returns — Andra Varvet")]
[Page("/returns-policy")]
[Layout(Shop)]
[AllowAnonymous]
component ReturnsPolicyPage() { render { AccountRoom() { ShopPolicy("returns"); } } }
