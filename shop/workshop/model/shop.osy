// What Rust & Chrome writes itself on top of the shop kit: how staff sign in, where Stripe posts, and how a price reads.
//
// There is NO signup — a staff account is made by someone who already runs the shop (`osy user add … --role Staff`),
// never by a stranger with the URL.

using Osysharp.UserAccounts;
using Osysharp.Identity;
using Osysharp.Shop.VatNumbers;
using Osysharp.Shipping;
using Osysharp.Payments.Klarna;
using Osysharp.Payments;
using Osysharp.Payments.Stripe;
using Osysharp.Shop;

// Who signs in — customers and staff — is Osysharp.UserAccounts', as the shop's own kind of account (`ShopAccounts`).
app.Accounts = ShopAccounts("Rust & Chrome");
// Staff see who holds which role — the desk's packers and counter staff (Osysharp.Identity's grants are the app's to show).
partial entity RoleGrant { security { allow read when IsShopStaff; } }

app.Audit = new AuditConfig {
  Redact = new AuditRedaction { Properties = [ShopAccount.PasswordHash] },
};

// Stripe posts here. Open, because Stripe has no account to sign in with — the kit's signature check is the lock.
// How this shop takes money and hands goods over — the providers it lists, which the shop kit calls through its
// payment and delivery contracts. Adding or removing one is a line here.
app.Shop = new ShopSetup {
  // The workshop shows a bike by its id, and has no category pages of its own.
  ProductPath = "/bike/{id}",
  // A company elsewhere in the EU, its VAT number confirmed by the EU's register, buys without VAT.
  VatNumbers = new ViesCheck(),
  Payments = [
    // A card on Stripe's own page. Offered once both keys are set (`osy secret set StripeApiKey`, `StripeWebhookSecret`).
    new StripePayments { ApiKey = Security.IsSecretSet("StripeApiKey") ? Secret.StripeApiKey : "",
                         WebhookSecret = Security.IsSecretSet("StripeWebhookSecret") ? Secret.StripeWebhookSecret : "",
                         Description = $"On Stripe's page, in TEST mode — {TestCardHint()}" },
    // Klarna's own page — pay now, later or in parts, charged when the order is sent. Its playground while a demo.
    new KlarnaPayments { Username = Security.IsSecretSet("KlarnaUsername") ? Secret.KlarnaUsername : "",
                         Password = Security.IsSecretSet("KlarnaPassword") ? Secret.KlarnaPassword : "",
                         Country = "DE", Locale = "en-DE", Playground = true },
    new ManualPayment { Key = "banktransfer", Label = "Bank transfer",
                        Description = "Demo — there is no account to pay. The order stays reserved while you would." },
    new ManualPayment { Key = "oncollection", Label = "Pay on collection",
                        Description = "Demo — there is nowhere to collect from. The order stays reserved.",
                        Instructions = "Pay when you collect." },
  ],
  OnlyWhenCollecting = ["oncollection"],
  Delivery = [
    // Delivery at the fee the desk sets, free above its threshold, collected at the desk's address — the shop reads
    // them where it uses them (data/00-shop.json), so a change applies to the next order.
    // Collection first: it is how most bikes leave the workshop, fitted to the rider.
    new CollectInStore { Label = "Collect from the workshop" },
    new FlatRateDelivery { Label = "Insured delivery", Description = "Anywhere in Europe · boxed by us", DaysMin = 3, DaysMax = 7 },
  ],
};

// The keys the payment providers above read. Set them with `osy secret set <NAME>`; until then they are not offered.
app.Secrets = [ new Secret("StripeApiKey"), new Secret("StripeWebhookSecret"), new Secret("KlarnaUsername"), new Secret("KlarnaPassword") ];

// Payment providers post their events here — Stripe to `/payments/stripe/events`, Klarna's callback to
// `/payments/klarna/events`. Open, because a provider has no account to sign in with; each verifies its own events.
app.Apis = [
  new RestApi("Payments") {
    Route = "payments",
    Auth  = new ApiAuth { Anonymous = true },
    Endpoints = [
      new Endpoint(ShopPaymentEvents) { Method = HttpMethod.Post, Path = "/{provider}/events", Raw = true, Headers = ["Stripe-Signature"] },
    ],
  },
];

/// A price as a collector reads it: euros, no cents.
string PriceText(decimal price) {
  return $"€{price:N0}";
}

// ── what a page reads while it renders ─────────────────────────────────────────────────────────────────────────────
//
// The cover, a spec line, sold and on hold are the shop kit's (`CoverPhoto`, `Spec`, `Sold`, `OnHold`, `CoverPhotoFor`,
// `SpecFor`): pure functions over rows a page holds, so they run in the browser as it renders. Only this store's own
// words are here.

/// "Colnago · 1981 · 56 cm" — the line a collector reads under a name.
string Specs(string brand, ProductSpec[] specs) {
  return $"{brand} · {Spec(specs, "Year")} · {Spec(specs, "Frame size")}";
}
