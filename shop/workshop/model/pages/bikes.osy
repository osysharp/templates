using Osysharp.Shop;
using Osysharp.Storage;

// The catalogue, a machine up close, the workshop's story, the archive, and the thank-you.

[Title("Every bike — Rust & Chrome")]
[Route("/bikes")]
[Layout(Shop)]
[Render(CSR)]
[AllowAnonymous]
component AllBikes() {
  live var bikes = Product.Include(p => p.Variants).Include(p => p.Images).Include(p => p.Specs)
    .Where(p => p.Status == ProductStatus.Listed && p.Variants.Any(v => v.Stock > 0 || v.Reserved > 0))
    .OrderBy(p => p.Rank).ToList();
  render { Catalogue("Every bike", "Everything in the window right now, restored and ready to ride.", bikes); }
}

[Title("Road — Rust & Chrome")]
[Route("/bikes/road")]
[Layout(Shop)]
[Render(CSR)]
[AllowAnonymous]
component RoadBikes() {
  live var bikes = Product.Include(p => p.Variants).Include(p => p.Images).Include(p => p.Specs)
    .Where(p => p.Status == ProductStatus.Listed && p.Variants.Any(v => v.Stock > 0 || v.Reserved > 0) && p.Category.Slug == "road")
    .OrderBy(p => p.Rank).ToList();
  render { Catalogue("Road", "Light, quick, made to climb — the bikes the classics were won on.", bikes); }
}

