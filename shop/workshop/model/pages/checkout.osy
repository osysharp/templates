using Osysharp.Shop;
using Osysharp.Storage;

// Checkout: who you are, how the bike reaches you, how you pay — and then the reservation, with its reference.

[Title("Checkout — Rust & Chrome")]
[Page("/checkout")]
[Layout(Shop)]
[Render(CSR)]
[AllowAnonymous]
component Checkout() {
  string visitId = Visitor.Id;
  live var bag = Bag.Include(b => b.Lines.Variant.Product).SingleOrDefault(b => b.VisitId == visitId);

  live var covers = ProductImage.Where(i => i.Rank == 0).ToList();
  live var specs = ProductSpec.Where(x => x.Name == "Year" || x.Name == "Frame size").ToList();
  string name = "";
  string email = "";
  string phone = "";
  Fulfilment fulfilment = Fulfilment.Collect;
  Payment payment = Payment.BankTransfer;
  bool cardOn = false;
  bool klarnaOn = false;
  string street = "";
  string postCode = "";
  string city = "";
  string country = "";
  string problem = "";
  Receipt receipt = null;

  on mount {
    cardOn = CardPaymentsOn();
    if (cardOn) { payment = Payment.Card; }
    klarnaOn = KlarnaPaymentsOn();
  }

  action Collect() { fulfilment = Fulfilment.Collect; }
  action Deliver() {
    fulfilment = Fulfilment.Deliver;
    if (payment == Payment.OnCollection) { payment = cardOn ? Payment.Card : Payment.BankTransfer; }   // needs a collection
  }
  action ByCard() { payment = Payment.Card; }
  action ByKlarna() { payment = Payment.Klarna; }
  action ByTransfer() { payment = Payment.BankTransfer; }
  action OnCollection() { payment = Payment.OnCollection; }

  action Reserve() {
    problem = "";
    try {
      receipt = PlaceOrder(visitId, name, email, phone, fulfilment, payment, street, postCode, city, country);
      // A card order goes on to Stripe's page; it comes back to /paid/{reference}/… when the visitor is done.
      if (receipt.PayUrl != "") { Navigation.Open(receipt.PayUrl, sameTab: true); }
    } catch (Exception ex) {
      problem = ex.Message;
    }
  }

  render {
    Section {
      if (receipt != null) {
        Confirmation(receipt, email);
      } else if (bag == null || bag.Lines.Count() == 0) {
        Stack(gap: 4, py: 20, maxW: "640px") {
          Text("Your bag is empty.", fontFamily: Font.Display, fontSize: FontSize.Hero, fontWeight: FontWeight.Bold,
               lineHeight: "0.9", textTransform: TextTransform.Uppercase);
          Text("Every machine here is one of a kind — find yours, and it will wait in the bag while you decide.",
               fontSize: FontSize.Lead, color: Colors.TextSecondary);
          Row { Link(href: "/bikes", label: "See every bike") { Text("See every bike →", color: Colors.Primary); } }
        }
      } else {
        Stack(gap: 0, pt: 12, pb: 20) {
          Text("Checkout", fontFamily: Font.Display, fontSize: FontSize.Hero, fontWeight: FontWeight.Black, lineHeight: "0.9",
               textTransform: TextTransform.Uppercase, pb: 10, animation: RiseIn);
          Box(display: Display.Grid, cols: "repeat(auto-fit, minmax(320px, 1fr))", gap: 16, align: Align.Start) {
            Stack(gap: 12, maxW: "640px") {
              CheckoutStep("01", "You") {
                Field("Name", value: name, placeholder: "Anna Lindqvist");
                Field("Email", value: email, type: "email", placeholder: "anna@example.com",
                      hint: "Your confirmation and the reference go here.");
                Field("Phone", value: phone, type: "tel", placeholder: "+46 70 123 45 67",
                      hint: "Optional — for arranging a collection time.");
              }
              CheckoutStep("02", "How it reaches you") {
                Stack(role: UiRole.RadioGroup, label: "How it reaches you", gap: 3) {
                  ChoiceCard("Collect from the workshop", "Järntorget, Gothenburg · free · we fit it to you on the day",
                             fulfilment == Fulfilment.Collect, Collect);
                  ChoiceCard("Insured delivery", "Anywhere in Europe · boxed by us · priced after you reserve",
                             fulfilment == Fulfilment.Deliver, Deliver);
                }
                if (fulfilment == Fulfilment.Deliver) {
                  Stack(gap: 4, pt: 2) {
                    Field("Street", value: street, placeholder: "Storgatan 12");
                    Box(display: Display.Grid, cols: "minmax(0, 1fr) minmax(0, 2fr)", gap: 4) {
                      Field("Postcode", value: postCode, placeholder: "411 38");
                      Field("City", value: city, placeholder: "Gothenburg");
                    }
                    Field("Country", value: country, placeholder: "Sweden");
                  }
                }
              }
              CheckoutStep("03", "Payment") {
                Stack(role: UiRole.RadioGroup, label: "Payment", gap: 3) {
                  if (cardOn) {
                    ChoiceCard("Card", $"On Stripe's page, in TEST mode — {TestCardHint()}",
                               payment == Payment.Card, ByCard);
                  }
                  if (klarnaOn) {
                    ChoiceCard("Klarna", "Pay now, later or in parts on Klarna's page — charged when your order is sent.",
                               payment == Payment.Klarna, ByKlarna);
                  }
                  ChoiceCard("Bank transfer", "Demo — there is no account to pay. The order just stays reserved for three days.",
                             payment == Payment.BankTransfer, ByTransfer);
                  if (fulfilment == Fulfilment.Collect) {
                    ChoiceCard("Pay on collection", "Demo — there is no workshop to visit. The order stays reserved for three days.",
                               payment == Payment.OnCollection, OnCollection);
                  }
                }
              }
            }
            Summary(bag, covers, specs, problem, payment, Reserve);
          }
        }
      }
    }
  }
}

/// A numbered step of the checkout: its number in the mono, its name in the display face, then its fields.
[Composable]
component CheckoutStep(string number, string title) {
  render {
    Stack(gap: 5, borderTW: 1, border: Colors.Border, pt: 6, label: title) {
      Row(gap: 3, align: Align.Baseline) {
        Text(number, fontFamily: Font.Mono, fontSize: FontSize.Body, color: Colors.Primary);
        Text(title, fontFamily: Font.Display, fontSize: "34px", fontWeight: FontWeight.Bold, lineHeight: "1",
             textTransform: TextTransform.Uppercase);
      }
      Stack(gap: 4) { Slot; }
    }
  }
}

/// One option of a choice, as a card you press: its name, a line under it, and a ring when it is the one chosen.
[Composable]
component ChoiceCard(string title, string line, bool selected, Action onPress) {
  variants {
    base { Display = Display.Block; W = "100%"; TextAlign = TextAlign.Left; P = 5; Bg = Colors.Surface; Color = Colors.OnBg;
           BorderW = 1; Border = Colors.Border; Transition = Motion.Lift;
           Hover { Border = Colors.TextMuted; }
           Focus { OutlineW = 2; OutlineColor = Colors.Primary; OutlineOffset = "2px"; OutlineStyle = OutlineStyle.Solid; } }
  }
  render {
    Pressable(onClick: onPress, label: title, role: UiRole.Radio, checked: selected,
              border: selected ? Colors.Primary : Colors.Border) {
      Row(gap: 4, align: Align.Start) {
        Box(w: "18px", h: "18px", mt: "3px", rounded: Radius.Pill, borderW: 2, shrink: 0,
            border: selected ? Colors.Primary : Colors.TextMuted, bg: selected ? Colors.Primary : "transparent",
            shadow: selected ? "inset 0 0 0 3px #151717" : "none");
        Stack(gap: 1) {
          Text(title, fontWeight: FontWeight.Semibold);
          Text(line, fontSize: FontSize.Label, color: Colors.TextMuted);
        }
      }
    }
  }
}

/// The order as it stands, beside the form and following it down the page: the machines, the total, and the button.
[Composable]
component Summary(Bag bag, List<ProductImage> covers, List<ProductSpec> specs, string problem, Payment payment, Action onReserve) {
  render {
    Stack(gap: 5, p: 6, bg: Colors.Surface, position: Position.Sticky, top: "120px", label: "Your order") {
      Text("Your order", fontFamily: Font.Mono, fontSize: FontSize.Label, color: Colors.TextMuted, letterSpacing: "0.04em");
      Stack(gap: 0) {
        foreach (var line in bag.Lines) {
          Row(gap: 4, py: 3, borderBW: 1, border: Colors.Border, align: Align.Center) {
            Image(src: File.Url(CoverFor(covers, line.Variant.Product.Id)), alt: line.Variant.Product.Name, w: "72px", aspectRatio: "4 / 5", objectFit: ObjectFit.Cover);
            Stack(gap: 1, grow: 1, minW: "0") {
              Text(line.Variant.Product.Name, fontFamily: Font.Display, fontSize: "22px", textTransform: TextTransform.Uppercase);
              Text($"{line.Variant.Product.Brand} · {SpecFor(specs, line.Variant.Product.Id, "Year")} · {SpecFor(specs, line.Variant.Product.Id, "Frame size")}", fontFamily: Font.Mono, fontSize: FontSize.Label, color: Colors.TextMuted);
            }
            Text(PriceText((line.Variant.Price ?? line.Variant.Product.Price)), fontFamily: Font.Mono);
          }
        }
      }
      Row(justify: Justify.Between, align: Align.Baseline) {
        Text("Total", color: Colors.TextMuted);
        Text(PriceText(bag.Lines.Sum(l => (l.Variant.Price ?? l.Variant.Product.Price) * l.Quantity)), fontFamily: Font.Display, fontSize: "40px", fontWeight: FontWeight.Bold);
      }
      if (problem != "") {
        Box(role: UiRole.Alert, p: 4, borderLW: 3, border: "#E8A87C", bg: "rgb(232 168 124 / 0.08)") {
          Text(problem, color: "#F2C4A6");
        }
      }
      Button(payment == Payment.Card || payment == Payment.Klarna ? "Reserve and pay" : "Reserve", onPress: onReserve, tone: Tone.Primary, size: Size.Lg);
      Text(payment == Payment.Klarna
             ? "You choose how to pay on Klarna's page next, and are charged when it is sent."
             : payment == Payment.Card
             ? "You pay on Stripe's page next. The bike is held under your name from this moment."
             : "Nothing is charged now. The bike is held under your name for three days while you pay.",
           fontSize: FontSize.Label, color: Colors.TextMuted);
    }
  }
}

/// What the visitor sees once the order is placed: the reference, what to do next, and the way back.
[Composable]
component Confirmation(Receipt receipt, string email) {
  render {
    Stack(gap: 8, py: 20, maxW: "760px", animation: RiseIn) {
      Stack(gap: 3) {
        Text($"Order {receipt.Reference}", fontFamily: Font.Mono, fontSize: FontSize.Body, color: Colors.Primary);
        Text("Reserved.", fontFamily: Font.Display, fontSize: FontSize.Mega, fontWeight: FontWeight.Black, lineHeight: "0.84",
             textTransform: TextTransform.Uppercase);
        Text($"It is off the market and held under your name. We will write to {email} within a day.",
             fontSize: FontSize.Lead, lineHeight: "1.6", color: Colors.TextSecondary);
      }
      if (receipt.PayProblem != "") {
        Box(role: UiRole.Alert, p: 4, borderLW: 3, border: "#E8A87C", bg: "rgb(232 168 124 / 0.08)") {
          Text(receipt.PayProblem, color: "#F2C4A6");
        }
      }
      Stack(gap: 0, borderTW: 1, border: Colors.Border) {
        if (receipt.Payment == Payment.BankTransfer || receipt.PayProblem != "") {
          SpecLine("Transfer", PriceText(receipt.Total));
          SpecLine("To", "Nobody — this is a demo, and there is no account");
          SpecLine("Reference", receipt.Reference);
          SpecLine("By", "Three days from today");
        } else {
          SpecLine("Pay", $"{PriceText(receipt.Total)} when you collect");
        }
        SpecLine("Handover", receipt.Fulfilment.Label);
      }
      Row { Link(href: "/bikes", label: "Back to the bikes") { Text("Back to the bikes →", color: Colors.Primary); } }
    }
  }
}
