// Rust & Chrome — a workshop that restores vintage steel road bicycles and sells them online.
//
// ⭐ THE SHOP IS A PACKAGE: catalogue, bag, orders, card payments and the staff desk are `Osysharp.Shop` — the same
//    tested backend every commerce template shares. What is Rust & Chrome's own is the look (model/theme.osy, the
//    fonts and photographs), the pages, and the words. Its bikes are data (data/*.json), photographs included.
//
// The Storefront shell's showcase (`StorefrontShell`) and a testbed for the design skill (`.claude/skills/osy-design`).
app RustAndChrome {
  use Osysharp.Ui;
  use Osysharp.Workflow;
  use Osysharp.Storage;
  // The shop. It reaches Stripe and reads the two Stripe secrets; this is where the app grants both.
  // The shop reads its mail key; how it is paid and delivered is `app.Shop`, in model/shop.osy.
  use Osysharp.Shop@1 { egress "api.resend.com"; secret "ResendApiKey"; }
  use Osysharp.Identity@0;
  use Osysharp.UserAccounts@1;
  use Osysharp.Payments@0;
  use Osysharp.Shipping@0;
  use Osysharp.Seo@0;
  // Discount codes: an add-on the shop finds by itself; staff make codes on /staff/codes.
  use Osysharp.Shop.Discounts@0;
  // Card payments through Stripe's hosted Checkout. The kit may reach one host, and this line is where the app
  // grants it — nothing else in the app can make the package talk to anywhere else.
  use Osysharp.Payments.Stripe@0 { egress "api.stripe.com"; }
  // Klarna through its Hosted Payment Page — the live host, and the playground one a test merchant uses.
  use Osysharp.Payments.Klarna@0 { egress "api.klarna.com"; egress "api.playground.klarna.com"; }
  // The shop's mail — confirmations, resets, returns — goes out through Resend, to this host only.
  use Osysharp.Resend@0 { egress "api.resend.com"; }
  // The books — SIE 4 for the accountant, the VAT report — read from the shop's invoices and credit notes. An add-on.
  use Osysharp.Shop.Bookkeeping@0;
  // A company elsewhere in the EU buys without VAT once VIES confirms its number (reverse charge).
  use Osysharp.Shop.VatNumbers@0 { egress "ec.europa.eu"; }
  // The tests stub `Http.Post`/`Http.Get` so no test ever reaches Stripe; a stub needs the capability named here.
  // The page desk (/staff/pages): the menu, the strip across the top, the footer — arranged by staff in versions of
  // the site, previewed first. Osysharp.Blocks, which keeps what they arrange, comes with the shop.
  use Osysharp.Blocks;
  use Osysharp.PageBuilder@0;
  // The block types staff place — a hero, a quote, the strip across the top, the footer's words — drawn in the shop's design.
  use Osysharp.Site.Looks@0;
  use Osysharp.Http;
  model "model/**/*.osy";
  tests "tests/**/*.test.osy";
  data  "data/**/*.json";
}
