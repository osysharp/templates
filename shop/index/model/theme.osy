// THE DIRECTION — "the index".
//
// Brief: the same shop for a customer who shops like a designer reads a catalogue — by department, fast, every piece
// in view with its price.
//
// Looked at in the category: design-store catalogues (grey ground, black grotesk, monospace labels and prices, a
// shelf list always on screen), department stores (a mega-menu over a hero), and streetwear drops (black, one loud
// colour, oversized type). Three directions written for this shop:
//   1. Department store — mega-menu and banners. REJECTED: a hero and a menu over a grid is Atelier with a menu.
//   2. The drop — black with one loud colour. REJECTED: it sells scarcity, and this shop sells staples.
//   3. The index — CHOSEN: a light grey ground, black Geist, Geist Mono for labels and prices, the shelves always open
//      in a column, a denser grid, and ONE accent — acid lime, always carrying black text — for what to press.
theme Index {
  Colors {
    Bg            = "#F1F1EF";
    OnBg          = "#0E0E0E";
    Surface       = "#FFFFFF";
    OnSurface     = "#0E0E0E";
    Muted         = "#E6E6E3";
    TextMuted     = "#6E6E6A";
    TextSecondary = "#2E2E2C";
    Border        = "#D9D9D5";
    Primary       = Palette.From("#C8F531");   // acid lime — the ONE accent
    OnPrimary     = "#0E0E0E";
    OnImage       = "#FFFFFF";
    Scrim         = "rgb(14 14 14 / 0.45)";
  }
  Font {
    Display = "\"Geist\", system-ui, sans-serif";
    Sans    = "\"Geist\", system-ui, sans-serif";
    Mono    = "\"Geist Mono\", ui-monospace, monospace";
  }
  FontSize {
    Mega    = "clamp(48px, 7vw, 112px)";
    Hero    = "clamp(36px, 4.5vw, 64px)";
    Title   = "22px";
    Lead    = "17px";
    Body    = "14px";
    Label   = "11px";
    Caption = "11px";
  }
  FontWeight { Light = 500; }
  Radius { Card = "0"; Md = "0"; Lg = "0"; Pill = "0"; }
  Shadow { Raised = "none"; Floating = "none"; }
  Motion {
    Lift = "transform 200ms ease, opacity 200ms ease";
    Fade = "opacity 180ms ease";
  }
}

animation RiseIn  { Duration = "420ms"; Easing = EaseOut; from { Opacity = 0; TranslateY = "10px"; } to { Opacity = 1; TranslateY = "0"; } }
animation Surface { Duration = "600ms"; from { Opacity = 0; } to { Opacity = 1; } }
