// The frame — the kit's CatalogueShell: the whole shelf tree open in a column beside the page, the bag at its foot.

using Osysharp.Shop;

app.DefaultCulture = "sv-SE";

[Layout]
[AllowAnonymous]
component Shop() {
  string visitId = Visitor.Id;
  live var bag = Bag.Include(b => b.Lines).SingleOrDefault(b => b.VisitId == visitId);
  live var inBag = bag == null ? 0 : bag.Lines.Sum(l => l.Quantity);

  action OpenBag() { Navigation.Go("/bag"); }

  render {
    var chrome = new AppChrome {
      Product = "Vall",
      Home = "/",
      Nav = [
        new NavItem { Label = "New in", To = "/shop", Exact = true },
        new NavItem { Label = "Clothing", To = "/shop/clothing", Children = [
          new NavItem { Label = "Dresses", To = "/shop/dresses" },
          new NavItem { Label = "Knitwear", To = "/shop/knitwear" },
          new NavItem { Label = "Coats & jackets", To = "/shop/coats-jackets" },
          new NavItem { Label = "Trousers & skirts", To = "/shop/trousers-skirts" },
        ] },
        new NavItem { Label = "Shoes", To = "/shop/shoes", Children = [
          new NavItem { Label = "Boots", To = "/shop/boots" },
          new NavItem { Label = "Sneakers", To = "/shop/sneakers" },
          new NavItem { Label = "Heels & flats", To = "/shop/heels-flats" },
        ] },
        new NavItem { Label = "Accessories", To = "/shop/accessories", Children = [
          new NavItem { Label = "Bags", To = "/shop/bags" },
          new NavItem { Label = "Scarves", To = "/shop/scarves" },
          new NavItem { Label = "Jewellery", To = "/shop/jewellery" },
        ] },
        new NavItem { Label = "Sale", To = "/sale" },
      ],
    };
    CatalogueShell(chrome) {
      ShopVisitSync();
      Outlet(retain: 8);
      slot promo { StorePromo(DemoNotice()); }
      slot actions { ShopAccountButton(); Button(inBag == 0 ? "Bag" : $"Bag ({inBag})", onPress: OpenBag, tone: Tone.Primary); }
      slot footer {
        EditorialFooter(chrome, blurb: "A small Stockholm shop for a few good pieces a season — clothing, shoes and accessories chosen to be worn for years.",
                        note: "A demo built in Osy#. Vall is a fictional shop · Photography via Pexels");
        Box(px: 6, pb: 6) { ShopPolicyLinks(); }
      }
    }
  }
}

/// A page's content column — generous side margins that shrink on a phone.
[Composable]
component Section() {
  variants { base { W = "100%"; Px = 5; Laptop { Px = 8; } } }
  render { Box { Slot; } }
}
