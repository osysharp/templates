// THE DIRECTION — "loud".
//
// Brief: the thrift shop as a party — second-hand as the fun choice, not the worthy one, for a customer who wants the
// shop to shout about a find.
//
// Looked at: charity-shop windows (hand-painted signs, yellow and red), gig posters (black type on flat colour), and
// resale drops (a ticker, a countdown). Three directions written:
//   1. Hand-painted window. REJECTED: needs lettering this shop does not have.
//   2. Countdown drop. REJECTED: a sale gimmick on pieces that are one of one anyway.
//   3. Loud — CHOSEN: a hot yellow ground, black Archivo Black at poster size, a ticker of news, and ONE accent —
//      electric blue, carrying white text — for the current shelf and the thing to press.
theme Loud {
  Colors {
    Bg = "#FFE14D"; OnBg = "#0A0A0A"; Surface = "#FFF3A8"; OnSurface = "#0A0A0A"; Muted = "#FFEA80";
    TextMuted = "#5A5220"; TextSecondary = "#2A2710"; Border = "#0A0A0A";
    Primary = Palette.From("#1F3BFF");   // the ONE accent
    OnPrimary = "#FFFFFF"; OnImage = "#FFFFFF"; Scrim = "rgb(0 0 0 / 0.5)";
  }
  Font {
    Display = "\"Archivo Black\", system-ui, sans-serif"; Sans = "system-ui, sans-serif"; Mono = "ui-monospace, monospace";
  }
  FontSize {
    Mega = "clamp(60px, 10vw, 170px)"; Hero = "clamp(40px, 5.5vw, 84px)"; Title = "26px";
    Lead = "18px"; Body = "15px"; Label = "12px"; Caption = "12px";
  }
  FontWeight { Light = 400; }
  Radius { Card = "0"; Md = "0"; Lg = "0"; Pill = "0"; }
  Shadow { Raised = "none"; Floating = "0 18px 40px -24px rgb(0 0 0 / 0.35)"; }
  Motion {
    Lift = "transform 280ms cubic-bezier(.2,.8,.2,1), opacity 280ms ease";
    Fade = "opacity 220ms ease";
  }
}

animation RiseIn  { Duration = "560ms"; Easing = EaseOut; from { Opacity = 0; TranslateY = "16px"; } to { Opacity = 1; TranslateY = "0"; } }
animation Surface { Duration = "900ms"; from { Opacity = 0; TranslateY = "28px"; } to { Opacity = 1; TranslateY = "0"; } }
