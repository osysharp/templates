// The frame — the kit's StorefrontShell: the shelves across the top with their sub-shelves in a panel, and the bag
// sliding in from the side, always one tap away.

using Osysharp.Shop;
using Osysharp.Storage;

app.DefaultCulture = "sv-SE";

[Layout]
[AllowAnonymous]
component Shop() {
  string visitId = Visitor.Id;
  live var bag = Bag.Include(b => b.Lines).SingleOrDefault(b => b.VisitId == visitId);
  live var inBag = bag == null ? 0 : bag.Lines.Sum(l => l.Quantity);

  AppChrome chrome = new AppChrome {
    Product = "Vall",
    Tagline = "Clothing, shoes & accessories · Stockholm",
    Home = "/",
    Nav = [
      new NavItem { Label = "New in", To = "/shop", Exact = true },
      new NavItem { Label = "Clothing", Children = [
        new NavItem { Label = "Dresses", To = "/shop/dresses" },
        new NavItem { Label = "Knitwear", To = "/shop/knitwear" },
        new NavItem { Label = "Coats & jackets", To = "/shop/coats-jackets" },
        new NavItem { Label = "Trousers & skirts", To = "/shop/trousers-skirts" },
        new NavItem { Label = "All clothing", To = "/shop/clothing", Exact = true },
      ] },
      new NavItem { Label = "Shoes", Children = [
        new NavItem { Label = "Boots", To = "/shop/boots" },
        new NavItem { Label = "Sneakers", To = "/shop/sneakers" },
        new NavItem { Label = "Heels & flats", To = "/shop/heels-flats" },
        new NavItem { Label = "All shoes", To = "/shop/shoes", Exact = true },
      ] },
      new NavItem { Label = "Accessories", Children = [
        new NavItem { Label = "Bags", To = "/shop/bags" },
        new NavItem { Label = "Scarves", To = "/shop/scarves" },
        new NavItem { Label = "Jewellery", To = "/shop/jewellery" },
        new NavItem { Label = "All accessories", To = "/shop/accessories", Exact = true },
      ] },
      new NavItem { Label = "Sale", To = "/sale" },
    ],
  };

  render {
    StorefrontShell(chrome, bagCount: inBag) {
      ShopVisitSync();
      slot actions { ShopAccountButton(); }
      Outlet(retain: 8);
      slot promo { StorePromo(DemoNotice()); }
      slot bag { BagContents(); }
      slot footer {
        StoreFooter(chrome, "A small Stockholm shop for a few good pieces a season — clothing, shoes and accessories chosen to be worn for years.",
                    note: "A demo built in Osy#. Vall is a fictional shop · Photography via Pexels");
        Box(px: 6, pb: 6) { ShopPolicyLinks(); }
      }
    }
  }
}

/// What the bag panel holds: each piece with its size, the total, and the way to check out.
[Composable]
[AllowAnonymous]
component BagContents() {
  string visitId = Visitor.Id;
  live var bag = Bag.Include(b => b.Lines.Variant.Product).SingleOrDefault(b => b.VisitId == visitId);
  live var covers = ProductImage.Where(i => i.Rank == 0).ToList();

  action Remove(BagLine line) { RemoveFromBag(line); }
  action Pay() { Navigation.Go("/checkout"); }

  render {
    Stack(gap: 5, p: 5) {
      if (bag == null || bag.Lines.Count() == 0) {
        Text("Nothing in the bag yet.", color: Colors.TextSecondary);
      } else {
        foreach (var line in bag.Lines) {
          Row(gap: 4, align: Align.Center, label: line.Variant.Product.Name) {
            Image(src: File.Url(CoverFor(covers, line.Variant.Product.Id)), alt: line.Variant.Product.Name, w: "76px",
                  aspectRatio: "3 / 4", objectFit: ObjectFit.Cover, rounded: Radius.Md);
            Stack(gap: 1, grow: 1, minW: "0") {
              Text(line.Variant.Product.Name, fontWeight: FontWeight.Semibold);
              ShopLineNote(line);
              Text($"{VariantName(line.Variant)} · {line.Quantity} ×", fontSize: FontSize.Label, color: Colors.TextMuted);
              Text(PriceText((line.Variant.Price ?? line.Variant.Product.Price) * line.Quantity));
            }
            IconButton("Remove " + line.Variant.Product.Name, () => Remove(line)) { Icon(Icons.Close); }
          }
        }
        Row(justify: Justify.Between, align: Align.Baseline, pt: 3, borderTW: 1, border: Colors.Border) {
          Text("Subtotal", color: Colors.TextMuted);
          Text(PriceText(bag.Lines.Sum(l => (l.Variant.Price ?? l.Variant.Product.Price) * l.Quantity)), fontFamily: Font.Display,
               fontSize: FontSize.Title);
        }
        Button("Check out", onPress: Pay, tone: Tone.Primary, size: Size.Lg);
        Text("Free delivery over 1 000 kr · returns within 30 days.", fontSize: FontSize.Label, color: Colors.TextMuted);
      }
    }
  }
}

/// A page's content column.
[Composable]
component Section() {
  variants { base { W = "100%"; MaxW = "1360px"; Mx = "auto"; Px = 5; Laptop { Px = 10; } } }
  render { Box { Slot; } }
}
