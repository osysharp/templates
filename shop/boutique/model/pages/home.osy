using Osysharp.Shop;
using Osysharp.Storage;

// The front of the boutique: a hello and two pieces side by side, what is new, and the three shelves as rounded tiles.

[Title("Vall — the boutique")]
[Page("/")]
[Layout(Shop)]
[Render(CSR)]
[AllowAnonymous]
component Home() {
  live var newIn = Product.Include(p => p.Images).Include(p => p.Variants)
    .Where(p => p.Status == ProductStatus.Listed).OrderBy(p => p.Rank).Take(8).ToList();
  live var left = Product.Include(p => p.Images).Where(p => p.Slug == "chunky-rib-cardigan").ToList();
  live var right = Product.Include(p => p.Images).Where(p => p.Slug == "cotton-v-neck-cardigan").ToList();
  live var clothing = Product.Include(p => p.Images).Where(p => p.Slug == "jersey-pencil-midi-dress").ToList();
  live var shoes = Product.Include(p => p.Images).Where(p => p.Slug == "metallic-leather-sneaker").ToList();
  live var accessories = Product.Include(p => p.Images).Where(p => p.Slug == "croc-embossed-leather-tote").ToList();

  render {
    Stack(gap: 0) {
      Section {
        Box(display: Display.Grid, cols: "repeat(auto-fit, minmax(320px, 1fr))", gap: 8, py: 12, align: Align.Center) {
          Stack(gap: 5, animation: RiseIn) {
            Text("Hej! Knit season is here.", fontFamily: Font.Display, fontSize: FontSize.Mega, lineHeight: "0.95",
                 letterSpacing: "-0.02em");
            Text("Cardigans to live in, a dress for the dark evenings and a sneaker that goes with all of it. Try it on at home — returns are free for 30 days.",
                 fontSize: FontSize.Lead, lineHeight: "1.55", color: Colors.TextSecondary, maxW: "520px");
            Row { Link(href: "/shop/knitwear", label: "Shop knitwear") { Pill("Shop knitwear"); } }
          }
          Box(display: Display.Grid, cols: "1fr 1fr", gap: 3, align: Align.Start) {
            foreach (var p in left) { Rounded(Cover(p.Images), p.Name, "0"); }
            foreach (var p in right) { Rounded(Cover(p.Images), p.Name, "48px"); }
          }
        }
      }
      Section {
        Stack(gap: 0, pt: 8, pb: 12) {
          SectionHead("New in", linkLabel: "Shop all", to: "/shop");
          ProductGrid(newIn);
        }
      }
      Section {
        Box(display: Display.Grid, cols: "repeat(auto-fit, minmax(260px, 1fr))", gap: 4, pb: 16) {
          foreach (var p in clothing) { ShelfTile("Clothing", "/shop/clothing", Cover(p.Images)); }
          foreach (var p in shoes) { ShelfTile("Shoes", "/shop/shoes", Cover(p.Images)); }
          foreach (var p in accessories) { ShelfTile("Accessories", "/shop/accessories", Cover(p.Images)); }
        }
      }
    }
  }
}

/// A photograph with round corners, dropped a little so two sit staggered.
[Composable]
component Rounded(string photo, string alt, string drop) {
  render {
    Box(mt: drop, overflow: Overflow.Hidden, rounded: Radius.Lg, shadow: Shadow.Floating) {
      Image(src: File.Url(photo), alt: alt, w: "100%", aspectRatio: "3 / 4", objectFit: ObjectFit.Cover);
    }
  }
}

/// The tomato pill.
[Composable]
component Pill(string label) {
  variants { base { Bg = Colors.Primary; Color = Colors.OnPrimary; Px = 6; Py = 3; Rounded = Radius.Pill; FontWeight = FontWeight.Semibold;
                    Transition = Motion.Lift; Hover { TranslateY = "-2px"; } } }
  render { Text(label); }
}

/// A shelf as a rounded photograph with its name on it.
[Composable]
component ShelfTile(string name, string to, string photo) {
  variants { base { Display = Display.Block; Color = Colors.OnImage; TextDecoration = TextDecoration.None; Transition = Motion.Lift;
                    Hover { TranslateY = "-4px"; } } }
  render {
    Link(href: to, label: name) {
      Box(position: Position.Relative, overflow: Overflow.Hidden, rounded: Radius.Card) {
        Image(src: File.Url(photo), alt: name, w: "100%", aspectRatio: "4 / 5", objectFit: ObjectFit.Cover);
        Box(position: Position.Absolute, inset: "0", bgImage: "linear-gradient(180deg, rgb(0 0 0 / 0) 55%, rgb(0 0 0 / 0.45) 100%)");
        Text(name, position: Position.Absolute, left: "20px", bottom: "16px", fontFamily: Font.Display, fontSize: FontSize.Title,
             color: Colors.OnImage);
      }
    }
  }
}
