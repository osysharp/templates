using Osysharp.Shop;

// The customer's account: the kit's account components in this style's frame. The kit does the work; this file is the
// routes and the room around them.

/// The account pages' room: centred, with the page's own air.
[Composable]
component AccountRoom() {
  render {
    Row(justify: Justify.Center, px: 5, py: 14) {
      Box(w: "100%", maxW: "960px") { Slot(); }
    }
  }
}

[Title("Sign in — Vall")]
[Route("/account/sign-in")]
[Layout(Shop)]
[AllowAnonymous]
component AccountSignIn() {
  render { AccountRoom() { ShopSignIn(); } }
}

[Title("Create an account — Vall")]
[Route("/account/new")]
[Layout(Shop)]
[AllowAnonymous]
component AccountNew() {
  render { AccountRoom() { ShopSignUp(); } }
}

[Title("Forgotten password — Vall")]
[Route("/account/forgot")]
[Layout(Shop)]
[AllowAnonymous]
component AccountForgot() {
  render { AccountRoom() { ShopForgotPassword(); } }
}

[Title("New password — Vall")]
[Route("/account/reset/{token}")]
[Layout(Shop)]
[AllowAnonymous]
component AccountReset(string token) {
  render { AccountRoom() { ShopChooseNewPassword(token); } }
}

[Title("Your account — Vall")]
[Route("/account")]
[Layout(Shop)]
component AccountHome() {
  render { AccountRoom() { ShopAccountPanel(); } }
}
