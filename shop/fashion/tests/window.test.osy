// THE WINDOW — the whole of Vall's catalogue as the store's data has it (data/*.json): its shelves, its twenty-one
// pieces with their sizes, spec sheets and photographs. What every look is photographed with, so five designs are
// compared over the same pieces. Written out from the data files; the photographs are the store's own (public/products).

using Osysharp.Shop;

[TestFixture]
void Window() {
  new ShopSettings { Name = "Vall", Currency = "SEK", CurrencySymbol = "kr", SymbolAfter = true, OrderPrefix = "VL-",
                     HoldDays = 2, DeliveryFee = 59m, FreeDeliveryFrom = 1000m, VatPercent = 25m };
  var c_clothing = new Category { Name = "Clothing", Slug = "clothing", Rank = 0 };
  var c_shoes = new Category { Name = "Shoes", Slug = "shoes", Rank = 5 };
  var c_accessories = new Category { Name = "Accessories", Slug = "accessories", Rank = 9 };
  var c_dresses = new Category { Name = "Dresses", Slug = "dresses", Parent = c_clothing, Rank = 0 };
  var c_knitwear = new Category { Name = "Knitwear", Slug = "knitwear", Parent = c_clothing, Rank = 1 };
  var c_coats_jackets = new Category { Name = "Coats & jackets", Slug = "coats-jackets", Parent = c_clothing, Rank = 2 };
  var c_trousers_skirts = new Category { Name = "Trousers & skirts", Slug = "trousers-skirts", Parent = c_clothing, Rank = 3 };
  var c_boots = new Category { Name = "Boots", Slug = "boots", Parent = c_shoes, Rank = 4 };
  var c_sneakers = new Category { Name = "Sneakers", Slug = "sneakers", Parent = c_shoes, Rank = 5 };
  var c_heels_flats = new Category { Name = "Heels & flats", Slug = "heels-flats", Parent = c_shoes, Rank = 6 };
  var c_bags = new Category { Name = "Bags", Slug = "bags", Parent = c_accessories, Rank = 7 };
  var c_scarves = new Category { Name = "Scarves", Slug = "scarves", Parent = c_accessories, Rank = 8 };
  var c_jewellery = new Category { Name = "Jewellery", Slug = "jewellery", Parent = c_accessories, Rank = 9 };
  var p_satin_cowl_slip_dress = new Product { Name = "Satin cowl slip dress", Slug = "satin-cowl-slip-dress", Category = c_dresses, Price = 1290m, Rank = 0, Brand = "Vall Studio", Summary = "A short ivory slip dress in fluid satin with a soft cowl neck.", Description = "Cut on the bias so it skims rather than clings, with thin adjustable straps and a draped cowl at the front. Wear it alone in summer or over a fine knit when the evenings turn." };
  var p_jersey_pencil_midi_dress = new Product { Name = "Jersey pencil midi dress", Slug = "jersey-pencil-midi-dress", Category = c_dresses, Price = 1590m, Rank = 1, Brand = "Vall Studio", Summary = "A stone-coloured long-sleeve midi in heavy jersey with a front slit.", Description = "A clean V-neck, fitted waist seam and a centre-front slit that makes walking easy. The jersey is dense enough to hold its line and soft enough to wear all day." };
  var p_cotton_v_neck_cardigan = new Product { Name = "Cotton V-neck cardigan", Slug = "cotton-v-neck-cardigan", Category = c_knitwear, Price = 990m, Rank = 2, Brand = "Vall Studio", Summary = "A boxy sage cardigan in a fine cotton rib, cropped at the hip.", Description = "Dropped shoulders, a deep V and five tonal buttons. Light enough for a cool summer evening, easy to layer over a slip or a shirt when it gets colder." };
  var p_chunky_rib_cardigan = new Product { Name = "Chunky rib cardigan", Slug = "chunky-rib-cardigan", Category = c_knitwear, Price = 1190m, Rank = 3, Brand = "Vall Studio", Summary = "A heavyweight fisherman-rib cardigan with a V-neck, in three colours.", Description = "Knitted in a thick half-cardigan stitch that gives it body without weight. Long cuffs you can fold back and a single row of horn-look buttons." };
  var p_cotton_trench_coat = new Product { Name = "Cotton trench coat", Slug = "cotton-trench-coat", Category = c_coats_jackets, Price = 2890m, Rank = 4, Brand = "Vall Studio", Summary = "A classic double-breasted trench in sand cotton gabardine.", Description = "Storm flap, epaulettes, a back yoke and a self belt at the waist. The cotton is tightly woven so it shrugs off a shower and softens with wear." };
  var p_check_double_breasted_blazer = new Product { Name = "Check double-breasted blazer", Slug = "check-double-breasted-blazer", Category = c_coats_jackets, Price = 1790m, Rank = 5, Brand = "Vall Studio", Summary = "A grey Prince of Wales check blazer with black buttons.", Description = "Peak lapels, a longer line and a slightly oversized shoulder. Wear it over a slip dress or with trousers and the matching mood of a suit without the suit." };
  var p_wide_leg_tailored_trousers = new Product { Name = "Wide-leg tailored trousers", Slug = "wide-leg-tailored-trousers", Category = c_trousers_skirts, Price = 1390m, Rank = 6, Brand = "Vall Studio", Summary = "High-waisted camel trousers with front pleats and a wide leg.", Description = "A curved high waistband, two front pleats and a leg that falls straight to the floor. Side seam splits at the hem let them move." };
  var p_pleated_wool_blend_mini_skirt = new Product { Name = "Pleated wool-blend mini skirt", Slug = "pleated-wool-blend-mini-skirt", Category = c_trousers_skirts, Price = 890m, Rank = 7, Brand = "Vall Studio", Summary = "A charcoal mini skirt with soft pleats and an A-line shape.", Description = "Sits at the natural waist and flares slightly over the hips. The wool blend has a fine brushed surface and a lining so it does not catch on tights." };
  var p_lace_up_leather_boot = new Product { Name = "Lace-up leather boot", Slug = "lace-up-leather-boot", Category = c_boots, Price = 1990m, Rank = 8, Summary = "A black pebbled-leather lace-up boot on a chunky lug sole.", Description = "Eight eyelets, an inside zip so you do not have to unlace, and a deep-tread sole that grips on wet cobbles. Ankle height." };
  var p_buckle_strap_heeled_boot = new Product { Name = "Buckle strap heeled boot", Slug = "buckle-strap-heeled-boot", Category = c_boots, Price = 2290m, Rank = 9, Summary = "A cognac leather boot with a suede shaft, buckle strap and block heel.", Description = "Hand-burnished leather that darkens at the toe, a suede panel at the shaft and an outside zip. The stacked block heel is 7 cm on a treaded sole." };
  var p_leather_platform_sneaker = new Product { Name = "Leather platform sneaker", Slug = "leather-platform-sneaker", Category = c_sneakers, Price = 1490m, Rank = 10, Summary = "A white leather low-top on a stitched platform cupsole.", Description = "Smooth leather upper, flat waxed laces and a 4 cm cupsole that adds height without weight. Wipes clean." };
  var p_metallic_leather_sneaker = new Product { Name = "Metallic leather sneaker", Slug = "metallic-leather-sneaker", Category = c_sneakers, Price = 1590m, Rank = 11, Summary = "A silver leather low-top with a perforated toe.", Description = "The same platform last as our white sneaker in a soft metallic leather. Perforations at the toe box keep it breathable." };
  var p_padded_block_heel_mule = new Product { Name = "Padded block-heel mule", Slug = "padded-block-heel-mule", Category = c_heels_flats, Price = 1390m, Rank = 12, Summary = "A black leather mule with a padded, top-stitched strap and a white block heel.", Description = "Three puffed leather bands with contrast stitching across the front, on a 7 cm stacked heel. Cushioned insole for a full day on your feet." };
  var p_kitten_heel_pump = new Product { Name = "Kitten-heel pump", Slug = "kitten-heel-pump", Category = c_heels_flats, Price = 1290m, Rank = 13, Summary = "A pointed pump on a low 5 cm kitten heel, in ivory or red snake.", Description = "A sharp toe and a low heel make this the pump you can actually wear to work. Both colours are cut from the same last." };
  var p_croc_embossed_leather_tote = new Product { Name = "Croc-embossed leather tote", Slug = "croc-embossed-leather-tote", Category = c_bags, Price = 2490m, Rank = 14, Summary = "A navy leather tote with a croc-embossed front panel and zip pockets.", Description = "Smooth leather sides, a metallic croc-embossed panel and two vertical zip pockets on the front. Fits a laptop and closes with a top zip." };
  var p_slouch_leather_shoulder_bag = new Product { Name = "Slouch leather shoulder bag", Slug = "slouch-leather-shoulder-bag", Category = c_bags, Price = 2190m, Rank = 15, Summary = "A soft cognac leather shoulder bag with gathered sides and a buckle strap.", Description = "Vegetable-tanned leather that softens and darkens with use. Long shoulder straps, a gathered body and a buckled tab at each end." };
  var p_top_handle_satchel = new Product { Name = "Top-handle satchel", Slug = "top-handle-satchel", Category = c_bags, Price = 1890m, Rank = 16, Summary = "A structured teal leather satchel with a push-lock clasp.", Description = "A rigid body, a single rolled top handle and a detachable shoulder strap. The gold-tone push lock and feet on the base keep it looking new." };
  var p_printed_silk_square_tide = new Product { Name = "Printed silk square, Tide", Slug = "printed-silk-square-tide", Category = c_scarves, Price = 890m, Rank = 17, Summary = "A 90 cm silk twill square in orange, cobalt and ink.", Description = "An abstract wave print with a hand-rolled hem. Tie it at the neck, around a bag handle or in your hair." };
  var p_printed_silk_square_saffron = new Product { Name = "Printed silk square, Saffron", Slug = "printed-silk-square-saffron", Category = c_scarves, Price = 890m, Rank = 18, Summary = "A 90 cm silk twill square in saffron yellow with an orange border.", Description = "A lighter print from the same series, with fine illustrated detail on a yellow ground. Hand-rolled hem." };
