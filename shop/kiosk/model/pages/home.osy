using Osysharp.Shop;
using Osysharp.Storage;

// The front of the shop: one piece, full-bleed; what is new; the three shelves as three tall photographs.

[Title("Andra Varvet — second-hand clothing")]
[Page("/")]
[Layout(Shop)]
[Render(CSR)]
[AllowAnonymous]
component Home() {
  live var newIn = Product.Include(p => p.Images).Include(p => p.Variants)
    .Where(p => p.Status == ProductStatus.Listed).OrderBy(p => p.Rank).Take(8).ToList();
  live var hero = Product.Include(p => p.Images)
    .Where(p => p.Slug == "shearling-collar-leather-jacket").ToList();
  live var clothing = Product.Include(p => p.Images).Where(p => p.Slug == "rose-print-tea-dress").ToList();
  live var shoes = Product.Include(p => p.Images).Where(p => p.Slug == "western-leather-boots").ToList();
  live var accessories = Product.Include(p => p.Images).Where(p => p.Slug == "tooled-leather-saddle-bag").ToList();

  render {
    Stack(gap: 0) {
      // ── the hero: one piece, full-bleed, and one line ────────────────────────────────────────────────────
      Box(position: Position.Relative, h: "min(92vh, 980px)", minH: "560px", overflow: Overflow.Hidden, bg: Colors.Surface) {
        foreach (var h in hero) {
          Image(src: File.Url(Cover(h.Images)), alt: "A 1970s brown leather jacket with a shearling collar, on a hook beside a hat",
                w: "100%", h: "100%", objectFit: ObjectFit.Cover, objectPosition: "center 30%");
        }
        Box(position: Position.Absolute, inset: "0",
            bgImage: "linear-gradient(180deg, rgb(0 0 0 / 0) 55%, rgb(0 0 0 / 0.38) 100%)");
        Stack(position: Position.Absolute, left: "0", right: "0", bottom: "0", gap: 4, px: 5, pb: 12, maxW: "1440px",
              mx: "auto", animation: RiseIn) {
          Text("Found, not made.", fontFamily: Font.Display, fontSize: FontSize.Mega, fontWeight: FontWeight.Light,
               lineHeight: "0.95", letterSpacing: "-0.03em", color: Colors.OnImage);
          Row(gap: 6, align: Align.Center, wrap: Wrapping.Wrap) {
            Text("One of each — washed, mended, priced like a find.", fontSize: FontSize.Lead, color: Colors.OnImage);
            Link(href: "/shop", label: "See what's just in") { HeroLink("See what's just in"); }
          }
        }
      }

      // ── new in ───────────────────────────────────────────────────────────────────────────────────────────
      Section {
        Stack(gap: 0, pt: 16, pb: 12) {
          SectionHead("New in", linkLabel: "Shop all", to: "/shop");
          ProductGrid(newIn);
        }
      }

      // ── the three shelves ────────────────────────────────────────────────────────────────────────────────
      Section {
        Box(display: Display.Grid, cols: "repeat(auto-fit, minmax(300px, 1fr))", gap: 3, pb: 20) {
          // Dresses, boots, bags — in that order, each with a photograph the grid above does not already show.
          foreach (var p in clothing) { ShelfTile("Dresses", "/shop/dresses-tops", SecondCover(p.Images)); }
          foreach (var p in shoes) { ShelfTile("Boots", "/shop/shoes-boots", Cover(p.Images)); }
          foreach (var p in accessories) { ShelfTile("Bags", "/shop/bags", Cover(p.Images)); }
        }
      }
    }
  }
}

/// The hero's call to action: text and a hairline, not a box.
[Composable]
component HeroLink(string label) {
  variants {
    base { Color = Colors.OnImage; BorderBW = 1; Border = Colors.OnImage; Pb = 1; FontSize = FontSize.Body;
           LetterSpacing = "0.08em"; Transition = Motion.Fade; Hover { Opacity = 0.7; } }
  }
  render { Text(label); }
}

/// A shelf as a tall photograph with its name under it; the photograph eases in under the pointer.
[Composable]
component ShelfTile(string name, string to, string photo) {
  variants {
    base { Display = Display.Block; Color = Colors.OnBg; TextDecoration = TextDecoration.None; }
  }
  render {
    Link(href: to, label: name) {
      Stack(gap: 3) {
        Box(overflow: Overflow.Hidden, bg: Colors.Surface) {
          ShelfPhoto(photo, name);
        }
        Row(justify: Justify.Between, align: Align.Baseline) {
          Text(name, fontSize: FontSize.Title, fontWeight: FontWeight.Light);
          Text("Shop →", fontSize: FontSize.Label, color: Colors.TextMuted, letterSpacing: "0.08em");
        }
      }
    }
  }
}

[Composable]
component ShelfPhoto(string photo, string name) {
  variants { base { Transition = Motion.Lift; inside ShelfTile.Hover { Scale = "1.03"; } } }
  render { Image(src: File.Url(photo), alt: name, w: "100%", aspectRatio: "3 / 4", objectFit: ObjectFit.Cover); }
}
