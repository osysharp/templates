using Osysharp.Shop;
using Osysharp.Workflow;

// DEMO MODE — this shop is a showcase of Osy#, publicly reachable, running on Stripe's TEST mode. Everything that makes
// it a demo rather than a shop lives in this file: the notice across the top, the test-card hint at checkout, and the
// public "Restock the window" button. Delete this file (and the three places the compiler then names) to make it real.

/// What the bar across the top says — that nothing here is for sale and no money moves.
string DemoNotice() {
  return "A demo of Osy# — nothing here is for sale and no money moves. Pay with the test card 4242 4242 4242 4242.";
}

/// The test card, as checkout shows it.
string TestCardHint() {
  return "test card 4242 4242 4242 4242, any future date, any CVC. Nothing is charged.";
}

/// Puts everything back on sale — anybody may press it, because a public demo that sells out after five
/// visitors is a broken demo. It goes THROUGH each order's workflow (`Void`), so every order ends as "Voided" and the
/// desk still tells the whole story; the pieces go back exactly as a lapse puts them back. Answers how many orders it
/// ended.
[AllowAnonymous]
int RestockWindow() {
  var holding = Order
    .Where(o => o.Status == OrderStatus.Reserved || o.Status == OrderStatus.Paid || o.Status == OrderStatus.Fulfilled
             || o.Status == OrderStatus.RefundRequested || o.Status == OrderStatus.RefundProcessing)
    .ToList();
  foreach (var order in holding) { OrderLifecycle.RaiseVoid(order, "Restocked for the demo"); }
  return holding.Count;
}

/// The button, with how many pieces it would put back. Hidden when nothing is held.
[Composable]
[AllowAnonymous]
component RestockButton() {
  live var held = OrderLine.Where(l => l.Held).Count();
  string done = "";

  action Restock() {
    var ended = RestockWindow();
    done = ended == 1 ? "1 order restocked." : $"{ended} orders restocked.";
  }

  render {
    Row(gap: 3, align: Align.Center) {
      if (held > 0) {
        Button($"Restock the shop ({held} {(held == 1 ? "piece" : "pieces")} out)", onPress: Restock);
      }
      if (done != "") { Text(done, fontSize: FontSize.Label, color: Colors.TextMuted); }
    }
  }
}
