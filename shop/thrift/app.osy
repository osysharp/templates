// Second Round — one second-hand shop, five LOOKS. The catalogue, the bag, the checkout, the
// orders and the desk are the shop kit's and this app's; how the shop LOOKS is a look kit's — the Rail (the painted
// wall), the Kiosk, the Fitting room, the Swap sheet and Loud — and which one customers see is the site version's, picked
// at the page desk (/staff/pages): drafted, previewed as a whole site, switched on a date. Orders, stock and customers
// stay put across a switch, and so does everything staff arranged: a look redraws the same words and photographs in its
// own design.
app SecondRound {
  use Osysharp.Ui;
  use Osysharp.Workflow;
  use Osysharp.Storage;
  // The shop reads its mail key; how it is paid and delivered is `app.Shop`, in model/shop.osy.
  use Osysharp.Shop@1 { egress "api.resend.com"; secret "ResendApiKey"; }
  use Osysharp.Identity@0;
  use Osysharp.Accounts@1;
  use Osysharp.Payments@0;
  use Osysharp.Delivery@0;
  use Osysharp.Seo@0;
  // Discount codes: an add-on the shop finds by itself; staff make codes on /staff/codes.
  use Osysharp.Shop.Discounts@0;
  use Osysharp.Payments.Stripe@0 { egress "api.stripe.com"; }
  // Klarna through its Hosted Payment Page — the live host, and the playground one a test merchant uses.
  use Osysharp.Payments.Klarna@0 { egress "api.klarna.com"; egress "api.playground.klarna.com"; }
  // The shop's mail — confirmations, resets, returns — goes out through Resend, to this host only.
  use Osysharp.Resend@0 { egress "api.resend.com"; }
  // The page desk (/staff/pages): the versions of the site, the look each wears, the menu, the strip across the top,
  // the footer and the front page — arranged by staff, previewed first. Osysharp.Blocks keeps what they arrange.
  use Osysharp.Blocks;
  use Osysharp.Pages@0;
  // The block types every look draws — the general site's and (inside the shop kit) the shop's.
  use Osysharp.Site.Looks@0;
  // THE LOOKS. Each is a kit: its frame, its pages, its theme and fonts, its design of every block type. None carries
  // data or logic. `app.Look` (model/shell.osy) names the one the site wears until staff choose another.
  use Osysharp.Shop.Looks.Rail@0;
  use Osysharp.Shop.Looks.Kiosk@0;
  use Osysharp.Shop.Looks.Fitting@0;
  use Osysharp.Shop.Looks.Swap@0;
  use Osysharp.Shop.Looks.Loud@0;
  use Osysharp.Http;
  model "model/**/*.osy";
  tests "tests/**/*.test.osy";
  data  "data/**/*.json";
}
