// THE WINDOW — the whole of Second Round's rail as the store's data has it (data/*.json): its shelves, its sixteen
// pieces — one of each — with their sizes, spec sheets and photographs. What every look is photographed with, so five
// designs are compared over the same pieces. Written out from the data files; the photographs are the store's own
// (public/products).

using Osysharp.Shop;

[TestFixture]
void Window() {
  new ShopSettings { Name = "Second Round", Currency = "SEK", CurrencySymbol = "kr", SymbolAfter = true, OrderPrefix = "AV-",
                     HoldDays = 3, DeliveryFee = 49m, VatPercent = 25m };
  var c_jackets_coats = new Category { Name = "Jackets & coats", Slug = "jackets-coats", Rank = 0 };
  var c_denim = new Category { Name = "Denim", Slug = "denim", Rank = 1 };
  var c_knitwear = new Category { Name = "Knitwear", Slug = "knitwear", Rank = 2 };
  var c_dresses_tops = new Category { Name = "Dresses & tops", Slug = "dresses-tops", Rank = 3 };
  var c_bags = new Category { Name = "Bags", Slug = "bags", Rank = 4 };
  var c_shoes_boots = new Category { Name = "Shoes & boots", Slug = "shoes-boots", Rank = 5 };
  var c_accessories = new Category { Name = "Accessories", Slug = "accessories", Rank = 6 };
  var p_shearling_collar_leather_jacket = new Product { Name = "Shearling-collar leather jacket", Slug = "shearling-collar-leather-jacket", Category = c_jackets_coats, Price = 1450m, Rank = 0, Summary = "A 1970s brown leather jacket with a curly shearling collar and cuffs.", Description = "The leather has a lovely worn-in grain, darker at the seams, and the shearling trim is full and clean. All snaps work and the lining was replaced at some point in a matching brown." };
  var p_rust_twill_jacket = new Product { Name = "Rust twill jacket", Slug = "rust-twill-jacket", Category = c_jackets_coats, Price = 450m, Rank = 1, Summary = "A boxy rust-orange cotton twill jacket with snap buttons.", Description = "Heavy cotton twill faded to a warm rust, with press studs down the front and a point collar. Cut short and square, easy over a knit." };
  var p_faded_denim_trucker_jacket = new Product { Name = "Faded denim trucker jacket", Slug = "faded-denim-trucker-jacket", Category = c_denim, Price = 550m, Rank = 2, Summary = "A classic light-blue denim jacket with copper buttons and flap pockets.", Description = "Soft, properly broken-in denim with the fading exactly where it should be: collar, cuffs and pocket flaps. Leather-look patch inside the collar, no holes." };
  var p_light_wash_straight_jeans = new Product { Name = "Light-wash straight jeans", Slug = "light-wash-straight-jeans", Category = c_denim, Price = 390m, Rank = 3, Summary = "High-rise, straight-leg jeans in a pale sun-bleached wash.", Description = "Rigid cotton denim with no stretch, so they hold their shape and mould to you. Five pockets, button fly, a paper-look back patch." };
  var p_terracotta_canvas_overshirt = new Product { Name = "Terracotta canvas overshirt", Slug = "terracotta-canvas-overshirt", Category = c_jackets_coats, Price = 420m, Rank = 4, Summary = "A garment-dyed cotton canvas overshirt in faded terracotta.", Description = "Two patch pockets on the chest, horn-look buttons and a small leather tab at the neck. The dye has softened unevenly, which is exactly its charm." };
  var p_rose_print_tea_dress = new Product { Name = "Rose print tea dress", Slug = "rose-print-tea-dress", Category = c_dresses_tops, Price = 520m, Rank = 5, Summary = "A dark floral tea dress with puff shoulders and a velvet-trimmed waist.", Description = "Sheer crepe printed with dusky roses on black, a wrap-effect V-neck and three-quarter sleeves. Fully lined skirt, falls to mid-calf." };
  var p_sheer_black_tie_front_blouse = new Product { Name = "Sheer black tie-front blouse", Slug = "sheer-black-tie-front-blouse", Category = c_dresses_tops, Price = 320m, Rank = 6, Summary = "A cropped sheer black blouse with balloon sleeves and a long tie.", Description = "Fine chiffon that ties at the front, with gathered sleeves and narrow cuffs. Wear it over a slip or a fitted vest." };
  var p_striped_wool_jumper = new Product { Name = "Striped wool jumper", Slug = "striped-wool-jumper", Category = c_knitwear, Price = 360m, Rank = 7, Summary = "A hand-knit crew-neck in raspberry with a purple rib and brown stripe.", Description = "Someone knitted this by hand and it shows in the best way. Thick wool, a slightly uneven purple rib at the neck and a band of brown across the body." };
  var p_red_rib_knit_cardigan = new Product { Name = "Red rib-knit cardigan", Slug = "red-rib-knit-cardigan", Category = c_knitwear, Price = 420m, Rank = 8, Summary = "A cropped cardigan in bright red chunky rib with gold buttons.", Description = "A generous boxy shape with dropped shoulders and a deep V. The rib is springy and the colour is still strong." };
  var p_western_leather_boots = new Product { Name = "Western leather boots", Slug = "western-leather-boots", Category = c_shoes_boots, Price = 890m, Rank = 9, Summary = "Tan cowboy boots with stitched shafts and a scuffed, polished toe.", Description = "Proper pull-on western boots with a stacked heel and a decorative stitch pattern up the shaft. The toes are scuffed and have been polished over, the soles have plenty of life." };
  var p_leather_doctors_bag = new Product { Name = "Leather doctor's bag", Slug = "leather-doctors-bag", Category = c_bags, Price = 1250m, Rank = 10, Summary = "A black leather Gladstone bag with a hinged frame and a single handle.", Description = "Heavy, polished leather that has been looked after for decades. The metal frame opens wide and locks shut. A statement piece for travel or a desk." };
  var p_tooled_leather_saddle_bag = new Product { Name = "Tooled leather saddle bag", Slug = "tooled-leather-saddle-bag", Category = c_bags, Price = 680m, Rank = 11, Summary = "A tan hand-tooled leather shoulder bag with whipstitched edges.", Description = "Hand-tooled floral panels, a leather-covered button and a long adjustable strap. The kind of bag that gets better with every year it is carried." };
  var p_woven_frame_handbag = new Product { Name = "Woven frame handbag", Slug = "woven-frame-handbag", Category = c_bags, Price = 560m, Rank = 12, Summary = "A black woven box bag with a gold-tone frame handle.", Description = "A small, rigid box shape in woven black straw with a brass handle and clasp. Lined in black fabric, clean inside." };
  var p_embroidered_evening_purse = new Product { Name = "Embroidered evening purse", Slug = "embroidered-evening-purse", Category = c_accessories, Price = 620m, Rank = 13, Summary = "A frame purse embroidered with gold thread in a heraldic pattern.", Description = "Petit-point and gold thread embroidery on a black ground, a kiss-lock clasp and a fine chain handle. Too good to keep in a drawer." };
  var p_tortoiseshell_cat_eye_sunglasses = new Product { Name = "Tortoiseshell cat-eye sunglasses", Slug = "tortoiseshell-cat-eye-sunglasses", Category = c_accessories, Price = 280m, Rank = 14, Summary = "Oversized cat-eye frames in warm tortoiseshell with grey lenses.", Description = "Thick acetate frames with a lifted upper edge and grey lenses. The hinges are tight and the lenses are unscratched." };
  var p_linen_market_tote = new Product { Name = "Linen market tote", Slug = "linen-market-tote", Category = c_bags, Price = 240m, Rank = 15, Summary = "A large brown linen tote with long leather handles.", Description = "Washed linen in a deep brown with a patch pocket on the front and rust leather handles riveted at the top. Holds a week of groceries." };
