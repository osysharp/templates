using Osysharp.Shop;
using Osysharp.Storage;

// The front of the shop: the line, three finds pinned at an angle, the rail itself, and how a piece gets here.

[Title("Andra Varvet — second-hand clothing")]
[Page("/")]
[Layout(Shop)]
[Render(CSR)]
[AllowAnonymous]
component Home() {
  live var justIn = Product.Include(p => p.Images).Include(p => p.Variants)
    .Where(p => p.Status == ProductStatus.Listed).OrderBy(p => p.Rank).Take(8).ToList();
  live var pinA = Product.Include(p => p.Images).Where(p => p.Slug == "shearling-collar-leather-jacket").ToList();
  live var pinB = Product.Include(p => p.Images).Where(p => p.Slug == "rose-print-tea-dress").ToList();
  live var pinC = Product.Include(p => p.Images).Where(p => p.Slug == "tooled-leather-saddle-bag").ToList();

  render {
    Stack(gap: 0) {
      // ── the line, and three finds pinned beside it ─────────────────────────────────────────────────────
      Section {
        Box(display: Display.Grid, cols: "repeat(auto-fit, minmax(320px, 1fr))", gap: 10, py: 14, align: Align.Center) {
          Stack(gap: 6, animation: RiseIn) {
            Text("Worn once.\nLoved twice.", fontFamily: Font.Display, fontSize: FontSize.Mega, fontWeight: FontWeight.Black,
                 lineHeight: "0.86", letterSpacing: "-0.04em", whiteSpace: WhiteSpace.PreLine);
            Text("Jackets, denim, knits and leather — every piece one of one, washed, mended where it needed it, and priced like a find.",
                 fontSize: FontSize.Lead, lineHeight: "1.5", color: Colors.TextSecondary, maxW: "520px");
            Row { Link(href: "/shop", label: "See what's just in") { Pill("See what's just in →"); } }
          }
          Box(position: Position.Relative, h: "560px") {
            foreach (var p in pinA) { Pinned(Cover(p.Images), p.Name, "0", "6%", "-4deg", 1); }
            foreach (var p in pinB) { Pinned(Cover(p.Images), p.Name, "22%", "46%", "5deg", 2); }
            foreach (var p in pinC) { Pinned(Cover(p.Images), p.Name, "52%", "10%", "-2deg", 3); }
          }
        }
      }

      // ── the rail ─────────────────────────────────────────────────────────────────────────────────────────
      Section {
        Stack(gap: 0, pt: 10, pb: 16) {
          SectionHead("Just in", linkLabel: "The whole rail", to: "/shop");
          ProductGrid(justIn);
        }
      }

      // ── how a piece gets here ────────────────────────────────────────────────────────────────────────────
      Box(bg: Colors.Surface) {
        Section {
          Box(display: Display.Grid, cols: "repeat(auto-fit, minmax(240px, 1fr))", gap: 8, py: 16) {
            Step("01", "Picked one by one", "Nothing comes in by the bale. Every piece is chosen for its cloth, its cut and how much wear it has left.");
            Step("02", "Washed and mended", "Buttons sewn back on, seams closed, leather fed. If it cannot be made right, it does not go on the rail.");
            Step("03", "Gone when it's gone", "There is one of each. Put it in your bag and it is held for you for three days while you pay.");
          }
        }
      }
    }
  }
}

/// A find pinned to the wall at an angle — a photograph with a white border, rising a little under the pointer.
[Composable]
component Pinned(string photo, string alt, string top, string left, string tilt, int layer) {
  variants {
    base { Position = Position.Absolute; W = "46%"; P = 2; Bg = "#F3F1EA"; Shadow = Shadow.Floating; Transition = Motion.Lift;
           Hover { TranslateY = "-6px"; } }
  }
  render {
    Box(top: top, left: left, rotate: tilt, z: layer) {
      Image(src: File.Url(photo), alt: alt, w: "100%", aspectRatio: "4 / 5", objectFit: ObjectFit.Cover);
    }
  }
}

/// The one yellow thing to press.
[Composable]
component Pill(string label) {
  variants {
    base { Bg = Colors.Primary; Color = Colors.OnPrimary; Px = 6; Py = 3; Rounded = Radius.Pill; FontWeight = FontWeight.Semibold;
           Transition = Motion.Lift; Hover { TranslateY = "-2px"; } }
  }
  render { Text(label); }
}

/// One step of how a piece gets here.
[Composable]
component Step(string number, string title, string body) {
  render {
    Stack(gap: 3, animation: Surface, animationTimeline: AnimationTimeline.View) {
      Text(number, color: Colors.Primary, fontWeight: FontWeight.Black);
      Text(title, fontSize: FontSize.Title, fontWeight: FontWeight.Black, lineHeight: "1.05");
      Text(body, color: Colors.TextSecondary, lineHeight: "1.6");
    }
  }
}
