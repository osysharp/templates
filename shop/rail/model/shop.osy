// What Andra Varvet writes itself on top of the shop kit: how staff sign in, where Stripe posts, and how a price reads.
//
// There is NO signup — a staff account is made by someone who already runs the shop (`osy user add … --role Staff`),
// never by a stranger with the URL.

using Osysharp.Shop;

app.Auth = new PasswordAuth { LoginField = Email, PasswordField = PasswordHash };
app.AuthBootstrap = new AuthBootstrap {
  Role = ShopRole.Authenticator, LoginPage = AccountSignIn,
  Login = ShopLogin, Signup = ShopSignup,
  PasswordResetRequest = ShopRequestPasswordReset, PasswordReset = ShopResetPassword,
  PasswordChange = ShopChangePassword, EmailChange = ShopChangeEmail,
};

app.Audit = new AuditConfig {
  Redact = new AuditRedaction { Properties = [ShopAccount.PasswordHash] },
};

// Stripe posts here. Open, because Stripe has no account to sign in with — the kit's signature check is the lock.
app.Apis = [
  new RestApi("Stripe") {
    Route = "stripe",
    Auth  = new ApiAuth { Anonymous = true },
    Endpoints = [
      new Endpoint(ShopStripeEvents) { Method = HttpMethod.Post, Path = "/events", Raw = true, Headers = ["Stripe-Signature"] },
    ],
  },
  // Klarna reports a finished payment here. Unsigned, so the kit reads the order back from Klarna before it counts.
  new RestApi("Klarna") {
    Route = "klarna",
    Auth  = new ApiAuth { Anonymous = true },
    Endpoints = [
      new Endpoint(ShopKlarnaEvents) { Method = HttpMethod.Post, Path = "/events", Raw = true },
    ],
  },
];

/// A price the way the shop writes it: kronor, no öre.
string PriceText(decimal price) {
  return $"{price:N0} kr";
}

// ── read helpers a page can call while it renders ───────────────────────────────────────────────────────────────
//
// ⚠ THE KIT HAS THESE TOO (`CoverPhoto`, `Spec`, `Sold`, `OnHold`), and they cannot yet run in a render: a PACKAGE's
//   function is not sent to the browser, even a pure one, while the same body declared in the app is. So the
//   store carries its own few lines of each.

/// The cover photograph — the first by rank — of the photos handed in.
string Cover(ProductImage[] images) {
  return images.OrderBy(i => i.Rank).Select(i => i.Path).FirstOrDefault() ?? "";
}

/// One line of a spec sheet, or "".
string SpecOf(ProductSpec[] specs, string name) {
  return specs.Where(s => s.Name == name).Select(s => s.Value).FirstOrDefault() ?? "";
}

/// Paid for and gone: nothing left, nothing merely reserved.
bool IsSold(Variant[] variants) {
  return variants.All(v => v.Stock == 0 && v.Reserved == 0);
}

/// An unpaid order is holding it.
bool IsHeld(Variant[] variants) {
  return variants.Any(v => v.Reserved > 0);
}

/// A product's cover among covers read on their own — for the bag, whose lines reach their product through two
/// references (a photo collection at the end of `Lines.Variant.Product` is not carried to the browser by the include).
string CoverFor(List<ProductImage> covers, Guid product) {
  return covers.Where(c => c.Product.Id == product).OrderBy(c => c.Rank).Select(c => c.Path).FirstOrDefault() ?? "";
}

/// One spec line of a product, among lines read on their own.
string SpecFor(List<ProductSpec> specs, Guid product, string name) {
  return specs.Where(s => s.Product.Id == product && s.Name == name).Select(s => s.Value).FirstOrDefault() ?? "";
}

/// "Colnago · 1981 · 56 cm" — the line a collector reads under a name.
string Specs(string brand, ProductSpec[] specs) {
  return $"{brand} · {SpecOf(specs, "Year")} · {SpecOf(specs, "Frame size")}";
}

/// "S", "Black", "Black / S" — a variant as a size chip reads it.
string VariantName(Variant v) {
  var size = v.Size ?? "";
  var colour = v.Colour ?? "";
  if (size != "" && colour != "") { return $"{colour} / {size}"; }
  return size != "" ? size : (colour != "" ? colour : "One size");
}

/// What a variant costs.
decimal VariantPrice(Variant v, decimal productPrice) {
  return v.Price ?? productPrice;
}

/// The second photograph by rank — what a card shows under the pointer — or the cover when there is only one.
string SecondCover(ProductImage[] images) {
  return images.OrderBy(i => i.Rank).Skip(1).Select(i => i.Path).FirstOrDefault() ?? Cover(images);
}
