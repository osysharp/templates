using Osysharp.Shop;
using Osysharp.Storage;

// The front of the showroom: the season's line in italic beside the pinned coat, then what is new, two across.

[Title("Andra Varvet — the fitting room")]
[Page("/")]
[Layout(Shop)]
[Render(CSR)]
[AllowAnonymous]
component Home() {
  live var newIn = Product.Include(p => p.Images).Include(p => p.Variants)
    .Where(p => p.Status == ProductStatus.Listed).OrderBy(p => p.Rank).Take(6).ToList();

  render {
    Stack(gap: 0) {
      Section {
        Stack(gap: 6, pt: 14, pb: 12, animation: RiseIn) {
          Text("Second hand, first choice.", fontFamily: Font.Display, fontStyle: FontStyle.Italic, fontSize: FontSize.Mega,
               lineHeight: "0.92", letterSpacing: "-0.02em");
          Text("Sixteen pieces, each the only one of its kind — a shearling from the seventies, a tooled saddle bag, a tea dress with its buttons all there.",
               fontSize: FontSize.Lead, lineHeight: "1.6", color: Colors.TextSecondary, maxW: "520px");
          Row(gap: 5, align: Align.Center) {
            Link(href: "/shop", label: "See the rail") { ShowroomLink("See the rail"); }
            Link(href: "/p/shearling-collar-leather-jacket", label: "The shearling") { Text("The shearling →", color: Colors.TextSecondary); }
          }
        }
      }
      Section {
        Stack(gap: 0, pb: 16) {
          SectionHead("New in", linkLabel: "Shop all", to: "/shop");
          ShowroomGrid(newIn);
        }
      }
    }
  }
}

/// The call to action: a hot-pink pill.
[Composable]
component ShowroomLink(string label) {
  variants { base { Bg = Colors.Primary; Color = Colors.OnPrimary; Px = 6; Py = 3; Rounded = Radius.Pill; FontWeight = FontWeight.Semibold;
                    Transition = Motion.Lift; Hover { TranslateY = "-2px"; } } }
  render { Text(label); }
}

/// Two across — the showroom's grid sits in half a screen, so its cards stay large.
[Composable]
component ShowroomGrid(List<Product> products) {
  variants { base { Display = Display.Grid; Cols = "repeat(2, minmax(0, 1fr))"; Gap = 5; } }
  render { Box { foreach (var p in products) { ProductCard(p, products.IndexOf(p)); } } }
}
