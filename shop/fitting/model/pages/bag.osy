using Osysharp.Shop;
using Osysharp.Storage;

// The bag, as a page of its own: each piece with its size, how many, and the way to checkout.

[Title("Your bag — Andra Varvet")]
[Page("/bag")]
[Layout(Shop)]
[Render(CSR)]
[AllowAnonymous]
component BagPage() {
  string visitId = Visitor.Id;
  live var bag = Bag.Include(b => b.Lines.Variant.Product).SingleOrDefault(b => b.VisitId == visitId);
  live var covers = ProductImage.Where(i => i.Rank == 0).ToList();
  string problem = "";

  action Remove(BagLine line) { RemoveFromBag(line); }
  action More(BagLine line) { problem = SetQuantity(line, line.Quantity + 1); }
  action Fewer(BagLine line) { problem = SetQuantity(line, line.Quantity - 1); }
  action Checkout() { Navigation.Go("/checkout"); }

  render {
    Section {
      Stack(gap: 0, pt: 14, pb: 20, maxW: "960px") {
        Text("Your bag", fontFamily: Font.Display, fontSize: FontSize.Hero, fontWeight: FontWeight.Light, pb: 8);
        if (bag == null || bag.Lines.Count() == 0) {
          Stack(gap: 3) {
            Text("Nothing in the bag yet.", fontSize: FontSize.Lead, color: Colors.TextSecondary);
            Row { Link(href: "/shop", label: "See what's just in") { Text("See what's just in →", color: Colors.TextSecondary); } }
          }
        } else {
          Stack(gap: 0, borderTW: 1, border: Colors.Border) {
            foreach (var line in bag.Lines) {
              Row(gap: 5, py: 5, borderBW: 1, border: Colors.Border, align: Align.Center, label: line.Variant.Product.Name) {
                Image(src: File.Url(CoverFor(covers, line.Variant.Product.Id)), alt: line.Variant.Product.Name, w: "96px",
                      aspectRatio: "3 / 4", objectFit: ObjectFit.Cover);
                Stack(gap: 1, grow: 1, minW: "0") {
                  Text(line.Variant.Product.Name);
                  ShopLineNote(line);
                  Text(VariantName(line.Variant), fontSize: FontSize.Label, color: Colors.TextMuted);
                  Row(gap: 3, align: Align.Center, pt: 2) {
                    IconButton("One fewer " + line.Variant.Product.Name, () => Fewer(line)) { Icon(Icons.Minus); }
                    Text($"{line.Quantity}");
                    IconButton("One more " + line.Variant.Product.Name, () => More(line)) { Icon(Icons.Plus); }
                  }
                }
                Stack(gap: 2, align: Align.End) {
                  Text(PriceText(VariantPrice(line.Variant, line.Variant.Product.Price) * line.Quantity));
                  Button("Remove", onPress: () => Remove(line));
                }
              }
            }
          }
          if (problem != "") { Text(problem, role: UiRole.Alert, color: Colors.Primary, pt: 3); }
          Row(justify: Justify.Between, align: Align.Center, pt: 6, gap: 4, wrap: Wrapping.Wrap) {
            Text($"Subtotal {PriceText(bag.Lines.Sum(l => (l.Variant.Price ?? l.Variant.Product.Price) * l.Quantity))}",
                 fontSize: FontSize.Lead);
            Button("Check out", onPress: Checkout, tone: Tone.Primary, size: Size.Lg);
          }
        }
      }
    }
  }
}
