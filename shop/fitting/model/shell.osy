// The frame — the kit's SplitShell: one photograph pinned to half the screen, chosen for the page, while the page
// scrolls beside it. On a product page it is that piece.

using Osysharp.Shop;
using Osysharp.Storage;

app.DefaultCulture = "sv-SE";

/// Which piece's photograph holds the pinned half for a route: a product page shows its own piece, a shelf a piece
/// from it, the home page the season's coat.
string ArtSlug(string path) {
  if (path.StartsWith("/p/")) { return path.Substring(3); }
  if (path.StartsWith("/shop/shoes-boots")) { return "western-leather-boots"; }
  if (path.StartsWith("/shop/bags")) { return "tooled-leather-saddle-bag"; }
  if (path.StartsWith("/shop/denim")) { return "faded-denim-trucker-jacket"; }
  if (path.StartsWith("/shop/knitwear")) { return "striped-wool-jumper"; }
  if (path.StartsWith("/shop/dresses-tops")) { return "rose-print-tea-dress"; }
  if (path.StartsWith("/shop")) { return "rust-twill-jacket"; }
  return "shearling-collar-leather-jacket";
}

[Layout]
[AllowAnonymous]
component Shop() {
  string visitId = Visitor.Id;
  live var path = Navigation.CurrentPath ?? "";
  live var artSlug = ArtSlug(path);
  live var art = Product.Include(p => p.Images).Where(p => p.Slug == artSlug).ToList();
  live var bag = Bag.Include(b => b.Lines).SingleOrDefault(b => b.VisitId == visitId);
  live var inBag = bag == null ? 0 : bag.Lines.Sum(l => l.Quantity);

  action OpenBag() { Navigation.Go("/bag"); }

  render {
    var chrome = new AppChrome {
      Product = "Andra Varvet",
      Home = "/",
      Nav = [
        new NavItem { Label = "Just in", To = "/shop", Exact = true },
        new NavItem { Label = "Jackets", To = "/shop/jackets-coats" },
        new NavItem { Label = "Denim", To = "/shop/denim" },
        new NavItem { Label = "Knitwear", To = "/shop/knitwear" },
        new NavItem { Label = "Dresses", To = "/shop/dresses-tops" },
        new NavItem { Label = "Bags", To = "/shop/bags" },
        new NavItem { Label = "Shoes", To = "/shop/shoes-boots" },
        new NavItem { Label = "Accessories", To = "/shop/accessories" },
        new NavItem { Label = "Sale", To = "/sale" },
      ],
    };
    SplitShell(chrome) {
      ShopVisitSync();
      Outlet(retain: 8);
      slot art {
        foreach (var p in art) {
          Image(src: File.Url(Cover(p.Images)), alt: p.Name, w: "100%", h: "100%", objectFit: ObjectFit.Cover, objectPosition: "center 25%");
        }
      }
      slot promo { StorePromo(DemoNotice()); }
      slot actions { ShopAccountButton(); Button(inBag == 0 ? "Bag" : $"Bag ({inBag})", onPress: OpenBag, tone: Tone.Primary); }
      slot footer {
        EditorialFooter(chrome, blurb: "Second-hand clothing, bags and boots, picked one at a time, washed, mended where it needs it, and priced like a find.",
                        note: "A demo built in Osy#. Andra Varvet is a fictional shop · Photography via Pexels");
        Box(px: 6, pb: 6) { ShopPolicyLinks(); }
      }
    }
  }
}

/// A page's content column — inside the split's half, so narrower margins than a full-width shell.
[Composable]
component Section() {
  variants { base { W = "100%"; Px = 5; Laptop { Px = 8; } } }
  render { Box { Slot; } }
}
