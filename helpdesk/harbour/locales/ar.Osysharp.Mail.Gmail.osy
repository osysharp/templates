  error "Google's token endpoint answered {answered.StatusCode} for '{Address}'." => { zero: "أجابت نقطة نهاية الرموز في Google بـ {answered.StatusCode} لـ '{Address}'.", one: "أجابت نقطة نهاية الرموز في Google بـ {answered.StatusCode} لـ '{Address}'.", two: "أجابت نقطة نهاية الرموز في Google بـ {answered.StatusCode} لـ '{Address}'.", few: "أجابت نقطة نهاية الرموز في Google بـ {answered.StatusCode} لـ '{Address}'.", many: "أجابت نقطة نهاية الرموز في Google بـ {answered.StatusCode} لـ '{Address}'.", other: "أجابت نقطة نهاية الرموز في Google بـ {answered.StatusCode} لـ '{Address}'." };

