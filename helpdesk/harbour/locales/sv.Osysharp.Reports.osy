  /// placeholders: {of} = of
  /// beside: "Close"
  text "The rows behind {of}" => "Raderna bakom {of}";

  // ── Osysharp.Reports · ReportStatus ──
  /// ReportStatus · a control's name for screen readers
  accessibleName "Loading the report" => "Läser in rapporten";
  /// ReportStatus · text on the page
  /// placeholders: {nouns} = nouns
  /// shown through EmptyState.body
  text "No {nouns} in this period match. Widen the period, or take a filter off." => "Inga {nouns} under perioden matchar. Vidga perioden eller ta bort ett filter.";
  /// ReportStatus · text on the page
  /// placeholders: {result.Rows.Count} = result.Rows.Count
  text "Showing the first {result.Rows.Count} groups. Add a filter or a coarser grouping to see them all." => "Visar de första {result.Rows.Count} grupperna. Lägg till ett filter eller en grövre gruppering för att se alla.";
  /// ReportStatus · text on the page
  /// shown through ReportStatus.nouns
  text "rows" => "rader";
  /// ReportStatus · a title
  /// shown through Alert.title
  title "This report could not run" => "Rapporten kunde inte köras";

  // ── Osysharp.Reports · ReportTable ──
  /// ReportTable · a label (a field, a list item, a menu entry) · at most ~12 characters
  /// shown through ReportTable.label
  label "Report" => "Rapport";

  // ── Osysharp.Reports · ReportTableRow ──
  /// ReportTableRow · a control's name for screen readers
  /// placeholders: {CellText} = CellText(…)
  accessibleName "Show the rows of {CellText}" => "Visa raderna för {CellText}";

  // ── Osysharp.Reports · ReportTotals ──
  /// ReportTotals · a label (a field, a list item, a menu entry) · at most ~12 characters
  /// shown through ReportFigures.label
  label "Totals" => "Totalt";
  /// ReportTotals · text on the page
  /// placeholders: {answer.PeriodBefore} = answer.PeriodBefore
  text "Change against {answer.PeriodBefore}" => "Förändring jämfört med {answer.PeriodBefore}";

  // ── Osysharp.Reports · RunReport ──
  /// RunReport · message
  /// shown through ExploreResult.Problem
  message "This app does not report on that. Choose one of its reports." => "Appen rapporterar inte om det. Välj en av dess rapporter.";

  // ── Osysharp.Reports · RunSourceReport ──
  /// RunSourceReport · message
  /// shown through ExploreResult.Problem
  /// also in RunSourceRows
  /// also in RunSourceNow
  message "This app does not report on that." => "Appen rapporterar inte om det.";

  // ── Osysharp.Reports · RunSourceRows ──
  /// RunSourceRows · message
  /// shown through ExploreResult.Problem
  message "This report does not list the rows it counts." => "Den här rapporten listar inte raderna den räknar.";

  // ── Osysharp.Reports · SaveReport ──
  /// SaveReport · an error message
  /// shown through ValidationException
  error "Name the report." => "Ge rapporten ett namn.";
  /// SaveReport · an error message
  /// shown through ValidationException
  error "Sign in to save a report." => "Logga in för att spara en rapport.";
  /// SaveReport · an error message
  /// shown through ValidationException
  error "This app does not report on that." => "Appen rapporterar inte om det.";

  // ── Osysharp.Reports · SaveReportBar ──
  /// SaveReportBar · a control's name for screen readers
  accessibleName "Save the report" => "Spara rapporten";
  /// SaveReportBar · a button's label · at most ~17 characters
  /// shown through Button.label
  /// beside: "240px", "Cancel"
  button "Save report" => "Spara rapport";
  /// SaveReportBar · text on the page
  /// beside: "240px"
  text "A saved report keeps the question, not the numbers: whoever opens it sees the rows they may read, as they are then." => "En sparad rapport behåller frågan, inte siffrorna: den som öppnar den ser de rader hen får läsa, som de är då.";

  // ── Osysharp.Reports · SearchHint ──
  /// SearchHint · placeholder text inside an empty field · at most ~26 characters
  /// shown through SearchHint()
  placeholder "Search the fields…" => "Sök bland fälten…";

  // ── Osysharp.Reports · TrendWords ──
  /// TrendWords · text on the page
  /// placeholders: {what} = what (string)
  text "{what} per day" key "report-trend-day" => "{what} per dag";
  /// TrendWords · text on the page
  /// placeholders: {what} = what (string)
  text "{what} per hour" key "report-trend-hour" => "{what} per timme";
  /// TrendWords · text on the page
  /// placeholders: {what} = what (string)
  text "{what} per month" key "report-trend-month" => "{what} per månad";
  /// TrendWords · text on the page
  /// placeholders: {what} = what (string)
  text "{what} per quarter" key "report-trend-quarter" => "{what} per kvartal";
  /// TrendWords · text on the page
  /// placeholders: {what} = what (string)
  text "{what} per week" key "report-trend-week" => "{what} per vecka";
  /// TrendWords · text on the page
  /// placeholders: {what} = what (string)
  text "{what} per year" key "report-trend-year" => "{what} per år";
}
