// sv (Svenska): the words of Helpdesk · Osysharp.Reports, translated.
// Written and kept in step with the source by `osy translate`: a new text arrives as `=> null`, a text
// whose source changed keeps its old translation in a `was` clause. The words are yours to edit.
// Source language: en.

translations sv {
  // ── Osysharp.Reports · BucketWords ──
  /// BucketWords · text on the page
  /// placeholders: {name} = name (string), {ToLower} = bucket.Value.Label.ToLower(…) (string)
  /// shown through BucketWords()
  text "{name}, by {ToLower}" => "{name}, per {ToLower}";

  // ── Osysharp.Reports · CheckedSpecs ──
  /// CheckedSpecs · message
  /// placeholders: {m.Label} = m.Label (string), {s.Title} = s.Title (string)
  /// shown through CheckedSpecs()
  message "'{m.Label}' is not one of the measures of {s.Title}." => "'{m.Label}' är inte ett av måtten i {s.Title}.";
  /// CheckedSpecs · message
  /// placeholders: {key} = key (string)
  /// shown through CheckedSpecs()
  /// also in OverviewFor
  message "This app has no report called '{key}'." => "Appen har ingen rapport som heter '{key}'.";

  // ── Osysharp.Reports · DurationWords ──
  /// DurationWords · a control's name for screen readers
  /// placeholders: {sign} = sign (string), {days} = days (int) — {days} is a count: give one text per plural form
  /// shown through DurationWords()
  accessibleName "{sign}{days} d" => { one: "{sign}{days} d", other: "{sign}{days} d" };
  /// DurationWords · a control's name for screen readers
  /// placeholders: {sign} = sign (string), {days} = days (int), {h} = h (int) — {days} is a count: give one text per plural form
  /// shown through DurationWords()
  accessibleName "{sign}{days} d {h} h" => { one: "{sign}{days} d {h} h", other: "{sign}{days} d {h} h" };
  /// DurationWords · a control's name for screen readers
  /// placeholders: {sign} = sign (string), {hours} = hours (int) — {hours} is a count: give one text per plural form
  /// shown through DurationWords()
  accessibleName "{sign}{hours} h" => { one: "{sign}{hours} h", other: "{sign}{hours} h" };
  /// DurationWords · a control's name for screen readers
  /// placeholders: {sign} = sign (string), {hours} = hours (int), {rest} = rest (int) — {hours} is a count: give one text per plural form
  /// shown through DurationWords()
  accessibleName "{sign}{hours} h {rest} min" => { one: "{sign}{hours} h {rest} min", other: "{sign}{hours} h {rest} min" };
  /// DurationWords · a control's name for screen readers
  /// placeholders: {sign} = sign (string), {minutes} = minutes (int) — {minutes} is a count: give one text per plural form
  /// shown through DurationWords()
  accessibleName "{sign}{minutes} min" => { one: "{sign}{minutes} min", other: "{sign}{minutes} min" };

  // ── Osysharp.Reports · FieldList ──
  /// FieldList · a control's name for screen readers
  /// placeholders: {listed.Count} = listed.Count
  accessibleName "Fields through lists ({listed.Count})" => "Fält genom listor ({listed.Count})";
  /// FieldList · a control's name for screen readers
  accessibleName "Hide fields through lists" => "Dölj fält genom listor";
  /// FieldList · text on the page
  /// shown through FieldHeading.text
  /// beside: "Suggested"
  text "Every field" => "Alla fält";
  /// FieldList · text on the page
  text "Fields through lists" => "Fält genom listor";
  /// FieldList · text on the page
  /// placeholders: {listed.Count} = listed.Count
  text "Fields through lists ({listed.Count})" => "Fält genom listor ({listed.Count})";
  /// FieldList · text on the page
  /// placeholders: {search} = search
  text "No field is called \"{search}\"." => "Inget fält heter \"{search}\".";
  /// FieldList · text on the page
  /// shown through FieldHeading.text
  /// beside: "Every field"
  text "Suggested" => "Förslag";

