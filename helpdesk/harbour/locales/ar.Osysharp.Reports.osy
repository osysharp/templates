// ar (العربية): the words of Helpdesk · Osysharp.Reports, translated.
// Written and kept in step with the source by `osy translate`: a new text arrives as `=> null`, a text
// whose source changed keeps its old translation in a `was` clause. The words are yours to edit.
// Source language: en.

translations ar {
  // ── Osysharp.Reports · BucketWords ──
  /// BucketWords · text on the page
  /// placeholders: {name} = name (string), {ToLower} = bucket.Value.Label.ToLower(…) (string)
  /// shown through BucketWords()
  text "{name}, by {ToLower}" => "{name}، حسب {ToLower}";

  // ── Osysharp.Reports · CheckedSpecs ──
  /// CheckedSpecs · message
  /// placeholders: {m.Label} = m.Label (string), {s.Title} = s.Title (string)
  /// shown through CheckedSpecs()
  message "'{m.Label}' is not one of the measures of {s.Title}." => "'{m.Label}' ليس من مقاييس {s.Title}.";
  /// CheckedSpecs · message
  /// placeholders: {key} = key (string)
  /// shown through CheckedSpecs()
  /// also in OverviewFor
  message "This app has no report called '{key}'." => "لا يوجد في هذا التطبيق تقرير باسم '{key}'.";

  // ── Osysharp.Reports · DurationWords ──
  /// DurationWords · a control's name for screen readers
  /// placeholders: {sign} = sign (string), {days} = days (int) — {days} is a count: give one text per plural form
  /// shown through DurationWords()
  accessibleName "{sign}{days} d" => { zero: "{sign}{days} ي", one: "{sign}{days} ي", two: "{sign}{days} ي", few: "{sign}{days} ي", many: "{sign}{days} ي", other: "{sign}{days} ي" };
  /// DurationWords · a control's name for screen readers
  /// placeholders: {sign} = sign (string), {days} = days (int), {h} = h (int) — {days} is a count: give one text per plural form
  /// shown through DurationWords()
  accessibleName "{sign}{days} d {h} h" => { zero: "{sign}{days} ي {h} س", one: "{sign}{days} ي {h} س", two: "{sign}{days} ي {h} س", few: "{sign}{days} ي {h} س", many: "{sign}{days} ي {h} س", other: "{sign}{days} ي {h} س" };
  /// DurationWords · a control's name for screen readers
  /// placeholders: {sign} = sign (string), {hours} = hours (int) — {hours} is a count: give one text per plural form
  /// shown through DurationWords()
  accessibleName "{sign}{hours} h" => { zero: "{sign}{hours} س", one: "{sign}{hours} س", two: "{sign}{hours} س", few: "{sign}{hours} س", many: "{sign}{hours} س", other: "{sign}{hours} س" };
  /// DurationWords · a control's name for screen readers
  /// placeholders: {sign} = sign (string), {hours} = hours (int), {rest} = rest (int) — {hours} is a count: give one text per plural form
  /// shown through DurationWords()
  accessibleName "{sign}{hours} h {rest} min" => { zero: "{sign}{hours} س {rest} د", one: "{sign}{hours} س {rest} د", two: "{sign}{hours} س {rest} د", few: "{sign}{hours} س {rest} د", many: "{sign}{hours} س {rest} د", other: "{sign}{hours} س {rest} د" };
  /// DurationWords · a control's name for screen readers
  /// placeholders: {sign} = sign (string), {minutes} = minutes (int) — {minutes} is a count: give one text per plural form
  /// shown through DurationWords()
  accessibleName "{sign}{minutes} min" => { zero: "{sign}{minutes} د", one: "{sign}{minutes} د", two: "{sign}{minutes} د", few: "{sign}{minutes} د", many: "{sign}{minutes} د", other: "{sign}{minutes} د" };

  // ── Osysharp.Reports · FieldList ──
  /// FieldList · a control's name for screen readers
  /// placeholders: {listed.Count} = listed.Count
  accessibleName "Fields through lists ({listed.Count})" => "حقول عبر القوائم ({listed.Count})";
  /// FieldList · a control's name for screen readers
  accessibleName "Hide fields through lists" => "إخفاء الحقول عبر القوائم";
  /// FieldList · text on the page
  /// shown through FieldHeading.text
  /// beside: "Suggested"
  text "Every field" => "كل الحقول";
  /// FieldList · text on the page
  text "Fields through lists" => "حقول عبر القوائم";
  /// FieldList · text on the page
  /// placeholders: {listed.Count} = listed.Count
  text "Fields through lists ({listed.Count})" => "حقول عبر القوائم ({listed.Count})";
  /// FieldList · text on the page
  /// placeholders: {search} = search
  text "No field is called \"{search}\"." => "لا يوجد حقل باسم \"{search}\".";
  /// FieldList · text on the page
  /// shown through FieldHeading.text
  /// beside: "Every field"
  text "Suggested" => "مقترحة";

