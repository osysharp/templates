  /// placeholders: {answer.Title} = answer.Title, {value} = …
  /// shown through ReportTable.label
  label "{answer.Title} by {value}" => "{answer.Title} حسب {value}";
  /// ReportOverview · text on the page
  text "Build a report" => "إنشاء تقرير";
  /// ReportOverview · text on the page
  /// placeholders: {answer.Nouns} = answer.Nouns
  text "No {answer.Nouns} in this period." => "لا توجد {answer.Nouns} في هذه الفترة.";
  /// ReportOverview · text on the page
  /// shown through problem
  text "The export could not be made. Try again in a moment." => "تعذّر إنشاء الملف المصدَّر. حاول مرة أخرى بعد قليل.";
  /// ReportOverview · text on the page
  /// placeholders: {answer.Breakdown.Rows.Count} = answer.Breakdown.Rows.Count
  text "The {answer.Breakdown.Rows.Count} largest. Build a report to see every one." => "أكبر {answer.Breakdown.Rows.Count}. أنشئ تقريرًا لرؤيتها كلها.";
  /// ReportOverview · text on the page
  /// placeholders: {answer.Period} = answer.Period, {answer.PeriodBefore} = answer.PeriodBefore
  text "{answer.Period} · against {answer.PeriodBefore}" => "{answer.Period} · مقارنة بـ {answer.PeriodBefore}";
  /// ReportOverview · a title
  /// shown through OverviewCard.title
  title "Breakdown" => "التفصيل";
  /// ReportOverview · a title
  /// shown through Alert.title
  title "This overview could not run" => "تعذّر تشغيل النظرة العامة";

  // ── Osysharp.Reports · ReportRows ──
  /// ReportRows · a control's name for screen readers
  /// placeholders: {of} = of
  accessibleName "The rows behind {of}" => "الصفوف وراء {of}";
  /// ReportRows · a label (a field, a list item, a menu entry) · at most ~10 characters
  /// shown through ReportTable.label
  label "Rows" => "الصفوف";
  /// ReportRows · text on the page
  text "No rows." => "لا توجد صفوف.";
  /// ReportRows · text on the page
  /// placeholders: {rows.Result.Rows.Count} = rows.Result.Rows.Count
  text "The first {rows.Result.Rows.Count} — narrow the report to see the rest." => "أول {rows.Result.Rows.Count}. ضيّق التقرير لترى الباقي.";
  /// ReportRows · text on the page
  /// placeholders: {of} = of
  /// beside: "Close"
  text "The rows behind {of}" => "الصفوف وراء {of}";

  // ── Osysharp.Reports · ReportStatus ──
  /// ReportStatus · a control's name for screen readers
  accessibleName "Loading the report" => "جارٍ تحميل التقرير";
  /// ReportStatus · text on the page
  /// placeholders: {nouns} = nouns
  /// shown through EmptyState.body
  text "No {nouns} in this period match. Widen the period, or take a filter off." => "لا توجد {nouns} مطابقة في هذه الفترة. وسّع الفترة أو أزل أحد عوامل التصفية.";
  /// ReportStatus · text on the page
  /// placeholders: {result.Rows.Count} = result.Rows.Count
  text "Showing the first {result.Rows.Count} groups. Add a filter or a coarser grouping to see them all." => "يعرض أول {result.Rows.Count} مجموعة. أضف تصفية أو تجميعًا أوسع لرؤيتها كلها.";
  /// ReportStatus · text on the page
  /// shown through ReportStatus.nouns
  text "rows" => "صفوف";
  /// ReportStatus · a title
  /// shown through Alert.title
  title "This report could not run" => "تعذّر تشغيل هذا التقرير";

  // ── Osysharp.Reports · ReportTable ──
  /// ReportTable · a label (a field, a list item, a menu entry) · at most ~12 characters
  /// shown through ReportTable.label
  label "Report" => "تقرير";

  // ── Osysharp.Reports · ReportTableRow ──
  /// ReportTableRow · a control's name for screen readers
  /// placeholders: {CellText} = CellText(…)
  accessibleName "Show the rows of {CellText}" => "اعرض صفوف {CellText}";

  // ── Osysharp.Reports · ReportTotals ──
  /// ReportTotals · a label (a field, a list item, a menu entry) · at most ~12 characters
  /// shown through ReportFigures.label
  label "Totals" => "الإجماليات";
  /// ReportTotals · text on the page
  /// placeholders: {answer.PeriodBefore} = answer.PeriodBefore
  text "Change against {answer.PeriodBefore}" => "التغيّر مقارنة بـ {answer.PeriodBefore}";

  // ── Osysharp.Reports · RunReport ──
  /// RunReport · message
  /// shown through ExploreResult.Problem
  message "This app does not report on that. Choose one of its reports." => "لا يقدّم هذا التطبيق تقارير عن ذلك. اختر أحد تقاريره.";

  // ── Osysharp.Reports · RunSourceReport ──
  /// RunSourceReport · message
  /// shown through ExploreResult.Problem
  /// also in RunSourceRows
  /// also in RunSourceNow
  message "This app does not report on that." => "لا يقدّم هذا التطبيق تقارير عن ذلك.";

  // ── Osysharp.Reports · RunSourceRows ──
  /// RunSourceRows · message
  /// shown through ExploreResult.Problem
  message "This report does not list the rows it counts." => "هذا التقرير لا يعرض الصفوف التي يعدّها.";

  // ── Osysharp.Reports · SaveReport ──
  /// SaveReport · an error message
  /// shown through ValidationException
  error "Name the report." => "سمِّ التقرير.";
  /// SaveReport · an error message
  /// shown through ValidationException
  error "Sign in to save a report." => "سجّل الدخول لحفظ التقرير.";
  /// SaveReport · an error message
  /// shown through ValidationException
  error "This app does not report on that." => "لا يقدّم هذا التطبيق تقارير عن ذلك.";

  // ── Osysharp.Reports · SaveReportBar ──
  /// SaveReportBar · a control's name for screen readers
  accessibleName "Save the report" => "حفظ التقرير";
  /// SaveReportBar · a button's label · at most ~17 characters
  /// shown through Button.label
  /// beside: "240px", "Cancel"
  button "Save report" => "حفظ التقرير";
  /// SaveReportBar · text on the page
  /// beside: "240px"
  text "A saved report keeps the question, not the numbers: whoever opens it sees the rows they may read, as they are then." => "يحتفظ التقرير المحفوظ بالسؤال لا بالأرقام: من يفتحه يرى الصفوف التي يُسمح له بقراءتها، كما هي حينها.";

  // ── Osysharp.Reports · SearchHint ──
  /// SearchHint · placeholder text inside an empty field · at most ~26 characters
  /// shown through SearchHint()
  placeholder "Search the fields…" => "ابحث في الحقول…";

  // ── Osysharp.Reports · TrendWords ──
  /// TrendWords · text on the page
  /// placeholders: {what} = what (string)
  text "{what} per day" key "report-trend-day" => "{what} لكل يوم";
  /// TrendWords · text on the page
  /// placeholders: {what} = what (string)
  text "{what} per hour" key "report-trend-hour" => "{what} لكل ساعة";
  /// TrendWords · text on the page
  /// placeholders: {what} = what (string)
  text "{what} per month" key "report-trend-month" => "{what} لكل شهر";
  /// TrendWords · text on the page
  /// placeholders: {what} = what (string)
  text "{what} per quarter" key "report-trend-quarter" => "{what} لكل ربع سنة";
  /// TrendWords · text on the page
  /// placeholders: {what} = what (string)
  text "{what} per week" key "report-trend-week" => "{what} لكل أسبوع";
  /// TrendWords · text on the page
  /// placeholders: {what} = what (string)
  text "{what} per year" key "report-trend-year" => "{what} لكل سنة";
}
