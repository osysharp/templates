// ar (العربية): the words of Helpdesk · Osysharp.People, translated.
// Written and kept in step with the source by `osy translate`: a new text arrives as `=> null`, a text
// whose source changed keeps its old translation in a `was` clause. The words are yours to edit.
// Source language: en.

translations ar {
  // ── Osysharp.People · AccessTrail ──
  /// AccessTrail · text on the page
  /// placeholders: {value} = … (string), {whom} = whom (string)
  /// shown through AccessEvent.What
  text "Gave the integration “{value}” to {whom}" => "نقل التكامل «{value}» إلى {whom}";
  /// AccessTrail · text on the page
  /// placeholders: {Describe} = Describe(…) (string), {whom} = whom (string)
  /// shown through AccessEvent.What
  text "{Describe}, owned by {whom}" => "{Describe}، ويملكه {whom}";

  // ── Osysharp.People · AccessTrailList ──
  /// AccessTrailList · a control's name for screen readers
  accessibleName "Access changes" => "تغييرات الصلاحيات";
  /// AccessTrailList · text on the page
  /// shown through EmptyState.body
  text "Every change to somebody's access is listed here, with who made it and why." => "يُدرج هنا كل تغيير في صلاحيات أي شخص، مع من أجراه ولماذا.";

  // ── Osysharp.People · AddIntegration ──
  /// AddIntegration · an error message
  /// shown through ValidationException
  error "Keep the name under 100 characters — it is what every record it makes is filed under." => "اجعل الاسم أقل من 100 حرف — فهو الاسم الذي يُسجَّل تحته كل ما يفعله.";
  /// AddIntegration · an error message
  /// shown through ValidationException
  error "Name the integration — what it is, as you will recognise it in the list: “Zapier”." => "سمِّ التكامل — ما هو، كما ستتعرّف عليه في القائمة: «Zapier».";

  // ── Osysharp.People · Ago ──
  /// Ago · text on the page
  /// placeholders: {d} = d (int) — {d} is a count: give one text per plural form
  /// shown through Ago()
  text "{d} days ago" => { zero: "قبل {d} يوم", one: "قبل يوم", two: "قبل يومين", few: "قبل {d} أيام", many: "قبل {d} يومًا", other: "قبل {d} يوم" };
  /// Ago · text on the page
  /// placeholders: {value} = … (int) — {value} is a count: give one text per plural form
  /// shown through Ago()
  text "{value} h ago" => { zero: "قبل {value} ساعة", one: "قبل ساعة", two: "قبل ساعتين", few: "قبل {value} ساعات", many: "قبل {value} ساعة", other: "قبل {value} ساعة" };
  /// Ago · text on the page
  /// placeholders: {value} = … (int) — {value} is a count: give one text per plural form
  /// shown through Ago()
  text "{value} min ago" => { zero: "قبل {value} دقيقة", one: "قبل دقيقة", two: "قبل دقيقتين", few: "قبل {value} دقائق", many: "قبل {value} دقيقة", other: "قبل {value} دقيقة" };

  // ── Osysharp.People · ApiKeyLines ──
  /// ApiKeyLines · text on the page
  /// placeholders: {NameOf} = NameOf(…) (string)
  /// shown through ApiKeyLine.RevokedWords
  text " by {NameOf}" => " بواسطة {NameOf}";
  /// ApiKeyLines · text on the page
  /// placeholders: {NameOf} = NameOf(…) (string), {k.IssuedAt} = k.IssuedAt (DateTime)
  /// shown through ApiKeyLine.Issued
  text "Issued by {NameOf} · {k.IssuedAt}" => "أصدره {NameOf} · {k.IssuedAt}";
  /// ApiKeyLines · text on the page
  /// placeholders: {Ago} = Ago(…) (string)
  /// shown through ApiKeyLine.LastUsed
  text "Last used {Ago}" => "آخر استخدام {Ago}";
  /// ApiKeyLines · text on the page
  /// shown through ApiKeyLine.LastUsed
  text "Never used" => "لم يُستخدم قط";
  /// ApiKeyLines · text on the page
  /// placeholders: {k.RevokedAt} = k.RevokedAt (DateTime), {value} = … (string)
  /// shown through ApiKeyLine.RevokedWords
  text "Revoked {k.RevokedAt}{value}" => "أُلغي {k.RevokedAt}{value}";

  // ── Osysharp.People · ApiKeyManager ──
  /// ApiKeyManager · a control's name for screen readers
  accessibleName "API key" => "مفتاح API";
  /// ApiKeyManager · a control's name for screen readers
  /// beside: "Add an integration"
  accessibleName "Integrations" => "التكاملات";
  /// ApiKeyManager · a control's name for screen readers
  /// beside: "Issue a key"
  accessibleName "Keys in use" => "مفاتيح قيد الاستخدام";
  /// ApiKeyManager · a control's name for screen readers
  accessibleName "Revoked keys" => "المفاتيح الملغاة";
  /// ApiKeyManager · a control's name for screen readers
  /// beside: "Name", "Cancel"
  accessibleName "What it may do" => "ما يُسمح له به";
  /// ApiKeyManager · a button's label · at most ~26 characters
  /// shown through Button.label
  button "Add an integration" => "إضافة تكامل";
  /// ApiKeyManager · a button's label · at most ~31 characters
  /// shown through Button.label
  /// beside: "Cancel"
  button "Add it and issue a key" => "أضفه وأصدر مفتاحًا";
  /// ApiKeyManager · a button's label · at most ~12 characters
  /// shown through Button.label
  button "Copied" => "نُسخ";
  /// ApiKeyManager · a button's label · at most ~10 characters
  /// shown through Button.label
  button "Copy" => "نسخ";
  /// ApiKeyManager · a button's label · at most ~18 characters
  /// shown through Button.announceAs
  button "Copy the key" => "انسخ المفتاح";
  /// ApiKeyManager · a button's label · at most ~24 characters
  /// shown through Button.label
  button "Hide revoked keys" => "إخفاء المفاتيح الملغاة";
  /// ApiKeyManager · a button's label · at most ~23 characters
  /// shown through Button.label
  /// also in WebhookSubscriptions
  button "I have copied it" => "لقد نسخته";
  /// ApiKeyManager · a button's label · at most ~17 characters
  /// shown through Button.label
  button "Issue a key" => "إصدار مفتاح";
  /// ApiKeyManager · a button's label · at most ~14 characters
  /// shown through Button.label
  /// beside: "Cancel"
  button "Issue it" => "إصدار";
  /// ApiKeyManager · a button's label · at most ~17 characters
  /// shown through Button.label
  /// beside: "Cancel"
  button "Reassign it" => "انقل الملكية";
  /// ApiKeyManager · a button's label · at most ~15 characters
  /// shown through Button.label
  /// beside: "Cancel"
  button "Revoke it" => "إلغاء";
  /// ApiKeyManager · a button's label · at most ~49 characters
  /// placeholders: {revoked.Count} = revoked.Count
  /// shown through Button.label
  button "Show revoked keys ({revoked.Count})" => "عرض المفاتيح الملغاة ({revoked.Count})";
  /// ApiKeyManager · a button's label · at most ~19 characters
  /// shown through Button.label
  /// beside: "Cancel"
  button "Switch it off" => "أوقفه";
  /// ApiKeyManager · a description
  /// shown through SettingsPage.description
  description "A key lets a program call this app's API — as an integration of its own, or as the person it was issued to — with exactly what its holder may do. It is shown once, when it is issued." => "يتيح المفتاح لبرنامجٍ استدعاء واجهة API لهذا التطبيق — بوصفه تكاملًا قائمًا بذاته، أو باسم الشخص الذي أُصدر له — بما يُسمح لحامله به تمامًا. يُعرض مرة واحدة، عند إصداره.";
  /// ApiKeyManager · a description
  /// shown through SettingsSection.description
  /// beside: "Keys in use"
  description "A program that works with the app under its own name — what it does is recorded as its own, never as a teammate's. It holds keys and a role, and can never sign in. Switch it off and every key it holds stops working." => "برنامج يعمل مع التطبيق باسمه الخاص — ما يفعله يُسجَّل باسمه، لا باسم أحد أعضاء الفريق. يحمل مفاتيح ودورًا، ولا يمكنه تسجيل الدخول أبدًا. أوقفه فيتوقف كل مفتاح يحمله عن العمل.";
  /// ApiKeyManager · a description
  /// shown through SettingsSection.description
  /// beside: "Integrations"
  description "Each acts as its holder and nobody else. Revoke one and the next request that presents it is refused; deactivating a person revokes theirs." => "كل مفتاح يتصرف باسم صاحبه وحده. ألغِ مفتاحًا فيُرفض أول طلب يقدّمه بعد ذلك، وتعطيل شخص يلغي مفاتيحه.";
  /// ApiKeyManager · a description
  /// shown through SettingsSection.description
  description "Kept so you can see what a key was for and who took it away." => "تُحفظ لترى الغرض من كل مفتاح ومن ألغاه.";
  /// ApiKeyManager · a hint under a field
  /// shown through Field.hint
  /// beside: "Cancel"
  hint "How you will recognise it in the list." => "به ستعرفه في القائمة.";
  /// ApiKeyManager · a hint under a field
  /// shown through Field.hint
  /// beside: "New owner", "Cancel"
  hint "Kept with the change in the access trail." => "يُحفظ مع التغيير في سجل الوصول.";
  /// ApiKeyManager · a hint under a field
  /// shown through Field.hint
  /// beside: "What it may do", "Cancel"
  hint "What it is — everything it does is recorded under this name." => "ما هو — كل ما يفعله يُسجَّل تحت هذا الاسم.";
  /// ApiKeyManager · a label (a field, a list item, a menu entry) · at most ~9 characters
  /// shown through Dropdown.label
  label "For" => "لـ";
  /// ApiKeyManager · a label (a field, a list item, a menu entry) · at most ~15 characters
  /// shown through Dropdown.label
  /// beside: "Why", "Cancel"
  label "New owner" => "المالك الجديد";
  /// ApiKeyManager · a label (a field, a list item, a menu entry) · at most ~9 characters
  /// shown through Field.label
  /// beside: "New owner", "Cancel"
  /// also in PrivacyRequestPane
  /// also in RetentionEditor
  label "Why" => "السبب";
  /// ApiKeyManager · message
  /// placeholders: {p.DisplayName} = p.DisplayName
  /// shown through HolderName()
  message "{p.DisplayName} (integration)" => "{p.DisplayName} (تكامل)";
  /// ApiKeyManager · placeholder text inside an empty field · at most ~23 characters
  /// shown through Dropdown.placeholder
  placeholder "Choose a person…" => "اختر شخصًا…";
  /// ApiKeyManager · placeholder text inside an empty field · at most ~20 characters
  /// shown through Field.placeholder
  /// beside: "Cancel"
  placeholder "Nightly export" => "تصدير ليلي";
  /// ApiKeyManager · placeholder text inside an empty field · at most ~26 characters
  /// shown through Field.placeholder
  /// beside: "New owner", "Cancel"
  placeholder "They left the team" => "غادر الفريق";
  /// ApiKeyManager · placeholder text inside an empty field · at most ~12 characters
  /// shown through Field.placeholder
  /// beside: "What it may do", "Cancel"
  placeholder "Zapier" => "Zapier";
  /// ApiKeyManager · a subtitle
  /// shown through Dialog.subtitle
  subtitle "Choose who answers for it from now on: who to ask what it does and whether it is still needed. Its keys and its role stay as they are, and the change is recorded." => "اختر من يتولى مسؤوليته من الآن: من يُسأل عمّا يفعله وهل ما زالت الحاجة إليه قائمة. تبقى مفاتيحه ودوره كما هي، ويُسجَّل التغيير.";
  /// ApiKeyManager · a subtitle
  /// shown through Dialog.subtitle
  subtitle "Every key it holds is refused from its next request. What it already did stays recorded under its name." => "يُرفض كل مفتاح يحمله بدءًا من طلبه التالي. ويبقى ما فعله مسجّلًا باسمه.";
  /// ApiKeyManager · a subtitle
  /// shown through Dialog.subtitle
  subtitle "It acts under its own name with the role you choose, and you answer for it. It gets its first key now." => "يعمل باسمه الخاص بالدور الذي تختاره، وأنت مسؤول عنه. يحصل على مفتاحه الأول الآن.";
  /// ApiKeyManager · a subtitle
  /// placeholders: {revokingWhose} = revokingWhose
  /// shown through Dialog.subtitle
  subtitle "The key {revokingWhose}. A program that still uses it is refused from its next request. This cannot be undone — issue a new key instead." => "المفتاح {revokingWhose}. أي برنامج ما زال يستخدمه يُرفض من طلبه التالي. لا يمكن التراجع عن ذلك، فأصدر مفتاحًا جديدًا بدلًا منه.";
  /// ApiKeyManager · a subtitle
  /// shown through Dialog.subtitle
  subtitle "The program that holds it acts as this person — it can do exactly what they can, and nothing more." => "البرنامج الذي يحمله يتصرف باسم هذا الشخص، فيقدر على ما يقدر عليه تمامًا ولا شيء غيره.";
  /// ApiKeyManager · text on the page
  /// shown through EmptyState.body
  text "Add one for each program that calls the app — Zapier, a nightly export, a partner's system." => "أضف واحدًا لكل برنامج يستدعي التطبيق — Zapier، أو تصدير ليلي، أو نظام أحد الشركاء.";
  /// ApiKeyManager · text on the page
  /// shown through addProblem
  text "Choose what it may do — the role it acts with." => "اختر ما يُسمح له به — الدور الذي يعمل به.";
  /// ApiKeyManager · text on the page
  /// shown through reassignProblem
  text "Choose who answers for it from now on." => "اختر من يتولى مسؤوليته من الآن.";
  /// ApiKeyManager · text on the page
  /// shown through problem
  text "Choose who the key is for." => "اختر لمن هذا المفتاح.";
  /// ApiKeyManager · text on the page
  /// beside: "Copy the key", "I have copied it"
  text "Copy it into the program now — it is not shown again. The program sends it in the X-API-Key header." => "انسخه إلى البرنامج الآن، فلن يُعرض مرة أخرى. يرسله البرنامج في الترويسة X-API-Key.";
  /// ApiKeyManager · text on the page
  /// shown through EmptyState.body
  text "Issue one to let a program call this app's API as somebody on the team." => "أصدر مفتاحًا ليتمكن برنامج من استدعاء واجهة API لهذا التطبيق باسم أحد أعضاء الفريق.";
  /// ApiKeyManager · text on the page
  /// placeholders: {reassigningFrom} = reassigningFrom
  /// beside: "New owner", "Why", "Cancel"
  text "Owned by {reassigningFrom}" => "يملكه {reassigningFrom}";
  /// ApiKeyManager · text on the page
  /// placeholders: {revokingWords} = revokingWords
  /// shown through notice
  text "Revoked {revokingWords} — a request that presents it is refused from now on." => "أُلغي {revokingWords}. أي طلب يقدّمه يُرفض من الآن فصاعدًا.";
  /// ApiKeyManager · text on the page
  /// shown through Hint.text
  text "There is nobody to issue a key to — every account on the people list is deactivated." => "لا أحد يمكن إصدار مفتاح له: كل الحسابات في قائمة الأشخاص معطّلة.";
  /// ApiKeyManager · text on the page
  text "What it may do" => "ما يُسمح له به";
  /// ApiKeyManager · text on the page
  /// placeholders: {line.Ending} = line.Ending, {line.Holder} = line.Holder
  /// shown through revokingWhose
  text "{line.Ending} of {line.Holder}" => "{line.Ending} لـ {line.Holder}";
  /// ApiKeyManager · text on the page
  /// placeholders: {reassigningName} = reassigningName, {HolderName} = HolderName(…)
  /// shown through notice
  text "{reassigningName} is now answered for by {HolderName}. Its keys go on working." => "أصبح {HolderName} مسؤولًا عن {reassigningName}. تستمر مفاتيحه في العمل.";
  /// ApiKeyManager · text on the page
  /// placeholders: {switchingOffName} = switchingOffName
  /// shown through notice
  text "{switchingOffName} is switched off — every key it held is refused from now on." => "أُوقف {switchingOffName} — يُرفض كل مفتاح كان يحمله من الآن فصاعدًا.";
  /// ApiKeyManager · text on the page
  /// placeholders: {line.Name} = line.Name, {line.Ending} = line.Ending, {line.Holder} = line.Holder
  /// shown through revokingWords
  text "“{line.Name}” {line.Ending} of {line.Holder}" => "«{line.Name}» {line.Ending} لـ {line.Holder}";
