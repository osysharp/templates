  // ── Osysharp.People · IssueApiKey ──
  /// IssueApiKey · an error message
  /// shown through ValidationException
  error "Say what the key is for — it is how you will recognise it in the list." => "اكتب الغرض من المفتاح، فبه ستعرفه في القائمة.";
  /// IssueApiKey · an error message
  /// shown through ValidationException
  error "This account already holds two keys — revoke one before issuing another." => "لهذا الحساب مفتاحان بالفعل. ألغِ أحدهما قبل إصدار مفتاح آخر.";
  /// IssueApiKey · an error message
  /// shown through ValidationException
  error "This account is deactivated — reactivate it before issuing it a key." => "هذا الحساب معطّل. أعد تفعيله قبل أن تصدر له مفتاحًا.";

  // ── Osysharp.People · Osysharp.People.AccessChangeKind ──
