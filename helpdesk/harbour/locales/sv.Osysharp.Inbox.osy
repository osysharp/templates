  /// placeholders: {ToInt} = Convert.ToInt(…) (int) — {ToInt} is a count: give one text per plural form
  /// shown through Ago()
  text "{ToInt}m" => { one: "{ToInt} min", other: "{ToInt} min" };

  // ── Osysharp.WorkQueues · ArrivedWords ──
