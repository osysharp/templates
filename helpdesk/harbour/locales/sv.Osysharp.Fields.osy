// sv (Svenska): the words of Helpdesk · Osysharp.Fields, translated.
// Written and kept in step with the source by `osy translate`: a new text arrives as `=> null`, a text
// whose source changed keeps its old translation in a `was` clause. The words are yours to edit.
// Source language: en.

translations sv {
  // ── Osysharp.Fields · AnswerProblem ──
  /// AnswerProblem · an error message
  /// placeholders: {f.Name} = f.Name (string), {Join} = string.Join(…) (string)
  /// shown through AnswerProblem()
  error "{f.Name} is one of: {Join}." => "{f.Name} är något av: {Join}.";
  /// AnswerProblem · an error message
  /// placeholders: {f.Name} = f.Name (string)
  /// shown through AnswerProblem()
  error "{f.Name} is too long — keep it under 1,000 characters." => "{f.Name} är för långt. Håll det under 1 000 tecken.";
  /// AnswerProblem · an error message
  /// placeholders: {f.Name} = f.Name (string)
  /// shown through AnswerProblem()
  error "{f.Name} is yes or no." => "{f.Name} är ja eller nej.";
  /// AnswerProblem · an error message
  /// placeholders: {f.Name} = f.Name (string)
  /// shown through AnswerProblem()
  error "{f.Name} takes a date, like 2026-10-02." => "{f.Name} tar ett datum, till exempel 2026-10-02.";
  /// AnswerProblem · an error message
  /// placeholders: {f.Name} = f.Name (string)
  /// shown through AnswerProblem()
  error "{f.Name} takes a number, like 42 or 3.5." => "{f.Name} tar ett tal, till exempel 42 eller 3,5.";

  // ── Osysharp.Fields · Checked ──
