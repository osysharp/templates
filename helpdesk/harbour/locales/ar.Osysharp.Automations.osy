  // ── Osysharp.Automations · SaveRule ──
  /// SaveRule · an error message
  /// shown through ValidationException
  error "Name the rule — it is what the record's history says." => "أعطِ القاعدة اسمًا، فهو ما يظهر في سجل التغييرات.";
  /// SaveRule · an error message
  /// shown through ValidationException
