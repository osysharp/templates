  error "That rule is gone — somebody removed it." => "لم تعد تلك القاعدة موجودة، فقد أزالها أحدهم.";
  /// DraftOf · an error message
  /// shown through ValidationException
  error "That rule is no longer one of the app's." => "لم تعد تلك القاعدة من قواعد التطبيق.";

