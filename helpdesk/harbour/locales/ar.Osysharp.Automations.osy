// ar (العربية): the words of Helpdesk · Osysharp.Automations, translated.
// Written and kept in step with the source by `osy translate`: a new text arrives as `=> null`, a text
// whose source changed keeps its old translation in a `was` clause. The words are yours to edit.
// Source language: en.

translations ar {
  // ── Osysharp.Automations · AutomationRules ──
  /// AutomationRules · a control's name for screen readers
  /// beside: "Name", "When", "Then", "Off — keep it, but do not run it"
  accessibleName "Only if" => "فقط إذا";
  /// AutomationRules · a control's name for screen readers
  /// beside: "Add a rule"
  accessibleName "Rules" => "القواعد";
  /// AutomationRules · a control's name for screen readers
  /// beside: "Name", "When", "Only if", "Off — keep it, but do not run it"
  accessibleName "Then" => "ثم";
  /// AutomationRules · a control's name for screen readers
  accessibleName "What ran lately" => "ما نُفّذ مؤخرًا";
  /// AutomationRules · a button's label · at most ~21 characters
  /// shown through Button.label
  button "Add a condition" => "إضافة شرط";
  /// AutomationRules · a button's label · at most ~24 characters
  /// shown through Button.label
  /// beside: "Cancel"
  button "Add the condition" => "إضافة الشرط";
  /// AutomationRules · a button's label · at most ~18 characters
  /// shown through Button.label
  /// beside: "Cancel"
  button "Add the step" => "إضافة الخطوة";
  /// AutomationRules · a button's label · at most ~12 characters
  /// shown through Button.label
  button "Choose" => "اختر";
  /// AutomationRules · a button's label · at most ~21 characters
  /// shown through Button.label
  button "Remove the rule" => "إزالة القاعدة";
  /// AutomationRules · a button's label · at most ~20 characters
  /// placeholders: {value} = …
  /// shown through IconButton.label
  button "Remove {value}" => "إزالة {value}";
  /// AutomationRules · a button's label · at most ~31 characters
  /// shown through Button.label
  button "Restore the app's rule" => "استعادة قاعدة التطبيق";
  /// AutomationRules · a description
  /// placeholders: {noun} = noun
  /// shown through SettingsSection.description
  /// beside: "Rules, in the order they run"
  description "Every run is also on its {noun}'s own history." => "يظهر كل تنفيذ أيضًا في سجل {noun} الخاص به.";
  /// AutomationRules · a description
  /// placeholders: {noun} = noun, {noun2} = noun
  /// shown through SettingsPage.description
  description "Rules that do the routine work on each {noun} when something happens — run in order, each run written on the {noun2}. The app's own rules keep its updates; copy one to change it for the team, or for yours." => "قواعد تنجز العمل الروتيني على كل {noun} عند حدوث أمر ما، وتُنفَّذ بالترتيب، ويُسجَّل كل تنفيذ على {noun2}. تحتفظ قواعد التطبيق نفسه بتحديثاته؛ انسخ إحداها لتعديلها للفريق، أو لنفسك.";
  /// AutomationRules · a label (a field, a list item, a menu entry) · at most ~10 characters
  /// shown through Dropdown.label
  /// beside: "Add the condition"
  label "Asks" => "يسأل عن";
  /// AutomationRules · a label (a field, a list item, a menu entry) · at most ~14 characters
  /// shown through Dropdown.label
  label "Compared" => "المقارنة";
  /// AutomationRules · a label (a field, a list item, a menu entry) · at most ~10 characters
  /// shown through Dropdown.label
  /// beside: "Choose", "Add the step"
  label "Does" => "تنفّذ";
  /// AutomationRules · a label (a field, a list item, a menu entry) · at most ~45 characters
  /// shown through Switch.label
  /// beside: "Name", "When", "Only if", "Then"
  label "Off — keep it, but do not run it" => "متوقفة: احتفظ بها، لكن لا تنفّذها";
  /// AutomationRules · a label (a field, a list item, a menu entry) · at most ~59 characters
  /// placeholders: {noun} = noun
  /// shown through Checkbox.label
  label "The whole team's — it runs on every {noun}" => "للفريق كله: تُنفَّذ على كل {noun}";
  /// AutomationRules · placeholder text inside an empty field · at most ~13 characters
  /// shown through Dropdown.placeholder
  /// beside: "Add the condition"
  placeholder "Choose…" => "اختر…";
  /// AutomationRules · placeholder text inside an empty field · at most ~44 characters
  /// shown through Field.placeholder
  /// beside: "When", "Only if", "Then", "Off — keep it, but do not run it"
  placeholder "Urgent words raise the priority" => "الكلمات العاجلة ترفع الأولوية";
  /// AutomationRules · a subtitle
  /// shown through Dialog.subtitle
  subtitle "A copy of one of the app's rules — it replaces the app's while it exists. Remove it to restore the app's." => "نسخة من إحدى قواعد التطبيق، تحل محل قاعدة التطبيق ما دامت موجودة. احذفها لاستعادة قاعدة التطبيق.";
  /// AutomationRules · text on the page
  /// shown through EmptyState.body
  text "Add one for the work that always follows the same event — tag it, set it, tell somebody." => "أضف قاعدة للعمل الذي يتبع الحدث نفسه دائمًا: وسم، أو تعيين قيمة، أو إبلاغ شخص ما.";
  /// AutomationRules · text on the page
  /// placeholders: {noun} = noun
  text "Always — on every {noun} it happens to." => "دائمًا: على كل {noun} يحدث له ذلك.";
  /// AutomationRules · text on the page
  /// shown through problem
  text "Choose what it asks." => "اختر ما يسأل عنه.";
  /// AutomationRules · text on the page
  /// shown through problem
  text "Choose what it does." => "اختر ما تفعله.";
  /// AutomationRules · text on the page
  /// shown through notice
  text "Copied for the team — change it here; the app's rule waits until you restore it." => "نُسخت للفريق: عدّلها هنا، وستنتظر قاعدة التطبيق حتى تستعيدها.";
  /// AutomationRules · text on the page
  /// shown through notice
  text "Copied for you — it replaces the app's rule on yours." => "نُسخت لك: تحل محل قاعدة التطبيق فيما يخصك.";
  /// AutomationRules · text on the page
  /// shown through TriggerLabel()
  text "Every hour, while it holds" => "كل ساعة، ما دام الشرط قائمًا";
  /// AutomationRules · text on the page
  /// shown through notice
  text "Locked — nobody's copy replaces it." => "مقفلة: لا تحل محلها نسخة أحد.";
  /// AutomationRules · text on the page
  text "Nothing yet — add what it does." => "لا شيء بعد، أضف ما تفعله.";
  /// AutomationRules · text on the page
  /// shown through FieldLabel.text
  text "Only if — all of these hold" => "فقط إذا: تحققت كل هذه الشروط";
  /// AutomationRules · text on the page
  text "Open" => "فتح";
  /// AutomationRules · text on the page
  /// shown through notice
  text "Restored the app's rule." => "استُعيدت قاعدة التطبيق.";
  /// AutomationRules · text on the page
  /// shown through FieldLabel.text
  text "Then — in order" => "ثم، بالترتيب";
  /// AutomationRules · text on the page
  /// shown through notice
  text "Unlocked." => "أُلغي القفل.";
  /// AutomationRules · text on the page
  /// placeholders: {noun} = noun
  /// shown through EmptyState.body
  text "When a rule runs on a {noun}, it is listed here — what it did, or why it stopped." => "عندما تُنفَّذ قاعدة على {noun}، تظهر هنا: ما الذي فعلته، أو لماذا توقفت.";
  /// AutomationRules · text on the page
  /// shown through noun
  text "record" => "سجل";
  /// AutomationRules · a title
  /// shown through Dialog.title
  title "New rule" => "قاعدة جديدة";
  /// AutomationRules · a title
  /// shown through EmptyState.title
  title "No rules yet" => "لا توجد قواعد بعد";
  /// AutomationRules · a title
  /// shown through EmptyState.title
  title "Nothing has run yet" => "لم يُنفَّذ شيء بعد";
  /// AutomationRules · a title
  /// shown through SettingsSection.title
  /// beside: "What ran lately"
  title "Rules, in the order they run" => "القواعد بترتيب تنفيذها";
  /// AutomationRules · a title
  /// shown through SettingsSection.title
  /// beside: "Rules, in the order they run"
  title "What ran lately" => "ما نُفّذ مؤخرًا";

  // ── Osysharp.Automations · AutomationsSettings (/settings/automations) ──
  /// AutomationsSettings · /settings/automations · a title
  /// shown through [Title]
