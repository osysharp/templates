  /// shown through FireSentence()
  text "{name} was stopped: {fire.Problem}" => "أُوقفت {name}: {fire.Problem}";
  /// FireSentence · text on the page
  /// placeholders: {name} = name (string), {who} = who (string), {fire.Problem} = fire.Problem (string)
  /// shown through FireSentence()
  text "{name}{who} did nothing: {fire.Problem}" => "{name}{who} لم تفعل شيئًا: {fire.Problem}";
  /// FireSentence · text on the page
  /// placeholders: {name} = name (string), {who} = who (string), {Join} = string.Join(…) (string), {fire.Problem} = fire.Problem (string)
  /// shown through FireSentence()
  text "{name}{who} did {Join} — then {fire.Problem}" => "{name}{who} نفّذت {Join}، ثم {fire.Problem}";

  // ── Osysharp.Automations · LockRule ──
