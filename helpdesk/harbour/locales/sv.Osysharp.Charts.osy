// sv (Svenska): the words of Helpdesk · Osysharp.Charts, translated.
// Written and kept in step with the source by `osy translate`: a new text arrives as `=> null`, a text
// whose source changed keeps its old translation in a `was` clause. The words are yours to edit.
// Source language: en.

translations sv {
  // ── Osysharp.Charts · AnnotationLabel ──
  /// AnnotationLabel · a control's name for screen readers
  /// placeholders: {named} = named (string)
  /// shown through AnnotationLabel()
  accessibleName "{named} (above the top of this chart)" => "{named} (ovanför diagrammets topp)";
  /// AnnotationLabel · a control's name for screen readers
  /// placeholders: {named} = named (string)
  /// shown through AnnotationLabel()
  accessibleName "{named} (below the bottom of this chart)" => "{named} (under diagrammets botten)";

  // ── Osysharp.Charts · AnnotationMarks ──
  /// AnnotationMarks · a control's name for screen readers
  accessibleName "Annotations" => "Anteckningar";
  /// AnnotationMarks · text on the page
  /// placeholders: {a.Label} = a.Label, {a.Category} = a.Category
  text "⚠ note \"{a.Label}\" names a category this chart does not have: \"{a.Category}\"" => "⚠ anteckningen \"{a.Label}\" nämner en kategori som diagrammet inte har: \"{a.Category}\"";

  // ── Osysharp.Charts · BandLabel ──
  /// BandLabel · a control's name for screen readers
  /// placeholders: {Formatted} = Formatted(…) (string), {Formatted2} = Formatted(…) (string)
  /// shown through BandLabel()
  accessibleName "{Formatted} to {Formatted2}" => "{Formatted} till {Formatted2}";
  /// BandLabel · a control's name for screen readers
  /// placeholders: {named} = named (string)
  /// shown through BandLabel()
  accessibleName "{named} (clipped to the range of this chart)" => "{named} (avklippt till diagrammets intervall)";

  // ── Osysharp.Charts · CandleLabel ──
  /// CandleLabel · a control's name for screen readers
  /// shown through CandleLabel()
  accessibleName "down" => "ned";
  /// CandleLabel · a control's name for screen readers
  /// shown through CandleLabel()
  accessibleName "up" => "upp";
  /// CandleLabel · a control's name for screen readers
  /// placeholders: {m.Label} = m.Label (string), {value} = … (string), {Formatted} = Formatted(…) (string), {Formatted2} = Formatted(…) (string), {Formatted3} = Formatted(…) (string), {Formatted4} = Formatted(…) (string)
  /// shown through CandleLabel()
  accessibleName "{m.Label} {value}: open {Formatted}, high {Formatted2}, low {Formatted3}, close {Formatted4}" => "{m.Label} {value}: öppning {Formatted}, högsta {Formatted2}, lägsta {Formatted3}, stängning {Formatted4}";

  // ── Osysharp.Charts · Chart ──
  /// Chart · a control's name for screen readers
  accessibleName "Chart" => "Diagram";
  /// Chart · caption
  /// shown through ChartTable.caption
  caption "Chart data" => "Diagramdata";
  /// Chart · text on the page
  /// also in Pie
  text "No data to plot" => "Inga data att visa";

  // ── Osysharp.Charts · ColumnTitle ──
  /// ColumnTitle · text on the page
  /// placeholders: {m.Label} = m.Label (string)
  /// shown through ColumnTitle()
  text "{m.Label} (close)" => "{m.Label} (stängning)";

  // ── Osysharp.Charts · Pie ──
  /// Pie · a control's name for screen readers
  accessibleName "Pie chart" => "Cirkeldiagram";
  /// Pie · a control's name for screen readers
  /// also in SliceLegend
  accessibleName "Slices" => "Sektorer";

  // ── Osysharp.Charts · SeriesLegend ──
  /// SeriesLegend · a control's name for screen readers
  accessibleName "Series" => "Serie";

  // ── Osysharp.Charts · StackedColumns ──
  /// StackedColumns · a control's name for screen readers
  /// also in StackedBars
  accessibleName "Stacked series" => "Staplade serier";

  // ── Osysharp.Charts · TickLabel ──
  /// TickLabel · a control's name for screen readers
  /// placeholders: {ToString} = Convert.ToString(…) (double)
  /// shown through TickLabel()
  accessibleName "{ToString}K" => "{ToString} tn";
  /// TickLabel · a control's name for screen readers
  /// placeholders: {ToString} = Convert.ToString(…) (double)
  /// shown through TickLabel()
  accessibleName "{ToString}M" => "{ToString} mn";
}
