  // ── Osysharp.Inbox · Link ──
  /// Link · an error message
  /// shown through ValidationException
  error "An item cannot be linked to itself." => "لا يمكن ربط عنصر بنفسه.";
  /// Link · an error message
  /// placeholders: {words} = words (string), {NameOfItem} = NameOfItem(…) (string), {words2} = words (string)
  /// shown through ValidationException
  error "Other items are “{words}” {NameOfItem}, so it cannot be “{words2}” another — that would make a chain." => "عناصر أخرى «{words}» {NameOfItem}، فلا يمكن أن يكون «{words2}» عنصرًا آخر، لأن ذلك سيصنع سلسلة.";
  /// Link · an error message
  /// placeholders: {key} = key (string)
  /// shown through ValidationException
  error "There is no kind of link called “{key}” here." => "لا يوجد هنا نوع ربط باسم «{key}».";
  /// Link · an error message
  /// placeholders: {NameOfItem} = NameOfItem(…) (string), {NameOfItem2} = NameOfItem(…) (string)
  /// shown through ValidationException
  error "{NameOfItem} is already linked to {NameOfItem2} that way." => "{NameOfItem} مرتبط بالفعل بـ {NameOfItem2} بهذه الطريقة.";
  /// Link · an error message
  /// placeholders: {NameOfItem} = NameOfItem(…) (string), {words} = words (string), {NameOfItem2} = NameOfItem(…) (string)
  /// shown through ValidationException
  error "{NameOfItem} is already “{words}” {NameOfItem2} — remove that link first." => "{NameOfItem} بالفعل «{words}» {NameOfItem2}. أزل ذلك الربط أولًا.";
  /// Link · an error message
  /// placeholders: {NameOfItem} = NameOfItem(…) (string), {words} = words (string), {NameOfItem2} = NameOfItem(…) (string)
  /// shown through ValidationException
  error "{NameOfItem} is already “{words}” {NameOfItem2} — the link cannot run both ways." => "{NameOfItem} بالفعل «{words}» {NameOfItem2}، ولا يمكن أن يكون الربط في الاتجاهين.";
  /// Link · an error message
  /// placeholders: {NameOfItem} = NameOfItem(…) (string), {words} = words (string), {NameOfItem2} = NameOfItem(…) (string), {NameOfItem3} = NameOfItem(…) (string)
  /// shown through ValidationException
  error "{NameOfItem} is itself “{words}” {NameOfItem2} — link to {NameOfItem3} instead." => "{NameOfItem} نفسه «{words}» {NameOfItem2}. اربطه بـ {NameOfItem3} بدلًا من ذلك.";

