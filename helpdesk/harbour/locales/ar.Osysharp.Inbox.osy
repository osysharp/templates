  /// placeholders: {value} = … (int), {value2} = … (int) — {value} is a count: give one text per plural form
  /// shown through BudgetWords()
  text "{value}d {value2}h" => { zero: "{value} ي {value2} س", one: "{value} ي {value2} س", two: "{value} ي {value2} س", few: "{value} ي {value2} س", many: "{value} ي {value2} س", other: "{value} ي {value2} س" };
  /// BudgetWords · text on the page
