// ar (العربية): the words of Helpdesk · Osysharp.Inbox, translated.
// Written and kept in step with the source by `osy translate`: a new text arrives as `=> null`, a text
// whose source changed keeps its old translation in a `was` clause. The words are yours to edit.
// Source language: en.

translations ar {
  // ── Osysharp.Inbox · Ago ──
  /// Ago · text on the page
  /// shown through Ago()
  /// also in FeedbackWeeks
  text "now" => "الآن";
  /// Ago · text on the page
  /// placeholders: {ToInt} = Convert.ToInt(…) (int) — {ToInt} is a count: give one text per plural form
  /// shown through Ago()
  text "{ToInt}d" => { zero: "{ToInt} ي", one: "{ToInt} ي", two: "{ToInt} ي", few: "{ToInt} ي", many: "{ToInt} ي", other: "{ToInt} ي" };
  /// Ago · text on the page
  /// placeholders: {ToInt} = Convert.ToInt(…) (int) — {ToInt} is a count: give one text per plural form
  /// shown through Ago()
  text "{ToInt}h" => { zero: "{ToInt} س", one: "{ToInt} س", two: "{ToInt} س", few: "{ToInt} س", many: "{ToInt} س", other: "{ToInt} س" };
  /// Ago · text on the page
  /// placeholders: {ToInt} = Convert.ToInt(…) (int) — {ToInt} is a count: give one text per plural form
  /// shown through Ago()
  text "{ToInt}m" => { zero: "{ToInt} د", one: "{ToInt} د", two: "{ToInt} د", few: "{ToInt} د", many: "{ToInt} د", other: "{ToInt} د" };

  // ── Osysharp.Inbox · ArrivedWords ──
  /// ArrivedWords · text on the page
  /// placeholders: {happened.Due.Value} = happened.Due.Value (DateTime)
  /// shown through ArrivedWords()
  text "Arrived — due by {happened.Due.Value} UTC." => "وصلت، وموعد استحقاقها {happened.Due.Value} UTC.";
  /// ArrivedWords · text on the page
  /// shown through ArrivedWords()
  text "Arrived — no promise applies." => "وصلت، ولا ينطبق عليها أي وعد.";
  /// ArrivedWords · text on the page
  /// placeholders: {happened.Policy} = happened.Policy (string)
  /// shown through ArrivedWords()
  text "Arrived — promised by {happened.Policy}." => "وصلت، والوعد وفق {happened.Policy}.";

  // ── Osysharp.Inbox · AssignControl ──
