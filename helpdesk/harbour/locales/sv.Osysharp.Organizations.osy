  // ── Osysharp.Organizations · AddDomain ──
  /// AddDomain · an error message
  /// placeholders: {d} = d (string)
  /// shown through ValidationException
  error "Another organisation already has {d}." => "En annan organisation har redan {d}.";
  /// AddDomain · an error message
  /// shown through ValidationException
  error "That does not look like a mail domain — write it like acme.com." => "Det ser inte ut som en e-postdomän. Skriv den som acme.com.";
  /// AddDomain · an error message
  /// placeholders: {d} = d (string), {org.Name} = org.Name (string)
  /// shown through ValidationException
  error "{d} is a public mail service — anybody can have an address on it, so it cannot say who works for {org.Name}." => "{d} är en offentlig e-posttjänst. Vem som helst kan ha en adress där, så den kan inte visa vem som arbetar för {org.Name}.";

