  title "No legal holds in force" => "لا يوجد تجميد قانوني سارٍ";
  /// LegalHoldsEditor · a title
  /// shown through Dialog.title
  title "Place a legal hold" => "فرض تجميد قانوني";
  /// LegalHoldsEditor · a title
  /// shown through Dialog.title
  title "Review the hold" => "مراجعة التجميد";

  // ── Osysharp.Privacy · MyPrivacy ──
  /// MyPrivacy · a control's name for screen readers
