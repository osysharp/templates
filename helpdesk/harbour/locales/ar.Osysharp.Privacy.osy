  // ── Osysharp.Privacy · Release ──
  /// Release · an error message
  /// placeholders: {Key} = h.Key(…) (string), {c.Key} = c.Key (string)
  /// shown through ValidationException
  error "{Key} cannot give '{c.Key}' its period back, so the hold is not lifted — its rows would otherwise be kept for ever." => "لا يستطيع {Key} إعادة مدة الاحتفاظ إلى '{c.Key}'، لذا لم يُرفع التجميد، وإلا لاحتُفظ بصفوفها إلى الأبد.";

  // ── Osysharp.Privacy · RetentionEditor ──
  /// RetentionEditor · a button's label · at most ~31 characters
  /// placeholders: {p.Jurisdiction} = p.Jurisdiction
  /// shown through Button.label
  button "Apply {p.Jurisdiction}" => "تطبيق {p.Jurisdiction}";
  /// RetentionEditor · a button's label · at most ~24 characters
  /// placeholders: {r.Label} = r.Label
  /// shown through Button.announceAs
  /// beside: "Needs your decision"
  button "Confirm {r.Label}" => "تأكيد {r.Label}";
  /// RetentionEditor · a description
  /// shown through SettingsSection.description
  /// beside: "Bookkeeping preset", "Retention saved."
  description " Set in the app's own code." => " يُضبط في كود التطبيق نفسه.";
  /// RetentionEditor · a description
  /// shown through SettingsPage.description
  description "How long each kind of personal data is kept after its purpose ends, and on what basis. A request to erase keeps what the law still needs, restricted, until its period ends — then the daily purge removes it." => "مدة الاحتفاظ بكل نوع من البيانات الشخصية بعد انتهاء الغرض منه، وعلى أي أساس. طلب المحو يُبقي ما لا يزال القانون يحتاجه، مع تقييد معالجته، حتى تنتهي مدته، ثم يزيله الحذف اليومي.";
  /// RetentionEditor · a description
  /// shown through SettingsSection.description
  /// beside: "Plan review", "Retention saved."
  description "Set every bookkeeping category to a country's statutory period at once — recorded, and yours to verify with your adviser." => "اضبط كل فئات المحاسبة على المدة القانونية لبلد ما دفعة واحدة. يُسجَّل ذلك، وعليك التحقق منه مع مستشارك.";
  /// RetentionEditor · a description
  /// placeholders: {value} = …
  /// shown through SettingsSection.description
  /// beside: "Bookkeeping preset", "Retention saved."
  description "Which privacy-request plans wait for approval before they run.{value}" => "أي خطط طلبات الخصوصية تنتظر الموافقة قبل تنفيذها.{value}";
  /// RetentionEditor · a label (a field, a list item, a menu entry) · at most ~18 characters
  /// shown through Field.label
  label "Jurisdiction" => "الولاية القضائية";
  /// RetentionEditor · a label (a field, a list item, a menu entry) · at most ~17 characters
  /// shown through NumberField.label
  label "Months kept" => "أشهر الاحتفاظ";
  /// RetentionEditor · a label (a field, a list item, a menu entry) · at most ~27 characters
  /// shown through Badge.label
  /// beside: "Confirm"
  label "Needs your decision" => "يحتاج إلى قرارك";
  /// RetentionEditor · placeholder text inside an empty field · at most ~8 characters
  /// shown through Field.placeholder
  placeholder "SE" => "SE";
  /// RetentionEditor · placeholder text inside an empty field · at most ~54 characters
  /// shown through Field.placeholder
  placeholder "The statute or decision that allows it" => "القانون أو القرار الذي يسمح بذلك";
  /// RetentionEditor · text on the page
  /// shown through done
  text " categories" => " فئات";
  /// RetentionEditor · text on the page
  /// shown through done
  text " category" => " فئة";
  /// RetentionEditor · text on the page
  /// placeholders: {r.MinMonths} = r.MinMonths
  /// shown through Limits()
  text "At least {r.MinMonths} months without a stated reason" => "{r.MinMonths} شهرًا على الأقل دون ذكر سبب";
  /// RetentionEditor · text on the page
  /// placeholders: {s.Jurisdiction} = s.Jurisdiction, {s.Reason} = s.Reason
  text "Outside the kit's limits for {s.Jurisdiction}: {s.Reason}" => "خارج حدود الحزمة في {s.Jurisdiction}: {s.Reason}";
  /// RetentionEditor · text on the page
  /// beside: "160px"
  text "Outside the kit's limits only for a jurisdiction that allows it — say which, and why. Both are recorded." => "خارج حدود الحزمة فقط لولاية قضائية تسمح بذلك: اذكر أيّها ولماذا. يُسجَّل الأمران كلاهما.";
  /// RetentionEditor · text on the page
  /// shown through Refusal()
  text "Outside the kit's limits, a period is saved only with the jurisdiction that allows it and the reason." => "خارج حدود الحزمة، لا تُحفظ المدة إلا مع الولاية القضائية التي تسمح بها والسبب.";
  /// RetentionEditor · text on the page
  /// shown through SaveBar.saved
  /// beside: "Bookkeeping preset", "Plan review"
  text "Retention saved." => "تم حفظ مدة الاحتفاظ.";
  /// RetentionEditor · text on the page
  /// shown through EmptyState.body
  text "The app and its kits declare what personal data they hold; each kind appears here with its period." => "يعلن التطبيق وأدواته عن البيانات الشخصية التي يحتفظون بها؛ ويظهر كل نوع هنا مع مدته.";
  /// RetentionEditor · text on the page
  /// placeholders: {p.Jurisdiction} = p.Jurisdiction, {changes.Count} = changes.Count, {value} = …
  /// shown through done
  text "{p.Jurisdiction} preset set on {changes.Count}{value} — Save keeps it." => "طُبّق إعداد {p.Jurisdiction} المسبق على {changes.Count}{value}. يحفظه زر الحفظ.";
  /// RetentionEditor · text on the page
  /// placeholders: {r.MinMonths} = r.MinMonths, {r.MaxMonths} = r.MaxMonths
  /// shown through Limits()
  text "{r.MinMonths}–{r.MaxMonths} months without a stated reason" => "{r.MinMonths}–{r.MaxMonths} شهرًا دون ذكر سبب";
  /// RetentionEditor · a title
  /// shown through SettingsSection.title
  /// beside: "Plan review", "Retention saved."
  title "Bookkeeping preset" => "الإعداد المسبق للمحاسبة";
  /// RetentionEditor · a title
  /// shown through SettingsPage.title
  /// also in PrivacySettings /settings/privacy
  title "Data retention" => "الاحتفاظ بالبيانات";
  /// RetentionEditor · a title
  /// shown through EmptyState.title
  title "Nothing declared yet" => "لم يُعلَن عن شيء بعد";
  /// RetentionEditor · a title
  /// shown through SettingsSection.title
  /// beside: "Bookkeeping preset", "Retention saved."
  title "Plan review" => "مراجعة الخطط";

  // ── Osysharp.Privacy · RetentionLimitRefusal ──
  /// RetentionLimitRefusal · text on the page
  /// placeholders: {label} = label (string), {limit} = limit (string), {minMonths} = minMonths (int), {maxMonths} = maxMonths (int) — {minMonths} is a count: give one text per plural form
  /// shown through RetentionLimitRefusal()
  text "'{label}' cannot be kept {limit} without saying why: the kit declares {minMonths}–{maxMonths} months as the range no law it knows of asks you to leave. Set it outside only for a jurisdiction that allows it — state the jurisdiction and the reason, and both are recorded." => { zero: "لا يمكن الاحتفاظ بـ '{label}' {limit} دون ذكر السبب: تحدّد الحزمة {minMonths}–{maxMonths} شهرًا نطاقًا لا يطلب منك أي قانون تعرفه الخروج عنه. اضبطه خارجه فقط لولاية قضائية تسمح بذلك، واذكر الولاية والسبب، فيُسجَّل الأمران كلاهما.", one: "لا يمكن الاحتفاظ بـ '{label}' {limit} دون ذكر السبب: تحدّد الحزمة {minMonths}–{maxMonths} شهرًا نطاقًا لا يطلب منك أي قانون تعرفه الخروج عنه. اضبطه خارجه فقط لولاية قضائية تسمح بذلك، واذكر الولاية والسبب، فيُسجَّل الأمران كلاهما.", two: "لا يمكن الاحتفاظ بـ '{label}' {limit} دون ذكر السبب: تحدّد الحزمة {minMonths}–{maxMonths} شهرًا نطاقًا لا يطلب منك أي قانون تعرفه الخروج عنه. اضبطه خارجه فقط لولاية قضائية تسمح بذلك، واذكر الولاية والسبب، فيُسجَّل الأمران كلاهما.", few: "لا يمكن الاحتفاظ بـ '{label}' {limit} دون ذكر السبب: تحدّد الحزمة {minMonths}–{maxMonths} شهرًا نطاقًا لا يطلب منك أي قانون تعرفه الخروج عنه. اضبطه خارجه فقط لولاية قضائية تسمح بذلك، واذكر الولاية والسبب، فيُسجَّل الأمران كلاهما.", many: "لا يمكن الاحتفاظ بـ '{label}' {limit} دون ذكر السبب: تحدّد الحزمة {minMonths}–{maxMonths} شهرًا نطاقًا لا يطلب منك أي قانون تعرفه الخروج عنه. اضبطه خارجه فقط لولاية قضائية تسمح بذلك، واذكر الولاية والسبب، فيُسجَّل الأمران كلاهما.", other: "لا يمكن الاحتفاظ بـ '{label}' {limit} دون ذكر السبب: تحدّد الحزمة {minMonths}–{maxMonths} شهرًا نطاقًا لا يطلب منك أي قانون تعرفه الخروج عنه. اضبطه خارجه فقط لولاية قضائية تسمح بذلك، واذكر الولاية والسبب، فيُسجَّل الأمران كلاهما." };
  /// RetentionLimitRefusal · text on the page
  /// shown through RetentionLimitRefusal()
  text "A period is a number of months, 0 or more." => "المدة عدد من الأشهر، صفر أو أكثر.";

  // ── Osysharp.Privacy · RetentionSentence ──
  /// RetentionSentence · text on the page
  text "Erased on request" => "تُمحى عند الطلب";

  // ── Osysharp.Privacy · StandsFor ──
