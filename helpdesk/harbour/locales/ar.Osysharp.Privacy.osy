  button "Run it again" => "التشغيل مجددًا";
  /// PrivacyRequestPane · a label (a field, a list item, a menu entry) · at most ~12 characters
  /// shown through NumberField.label
  label "Months" => "الأشهر";
  /// PrivacyRequestPane · placeholder text inside an empty field · at most ~56 characters
  /// shown through Field.placeholder
  /// beside: "160px", "Cancel"
  placeholder "Your request covers ten years of orders." => "يشمل طلبك طلبات عشر سنوات.";
  /// PrivacyRequestPane · a subtitle
  /// shown through Dialog.subtitle
  subtitle "By one or two months, only within the first month, and only with the reason — the person is told it." => "شهرًا أو شهرين، خلال الشهر الأول فقط، ومع ذكر السبب، إذ يُبلَّغ به الشخص.";
  /// PrivacyRequestPane · text on the page
  /// placeholders: {ToString} = f.DueAt.Value.ToString(…)
  text "Answer by {ToString}" => "الرد بحلول {ToString}";
  /// PrivacyRequestPane · text on the page
  /// shown through done
  text "Approved — the plan ran." => "تمت الموافقة، ونُفّذت الخطة.";
  /// PrivacyRequestPane · text on the page
  /// shown through done
  text "Extended — the person is told why." => "تم التمديد، وأُبلغ الشخص بالسبب.";
  /// PrivacyRequestPane · text on the page
  /// placeholders: {f.Extension} = f.Extension
  text "Extended: {f.Extension}" => "تم التمديد: {f.Extension}";
  /// PrivacyRequestPane · text on the page
  /// placeholders: {Join} = string.Join(…)
  text "Not held: {Join}." => "غير محفوظة: {Join}.";
  /// PrivacyRequestPane · text on the page
  /// shown through SectionLabel.text
  text "The plan" => "الخطة";
  /// PrivacyRequestPane · text on the page
  /// shown through SectionLabel.text
  text "What the person is told" => "ما يُبلَّغ به الشخص";
  /// PrivacyRequestPane · text on the page
  /// shown through SectionLabel.text
  text "Who, and how we know" => "من هو، وكيف نعرف ذلك";
  /// PrivacyRequestPane · text on the page
