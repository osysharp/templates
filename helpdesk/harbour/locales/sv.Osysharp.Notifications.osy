// sv (Svenska): the words of Helpdesk · Osysharp.Notifications, translated.
// Written and kept in step with the source by `osy translate`: a new text arrives as `=> null`, a text
// whose source changed keeps its old translation in a `was` clause. The words are yours to edit.
// Source language: en.

translations sv {
  // ── Osysharp.Notifications · KitSentence ──
  /// KitSentence · text on the page
  /// shown through KitSentence()
  text "You were mentioned." => "Du nämndes.";
  /// KitSentence · text on the page
  /// placeholders: {by} = by (string)
  /// shown through KitSentence()
  text "{by} mentioned you." => "{by} nämnde dig.";

  // ── Osysharp.Notifications · NotificationBell ──
  /// NotificationBell · a control's name for screen readers
  accessibleName "Your notifications" => "Dina aviseringar";
  /// NotificationBell · a button's label · at most ~19 characters
  /// shown through ShellCountButton.label
  button "Notifications" => "Aviseringar";

  // ── Osysharp.Notifications · NotificationDigestMail ──
  /// NotificationDigestMail · a button's label · at most ~38 characters
  /// placeholders: {NotificationsAppName} = NotificationsAppName(…) (string)
  /// shown through EmailButton.label
  /// beside: "While you were away", "These are waiting for you. Each one opens where it happened."
  button "Open {NotificationsAppName}" => "Öppna {NotificationsAppName}";
  /// NotificationDigestMail · the preview line an inbox shows beside an email's subject
  /// shown through EmailLayout.preview
  mailPreview "What happened while you were away, newest first." => "Det som hände medan du var borta, det senaste först.";
  /// NotificationDigestMail · an email's subject line
  /// placeholders: {NotificationsAppName} = NotificationsAppName(…) (string)
  mailSubject "1 thing waiting for you in {NotificationsAppName}" => "1 sak väntar på dig i {NotificationsAppName}";
  /// NotificationDigestMail · an email's subject line
  /// placeholders: {items.Count} = items.Count (int), {NotificationsAppName} = NotificationsAppName(…) (string) — {items.Count} is a count: give one text per plural form
  mailSubject "{items.Count} things waiting for you in {NotificationsAppName}" => { one: "1 sak väntar på dig i {NotificationsAppName}", other: "{items.Count} saker väntar på dig i {NotificationsAppName}" };
  /// NotificationDigestMail · text in an email
  /// shown through EmailLayout.footer
  mailText "You get this because you have not read these in the app. Change what is mailed to you under Settings › Notifications." => "Du får det här eftersom du inte har läst dem i appen. Ändra vad som mejlas till dig under Inställningar › Aviseringar.";
  /// NotificationDigestMail · text on the page
  /// shown through EmailText.text
  /// beside: "While you were away"
  text "These are waiting for you. Each one opens where it happened." => "Det här väntar på dig. Var och en öppnas där det hände.";
  /// NotificationDigestMail · text on the page
  /// shown through EmailHeading.text
  /// beside: "These are waiting for you. Each one opens where it happened."
  text "While you were away" => "Medan du var borta";

  // ── Osysharp.Notifications · NotificationList ──
  /// NotificationList · a control's name for screen readers
  /// beside: "Notifications", "All"
  accessibleName "Notification list" => "Aviseringslista";
  /// NotificationList · a button's label · at most ~9 characters
  /// shown through Tab.label
  button "All" => "Alla";
  /// NotificationList · a button's label · at most ~19 characters
  /// shown through Button.label
  button "Mark all read" => "Markera alla som lästa";
  /// NotificationList · a button's label · at most ~30 characters
  /// shown through Button.label
  button "Notification settings" => "Aviseringsinställningar";
  /// NotificationList · a button's label · at most ~12 characters
  /// shown through Tab.label
  /// beside: "All"
  button "Unread" => "Olästa";
  /// NotificationList · a button's label · at most ~24 characters
  /// placeholders: {unread} = unread
  /// shown through Tab.label
  /// beside: "All"
  button "Unread · {unread}" => "Olästa · {unread}";
  /// NotificationList · text on the page
  /// shown through EmptyState.body
  text "Nothing unread. What you have read stays under All for a while." => "Inget oläst. Det du har läst ligger kvar under Alla ett tag.";
  /// NotificationList · text on the page
  text "Notifications" => "Aviseringar";
  /// NotificationList · text on the page
  /// shown through EmptyState.body
  text "When something needs you — a mention, work handed to you, a promise at risk — it appears here." => "När något behöver dig, som en nämning, arbete som lämnats till dig eller ett löfte i fara, visas det här.";
  /// NotificationList · a title
  /// shown through EmptyState.title
  /// also in KnowledgeFront
  /// also in ReportStatus
  title "Nothing here yet" => "Inget här än";
  /// NotificationList · a title
  /// shown through EmptyState.title
  title "You are all caught up" => "Du är ikapp";

  // ── Osysharp.Notifications · NotificationMailItem ──
  /// NotificationMailItem · text in an email
  /// placeholders: {line.At} = line.At (DateTime)
  mailText "{line.At} UTC" => "{line.At} UTC";

  // ── Osysharp.Notifications · NotificationMentionMail ──
  /// NotificationMentionMail · a button's label · at most ~13 characters
  /// shown through EmailButton.label
  button "Open it" => "Öppna";
  /// NotificationMentionMail · the preview line an inbox shows beside an email's subject
  /// shown through EmailLayout.preview
  mailPreview "You were mentioned, and have not read it yet." => "Du nämndes och har inte läst det än.";
  /// NotificationMentionMail · an email's subject line
  /// placeholders: {NotificationsAppName} = NotificationsAppName(…) (string)
  mailSubject "You were mentioned in {NotificationsAppName}" => "Du nämndes i {NotificationsAppName}";
  /// NotificationMentionMail · an email's subject line
  /// placeholders: {NotifierName} = NotifierName(…) (string), {NotificationsAppName} = NotificationsAppName(…) (string)
  mailSubject "{NotifierName} mentioned you in {NotificationsAppName}" => "{NotifierName} nämnde dig i {NotificationsAppName}";
  /// NotificationMentionMail · text in an email
  /// shown through EmailLayout.footer
  mailText "You get this because you asked for mentions at once. Change it under Settings › Notifications." => "Du får det här eftersom du bad om att få nämningar direkt. Ändra det under Inställningar › Aviseringar.";

  // ── Osysharp.Notifications · NotificationPreferencesEditor ──
  /// NotificationPreferencesEditor · a description
  /// shown through SettingsPage.description
  description "The bell shows everything as it happens. These are yours alone: what is mailed to you when you have not read it in the app." => "Klockan visar allt när det händer. De här inställningarna är bara dina: vad som mejlas till dig när du inte har läst det i appen.";
  /// NotificationPreferencesEditor · text on the page
  /// shown through SaveBar.saved
  text "Your notification preferences are saved." => "Dina aviseringsinställningar är sparade.";
  /// NotificationPreferencesEditor · a title
  /// shown through SettingsPage.title
  /// also in NotificationPreferencesPage /settings/notifications
  title "Notifications" => "Aviseringar";

  // ── Osysharp.Notifications · NotificationPreferencesFields ──
  /// NotificationPreferencesFields · a description
  /// shown through SettingsSection.description
  description "Mail is only ever about what you have not read here. Mail goes to the address you sign in with." => "Mejl handlar bara om det du inte har läst här. Mejlen går till adressen du loggar in med.";
  /// NotificationPreferencesFields · a hint under a field
  /// shown through SettingRow.hint
  hint "A mention waits a few minutes first — read it here and no mail is sent." => "En nämning väntar några minuter först. Läser du den här skickas inget mejl.";
  /// NotificationPreferencesFields · a label (a field, a list item, a menu entry) · at most ~13 characters
  /// shown through Dropdown.label
  label "Mail me" => "Mejla mig";

  // ── Osysharp.Notifications · NotificationRow ──
  /// NotificationRow · a control's name for screen readers
  accessibleName "Unread" => "Olästa";
  /// NotificationRow · text on the page
  /// placeholders: {TimeAgo} = TimeAgo(…), {n.Times} = n.Times
  text "{TimeAgo} · {n.Times} times" => { one: "{TimeAgo} · {n.Times} gång", other: "{TimeAgo} · {n.Times} gånger" };

  // ── Osysharp.Notifications · NotificationsAppName ──
  /// NotificationsAppName · an image's description for screen readers
  /// shown through NotificationsAppName()
  alt "your app" => "din app";

  // ── Osysharp.Notifications · Osysharp.Notifications.NotificationMail ──
  /// Osysharp.Notifications.NotificationMail · a label (a field, a list item, a menu entry) · at most ~54 characters
  /// shown through Osysharp.Notifications.NotificationMail.Daily
  /// beside: "Mentions at once, everything else in a daily digest", "Nothing — I read them in the app"
  label "A daily digest of what I have not seen" => "En daglig sammanfattning av det jag inte har sett";
  /// Osysharp.Notifications.NotificationMail · a label (a field, a list item, a menu entry) · at most ~72 characters
  /// shown through Osysharp.Notifications.NotificationMail.MentionsAtOnce
  /// beside: "A daily digest of what I have not seen", "Nothing — I read them in the app"
  label "Mentions at once, everything else in a daily digest" => "Nämningar direkt, allt annat i en daglig sammanfattning";
  /// Osysharp.Notifications.NotificationMail · a label (a field, a list item, a menu entry) · at most ~45 characters
  /// shown through Osysharp.Notifications.NotificationMail.Off
  /// beside: "Mentions at once, everything else in a daily digest", "A daily digest of what I have not seen"
  label "Nothing — I read them in the app" => "Inget, jag läser dem i appen";

  // ── Osysharp.Notifications · Osysharp.Notifications.NotificationState ──
  /// Osysharp.Notifications.NotificationState · a label (a field, a list item, a menu entry) · at most ~28 characters
  /// shown through Osysharp.Notifications.NotificationState.Merged
  /// beside: "Waiting", "Shown", "Shown — mail due", "Not shown"
  label "Joined an unread one" => "Slogs ihop med en oläst";
  /// Osysharp.Notifications.NotificationState · a label (a field, a list item, a menu entry) · at most ~15 characters
  /// shown through Osysharp.Notifications.NotificationState.Withheld
  /// beside: "Waiting", "Shown", "Shown — mail due", "Joined an unread one"
  label "Not shown" => "Visades inte";
  /// Osysharp.Notifications.NotificationState · a label (a field, a list item, a menu entry) · at most ~11 characters
  /// shown through Osysharp.Notifications.NotificationState.Shown
  /// beside: "Waiting", "Shown — mail due", "Not shown", "Joined an unread one"
  label "Shown" => "Visad";
  /// Osysharp.Notifications.NotificationState · a label (a field, a list item, a menu entry) · at most ~23 characters
  /// shown through Osysharp.Notifications.NotificationState.MailDue
  /// beside: "Waiting", "Shown", "Not shown", "Joined an unread one"
  label "Shown — mail due" => "Visad, mejl väntar";

  // ── Osysharp.Notifications · Osysharp.Notifications.NotificationWatchState ──
  /// Osysharp.Notifications.NotificationWatchState · a label (a field, a list item, a menu entry) · at most ~21 characters
  /// shown through Osysharp.Notifications.NotificationWatchState.Watching
  /// beside: "Stopped"
  /// also in Osysharp.Feedback.FeedbackWatchState
  label "Sweeping hourly" => "Körs varje timme";

  // ── Osysharp.Notifications · Osysharp.Notifications.__Settings_NotificationPreferences_Section.Sections ──
  /// Osysharp.Notifications.__Settings_NotificationPreferences_Section.Sections · a heading
  /// shown through SettingsLink.Group
  heading "You" => "Du";
  /// Osysharp.Notifications.__Settings_NotificationPreferences_Section.Sections · a hint under a field
  /// shown through SettingsLink.Hint
  hint "What is mailed to you when you have not seen it here." => "Vad som mejlas till dig när du inte har sett det här.";
  /// Osysharp.Notifications.__Settings_NotificationPreferences_Section.Sections · a label (a field, a list item, a menu entry) · at most ~19 characters
  /// shown through SettingsLink.Label
  label "Notifications" => "Aviseringar";

  // ── Osysharp.Notifications · __Settings_NotificationPreferences_Row ──
  /// __Settings_NotificationPreferences_Row · an error message
  /// shown through ValidationException
  error "Sign in to see your own settings." => "Logga in för att se dina egna inställningar.";
}
