// ar (العربية): the words of Helpdesk · Osysharp.Webhooks, translated.
// Written and kept in step with the source by `osy translate`: a new text arrives as `=> null`, a text
// whose source changed keeps its old translation in a `was` clause. The words are yours to edit.
// Source language: en.

translations ar {
  // ── Osysharp.Webhooks · AddWebhook ──
  /// AddWebhook · an error message
  /// shown through ValidationException
  /// also in ChangeWebhook
  error "Give the subscription a name — it is how you will recognise it in the list." => "أعطِ الاشتراك اسمًا، فبه ستتعرف عليه في القائمة.";

  // ── Osysharp.Webhooks · CheckedEvents ──
  /// CheckedEvents · an error message
  /// placeholders: {name} = name (string), {Join} = string.Join(…) (string)
  /// shown through ValidationException
  error "'{name}' is not an event this app sends. It sends: {Join}." => "'{name}' ليس حدثًا يرسله هذا التطبيق. يرسل: {Join}.";
  /// CheckedEvents · an error message
  /// shown through ValidationException
  error "Choose at least one event to send." => "اختر حدثًا واحدًا على الأقل لإرساله.";

  // ── Osysharp.Webhooks · CheckedUrl ──
  /// CheckedUrl · an error message
  /// placeholders: {host} = host (string)
  /// shown through ValidationException
  error "'{host}' is not a host that can be reached from the internet." => "'{host}' ليس مضيفًا يمكن الوصول إليه من الإنترنت.";
  /// CheckedUrl · an error message
  /// shown through ValidationException
  error "A webhook goes to an https:// address — what it carries is signed, and must not be read on the way." => "يُرسل الويب هوك إلى عنوان https://، فما يحمله موقّع ويجب ألا يُقرأ في الطريق.";
  /// CheckedUrl · an error message
  /// shown through ValidationException
  error "Give the endpoint's address — like https://example.com/hooks/orders." => "أدخل عنوان نقطة الاستقبال، مثل https://example.com/hooks/orders.";
  /// CheckedUrl · an error message
  /// shown through ValidationException
  error "That address has a space in it — copy it again from the receiving system." => "يحتوي هذا العنوان على مسافة. انسخه مرة أخرى من النظام المستقبِل.";
  /// CheckedUrl · an error message
  /// shown through ValidationException
  error "That address is longer than 2,000 characters." => "هذا العنوان أطول من 2,000 حرف.";

  // ── Osysharp.Webhooks · Days ──
  /// Days · a description
  /// shown through Days()
  description "1 day" => "يوم واحد";
  /// Days · a description
  /// shown through Days()
  description "1 hour" => "ساعة واحدة";
  /// Days · a description
  /// placeholders: {d} = d (int) — {d} is a count: give one text per plural form
  /// shown through Days()
  description "{d} days" => { zero: "{d} يوم", one: "يوم واحد", two: "يومين", few: "{d} أيام", many: "{d} يومًا", other: "{d} يوم" };
  /// Days · a description
  /// placeholders: {h} = h (int) — {h} is a count: give one text per plural form
  /// shown through Days()
  description "{h} hours" => { zero: "{h} ساعة", one: "ساعة واحدة", two: "ساعتين", few: "{h} ساعات", many: "{h} ساعة", other: "{h} ساعة" };

  // ── Osysharp.Webhooks · HealthOf ──
  /// HealthOf · text on the page
  /// placeholders: {s.LastDeliveredAt} = s.LastDeliveredAt (DateTime)
  /// shown through HealthOf()
  text "Last delivered {s.LastDeliveredAt}." => "آخر تسليم {s.LastDeliveredAt}.";
  /// HealthOf · text on the page
  /// placeholders: {s.LastFailedAt} = s.LastFailedAt (DateTime), {Sentence} = Sentence(…) (string)
  /// shown through HealthOf()
  text "Last try refused {s.LastFailedAt} — {Sentence} It is tried again until it is taken or given up on." => "رُفضت آخر محاولة {s.LastFailedAt}: {Sentence} تُعاد المحاولة حتى يُستلم أو يُتخلى عنه.";
  /// HealthOf · text on the page
  /// shown through HealthOf()
  text "Nothing sent yet." => "لم يُرسل شيء بعد.";
  /// HealthOf · text on the page
  /// placeholders: {s.PausedAt} = s.PausedAt (DateTime), {s.FailingInARow} = s.FailingInARow (int), {Sentence} = Sentence(…) (string) — {s.FailingInARow} is a count: give one text per plural form
  /// shown through HealthOf()
  text "Paused {s.PausedAt} after {s.FailingInARow} deliveries in a row were given up on — the last: {Sentence} Fix the endpoint, then resume it." => { zero: "أُوقف مؤقتًا {s.PausedAt} بعد التخلي عن {s.FailingInARow} عملية تسليم متتالية. آخرها: {Sentence} أصلح نقطة الاستقبال، ثم استأنفه.", one: "أُوقف مؤقتًا {s.PausedAt} بعد التخلي عن عملية تسليم واحدة. السبب: {Sentence} أصلح نقطة الاستقبال، ثم استأنفه.", two: "أُوقف مؤقتًا {s.PausedAt} بعد التخلي عن عمليتي تسليم متتاليتين. آخرهما: {Sentence} أصلح نقطة الاستقبال، ثم استأنفه.", few: "أُوقف مؤقتًا {s.PausedAt} بعد التخلي عن {s.FailingInARow} عمليات تسليم متتالية. آخرها: {Sentence} أصلح نقطة الاستقبال، ثم استأنفه.", many: "أُوقف مؤقتًا {s.PausedAt} بعد التخلي عن {s.FailingInARow} عملية تسليم متتالية. آخرها: {Sentence} أصلح نقطة الاستقبال، ثم استأنفه.", other: "أُوقف مؤقتًا {s.PausedAt} بعد التخلي عن {s.FailingInARow} عملية تسليم متتالية. آخرها: {Sentence} أصلح نقطة الاستقبال، ثم استأنفه." };
  /// HealthOf · text on the page
  /// placeholders: {s.PausedAt} = s.PausedAt (DateTime)
  /// shown through HealthOf()
  text "Paused {s.PausedAt} — its endpoint answered that it is gone (HTTP 410). Point it at the right address, then resume it." => "أُوقف مؤقتًا {s.PausedAt}، فقد ردّت نقطة الاستقبال بأنها لم تعد موجودة (HTTP 410). وجّهه إلى العنوان الصحيح، ثم استأنفه.";
  /// HealthOf · text on the page
  /// placeholders: {s.PausedAt} = s.PausedAt (DateTime)
  /// shown through HealthOf()
  text "Paused {s.PausedAt} — nothing is sent until it is resumed." => "أُوقف مؤقتًا {s.PausedAt}. لن يُرسل شيء حتى يُستأنف.";

  // ── Osysharp.Webhooks · NewWebhookSecret ──
  /// NewWebhookSecret · text on the page
  /// placeholders: {ToBase64String} = Convert.ToBase64String(…) (string)
  /// shown through NewWebhookSecret()
  text "whsec_{ToBase64String}" => "whsec_{ToBase64String}";

  // ── Osysharp.Webhooks · Osysharp.Webhooks.WebhookDeliveryState ──
