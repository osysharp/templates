  // ── Osysharp.Webhooks · SendWebhookAgain ──
  /// SendWebhookAgain · an error message
  /// shown through ValidationException
  error "Its document has been removed — it was kept for a short while only, so it cannot be sent again." => "حُذف مستنده، فقد كان يُحتفظ به لفترة قصيرة فقط، لذا لا يمكن إرساله مرة أخرى.";
  /// SendWebhookAgain · an error message
  /// shown through ValidationException
  error "Its subscription was removed." => "حُذف اشتراكه.";
  /// SendWebhookAgain · an error message
  /// shown through ValidationException
  error "Only a delivery that failed is sent again." => "لا يُعاد إرسال إلا التسليم الذي فشل.";
  /// SendWebhookAgain · an error message
  /// shown through NotFoundException
  error "That delivery is no longer in the log." => "لم يعد هذا التسليم موجودًا في السجل.";

  // ── Osysharp.Webhooks · SubscriptionById ──
