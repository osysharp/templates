  /// MyRequestRows · text on the page
  /// placeholders: {r.ExtensionReason} = r.ExtensionReason (string)
  /// shown through MyRequestRow.Extension
  text "We need more time: {r.ExtensionReason}" => "Vi behöver mer tid: {r.ExtensionReason}";

  // ── Osysharp.Privacy · NewHold ──
  /// NewHold · an error message
  /// shown through ValidationException
  error "A hold needs a review date in the future — a hold is reviewed, so it never becomes keeping for ever." => "Ett bevarande behöver ett granskningsdatum i framtiden. Det granskas, så det blir aldrig sparande för alltid.";
  /// NewHold · an error message
  /// shown through ValidationException
  error "Name the matter the hold is for — it is what a reviewer reads." => "Ange vilket ärende bevarandet gäller. Det är det som granskaren läser.";
  /// NewHold · an error message
  /// shown through ValidationException
  error "Say why the data must be kept — a hold without a reason cannot be reviewed." => "Ange varför uppgifterna måste sparas. Ett bevarande utan skäl kan inte granskas.";

  // ── Osysharp.Privacy · NoSelfService ──
  /// NoSelfService · message
  /// placeholders: {value} = … (string)
  /// shown through NoSelfService()
  message "This app cannot confirm it is you yet, so a request is made by writing to {value} — they will check it is you." => "Appen kan inte bekräfta att det är du än, så en förfrågan görs genom att skriva till {value}. De kontrollerar att det är du.";
  /// NoSelfService · message
  /// shown through NoSelfService()
  message "the people who run it" => "de som driver den";

