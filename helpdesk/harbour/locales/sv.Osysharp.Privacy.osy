  error "The next review date must be in the future." => "Nästa granskningsdatum måste vara i framtiden.";

  // ── Osysharp.Privacy · Release ──
  /// Release · an error message
  /// placeholders: {Key} = h.Key(…) (string), {c.Key} = c.Key (string)
  /// shown through ValidationException
  error "{Key} cannot give '{c.Key}' its period back, so the hold is not lifted — its rows would otherwise be kept for ever." => "{Key} kan inte ge '{c.Key}' tillbaka sin lagringstid, så bevarandet hävs inte. Annars skulle dess rader sparas för alltid.";

  // ── Osysharp.Privacy · RetentionEditor ──
  /// RetentionEditor · a button's label · at most ~31 characters
  /// placeholders: {p.Jurisdiction} = p.Jurisdiction
  /// shown through Button.label
  button "Apply {p.Jurisdiction}" => "Tillämpa {p.Jurisdiction}";
  /// RetentionEditor · a button's label · at most ~24 characters
  /// placeholders: {r.Label} = r.Label
  /// shown through Button.announceAs
  /// beside: "Needs your decision"
  button "Confirm {r.Label}" => "Bekräfta {r.Label}";
  /// RetentionEditor · a description
  /// shown through SettingsSection.description
  /// beside: "Bookkeeping preset", "Retention saved."
  description " Set in the app's own code." => " Anges i appens egen kod.";
  /// RetentionEditor · a description
  /// shown through SettingsPage.description
  description "How long each kind of personal data is kept after its purpose ends, and on what basis. A request to erase keeps what the law still needs, restricted, until its period ends — then the daily purge removes it." => "Hur länge varje typ av personuppgifter sparas efter att syftet upphört, och på vilken grund. En begäran om radering behåller det som lagen fortfarande kräver, begränsat, tills lagringstiden tar slut. Sedan tar den dagliga rensningen bort det.";
  /// RetentionEditor · a description
  /// shown through SettingsSection.description
  /// beside: "Plan review", "Retention saved."
  description "Set every bookkeeping category to a country's statutory period at once — recorded, and yours to verify with your adviser." => "Sätt alla bokföringskategorier till ett lands lagstadgade tid på en gång. Det sparas, och du kontrollerar det med din rådgivare.";
  /// RetentionEditor · a description
  /// placeholders: {value} = …
  /// shown through SettingsSection.description
  /// beside: "Bookkeeping preset", "Retention saved."
  description "Which privacy-request plans wait for approval before they run.{value}" => "Vilka planer för integritetsförfrågningar som väntar på godkännande innan de körs.{value}";
  /// RetentionEditor · a label (a field, a list item, a menu entry) · at most ~18 characters
  /// shown through Field.label
  label "Jurisdiction" => "Jurisdiktion";
  /// RetentionEditor · a label (a field, a list item, a menu entry) · at most ~17 characters
  /// shown through NumberField.label
  label "Months kept" => "Månader sparad";
  /// RetentionEditor · a label (a field, a list item, a menu entry) · at most ~27 characters
  /// shown through Badge.label
  /// beside: "Confirm"
  label "Needs your decision" => "Behöver ditt beslut";
  /// RetentionEditor · placeholder text inside an empty field · at most ~8 characters
  /// shown through Field.placeholder
  placeholder "SE" => "SE";
  /// RetentionEditor · placeholder text inside an empty field · at most ~54 characters
  /// shown through Field.placeholder
  placeholder "The statute or decision that allows it" => "Lagen eller beslutet som tillåter det";
  /// RetentionEditor · text on the page
  /// shown through done
  text " categories" => " kategorier";
  /// RetentionEditor · text on the page
  /// shown through done
  text " category" => " kategori";
  /// RetentionEditor · text on the page
  /// placeholders: {r.MinMonths} = r.MinMonths
  /// shown through Limits()
  text "At least {r.MinMonths} months without a stated reason" => "Minst {r.MinMonths} månader utan angivet skäl";
  /// RetentionEditor · text on the page
  /// placeholders: {s.Jurisdiction} = s.Jurisdiction, {s.Reason} = s.Reason
  text "Outside the kit's limits for {s.Jurisdiction}: {s.Reason}" => "Utanför kitets gränser för {s.Jurisdiction}: {s.Reason}";
  /// RetentionEditor · text on the page
  /// beside: "160px"
  text "Outside the kit's limits only for a jurisdiction that allows it — say which, and why. Both are recorded." => "Utanför kitets gränser bara för en jurisdiktion som tillåter det. Ange vilken, och varför. Båda sparas.";
  /// RetentionEditor · text on the page
  /// shown through Refusal()
  text "Outside the kit's limits, a period is saved only with the jurisdiction that allows it and the reason." => "Utanför kitets gränser sparas en lagringstid bara med den jurisdiktion som tillåter den och skälet.";
  /// RetentionEditor · text on the page
  /// shown through SaveBar.saved
  /// beside: "Bookkeeping preset", "Plan review"
  text "Retention saved." => "Lagringstiderna är sparade.";
  /// RetentionEditor · text on the page
  /// shown through EmptyState.body
  text "The app and its kits declare what personal data they hold; each kind appears here with its period." => "Appen och dess kit anger vilka personuppgifter de har; varje typ visas här med sin lagringstid.";
  /// RetentionEditor · text on the page
  /// placeholders: {p.Jurisdiction} = p.Jurisdiction, {changes.Count} = changes.Count, {value} = …
  /// shown through done
  text "{p.Jurisdiction} preset set on {changes.Count}{value} — Save keeps it." => "Förinställningen {p.Jurisdiction} tillämpad på {changes.Count}{value}. Spara för att behålla den.";
  /// RetentionEditor · text on the page
  /// placeholders: {r.MinMonths} = r.MinMonths, {r.MaxMonths} = r.MaxMonths
  /// shown through Limits()
  text "{r.MinMonths}–{r.MaxMonths} months without a stated reason" => "{r.MinMonths}–{r.MaxMonths} månader utan angivet skäl";
  /// RetentionEditor · a title
  /// shown through SettingsSection.title
  /// beside: "Plan review", "Retention saved."
  title "Bookkeeping preset" => "Förinställning för bokföring";
  /// RetentionEditor · a title
  /// shown through SettingsPage.title
  /// also in PrivacySettings /settings/privacy
  title "Data retention" => "Lagringstid";
  /// RetentionEditor · a title
  /// shown through EmptyState.title
  title "Nothing declared yet" => "Inget angivet än";
  /// RetentionEditor · a title
  /// shown through SettingsSection.title
  /// beside: "Bookkeeping preset", "Retention saved."
  title "Plan review" => "Granskning av planer";

  // ── Osysharp.Privacy · RetentionLimitRefusal ──
  /// RetentionLimitRefusal · text on the page
  /// placeholders: {label} = label (string), {limit} = limit (string), {minMonths} = minMonths (int), {maxMonths} = maxMonths (int) — {minMonths} is a count: give one text per plural form
  /// shown through RetentionLimitRefusal()
  text "'{label}' cannot be kept {limit} without saying why: the kit declares {minMonths}–{maxMonths} months as the range no law it knows of asks you to leave. Set it outside only for a jurisdiction that allows it — state the jurisdiction and the reason, and both are recorded." => { one: "'{label}' kan inte sparas {limit} utan motivering: kitet anger {minMonths}–{maxMonths} månader som det intervall som ingen lag det känner till kräver att du lämnar. Ange ett värde utanför bara för en jurisdiktion som tillåter det. Ange jurisdiktionen och skälet, så sparas båda.", other: "'{label}' kan inte sparas {limit} utan motivering: kitet anger {minMonths}–{maxMonths} månader som det intervall som ingen lag det känner till kräver att du lämnar. Ange ett värde utanför bara för en jurisdiktion som tillåter det. Ange jurisdiktionen och skälet, så sparas båda." };
  /// RetentionLimitRefusal · text on the page
  /// shown through RetentionLimitRefusal()
  text "A period is a number of months, 0 or more." => "En period är ett antal månader, 0 eller fler.";

  // ── Osysharp.Privacy · RetentionSentence ──
  /// RetentionSentence · text on the page
  text "Erased on request" => "Raderas på begäran";

