// sv (Svenska): the words of Helpdesk · Osysharp.Privacy, translated.
// Written and kept in step with the source by `osy translate`: a new text arrives as `=> null`, a text
// whose source changed keeps its old translation in a `was` clause. The words are yours to edit.
// Source language: en.

translations sv {
  // ── Osysharp.Privacy · AskAboutAnAddress ──
  /// AskAboutAnAddress · an error message
  /// shown through ValidationException
  error "This browser cannot keep your request — let it keep cookies for this site and ask again." => "Den här webbläsaren kan inte spara din förfrågan. Tillåt cookies för den här webbplatsen och fråga igen.";

  // ── Osysharp.Privacy · AskToLift ──
  /// AskToLift · an error message
  /// shown through ValidationException
  error "A lift is already waiting for a second person." => "En hävning väntar redan på en andra person.";
  /// AskToLift · an error message
  /// shown through ValidationException
  error "Lifting a legal hold needs a reason — it is recorded, and it is what shows the hold was ended on purpose." => "Att häva ett rättsligt bevarande kräver ett skäl. Det sparas och visar att bevarandet avslutades avsiktligt.";

  // ── Osysharp.Privacy · AskWithProof ──
  /// AskWithProof · message
  /// shown through AskWithProof()
  /// also in AskAboutAnAddressWithProof
  message "We could not file it — ask again." => "Vi kunde inte registrera den. Fråga igen.";

  // ── Osysharp.Privacy · AskWithoutAnAccount ──
  /// AskWithoutAnAccount · a control's name for screen readers
  accessibleName "What this will do" => "Vad det här gör";
  /// AskWithoutAnAccount · a label (a field, a list item, a menu entry) · at most ~26 characters
  /// shown through Field.label
  /// beside: "Send me a code"
  label "Your email address" => "Din e-postadress";
  /// AskWithoutAnAccount · a subtitle
  /// placeholders: {sentTo} = sentTo
  /// shown through Card.subtitle
  subtitle "About {sentTo}, and nothing else." => "Om {sentTo}, och inget annat.";
  /// AskWithoutAnAccount · a subtitle
  /// shown through PageHead.subtitle
  subtitle "No account needed — prove the email address you wrote to us from, and ask for a copy of what we hold, or to have it erased." => "Inget konto behövs. Bekräfta e-postadressen du skrev till oss från och be om en kopia av det vi har, eller om att få det raderat.";
  /// AskWithoutAnAccount · a subtitle
  /// shown through Card.subtitle
  subtitle "We mail a code there. Only that address gets the answer." => "Vi mejlar en kod dit. Bara den adressen får svaret.";
  /// AskWithoutAnAccount · a subtitle
  /// placeholders: {sentTo} = sentTo
  /// shown through Card.subtitle
  subtitle "We sent a code to {sentTo}. It works for fifteen minutes." => "Vi har skickat en kod till {sentTo}. Den gäller i femton minuter.";
  /// AskWithoutAnAccount · text on the page
  /// shown through problem
  text "Give the email address you wrote to us from." => "Ange e-postadressen du skrev till oss från.";
  /// AskWithoutAnAccount · text on the page
  /// shown through SectionLabel.text
  /// beside: "Send the request"
  text "What this will do" => "Vad det här gör";
  /// AskWithoutAnAccount · text on the page
  /// placeholders: {sentTo} = sentTo
  /// shown through done
  text "Your request is in. We answer within one month, by mail to {sentTo} — and only there." => "Din förfrågan är mottagen. Vi svarar inom en månad, via e-post till {sentTo}, och bara dit.";
  /// AskWithoutAnAccount · a title
  /// shown through Card.title
  title "1. Your email address" => "1. Din e-postadress";
  /// AskWithoutAnAccount · a title
  /// shown through Card.title
  title "2. The code" => "2. Koden";
  /// AskWithoutAnAccount · a title
  /// shown through Card.title
  title "3. What you ask for" => "3. Vad du ber om";

  // ── Osysharp.Privacy · AskedFor ──
  /// AskedFor · a title
  /// shown through AskedFor()
  title "Your request for a copy of your data" => "Din begäran om en kopia av dina uppgifter";
  /// AskedFor · a title
  /// shown through AskedFor()
  title "Your request to erase your data" => "Din begäran om att radera dina uppgifter";
  /// AskedFor · a title
  /// shown through AskedFor()
  title "Your request to move your data" => "Din begäran om att flytta dina uppgifter";
  /// AskedFor · a title
  /// shown through AskedFor()
  title "Your request to stop using your data" => "Din begäran om att sluta använda dina uppgifter";

  // ── Osysharp.Privacy · CategoryOf ──
  /// CategoryOf · an error message
  /// placeholders: {key} = key (string), {Join} = string.Join(…) (string)
  /// shown through ValidationException
  error "No holder declares the category '{key}'. The categories are: {Join}." => "Ingen hållare anger kategorin '{key}'. Kategorierna är: {Join}.";

  // ── Osysharp.Privacy · ControllerEditor ──
  /// ControllerEditor · a control's name for screen readers
  accessibleName "Who is responsible" => "Vem som är ansvarig";
  /// ControllerEditor · a button's label · at most ~27 characters
  /// shown through Button.label
  button "Name the controller" => "Ange personuppgiftsansvarig";
  /// ControllerEditor · a description
  /// shown through SettingsSection.description
  description "Named in every answer, set by the app." => "Anges i varje svar, inställt av appen.";
  /// ControllerEditor · a description
  /// shown through SettingsSection.description
  /// beside: "Saved."
  description "The legal entity that decides why and how people's data is used here — usually the company running the app. Every answer to a privacy request names it, and so do the records of processing." => "Den juridiska person som bestämmer varför och hur personuppgifter används här, oftast företaget som driver appen. Varje svar på en integritetsförfrågan anger den, och det gör även registren över behandling.";
  /// ControllerEditor · a hint under a field
  /// shown through Field.hint
  hint "Its registered name — what a person would look up." => "Det registrerade namnet, det som en person skulle slå upp.";
  /// ControllerEditor · a label (a field, a list item, a menu entry) · at most ~16 characters
  /// shown through Field.label
  label "Legal name" => "Juridiskt namn";
  /// ControllerEditor · placeholder text inside an empty field · at most ~45 characters
  /// shown through Field.placeholder
  placeholder "As on the company's registration" => "Som i företagets registrering";
  /// ControllerEditor · text on the page
  /// beside: "Name the controller"
  text "Name it here to say it in your own words." => "Ange den här för att säga det med egna ord.";
  /// ControllerEditor · text on the page
  /// placeholders: {fallback} = fallback
  /// beside: "Name the controller"
  text "Named by the app as {fallback}." => "Angiven av appen som {fallback}.";
  /// ControllerEditor · text on the page
  /// beside: "Name the controller"
  text "Not named yet." => "Inte angiven än.";
  /// ControllerEditor · text on the page
  /// beside: "Name the controller"
  text "Until it is, an answer says it comes from \"the people who run it\" — a person asking about their data is owed a name." => "Tills dess står det i svaren att de kommer från ”de som driver den”, men den som frågar om sina uppgifter har rätt till ett namn.";
  /// ControllerEditor · text on the page
  /// shown through SaveBar.blockedBy
  /// beside: "The controller"
  text "Write the controller's legal name." => "Skriv den personuppgiftsansvariges juridiska namn.";
  /// ControllerEditor · a title
  /// shown through SettingsSection.title
  /// beside: "Saved."
  title "The controller" => "Personuppgiftsansvarig";
  /// ControllerEditor · a title
  /// shown through SettingsSection.title
  title "Where a person can complain" => "Var en person kan klaga";

  // ── Osysharp.Privacy · ControllerSettings (/settings/privacy/controller) ──
  /// ControllerSettings · /settings/privacy/controller · a title
  /// shown through [Title]
  title "Who is responsible" => "Vem som är ansvarig";

  // ── Osysharp.Privacy · Deliver ──
  /// Deliver · an email's subject line
  /// shown through MailMessage.Subject
  mailSubject "Our answer to your request about your data" => "Vårt svar på din förfrågan om dina uppgifter";
  /// Deliver · text on the page
  /// placeholders: {text} = text (string), {where} = where (string), {ToString} = r.ExportExpiresAt.Value.ToString(…) (DateTime)
  /// shown through MailMessage.Text
  text "{text}\n\nYour data is ready {where} — until {ToString}. It can be downloaded once; after that date it is deleted." => "{text}\n\nDina uppgifter finns {where} till och med {ToString}. De kan laddas ner en gång; efter det datumet raderas de.";

  // ── Osysharp.Privacy · ExportByLinkPage (/privacy/export/{link}) ──
  /// ExportByLinkPage · /privacy/export/{link} · a subtitle
  /// shown through PageHead.subtitle
  subtitle "A copy of what we hold about you. It can be downloaded once; after that, or after seven days, it is deleted." => "En kopia av det vi har om dig. Den kan laddas ner en gång; efter det, eller efter sju dagar, raderas den.";
  /// ExportByLinkPage · /privacy/export/{link} · a title
  /// shown through PageHead.title
  /// also in ExportByLinkPage /privacy/export/{link}
  title "Your data" => "Dina uppgifter";

  // ── Osysharp.Privacy · ExtendDeadline ──
  /// ExtendDeadline · an error message
  /// shown through ValidationException
  error "A deadline may be extended by one or two months, no more." => "En tidsfrist kan förlängas med en eller två månader, inte mer.";
  /// ExtendDeadline · an error message
  /// shown through ValidationException
  error "An extension needs its reason — the person is told it." => "En förlängning behöver ett skäl. Personen får veta det.";
  /// ExtendDeadline · an error message
  /// shown through ValidationException
  error "The first month is over — an extension must be decided, and told, within it." => "Den första månaden är över. En förlängning måste beslutas, och meddelas, inom den.";
  /// ExtendDeadline · an error message
  /// shown through ValidationException
  error "This request is answered." => "Den här förfrågan är besvarad.";
  /// ExtendDeadline · an error message
  /// shown through ValidationException
  error "This request was already extended." => "Den här förfrågan har redan förlängts.";
  /// ExtendDeadline · an email's subject line
  /// shown through MailMessage.Subject
  mailSubject "Your request about your data will take longer" => "Din förfrågan om dina uppgifter tar längre tid";
  /// ExtendDeadline · text on the page
  /// placeholders: {ToString} = due.ToString(…) (DateTime), {Trim} = reason.Trim(…) (string)
  /// shown through MailMessage.Text
  text "We need more time to answer your request, and will answer by {ToString}: {Trim}" => "Vi behöver mer tid för att besvara din förfrågan och svarar senast {ToString}: {Trim}";

  // ── Osysharp.Privacy · FactsOf ──
  /// FactsOf · text on the page
  /// shown through RequestFacts.Delivery
  text "Filed by staff: send the answer yourself, through a channel you proved. Nothing is mailed to the address typed in." => "Registrerad av personal: skicka svaret själv, via en kanal du har bekräftat. Inget mejlas till den inskrivna adressen.";
  /// FactsOf · text on the page
  /// placeholders: {r.DeliverTo} = r.DeliverTo (string)
  /// shown through RequestFacts.Delivery
  text "Goes to {r.DeliverTo} — the address the person proved — when it is answered." => "Skickas till {r.DeliverTo}, adressen som personen bekräftade, när den besvaras.";
  /// FactsOf · text on the page
  /// placeholders: {l.Reason} = l.Reason (string)
  /// shown through PlanRow.Detail
  text "Kept, restricted — {l.Reason}" => "Sparas, begränsat: {l.Reason}";
  /// FactsOf · text on the page
  /// placeholders: {ToString} = ….ToString(…) (DateTime)
  /// shown through PlanRow.Detail
  text "Kept, restricted, through {ToString}" => "Sparas, begränsat, till och med {ToString}";
  /// FactsOf · text on the page
  /// placeholders: {PeriodWords} = PeriodWords(…) (string)
  /// shown through PlanRow.Detail
  text "Kept, restricted, {PeriodWords}" => "Sparas, begränsat, {PeriodWords}";
  /// FactsOf · text on the page
  /// placeholders: {ToString} = r.DeliveredAt.Value.ToString(…) (DateTime)
  /// shown through RequestFacts.Delivery
  text "Sent to the proven address on {ToString}." => "Skickat till den bekräftade adressen den {ToString}.";
  /// FactsOf · text on the page
  /// shown through RequestFacts.Asker
  text "an erased person (kept as a fingerprint)" => "en raderad person (sparad som ett fingeravtryck)";

  // ── Osysharp.Privacy · FetchMyExport ──
  /// FetchMyExport · an error message
  /// shown through ValidationException
  /// also in FetchExportByLink
  error "That export has expired and was deleted — ask again for a new one." => "Exporten har gått ut och raderats. Fråga igen för att få en ny.";
  /// FetchMyExport · an error message
  /// shown through ValidationException
  /// also in FetchExportByLink
  error "That export was already downloaded — ask again for a new one." => "Exporten har redan laddats ner. Fråga igen för att få en ny.";
  /// FetchMyExport · an error message
  /// shown through ValidationException
  error "That is not your request." => "Det är inte din förfrågan.";

  // ── Osysharp.Privacy · FileRequest ──
  /// FileRequest · an error message
  /// shown through ValidationException
  error "A step-up is the person's own proof on their privacy page — say how YOU checked it is them." => "En extra verifiering är personens eget bevis på sin integritetssida. Ange hur DU kontrollerade att det är hen.";
  /// FileRequest · an error message
  /// shown through ValidationException
  error "Say how you checked it is them — a fraudulent request is a known way to steal someone's data." => "Ange hur du kontrollerade att det är hen. En bedräglig förfrågan är ett känt sätt att stjäla någons uppgifter.";
  /// FileRequest · an error message
  /// shown through ValidationException
  error "Say who the request is about — their address, their number, or their account." => "Ange vem förfrågan gäller: adress, nummer eller konto.";

  // ── Osysharp.Privacy · FromPhrase ──
  /// FromPhrase · text on the page
  text "from the end of its calendar year" => "från slutet av kalenderåret";
  /// FromPhrase · text on the page
  text "from the end of its fiscal year" => "från slutet av räkenskapsåret";
  /// FromPhrase · text on the page
  text "from the end of the calendar year its fiscal year ended in" => "från slutet av det kalenderår då räkenskapsåret slutade";
  /// FromPhrase · text on the page
  text "from when it was collected" => "från när det samlades in";

  // ── Osysharp.Privacy · HoldControl ──
  /// HoldControl · a control's name for screen readers
  accessibleName "Legal hold" => "Rättsligt bevarande";
  /// HoldControl · a button's label · at most ~33 characters
  /// shown through Button.label
  button "Lift it on Legal holds…" => "Häv under Rättsligt bevarande…";
  /// HoldControl · a button's label · at most ~27 characters
  /// shown through Button.label
  button "Place a legal hold…" => "Besluta bevarande…";
  /// HoldControl · a button's label · at most ~20 characters
  /// shown through Button.label
  /// beside: "Cancel"
  /// also in LegalHoldsEditor
  button "Place the hold" => "Besluta bevarande";
  /// HoldControl · a hint under a field
  /// shown through Field.hint
  /// beside: "Why it must be kept", "Review by", "Cancel"
  hint "Never shown to the customer." => "Visas aldrig för kunden.";
  /// HoldControl · a hint under a field
  /// shown through DatePicker.hint
  /// beside: "Matter", "Why it must be kept", "Cancel"
  /// also in LegalHoldsEditor
  hint "When somebody looks at it again — a hold is never kept for ever unseen." => "När någon granskar det igen. Ett bevarande sparas aldrig för alltid utan granskning.";
  /// HoldControl · a label (a field, a list item, a menu entry) · at most ~12 characters
  /// shown through Field.label
  /// beside: "Why it must be kept", "Review by", "Cancel"
  /// also in LegalHoldsEditor
  label "Matter" => "Ärende";
  /// HoldControl · a label (a field, a list item, a menu entry) · at most ~15 characters
  /// shown through DatePicker.label
  /// beside: "Matter", "Why it must be kept", "Cancel"
  /// also in LegalHoldsEditor
  label "Review by" => "Granska senast";
  /// HoldControl · a label (a field, a list item, a menu entry) · at most ~27 characters
  /// shown through Field.label
  /// beside: "Matter", "Review by", "Cancel"
  /// also in LegalHoldsEditor
  label "Why it must be kept" => "Varför det måste sparas";
  /// HoldControl · placeholder text inside an empty field · at most ~40 characters
  /// shown through Field.placeholder
  /// beside: "Why it must be kept", "Review by", "Cancel"
  placeholder "Dispute about a refund, 2026" => "Tvist om en återbetalning, 2026";
  /// HoldControl · placeholder text inside an empty field · at most ~69 characters
  /// shown through Field.placeholder
  /// beside: "Matter", "Review by", "Cancel"
  placeholder "The customer has said they will take it to court." => "Kunden har sagt att hen kommer att gå till domstol.";
  /// HoldControl · a subtitle
  /// shown through Dialog.subtitle
  subtitle "Nothing on it is erased on request or purged until the hold is lifted. The customer is told only that it is kept for legal claims." => "Inget i det raderas på begäran eller rensas förrän bevarandet hävs. Kunden får bara veta att det sparas för rättsliga anspråk.";
  /// HoldControl · text on the page
  /// placeholders: {ToString} = facts.ReviewBy.Value.ToString(…)
  /// beside: "Lift it on Legal holds…"
  text " — reviewed by {ToString}" => ", granskas senast {ToString}";
  /// HoldControl · text on the page
  /// placeholders: {value} = …
  /// beside: "Lift it on Legal holds…"
  text "Nothing on it is erased or purged until the hold is lifted{value}." => "Inget i det raderas eller rensas förrän bevarandet hävs{value}.";
  /// HoldControl · text on the page
  /// placeholders: {facts.Matter} = facts.Matter
  text "On legal hold: {facts.Matter}" => "Rättsligt bevarande: {facts.Matter}";
  /// HoldControl · text on the page
  /// shown through problem
  text "Pick the date the hold is reviewed — a hold is never kept for ever unseen." => "Välj datum då bevarandet granskas. Ett bevarande sparas aldrig för alltid utan granskning.";
  /// HoldControl · a title
  /// placeholders: {label} = label
  /// shown through Dialog.title
  title "Place a legal hold on {label}" => "Besluta rättsligt bevarande av {label}";

  // ── Osysharp.Privacy · HoldReviewOf ──
  /// HoldReviewOf · text on the page
  /// shown through HoldReviewFacts.On
  /// also in HoldRows
  text "an account" => "ett konto";

  // ── Osysharp.Privacy · HoldReviewPane ──
  /// HoldReviewPane · a control's name for screen readers
  accessibleName "Legal hold review" => "Granskning av rättsligt bevarande";
  /// HoldReviewPane · a control's name for screen readers
  accessibleName "What it is for" => "Vad det gäller";
  /// HoldReviewPane · a button's label · at most ~20 characters
  /// shown through Button.label
  /// beside: "Cancel"
  /// also in LegalHoldsEditor
  button "Ask to lift it" => "Begär hävning";
  /// HoldReviewPane · a button's label · at most ~13 characters
  /// shown through Button.label
  /// beside: "Cancel"
  /// also in LegalHoldsEditor
  button "Keep it" => "Behåll det";
  /// HoldReviewPane · a button's label · at most ~37 characters
  /// shown through Button.label
  /// beside: "Lift the hold…"
  button "Keep it, and review again…" => "Behåll det och granska igen…";
  /// HoldReviewPane · a button's label · at most ~19 characters
  /// shown through Button.label
  /// beside: "Cancel"
  /// also in LegalHoldsEditor
  button "Lift the hold" => "Häv bevarandet";
  /// HoldReviewPane · a button's label · at most ~20 characters
  /// shown through Button.label
  /// beside: "Keep it, and review again…"
  button "Lift the hold…" => "Häv bevarandet…";
  /// HoldReviewPane · a hint under a field
  /// shown through Field.hint
  /// beside: "Cancel"
  /// also in LegalHoldsEditor
  hint "Recorded with your name." => "Sparas med ditt namn.";
  /// HoldReviewPane · a label (a field, a list item, a menu entry) · at most ~10 characters
  /// shown through Badge.label
  /// also in LegalHoldsEditor
  label "Case" => "Ärende";
  /// HoldReviewPane · a label (a field, a list item, a menu entry) · at most ~17 characters
  /// shown through DatePicker.label
  /// beside: "Cancel"
  /// also in LegalHoldsEditor
  label "Next review" => "Nästa granskning";
  /// HoldReviewPane · a label (a field, a list item, a menu entry) · at most ~28 characters
  /// shown through Field.label
  /// beside: "Cancel"
  /// also in LegalHoldsEditor
  label "Why it can be lifted" => "Varför det kan hävas";
  /// HoldReviewPane · placeholder text inside an empty field · at most ~45 characters
  /// shown through Field.placeholder
  /// beside: "Cancel"
  /// also in LegalHoldsEditor
  placeholder "Settled out of court on 3 March." => "Förlikning utanför domstol den 3 mars.";
  /// HoldReviewPane · a subtitle
  /// shown through Dialog.subtitle
  /// also in LegalHoldsEditor
  subtitle "A second person confirms the lift. Until then it stays in force." => "En andra person bekräftar hävningen. Till dess fortsätter det att gälla.";
  /// HoldReviewPane · a subtitle
  /// shown through Dialog.subtitle
  /// also in LegalHoldsEditor
  subtitle "Erasures that waited on it run, and anything past its period is purged at the next run." => "Raderingar som väntade på det körs, och allt som passerat sin lagringstid rensas vid nästa körning.";
  /// HoldReviewPane · a subtitle
  /// shown through Dialog.subtitle
  subtitle "It stays in force; this review closes, and a new one opens on the date you pick." => "Det fortsätter att gälla; den här granskningen stängs och en ny öppnas det datum du väljer.";
  /// HoldReviewPane · text on the page
  /// placeholders: {facts.On} = facts.On
  text "A legal hold on {facts.On}" => "Ett rättsligt bevarande av {facts.On}";
  /// HoldReviewPane · text on the page
  /// placeholders: {ToString} = next.Value.ToString(…)
  /// shown through done
  text "Kept. Somebody looks at it again on {ToString}." => "Behållet. Någon granskar det igen den {ToString}.";
  /// HoldReviewPane · text on the page
  /// shown through done
  /// also in LegalHoldsEditor
  text "Lifted. What waited on it — an erasure, a purge — runs now." => "Hävt. Det som väntade på det, en radering eller en rensning, körs nu.";
  /// HoldReviewPane · text on the page
  /// beside: "Why it is kept"
  text "Matter" => "Ärende";
  /// HoldReviewPane · text on the page
  /// shown through problem
  /// also in LegalHoldsEditor
  text "Pick the next review date." => "Välj nästa granskningsdatum.";
  /// HoldReviewPane · text on the page
  /// placeholders: {facts.PlacedBy} = facts.PlacedBy, {ToString} = facts.PlacedAt.ToString(…)
  /// beside: "Matter", "Why it is kept"
  text "Placed by {facts.PlacedBy} on {ToString}." => "Beslutat av {facts.PlacedBy} den {ToString}.";
  /// HoldReviewPane · text on the page
  text "Settled — this review is closed." => "Avgjort. Granskningen är stängd.";
  /// HoldReviewPane · text on the page
  /// shown through done
  text "The lift waits for a second person to confirm it on the legal holds page — the hold stays in force until then." => "Hävningen väntar på att en andra person bekräftar den på sidan för rättsligt bevarande. Bevarandet gäller till dess.";
  /// HoldReviewPane · text on the page
  /// beside: "Matter"
  text "Why it is kept" => "Varför det sparas";
  /// HoldReviewPane · text on the page
  /// placeholders: {value} = …
  text "{value}. While it stands nothing it covers is erased or purged — keep it only as long as the matter needs it." => "{value}. Så länge det gäller raderas eller rensas inget som det omfattar. Behåll det bara så länge ärendet kräver det.";
  /// HoldReviewPane · a title
  /// shown through Dialog.title
  title "Keep the hold" => "Behåll bevarandet";
  /// HoldReviewPane · a title
  /// placeholders: {facts.On} = facts.On
  /// shown through Dialog.title
  title "Lift the hold on {facts.On}" => "Häv bevarandet av {facts.On}";

  // ── Osysharp.Privacy · KeepOnCompellingGrounds ──
  /// KeepOnCompellingGrounds · an error message
  /// placeholders: {line.Category} = line.Category (string)
  /// shown through ValidationException
  error "'{line.Category}' is not held on a legitimate interest, so there are no grounds to weigh." => "'{line.Category}' sparas inte med stöd av berättigat intresse, så det finns inga skäl att väga.";
  /// KeepOnCompellingGrounds · an error message
  /// shown through ValidationException
  error "Keeping data a person asked to have erased needs the compelling grounds written down — they are told to the person." => "Att spara uppgifter som en person har bett om att få raderade kräver att de tvingande skälen skrivs ned. De meddelas personen.";
  /// KeepOnCompellingGrounds · an error message
  /// shown through ValidationException
  error "Only a plan waiting for approval can be changed." => "Bara en plan som väntar på godkännande kan ändras.";

  // ── Osysharp.Privacy · LegalHoldsEditor ──
  /// LegalHoldsEditor · a button's label · at most ~33 characters
  /// shown through Button.label
  button "Change the review date…" => "Ändra granskningsdatum…";
  /// LegalHoldsEditor · a button's label · at most ~23 characters
  /// shown through Button.label
  button "Confirm the lift" => "Bekräfta hävningen";
  /// LegalHoldsEditor · a button's label · at most ~37 characters
  /// placeholders: {r.On} = r.On
  /// shown through Button.announceAs
  button "Confirm the lift on {r.On}" => "Bekräfta hävningen för {r.On}";
  /// LegalHoldsEditor · a button's label · at most ~18 characters
  /// shown through Button.label
  button "Keep holding" => "Fortsätt bevara";
  /// LegalHoldsEditor · a button's label · at most ~27 characters
  /// placeholders: {r.On} = r.On
  /// shown through Button.announceAs
  button "Keep holding {r.On}" => "Fortsätt bevara {r.On}";
  /// LegalHoldsEditor · a button's label · at most ~33 characters
  /// shown through Button.label
  button "Keep, and review again…" => "Behåll och granska igen…";
  /// LegalHoldsEditor · a button's label · at most ~33 characters
  /// placeholders: {r.On} = r.On
  /// shown through Button.announceAs
  button "Lift the hold on {r.On}" => "Häv bevarandet av {r.On}";
  /// LegalHoldsEditor · a button's label · at most ~11 characters
  /// shown through Button.label
  button "Lift…" => "Häv…";
  /// LegalHoldsEditor · a button's label · at most ~18 characters
  /// shown through Button.label
  button "Place a hold" => "Besluta bevarande";
  /// LegalHoldsEditor · a button's label · at most ~35 characters
  /// placeholders: {r.On} = r.On
  /// shown through Button.announceAs
  button "Review the hold on {r.On}" => "Granska bevarandet av {r.On}";
  /// LegalHoldsEditor · a description
  /// shown through SettingsPage.description
  description "A hold keeps everything about a person — or one case — from being erased or purged while a dispute, a claim or an audit needs it. A request to erase it waits, and the person is told only that it is kept for legal claims." => "Ett bevarande hindrar att allt om en person, eller ett enskilt ärende, raderas eller rensas medan en tvist, ett anspråk eller en revision kräver det. En begäran om radering får vänta, och personen får bara veta att uppgifterna sparas för rättsliga anspråk.";
  /// LegalHoldsEditor · a description
  /// shown through SettingsSection.description
  description "Kept as a record — who lifted each hold, when and why — then forgotten after the period the kit's own records are kept." => "Sparas som en post, vem som hävde varje bevarande, när och varför, och glöms sedan efter den tid som kitets egna poster sparas.";
  /// LegalHoldsEditor · a hint under a field
  /// shown through Field.hint
  /// beside: "Their email address", "Why it must be kept", "Review by", "Cancel"
  hint "Never shown to the person." => "Visas aldrig för personen.";
  /// LegalHoldsEditor · a label (a field, a list item, a menu entry) · at most ~23 characters
  /// shown through Badge.label
  label "No second person" => "Ingen andra person";
  /// LegalHoldsEditor · a label (a field, a list item, a menu entry) · at most ~31 characters
  /// shown through Badge.label
  label "Second person required" => "Andra person krävs";
  /// LegalHoldsEditor · a label (a field, a list item, a menu entry) · at most ~27 characters
  /// shown through Field.label
  /// beside: "Matter", "Why it must be kept", "Review by", "Cancel"
  label "Their email address" => "Personens e-postadress";
  /// LegalHoldsEditor · message
  /// shown through Alert.message
  message "Pick the date the hold is reviewed — a hold is never kept for ever unseen." => "Välj datum då bevarandet granskas. Ett bevarande sparas aldrig för alltid utan granskning.";
  /// LegalHoldsEditor · placeholder text inside an empty field · at most ~37 characters
  /// shown through Field.placeholder
  /// beside: "Their email address", "Why it must be kept", "Review by", "Cancel"
  placeholder "Dispute with Acme AB, 2026" => "Tvist med Acme AB, 2026";
  /// LegalHoldsEditor · placeholder text inside an empty field · at most ~42 characters
  /// shown through Field.placeholder
  /// beside: "Their email address", "Matter", "Review by", "Cancel"
  placeholder "The complaint may go to court." => "Klagomålet kan gå till domstol.";
  /// LegalHoldsEditor · placeholder text inside an empty field · at most ~21 characters
  /// shown through Field.placeholder
  /// beside: "Matter", "Why it must be kept", "Review by", "Cancel"
  placeholder "ann@example.com" => "anna@example.com";
  /// LegalHoldsEditor · a subtitle
  /// shown through Dialog.subtitle
  subtitle "Everything held about this person is kept — not erased on request, not purged — until the hold is lifted." => "Allt som sparas om den här personen behålls, raderas inte på begäran och rensas inte, förrän bevarandet hävs.";
  /// LegalHoldsEditor · a subtitle
  /// shown through Dialog.subtitle
  subtitle "It stays in force; somebody looks at it again on the date you pick." => "Det fortsätter att gälla; någon granskar det igen det datum du väljer.";
  /// LegalHoldsEditor · text on the page
  /// placeholders: {ToString} = r.LiftedAt.Value.ToString(…)
  text " on {ToString}" => " den {ToString}";
  /// LegalHoldsEditor · text on the page
  /// placeholders: {ToLower} = ….ToLower(…)
  /// shown through done
  text "Holding everything about {ToLower}. Nothing about them is erased or purged until the hold is lifted." => "Bevarar allt om {ToLower}. Inget om personen raderas eller rensas förrän bevarandet hävs.";
  /// LegalHoldsEditor · text on the page
  /// placeholders: {ToString} = nextReview.Value.ToString(…)
  /// shown through done
  text "Kept, and reviewed again on {ToString}." => "Behållet, och granskas igen den {ToString}.";
  /// LegalHoldsEditor · text on the page
  /// placeholders: {r.LiftedBy} = r.LiftedBy, {value} = …, {r.LiftReason} = r.LiftReason
  text "Lifted by {r.LiftedBy}{value}: “{r.LiftReason}”" => "Hävt av {r.LiftedBy}{value}: ”{r.LiftReason}”";
  /// LegalHoldsEditor · text on the page
  /// shown through done
  text "Lifted. What waited on it runs now." => "Hävt. Det som väntade på det körs nu.";
  /// LegalHoldsEditor · text on the page
  /// shown through EmptyState.body
  text "Nothing is held now. When a dispute, a claim or an audit needs a person's data kept, place a hold here — or on a case from its own page." => "Inget bevaras nu. När en tvist, ett anspråk eller en revision kräver att en persons uppgifter sparas, besluta om bevarande här, eller på ett ärende från dess egen sida.";
  /// LegalHoldsEditor · text on the page
  /// placeholders: {r.PlacedBy} = r.PlacedBy, {ToString} = r.PlacedAt.ToString(…), {ToString2} = r.ReviewBy.ToString(…)
  text "Placed by {r.PlacedBy} on {ToString} · review by {ToString2}" => "Beslutat av {r.PlacedBy} den {ToString} · granskas senast {ToString2}";
  /// LegalHoldsEditor · text on the page
  /// shown through done
  text "The lift waits for a second person to confirm it — the hold stays in force until then." => "Hävningen väntar på att en andra person bekräftar den. Bevarandet gäller till dess.";
  /// LegalHoldsEditor · text on the page
  /// shown through done
  text "The lift was withdrawn — the hold stays in force." => "Hävningen drogs tillbaka. Bevarandet fortsätter att gälla.";
  /// LegalHoldsEditor · text on the page
  /// placeholders: {r.LiftRequestedBy} = r.LiftRequestedBy, {r.LiftReason} = r.LiftReason
  text "{r.LiftRequestedBy} asked to lift it: “{r.LiftReason}”" => "{r.LiftRequestedBy} har begärt hävning: ”{r.LiftReason}”";
  /// LegalHoldsEditor · a title
  /// shown through SettingsPage.title
  /// also in LegalHoldsSettings /settings/privacy/holds
  title "Legal holds" => "Rättsligt bevarande";
  /// LegalHoldsEditor · a title
  /// placeholders: {liftOn} = liftOn
  /// shown through Dialog.title
  title "Lift the hold on {liftOn}" => "Häv bevarandet av {liftOn}";
  /// LegalHoldsEditor · a title
  /// shown through SettingsSection.title
  title "Lifted" => "Hävda";
  /// LegalHoldsEditor · a title
  /// shown through SettingsSection.title
  /// beside: "Place a hold"
  title "Lifting a hold" => "Att häva ett bevarande";
  /// LegalHoldsEditor · a title
  /// shown through EmptyState.title
  title "No legal holds in force" => "Inga rättsliga bevaranden gäller";
  /// LegalHoldsEditor · a title
  /// shown through Dialog.title
  title "Place a legal hold" => "Besluta rättsligt bevarande";
  /// LegalHoldsEditor · a title
  /// shown through Dialog.title
  title "Review the hold" => "Granska bevarandet";

  // ── Osysharp.Privacy · MyPrivacy ──
  /// MyPrivacy · a control's name for screen readers
  /// beside: "Your privacy", "Your requests", "What we keep"
  accessibleName "Ask us" => "Fråga oss";
  /// MyPrivacy · a control's name for screen readers
  /// beside: "Your privacy", "Ask us", "Your requests"
  accessibleName "What we keep" => "Vad vi sparar";
  /// MyPrivacy · a button's label · at most ~27 characters
  /// shown through AskChoice.title
  /// beside: "Move your data", "Erase your data", "Stop using your data"
  /// also in AskWithoutAnAccount
  button "A copy of your data" => "En kopia av dina uppgifter";
  /// MyPrivacy · a button's label · at most ~26 characters
  /// shown through Button.label
  /// beside: "Once, within seven days of the answer."
  /// also in ExportByLinkPage /privacy/export/{link}
  button "Download your data" => "Ladda ner dina uppgifter";
  /// MyPrivacy · a button's label · at most ~47 characters
  /// placeholders: {r.Title} = r.Title
  /// shown through Button.announceAs
  /// beside: "Once, within seven days of the answer."
  button "Download your data from {r.Title}" => "Ladda ner dina uppgifter från {r.Title}";
  /// MyPrivacy · a button's label · at most ~21 characters
  /// shown through AskChoice.title
  /// beside: "A copy of your data", "Move your data", "Stop using your data"
  /// also in AskWithoutAnAccount
  button "Erase your data" => "Radera dina uppgifter";
  /// MyPrivacy · a button's label · at most ~20 characters
  /// shown through AskChoice.title
  /// beside: "A copy of your data", "Erase your data", "Stop using your data"
  button "Move your data" => "Flytta uppgifter";
  /// MyPrivacy · a button's label · at most ~20 characters
  /// shown through Button.label
  /// beside: "Cancel"
  /// also in AskWithoutAnAccount
  button "Send me a code" => "Skicka mig en kod";
  /// MyPrivacy · a button's label · at most ~23 characters
  /// shown through Button.label
  /// beside: "Cancel"
  /// also in AskWithoutAnAccount
  button "Send the request" => "Skicka förfrågan";
  /// MyPrivacy · a button's label · at most ~28 characters
  /// shown through AskChoice.title
  /// beside: "A copy of your data", "Move your data", "Erase your data"
  button "Stop using your data" => "Sluta använda mina uppgifter";
  /// MyPrivacy · a subtitle
  /// placeholders: {ToString} = r.AnswerBy.Value.ToString(…)
  /// shown through Card.subtitle
  subtitle " · we answer by {ToString}" => " · vi svarar senast {ToString}";
  /// MyPrivacy · a subtitle
  /// shown through Card.subtitle
  subtitle "Before anything happens, this is what your request does to each kind of data we hold." => "Innan något händer: så här påverkar din förfrågan varje typ av uppgifter vi har.";
  /// MyPrivacy · a subtitle
  /// placeholders: {ToString} = r.ReceivedAt.ToString(…), {value} = …
  /// shown through Card.subtitle
  subtitle "Received {ToString}{value}" => "Mottagen {ToString}{value}";
  /// MyPrivacy · a subtitle
  /// shown through PageHead.subtitle
  /// beside: "Ask us", "Your requests", "What we keep"
  subtitle "What we keep about you, why, and for how long — and how to ask for a copy, or to have it erased." => "Vad vi sparar om dig, varför och hur länge, och hur du ber om en kopia eller om att få det raderat.";
  /// MyPrivacy · text on the page
  /// shown through SectionLabel.text
  text "Ask us" => "Fråga oss";
  /// MyPrivacy · text on the page
  /// shown through AskChoice.body
  /// beside: "Move your data", "Erase your data", "Stop using your data"
  /// also in AskWithoutAnAccount
  text "Everything we hold about you, and why we keep it." => "Allt vi har om dig, och varför vi sparar det.";
  /// MyPrivacy · text on the page
  /// beside: "Download your data"
  text "Once, within seven days of the answer." => "En gång, inom sju dagar från svaret.";
  /// MyPrivacy · text on the page
  /// beside: "Cancel"
  text "To be sure it is you, we mail a code to the address on your account." => "För att vara säkra på att det är du mejlar vi en kod till adressen på ditt konto.";
  /// MyPrivacy · text on the page
  /// shown through askProblem
  /// also in AskWithoutAnAccount
  text "Type the code from the mail." => "Skriv in koden från mejlet.";
  /// MyPrivacy · text on the page
  /// shown through AskChoice.body
  /// beside: "A copy of your data", "Move your data", "Stop using your data"
  /// also in AskWithoutAnAccount
  text "We erase what we may, and tell you what the law makes us keep." => "Vi raderar det vi får och berättar vad lagen kräver att vi sparar.";
  /// MyPrivacy · text on the page
  /// shown through AskChoice.body
  /// beside: "A copy of your data", "Move your data", "Erase your data"
  text "We keep it, but use it for nothing until you say so." => "Vi sparar dem, men använder dem inte till något förrän du säger till.";
  /// MyPrivacy · text on the page
  /// placeholders: {sentTo} = sentTo
  /// beside: "240px", "Cancel"
  text "We sent a code to {sentTo}. It works for fifteen minutes." => "Vi har skickat en kod till {sentTo}. Den gäller i femton minuter.";
  /// MyPrivacy · text on the page
  /// shown through SectionLabel.text
  /// beside: "Beside each kind, how much of it we hold about you right now. Only how many — what they say is in a copy of your data."
  text "What we keep about people, and why" => "Vad vi sparar om personer, och varför";
  /// MyPrivacy · text on the page
  /// shown through AskChoice.body
  /// beside: "A copy of your data", "Erase your data", "Stop using your data"
  text "What you gave us, in a file another service can read." => "Det du gett oss, i en fil som en annan tjänst kan läsa.";
  /// MyPrivacy · text on the page
  /// shown through EmptyState.body
  text "When you ask us for a copy of your data, or to erase it, it shows here until it is answered — and after." => "När du ber oss om en kopia av dina uppgifter, eller om att radera dem, visas det här tills det är besvarat, och även efteråt.";
  /// MyPrivacy · text on the page
  /// shown through done
  text "Your request is in. We answer within one month — by mail to the address you just confirmed, and here." => "Din förfrågan är mottagen. Vi svarar inom en månad, via e-post till adressen du just bekräftade, och här.";
  /// MyPrivacy · a title
  /// shown through EmptyState.title
  title "No requests yet" => "Inga förfrågningar än";
  /// MyPrivacy · a title
  /// shown through Card.title
  title "What this will do" => "Vad det här gör";

  // ── Osysharp.Privacy · MyRequestRows ──
