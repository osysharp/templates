  /// KnowledgeReviewQueue · a subtitle
  /// shown through PageHead.subtitle
  /// beside: "‹ Knowledge base"
  subtitle "A reviewer who did not write a version publishes it, or sends it back saying what to change." => "ينشر النسخة مراجع لم يكتبها، أو يعيدها مع ذكر ما يجب تغييره.";
  /// KnowledgeReviewQueue · text on the page
  /// shown through EmptyState.body
  text "Versions sent for review appear here, the longest-waiting first." => "تظهر هنا النسخ المرسلة للمراجعة، الأطول انتظارًا أولًا.";
  /// KnowledgeReviewQueue · a title
  /// shown through EmptyState.title
  title "Nothing is waiting" => "لا شيء بانتظار";

