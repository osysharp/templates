  /// KnowledgeResultsPage · text on the page
  /// shown through KnowledgeHero.question
  /// beside: "880px"
  text "Search the help centre" => "ابحث في مركز المساعدة";
  /// KnowledgeResultsPage · text on the page
  /// shown through EmptyState.body
  text "Try fewer words, or other words for the same thing — or ask us, and a person answers." => "جرّب كلمات أقل أو كلمات أخرى للمعنى نفسه — أو اسألنا وسيجيبك شخص.";
  /// KnowledgeResultsPage · text on the page
