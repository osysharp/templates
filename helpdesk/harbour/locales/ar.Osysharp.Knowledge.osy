  // ── Osysharp.KnowledgeBase · AddKnowledgeCategory ──
  /// AddKnowledgeCategory · an error message
  /// shown through ValidationException
  /// also in EditKnowledgeCategory
  error "Give the category a name." => "أعطِ الفئة اسمًا.";

  // ── Osysharp.KnowledgeBase · AddKnowledgeSection ──
  /// AddKnowledgeSection · an error message
