  error "That rule is no longer one of the app's." => "Den regeln hör inte längre till appen.";

  // ── Osysharp.Automations · FireSentence ──
  /// FireSentence · text on the page
  /// placeholders: {fire.RanAs} = fire.RanAs (string)
