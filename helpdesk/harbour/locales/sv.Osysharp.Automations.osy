// sv (Svenska): the words of Helpdesk · Osysharp.Automations, translated.
// Written and kept in step with the source by `osy translate`: a new text arrives as `=> null`, a text
// whose source changed keeps its old translation in a `was` clause. The words are yours to edit.
// Source language: en.

translations sv {
  // ── Osysharp.Automations · AutomationRules ──
  /// AutomationRules · a control's name for screen readers
  /// beside: "Name", "When", "Then", "Off — keep it, but do not run it"
  accessibleName "Only if" => "Bara om";
  /// AutomationRules · a control's name for screen readers
  /// beside: "Add a rule"
  accessibleName "Rules" => "Regler";
  /// AutomationRules · a control's name for screen readers
  /// beside: "Name", "When", "Only if", "Off — keep it, but do not run it"
  accessibleName "Then" => "Då";
  /// AutomationRules · a control's name for screen readers
  accessibleName "What ran lately" => "Nyligen körda";
  /// AutomationRules · a button's label · at most ~21 characters
  /// shown through Button.label
  button "Add a condition" => "Lägg till villkor";
  /// AutomationRules · a button's label · at most ~24 characters
  /// shown through Button.label
  /// beside: "Cancel"
  button "Add the condition" => "Lägg till villkoret";
  /// AutomationRules · a button's label · at most ~18 characters
  /// shown through Button.label
  /// beside: "Cancel"
  button "Add the step" => "Lägg till steget";
  /// AutomationRules · a button's label · at most ~12 characters
  /// shown through Button.label
  button "Choose" => "Välj";
  /// AutomationRules · a button's label · at most ~21 characters
  /// shown through Button.label
  button "Remove the rule" => "Ta bort regeln";
  /// AutomationRules · a button's label · at most ~20 characters
  /// placeholders: {value} = …
  /// shown through IconButton.label
  button "Remove {value}" => "Ta bort {value}";
  /// AutomationRules · a button's label · at most ~31 characters
  /// shown through Button.label
  button "Restore the app's rule" => "Återställ appens regel";
  /// AutomationRules · a description
  /// placeholders: {noun} = noun
  /// shown through SettingsSection.description
  /// beside: "Rules, in the order they run"
  description "Every run is also on its {noun}'s own history." => "Varje körning finns också i historiken för {noun}.";
  /// AutomationRules · a description
  /// placeholders: {noun} = noun, {noun2} = noun
  /// shown through SettingsPage.description
  description "Rules that do the routine work on each {noun} when something happens — run in order, each run written on the {noun2}. The app's own rules keep its updates; copy one to change it for the team, or for yours." => "Regler som gör rutinarbetet på varje {noun} när något händer. De körs i ordning, och varje körning skrivs på {noun2}. Appens egna regler får appens uppdateringar; kopiera en för att ändra den för teamet, eller för din egen del.";
  /// AutomationRules · a label (a field, a list item, a menu entry) · at most ~10 characters
  /// shown through Dropdown.label
  /// beside: "Add the condition"
  label "Asks" => "Frågar";
  /// AutomationRules · a label (a field, a list item, a menu entry) · at most ~14 characters
  /// shown through Dropdown.label
  label "Compared" => "Jämförelse";
  /// AutomationRules · a label (a field, a list item, a menu entry) · at most ~10 characters
  /// shown through Dropdown.label
  /// beside: "Choose", "Add the step"
  label "Does" => "Gör";
  /// AutomationRules · a label (a field, a list item, a menu entry) · at most ~45 characters
  /// shown through Switch.label
  /// beside: "Name", "When", "Only if", "Then"
  label "Off — keep it, but do not run it" => "Av: behåll den, men kör den inte";
  /// AutomationRules · a label (a field, a list item, a menu entry) · at most ~59 characters
  /// placeholders: {noun} = noun
  /// shown through Checkbox.label
  label "The whole team's — it runs on every {noun}" => "Hela teamets: den körs på varje {noun}";
  /// AutomationRules · placeholder text inside an empty field · at most ~13 characters
  /// shown through Dropdown.placeholder
  /// beside: "Add the condition"
  placeholder "Choose…" => "Välj…";
  /// AutomationRules · placeholder text inside an empty field · at most ~44 characters
  /// shown through Field.placeholder
  /// beside: "When", "Only if", "Then", "Off — keep it, but do not run it"
  placeholder "Urgent words raise the priority" => "Brådskande ord höjer prioriteten";
  /// AutomationRules · a subtitle
  /// shown through Dialog.subtitle
  subtitle "A copy of one of the app's rules — it replaces the app's while it exists. Remove it to restore the app's." => "En kopia av en av appens regler. Den ersätter appens regel så länge den finns. Ta bort den för att återställa appens.";
  /// AutomationRules · text on the page
  /// shown through EmptyState.body
  text "Add one for the work that always follows the same event — tag it, set it, tell somebody." => "Lägg till en för arbetet som alltid följer samma händelse: tagga, ändra något, meddela någon.";
  /// AutomationRules · text on the page
  /// placeholders: {noun} = noun
  text "Always — on every {noun} it happens to." => "Alltid: på varje {noun} som det händer.";
  /// AutomationRules · text on the page
  /// shown through problem
  text "Choose what it asks." => "Välj vad den frågar.";
  /// AutomationRules · text on the page
  /// shown through problem
  text "Choose what it does." => "Välj vad den gör.";
  /// AutomationRules · text on the page
  /// shown through notice
  text "Copied for the team — change it here; the app's rule waits until you restore it." => "Kopierad för teamet. Ändra den här; appens regel väntar tills du återställer den.";
  /// AutomationRules · text on the page
  /// shown through notice
  text "Copied for you — it replaces the app's rule on yours." => "Kopierad för dig. Den ersätter appens regel för din del.";
  /// AutomationRules · text on the page
  /// shown through TriggerLabel()
  text "Every hour, while it holds" => "Varje timme, så länge det gäller";
  /// AutomationRules · text on the page
  /// shown through notice
  text "Locked — nobody's copy replaces it." => "Låst. Ingens kopia ersätter den.";
  /// AutomationRules · text on the page
  text "Nothing yet — add what it does." => "Inget än. Lägg till vad den gör.";
  /// AutomationRules · text on the page
  /// shown through FieldLabel.text
  text "Only if — all of these hold" => "Bara om: alla dessa gäller";
  /// AutomationRules · text on the page
  text "Open" => "Öppna";
  /// AutomationRules · text on the page
  /// shown through notice
  text "Restored the app's rule." => "Appens regel är återställd.";
  /// AutomationRules · text on the page
  /// shown through FieldLabel.text
  text "Then — in order" => "Då, i ordning";
  /// AutomationRules · text on the page
  /// shown through notice
  text "Unlocked." => "Upplåst.";
  /// AutomationRules · text on the page
  /// placeholders: {noun} = noun
  /// shown through EmptyState.body
  text "When a rule runs on a {noun}, it is listed here — what it did, or why it stopped." => "När en regel körs på {noun} visas den här: vad den gjorde, eller varför den stoppades.";
  /// AutomationRules · text on the page
  /// shown through noun
  text "record" => "post";
  /// AutomationRules · a title
  /// shown through Dialog.title
  title "New rule" => "Ny regel";
  /// AutomationRules · a title
  /// shown through EmptyState.title
  title "No rules yet" => "Inga regler än";
  /// AutomationRules · a title
  /// shown through EmptyState.title
  title "Nothing has run yet" => "Inget har körts än";
  /// AutomationRules · a title
  /// shown through SettingsSection.title
  /// beside: "What ran lately"
  title "Rules, in the order they run" => "Regler, i den ordning de körs";
  /// AutomationRules · a title
  /// shown through SettingsSection.title
  /// beside: "Rules, in the order they run"
  title "What ran lately" => "Nyligen körda";

