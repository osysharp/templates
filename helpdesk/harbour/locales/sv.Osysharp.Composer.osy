  /// SendFromComposer · text on the page
  /// shown through Said
  text "Note added." => "Anteckningen är tillagd.";
  /// SendFromComposer · text on the page
  /// shown through Said
  text "Sent." => "Skickat.";

  // ── Osysharp.Composer · TakePreparedDraft ──
  /// TakePreparedDraft · an error message
  /// shown through ValidationException
  error "That prepared draft is gone — somebody else took it." => "Det förberedda utkastet finns inte längre. Någon annan tog det.";

  // ── Osysharp.Composer · TargetFor ──
  /// TargetFor · an error message
  /// placeholders: {kind} = kind (string), {Join} = string.Join(…) (string)
  /// shown through ValidationException
  error "No composer is set up for '{kind}'. The kinds are: {Join}." => "Ingen skrivruta är konfigurerad för '{kind}'. Typerna är: {Join}.";
}
