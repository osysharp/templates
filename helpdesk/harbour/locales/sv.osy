// sv (Svenska): the words of Helpdesk, translated.
// Written and kept in step with the source by `osy translate`: a new text arrives as `=> null`, a text
// whose source changed keeps its old translation in a `was` clause. The words are yours to edit.
// Source language: en.

translations sv {
  // ── (every entity) ──
  /// (every entity) · a label (a field, a list item, a menu entry) · at most ~16 characters
  /// shown through the time a record was created or last changed
  /// beside: "Modified at"
  label "Created at" => "Skapad";
  /// (every entity) · a label (a field, a list item, a menu entry) · at most ~17 characters
  /// shown through the time a record was created or last changed
  /// beside: "Created at"
  label "Modified at" => "Ändrad";

  // ── AccessSettings (/settings/access) ──
  /// AccessSettings · /settings/access · a description
  /// shown through SettingsPage.description
  /// also in AccessSettings /settings/access
  description "Every change to somebody's access — a role, an account switched off, a lost phone, a sign-out — with who made it and why. Nobody edits or deletes these." => "Varje ändring av någons behörighet, som en roll, ett avstängt konto, en tappad telefon eller en utloggning, med vem som gjorde den och varför. Ingen kan redigera eller radera dessa.";
  /// AccessSettings · /settings/access · a title
  /// shown through SettingsPage.title
  /// also in AccessSettings /settings/access
  title "Access changes" => "Behörighetsändringar";

  // ── AccessTrailList ──
  /// AccessTrailList · a title
  /// shown through EmptyState.title
  /// also in AuditList
  title "No changes yet" => "Inga ändringar än";

  // ── AddCc ──
  /// AddCc · an error message
  /// placeholders: {t.Number} = t.Number (int)
  /// shown through ValidationException
  error "#{t.Number} is closed — nothing more is sent on it." => "#{t.Number} är stängt, inget mer skickas i det.";
  /// AddCc · an error message
  /// placeholders: {t.Number} = t.Number (int)
  /// shown through ValidationException
  error "#{t.Number} is kept out of use — nobody is added to it." => "#{t.Number} är spärrat från användning, ingen läggs till.";

  // ── Agent ──
  /// Agent · a label (a field, a list item, a menu entry) · at most ~15 characters
  /// shown through Agent.Signature
  label "Signature" => "Signatur";

  // ── ApiSetStatus ──
  /// ApiSetStatus · an error message
  /// shown through ValidationException
  error "That is not one of the desk's statuses — GET /statuses lists them." => "Det är inte en av supportens statusar. GET /statuses listar dem.";

  // ── ApiTag ──
  /// ApiTag · an error message
  /// shown through ValidationException
  error "Give the tag — a word or two, like billing." => "Ange taggen, ett eller två ord, till exempel billing.";

  // ── AskWithoutAnAccount ──
  /// AskWithoutAnAccount · a title
  /// shown through PageHead.title
  /// also in AskWithoutAnAccountPage /privacy/ask
  title "Ask about your data" => "Fråga om dina uppgifter";

  // ── AssignTicket ──
  /// AssignTicket · a label (a field, a list item, a menu entry) · at most ~14 characters
  /// shown through [Action] AssignTicket
  /// beside: "Assign to"
  label "Teammate" => "Kollega";

  // ── AuditArea ──
  /// AuditArea · a label (a field, a list item, a menu entry) · at most ~17 characters
  /// shown through AuditArea.Everything
  /// beside: "Access", "Desk settings"
  label "All changes" => "Alla ändringar";
  /// AuditArea · a label (a field, a list item, a menu entry) · at most ~19 characters
  /// shown through AuditArea.Settings
  /// beside: "All changes", "Access"
  label "Desk settings" => "Deskens inställningar";

  // ── AuditList ──
  /// AuditList · a control's name for screen readers
  accessibleName "Changes" => "Ändringar";
  /// AuditList · text on the page
  text "1 change" => "1 ändring";
  /// AuditList · text on the page
  /// shown through EmptyState.body
  text "Nobody made a change of this kind in this period. Try a longer period, or anyone." => "Ingen gjorde en sådan ändring under perioden. Prova en längre period, eller vem som helst.";
  /// AuditList · text on the page
  /// placeholders: {AuditTake} = AuditTake(…) (int) — {AuditTake} is a count: give one text per plural form
  text "The newest {AuditTake} — narrow the period to see further back" => "De {AuditTake} senaste — välj en kortare period för att se längre bakåt";
  /// AuditList · text on the page
  /// shown through EmptyState.body
  text "When somebody changes the desk's settings or somebody's access, it is listed here — what, who and when." => "När någon ändrar deskens inställningar eller någons behörighet visas det här — vad, vem och när.";
  /// AuditList · text on the page
  /// placeholders: {value} = … (string), {value2} = … (string)
  text "by {value}{value2}" => "av {value}{value2}";
  /// AuditList · text on the page
  text "somebody no longer named" => "någon som inte längre har ett namn här";
  /// AuditList · text on the page
  /// placeholders: {shown.Count} = shown.Count (int) — {shown.Count} is a count: give one text per plural form
  text "{shown.Count} changes" => "{shown.Count} ändringar";

  // ── AuditLog ──
  /// AuditLog · text on the page
  /// placeholders: {value} = … (string)
  /// shown through AuditLine.Detail
  text "Refused: {value}" => "Avvisad: {value}";

  // ── AuditPeriod ──
