  /// shown through Button.label
  button "Side conversation" => "Sidokonversation";
  /// TicketView · a button's label · at most ~24 characters
  /// placeholders: {value} = … (int) — {value} is a count: give one text per plural form
  /// shown through Button.label
  /// beside: "Cancel"
  button "Solve all {value}" => { one: "Lös {value}", other: "Lös alla {value}" };
  /// TicketView · a button's label · at most ~33 characters
  /// shown through ConversationThread.splitLabel
  button "Split into a new ticket" => "Dela av till ett nytt ärende";
  /// TicketView · a button's label · at most ~18 characters
  /// shown through Button.label
  /// beside: "Cancel"
  button "Split it off" => "Dela av";
  /// TicketView · an error message
  /// shown through Field.error
  /// beside: "Cancel"
  /// also in SplitTicket
  error "Give the new ticket a subject: one line saying what this part is about." => "Ge det nya ärendet ett ämne: en rad om vad den här delen handlar om.";
  /// TicketView · a hint under a field
  /// shown through TextAreaField.hint
  /// beside: "Cancel"
  hint "Each incident's customer is mailed that their request is solved, with this, and asked how we did. Leave it empty to say only that it is solved." => "Varje incidents kund får ett mejl om att ärendet är löst, med den här texten, och tillfrågas hur det gick. Lämna tomt för att bara säga att det är löst.";
  /// TicketView · a label (a field, a list item, a menu entry) · at most ~24 characters
  /// shown through TextAreaField.label
  /// beside: "Cancel"
  label "How it was solved" => "Hur det löstes";
  /// TicketView · a label (a field, a list item, a menu entry) · at most ~11 characters
  /// shown through HeadChip.label
  /// beside: "Fields", "Queue", "Seen before"
  label "Links" => "Länkar";
  /// TicketView · a label (a field, a list item, a menu entry) · at most ~17 characters
  /// shown through HeadChip.label
  /// beside: "Fields", "Queue", "Links"
  label "Seen before" => "Sett förut";
  /// TicketView · a label (a field, a list item, a menu entry) · at most ~35 characters
  /// shown through Field.label
  /// beside: "Cancel"
  label "Subject of the new ticket" => "Ämne för det nya ärendet";
  /// TicketView · placeholder text inside an empty field · at most ~55 characters
  /// shown through Field.placeholder
  /// beside: "Cancel"
  placeholder "One line saying what this part is about" => "En rad om vad den här delen handlar om";
  /// TicketView · a subtitle
  /// shown through Dialog.subtitle
  subtitle "Each incident still open is solved with it, and its timeline says which problem solved it." => "Varje incident som fortfarande är öppen löses tillsammans med det, och dess tidslinje säger vilket problem som löste den.";
  /// TicketView · a subtitle
  /// shown through Dialog.subtitle
  subtitle "Mail somebody outside about this ticket — they read only what you write them, never the ticket — or start a thread inside the team. It sits on the ticket's timeline, and their answer lands there." => "Mejla någon utanför om det här ärendet. De läser bara det du skriver till dem, aldrig ärendet. Eller starta en tråd inom teamet. Den ligger på ärendets tidslinje, och svaret hamnar där.";
  /// TicketView · a subtitle
  /// shown through Dialog.subtitle
  subtitle "The message moves to a ticket of its own for the same customer, with its files. Their reply to it lands there, and both tickets stay linked." => "Meddelandet flyttas till ett eget ärende för samma kund, med sina filer. Kundens svar på det hamnar där, och båda ärendena förblir länkade.";
  /// TicketView · text on the page
  /// placeholders: {t.FollowUpOf.Number} = t.FollowUpOf.Number (int)
  text "Follows #{t.FollowUpOf.Number}, which was closed." => "Följer #{t.FollowUpOf.Number}, som stängdes.";
  /// TicketView · text on the page
  /// shown through queueName
  text "None" => "Inga";
  /// TicketView · text on the page
  text "Nothing more is sent on this ticket. If the customer writes to us again, that opens a new one." => "Inget mer skickas i det här ärendet. Om kunden skriver till oss igen öppnas ett nytt.";
  /// TicketView · a title
  /// placeholders: {t.Number} = t.Number (int)
  /// shown through ShellSheet.title
  title "Fields of #{t.Number}" => "Fält i #{t.Number}";
  /// TicketView · a title
  /// placeholders: {t.Number} = t.Number (int)
  /// shown through ShellSheet.title
  title "How #{t.Number} got here" => "Så hamnade #{t.Number} här";
  /// TicketView · a title
  /// placeholders: {t.Number} = t.Number (int)
  /// shown through ShellSheet.title
  title "Links of #{t.Number}" => "Länkar för #{t.Number}";
  /// TicketView · a title
  /// placeholders: {t.Number} = t.Number (int)
  /// shown through ShellSheet.title
  title "Seen before #{t.Number}" => "Sett förut #{t.Number}";
  /// TicketView · a title
