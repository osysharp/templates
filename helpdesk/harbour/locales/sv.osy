  /// TicketView · a title
  /// shown through Dialog.title
  title "Split into a new ticket" => "Dela av till ett nytt ärende";
  /// TicketView · a title
  /// shown through Dialog.title
  title "Start a side conversation" => "Starta en sidokonversation";

