  /// KeptConversation · text on the page
  text "This read is recorded, with your name." => "Den här läsningen registreras, med ditt namn.";
  /// KeptConversation · a title
  /// placeholders: {t.Number} = t.Number (int)
  /// shown through ShellSheet.title
  title "Kept conversation · #{t.Number}" => "Sparad konversation · #{t.Number}";

  // ── KeptCustomer ──
