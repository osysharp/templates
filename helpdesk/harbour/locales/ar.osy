  // ── DeskCopy.EventSentence ──
  /// DeskCopy.EventSentence · text on the page
  /// placeholders: {value} = … (int), {t.Was} = t.Was (string), {who} = who (string)
  /// shown through EventSentence()
  text "#{value} ({t.Was}) from {who} was merged into this ticket." => "دُمجت #{value} ({t.Was}) من {who} في هذه التذكرة.";
  /// DeskCopy.EventSentence · text on the page
  /// placeholders: {value} = … (int), {t.Was} = t.Was (string), {who} = who (string), {last} = last (string)
  /// shown through EventSentence()
  text "#{value} ({t.Was}) from {who} was merged into this ticket. Their last message: “{last}”" => "دُمجت #{value} ({t.Was}) من {who} في هذه التذكرة. آخر رسالة منه: «{last}»";
  /// DeskCopy.EventSentence · text on the page
  /// placeholders: {value} = … (int), {who} = who (string)
  /// shown through EventSentence()
  text "#{value} from {who} was merged into this ticket." => "دُمجت #{value} من {who} في هذه التذكرة.";
  /// DeskCopy.EventSentence · text on the page
  /// shown through EventSentence()
  text "A field was changed." => "تغيّر أحد الحقول.";
  /// DeskCopy.EventSentence · text on the page
  /// placeholders: {value} = … (int), {t.Name} = t.Name (string)
  /// shown through EventSentence()
  text "A message was split into #{value}: {t.Name}." => "فُصلت رسالة إلى #{value}: {t.Name}.";
  /// DeskCopy.EventSentence · text on the page
