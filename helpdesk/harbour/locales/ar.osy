  // ── PrivacyWords ──
  /// PrivacyWords · text on the page
  /// shown through PrivacyWords()
  text "A legal hold now keeps it, until the hold is lifted." => "يحفظها الآن تجميد قانوني، حتى يُرفع.";
  /// PrivacyWords · text on the page
  /// shown through PrivacyWords()
  text "Closed: the conversation was kept for legal claims, and was erased when its period ended." => "أُغلقت: كانت المحادثة محفوظة لأجل مطالبات قانونية، ومُحيت عند انتهاء مدتها.";
  /// PrivacyWords · text on the page
  /// shown through PrivacyWords()
  text "Closed: the customer asked to be erased, and this conversation concerns a claim, so it is kept for legal claims, out of use." => "أُغلقت: طلب العميل محو بياناته، وهذه المحادثة تخص مطالبة، لذا تُحفظ لأجل مطالبات قانونية خارج الاستخدام.";
  /// PrivacyWords · text on the page
  /// shown through PrivacyWords()
  text "Closed: the customer asked us to stop using their data, so this conversation is out of use until they say otherwise." => "أُغلقت: طلب العميل منا التوقف عن استخدام بياناته، لذا هذه المحادثة خارج الاستخدام حتى يقول غير ذلك.";
  /// PrivacyWords · text on the page
  /// shown through PrivacyWords()
  text "Closed: the customer's data in this conversation was erased at their request." => "أُغلقت: مُحيت بيانات العميل في هذه المحادثة بناءً على طلبه.";
  /// PrivacyWords · text on the page
  /// shown through PrivacyWords()
  text "The legal hold was lifted." => "رُفع التجميد القانوني.";
  /// PrivacyWords · text on the page
  /// placeholders: {until.Value} = until.Value (DateTime)
  /// shown through PrivacyWords()
  text "The legal hold was lifted: it is kept until {until.Value}, then erased." => "رُفع التجميد القانوني: تُحفظ حتى {until.Value}، ثم تُمحى.";

