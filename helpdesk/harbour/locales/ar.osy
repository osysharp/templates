  title "Search" => "ابحث";

  // ── HelpPage (/help) ──
  /// HelpPage · /help · a button's label · at most ~19 characters
  /// shown through Button.label
  button "Write another" => "كتابة طلب آخر";
  /// HelpPage · /help · a label (a field, a list item, a menu entry) · at most ~28 characters
  /// shown through Done.label
  label "We have your request" => "استلمنا طلبك";
  /// HelpPage · /help · text on the page
  /// beside: "We have your request", "Write another"
  text ", and you can follow it under Your requests." => "، ويمكنك متابعته من «طلباتك».";
  /// HelpPage · /help · text on the page
  /// placeholders: {sent} = sent (int)
  text "Open #{sent}" => "فتح #{sent}";
  /// HelpPage · /help · text on the page
  /// beside: "How can we help?"
  text "Tell us what happened. A person on the team answers, usually within a working day and sooner for anything urgent." => "أخبرنا بما حدث. سيرد عليك أحد أعضاء الفريق، عادةً خلال يوم عمل، وأسرع من ذلك في الأمور العاجلة.";
  /// HelpPage · /help · text on the page
  /// placeholders: {sent} = sent (int), {value} = … (string)
  /// beside: "We have your request", "Write another"
  text "Your reference is #{sent}. We'll answer by mail{value}" => "رقمك المرجعي هو #{sent}. سنرد عليك عبر البريد{value}";
  /// HelpPage · /help · a title
  /// shown through [Title]
  title "Get help" => "احصل على المساعدة";

  // ── HoldReviewPage (/v/{view}/h/{id}) ──
  /// HoldReviewPage · /v/{view}/h/{id} · text on the page
