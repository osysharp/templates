  /// DeskCopy.EventSentence · text on the page
  /// placeholders: {value} = … (int) — {value} is a count: give one text per plural form
  /// shown through EventSentence()
  text "Solved after {value} days with no word from the customer." => { zero: "حُلّت بعد {value} يوم دون أي كلمة من العميل.", one: "حُلّت بعد يوم واحد دون أي كلمة من العميل.", two: "حُلّت بعد يومين دون أي كلمة من العميل.", few: "حُلّت بعد {value} أيام دون أي كلمة من العميل.", many: "حُلّت بعد {value} يومًا دون أي كلمة من العميل.", other: "حُلّت بعد {value} يوم دون أي كلمة من العميل." };
  /// DeskCopy.EventSentence · text on the page
  /// placeholders: {value} = … (int) — {value} is a count: give one text per plural form
  /// shown through EventSentence()
  text "Solved its {value} incidents with it." => { zero: "لم تُحل معها أي حادثة.", one: "حُلّت حادثتها معها.", two: "حُلّت حادثتاها معها.", few: "حُلّت {value} حوادث معها.", many: "حُلّت {value} حادثة معها.", other: "حُلّت {value} حادثة معها." };
  /// DeskCopy.EventSentence · text on the page
  /// placeholders: {value} = … (int)
  /// shown through EventSentence()
  text "Solved with its problem, #{value}." => "حُلّت مع مشكلتها، #{value}.";
  /// DeskCopy.EventSentence · text on the page
  /// placeholders: {value} = … (int), {t.Name} = t.Name (string)
  /// shown through EventSentence()
  text "Split from #{value} ({t.Name}) — the customer's message moved here." => "مفصولة من #{value} ({t.Name}). نُقلت رسالة العميل إلى هنا.";
  /// DeskCopy.EventSentence · text on the page
  /// placeholders: {t.Name} = t.Name (string)
  /// shown through EventSentence()
  text "Status set to {t.Name}." => "عُيّنت الحالة: {t.Name}.";
  /// DeskCopy.EventSentence · text on the page
  /// placeholders: {t.Name} = t.Name (string), {t.Rule} = t.Rule (string)
  /// shown through EventSentence()
  text "Tagged {t.Name} — rule “{t.Rule}”." => "وُسمت بـ {t.Name} وفق القاعدة «{t.Rule}».";
  /// DeskCopy.EventSentence · text on the page
  /// placeholders: {t.Name} = t.Name (string)
  /// shown through EventSentence()
  text "The automation “{t.Name}” ran." => "نُفّذت الأتمتة «{t.Name}».";
  /// DeskCopy.EventSentence · text on the page
