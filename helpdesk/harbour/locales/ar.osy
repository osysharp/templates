// ar (العربية): the words of Helpdesk, translated.
// Written and kept in step with the source by `osy translate`: a new text arrives as `=> null`, a text
// whose source changed keeps its old translation in a `was` clause. The words are yours to edit.
// Source language: en.

translations ar {
  // ── (every entity) ──
  /// (every entity) · a label (a field, a list item, a menu entry) · at most ~16 characters
  /// shown through the time a record was created or last changed
  /// beside: "Modified at"
  label "Created at" => "تاريخ الإنشاء";
  /// (every entity) · a label (a field, a list item, a menu entry) · at most ~17 characters
  /// shown through the time a record was created or last changed
  /// beside: "Created at"
  label "Modified at" => "تاريخ التعديل";

  // ── AccessSettings (/settings/access) ──
  /// AccessSettings · /settings/access · a description
  /// shown through SettingsPage.description
  /// also in AccessSettings /settings/access
  description "Every change to somebody's access — a role, an account switched off, a lost phone, a sign-out — with who made it and why. Nobody edits or deletes these." => "كل تغيير في صلاحيات أي شخص، سواء كان دورًا، أو حسابًا معطَّلًا، أو هاتفًا مفقودًا، أو تسجيل خروج، مع من أجراه ولماذا. لا يمكن لأحد تعديل هذه السجلات أو حذفها.";
  /// AccessSettings · /settings/access · a title
  /// shown through SettingsPage.title
  /// also in AccessSettings /settings/access
  title "Access changes" => "تغييرات الصلاحيات";

  // ── AccessTrailList ──
  /// AccessTrailList · a title
  /// shown through EmptyState.title
  /// also in AuditList
  title "No changes yet" => "لا توجد تغييرات بعد";

  // ── AddCc ──
  /// AddCc · an error message
  /// placeholders: {t.Number} = t.Number (int)
  /// shown through ValidationException
  error "#{t.Number} is closed — nothing more is sent on it." => "#{t.Number} مغلقة، ولن يُرسل عليها شيء بعد الآن.";
  /// AddCc · an error message
  /// placeholders: {t.Number} = t.Number (int)
  /// shown through ValidationException
  error "#{t.Number} is kept out of use — nobody is added to it." => "#{t.Number} موقوفة عن الاستخدام، ولا يُضاف إليها أحد.";

  // ── Agent ──
  /// Agent · a label (a field, a list item, a menu entry) · at most ~15 characters
  /// shown through Agent.Signature
  label "Signature" => "التوقيع";

  // ── ApiSetStatus ──
  /// ApiSetStatus · an error message
  /// shown through ValidationException
  error "That is not one of the desk's statuses — GET /statuses lists them." => "هذه ليست إحدى حالات مكتب الدعم. يعرضها GET /statuses.";

  // ── ApiTag ──
  /// ApiTag · an error message
  /// shown through ValidationException
  error "Give the tag — a word or two, like billing." => "أدخل الوسم، كلمة أو كلمتين، مثل billing.";

  // ── AskWithoutAnAccount ──
  /// AskWithoutAnAccount · a title
  /// shown through PageHead.title
  /// also in AskWithoutAnAccountPage /privacy/ask
  title "Ask about your data" => "اسأل عن بياناتك";

  // ── AssignTicket ──
  /// AssignTicket · a label (a field, a list item, a menu entry) · at most ~14 characters
  /// shown through [Action] AssignTicket
  /// beside: "Assign to"
  label "Teammate" => "عضو الفريق";

  // ── AuditArea ──
  /// AuditArea · a label (a field, a list item, a menu entry) · at most ~17 characters
  /// shown through AuditArea.Everything
  /// beside: "Access", "Desk settings"
  label "All changes" => "كل التغييرات";
  /// AuditArea · a label (a field, a list item, a menu entry) · at most ~19 characters
  /// shown through AuditArea.Settings
  /// beside: "All changes", "Access"
  label "Desk settings" => "إعدادات المكتب";

  // ── AuditList ──
  /// AuditList · a control's name for screen readers
  accessibleName "Changes" => "التغييرات";
  /// AuditList · text on the page
  text "1 change" => "تغيير واحد";
  /// AuditList · text on the page
  /// shown through EmptyState.body
  text "Nobody made a change of this kind in this period. Try a longer period, or anyone." => "لم يُجرِ أحد تغييرًا من هذا النوع في هذه الفترة. جرّب فترة أطول، أو أي شخص.";
  /// AuditList · text on the page
  /// placeholders: {AuditTake} = AuditTake(…) (int) — {AuditTake} is a count: give one text per plural form
  text "The newest {AuditTake} — narrow the period to see further back" => "أحدث {AuditTake} — اختر فترة أقصر لترى ما قبلها";
  /// AuditList · text on the page
  /// shown through EmptyState.body
  text "When somebody changes the desk's settings or somebody's access, it is listed here — what, who and when." => "عندما يغيّر أحدٌ إعدادات المكتب أو صلاحيات أحد، يظهر ذلك هنا — ماذا، ومن، ومتى.";
  /// AuditList · text on the page
  /// placeholders: {value} = … (string), {value2} = … (string)
  text "by {value}{value2}" => "بواسطة {value}{value2}";
  /// AuditList · text on the page
  text "somebody no longer named" => "شخص لم يعد له اسم هنا";
  /// AuditList · text on the page
  /// placeholders: {shown.Count} = shown.Count (int) — {shown.Count} is a count: give one text per plural form
  text "{shown.Count} changes" => "{shown.Count} تغييرات";

  // ── AuditLog ──
  /// AuditLog · text on the page
  /// placeholders: {value} = … (string)
  /// shown through AuditLine.Detail
  text "Refused: {value}" => "مرفوض: {value}";

  // ── AuditPeriod ──
  /// AuditPeriod · a label (a field, a list item, a menu entry) · at most ~15 characters
  /// shown through AuditPeriod.Year
  /// beside: "Last 7 days", "Last 30 days", "Last 90 days"
  label "Last year" => "آخر سنة";

  // ── AuditSettings (/settings/audit) ──
  /// AuditSettings · /settings/audit · a description
  /// shown through SettingsPage.description
  description "Every change to the desk's settings and to somebody's access — what changed, from what to what, who made it and when. Nobody edits or deletes these." => "كل تغيير في إعدادات المكتب وفي صلاحيات أي شخص — ما الذي تغيّر، ومن ماذا إلى ماذا، ومن أجراه ومتى. لا أحد يعدّل هذه السجلات أو يحذفها.";
  /// AuditSettings · /settings/audit · a label (a field, a list item, a menu entry) · at most ~16 characters
  /// shown through Dropdown.label
  label "Changed by" => "غيّره";
  /// AuditSettings · /settings/audit · a label (a field, a list item, a menu entry) · at most ~12 characters
  /// shown through Dropdown.label
  label "Period" => "الفترة";
  /// AuditSettings · /settings/audit · placeholder text inside an empty field · at most ~12 characters
  /// shown through Dropdown.placeholder
  placeholder "Anyone" => "أي شخص";
  /// AuditSettings · /settings/audit · a title
  /// shown through SettingsPage.title
  /// also in AuditSettings /settings/audit
  title "Audit log" => "سجل التدقيق";

  // ── AutomationSaid.Sentence ──
  /// AutomationSaid.Sentence · text on the page
  /// shown through Sentence()
  text "An automation ran on a ticket." => "نُفّذت أتمتة على تذكرة.";

  // ── ChartTable ──
  /// ChartTable · text on the page
  /// also in __PersonalDataExport2
  text "Category" => "الفئة";

  // ── CompaniesPage (/companies) ──
  /// CompaniesPage · /companies · a label (a field, a list item, a menu entry) · at most ~15 characters
  /// shown through DataGrid.label
  /// also in DeskNav
  label "Companies" => "الشركات";
  /// CompaniesPage · /companies · a label (a field, a list item, a menu entry) · at most ~18 characters
