  label "Open tickets" => "التذاكر المفتوحة";
  /// CompaniesPage · /companies · a subtitle
  /// shown through PageHead.subtitle
  subtitle "Every customer company, its plan, and what it has open." => "كل شركة عميلة، وخطتها، وما لديها من تذاكر مفتوحة.";
  /// CompaniesPage · /companies · a title
  /// shown through PageHead.title
  /// also in CompaniesPage /companies
  title "Companies" => "الشركات";

  // ── Company ──
  /// Company · a label (a field, a list item, a menu entry) · at most ~12 characters
  /// shown through Company.Fields
  /// beside: "Shares tickets", "Notes", "People"
  /// also in Customer
