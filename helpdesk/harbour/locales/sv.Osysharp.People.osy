  text "{d.Name} is now {giving.Label}." => "{d.Name} är nu {giving.Label}.";
  /// PersonPanel · text on the page
  /// placeholders: {d.Name} = d.Name
  /// shown through done
  text "{d.Name} was signed out everywhere." => "{d.Name} har loggats ut överallt.";
  /// PersonPanel · text on the page
  /// placeholders: {r.Label} = r.Label, {d.Name} = d.Name
  /// shown through done
  text "{r.Label} was taken from {d.Name}." => "{r.Label} togs från {d.Name}.";
  /// PersonPanel · a title
  /// placeholders: {d.Name} = d.Name
  /// shown through Dialog.title
  title "Deactivate {d.Name}?" => "Inaktivera {d.Name}?";
  /// PersonPanel · a title
