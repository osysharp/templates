  // ── Osysharp.UserManagement · IssueApiKey ──
  /// IssueApiKey · an error message
  /// shown through ValidationException
  error "Say what the key is for — it is how you will recognise it in the list." => "Skriv vad nyckeln är till för, så känner du igen den i listan.";
  /// IssueApiKey · an error message
  /// shown through ValidationException
  error "This account already holds two keys — revoke one before issuing another." => "Kontot har redan två nycklar. Återkalla en innan du skapar en ny.";
  /// IssueApiKey · an error message
  /// shown through ValidationException
  error "This account is deactivated — reactivate it before issuing it a key." => "Kontot är inaktiverat. Aktivera det igen innan du ger det en nyckel.";

