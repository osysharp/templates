  /// shown through Osysharp.UserManagement.AccessChangeKind.IntegrationReassigned
  /// beside: "Role granted", "Role revoked", "Deactivated", "Reactivated", "Two-step sign-in reset", "Signed out everywhere"
  label "Integration reassigned" => "Integration omfördelad";
