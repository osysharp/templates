  /// PersonPanel · text on the page
  text "Signing in" => "Inloggning";
  /// PersonPanel · text on the page
  /// placeholders: {d.Name} = d.Name
  /// shown through done
  text "Two-step sign-in was reset for {d.Name}; they set it up again when they next sign in." => "Tvåstegsinloggning har återställts för {d.Name}; hen ställer in den igen vid nästa inloggning.";
  /// PersonPanel · text on the page
  /// placeholders: {r.Organization} = r.Organization
  text "at {r.Organization}" => "hos {r.Organization}";
  /// PersonPanel · text on the page
  /// placeholders: {e.By} = e.By, {value} = …
  /// also in AccessTrailList
  text "by {e.By}{value}" => "av {e.By}{value}";
  /// PersonPanel · text on the page
  /// placeholders: {d.Name} = d.Name
