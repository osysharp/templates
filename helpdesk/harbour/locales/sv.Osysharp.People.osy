// sv (Svenska): the words of Helpdesk · Osysharp.UserManagement, translated.
// Written and kept in step with the source by `osy translate`: a new text arrives as `=> null`, a text
// whose source changed keeps its old translation in a `was` clause. The words are yours to edit.
// Source language: en.

translations sv {
  // ── Osysharp.UserManagement · AccessTrail ──
  /// AccessTrail · text on the page
  /// placeholders: {value} = … (string), {whom} = whom (string)
  /// shown through AccessEvent.What
  text "Gave the integration “{value}” to {whom}" => "Gav integrationen ”{value}” till {whom}";
  /// AccessTrail · text on the page
  /// placeholders: {Describe} = Describe(…) (string), {whom} = whom (string)
  /// shown through AccessEvent.What
  text "{Describe}, owned by {whom}" => "{Describe}, ägs av {whom}";

  // ── Osysharp.UserManagement · AccessTrailList ──
  /// AccessTrailList · a control's name for screen readers
  accessibleName "Access changes" => "Behörighetsändringar";
  /// AccessTrailList · text on the page
  /// shown through EmptyState.body
  text "Every change to somebody's access is listed here, with who made it and why." => "Varje ändring av någons behörighet listas här, med vem som gjorde den och varför.";

  // ── Osysharp.UserManagement · AddIntegration ──
  /// AddIntegration · an error message
  /// shown through ValidationException
  error "Keep the name under 100 characters — it is what every record it makes is filed under." => "Håll namnet under 100 tecken — det är namnet allt den gör sparas under.";
  /// AddIntegration · an error message
  /// shown through ValidationException
  error "Name the integration — what it is, as you will recognise it in the list: “Zapier”." => "Ge integrationen ett namn — vad den är, så som du känner igen den i listan: ”Zapier”.";

  // ── Osysharp.UserManagement · Ago ──
  /// Ago · text on the page
  /// placeholders: {d} = d (int) — {d} is a count: give one text per plural form
  /// shown through Ago()
  text "{d} days ago" => { one: "för en dag sedan", other: "för {d} dagar sedan" };
  /// Ago · text on the page
  /// placeholders: {value} = … (int) — {value} is a count: give one text per plural form
  /// shown through Ago()
  text "{value} h ago" => { one: "för en timme sedan", other: "för {value} timmar sedan" };
  /// Ago · text on the page
  /// placeholders: {value} = … (int) — {value} is a count: give one text per plural form
  /// shown through Ago()
  text "{value} min ago" => { one: "för en minut sedan", other: "för {value} minuter sedan" };

  // ── Osysharp.UserManagement · ApiKeyLines ──
  /// ApiKeyLines · text on the page
  /// placeholders: {NameOf} = NameOf(…) (string)
  /// shown through ApiKeyLine.RevokedWords
  text " by {NameOf}" => " av {NameOf}";
  /// ApiKeyLines · text on the page
  /// placeholders: {NameOf} = NameOf(…) (string), {k.IssuedAt} = k.IssuedAt (DateTime)
  /// shown through ApiKeyLine.Issued
  text "Issued by {NameOf} · {k.IssuedAt}" => "Utfärdad av {NameOf} · {k.IssuedAt}";
  /// ApiKeyLines · text on the page
  /// placeholders: {Ago} = Ago(…) (string)
  /// shown through ApiKeyLine.LastUsed
  text "Last used {Ago}" => "Senast använd {Ago}";
  /// ApiKeyLines · text on the page
  /// shown through ApiKeyLine.LastUsed
  text "Never used" => "Aldrig använd";
  /// ApiKeyLines · text on the page
  /// placeholders: {k.RevokedAt} = k.RevokedAt (DateTime), {value} = … (string)
  /// shown through ApiKeyLine.RevokedWords
  text "Revoked {k.RevokedAt}{value}" => "Återkallad {k.RevokedAt}{value}";

  // ── Osysharp.UserManagement · ApiKeyManager ──
  /// ApiKeyManager · a control's name for screen readers
  accessibleName "API key" => "API-nyckel";
  /// ApiKeyManager · a control's name for screen readers
  /// beside: "Add an integration"
  accessibleName "Integrations" => "Integrationer";
  /// ApiKeyManager · a control's name for screen readers
  /// beside: "Issue a key"
  accessibleName "Keys in use" => "Nycklar som används";
  /// ApiKeyManager · a control's name for screen readers
  accessibleName "Revoked keys" => "Återkallade nycklar";
  /// ApiKeyManager · a control's name for screen readers
  /// beside: "Name", "Cancel"
  accessibleName "What it may do" => "Vad den får göra";
  /// ApiKeyManager · a button's label · at most ~26 characters
  /// shown through Button.label
  button "Add an integration" => "Lägg till integration";
  /// ApiKeyManager · a button's label · at most ~31 characters
  /// shown through Button.label
  /// beside: "Cancel"
  button "Add it and issue a key" => "Lägg till och utfärda nyckel";
  /// ApiKeyManager · a button's label · at most ~12 characters
  /// shown through Button.label
  button "Copied" => "Kopierad";
  /// ApiKeyManager · a button's label · at most ~10 characters
  /// shown through Button.label
  button "Copy" => "Kopiera";
  /// ApiKeyManager · a button's label · at most ~18 characters
  /// shown through Button.announceAs
  button "Copy the key" => "Kopiera nyckeln";
  /// ApiKeyManager · a button's label · at most ~24 characters
  /// shown through Button.label
  button "Hide revoked keys" => "Dölj återkallade nycklar";
  /// ApiKeyManager · a button's label · at most ~23 characters
  /// shown through Button.label
  /// also in WebhookSubscriptions
  button "I have copied it" => "Jag har kopierat den";
  /// ApiKeyManager · a button's label · at most ~17 characters
  /// shown through Button.label
  button "Issue a key" => "Skapa nyckel";
  /// ApiKeyManager · a button's label · at most ~14 characters
  /// shown through Button.label
  /// beside: "Cancel"
  button "Issue it" => "Skapa";
  /// ApiKeyManager · a button's label · at most ~17 characters
  /// shown through Button.label
  /// beside: "Cancel"
  button "Reassign it" => "Ge den ny ägare";
  /// ApiKeyManager · a button's label · at most ~15 characters
  /// shown through Button.label
  /// beside: "Cancel"
  button "Revoke it" => "Återkalla";
  /// ApiKeyManager · a button's label · at most ~49 characters
  /// placeholders: {revoked.Count} = revoked.Count
  /// shown through Button.label
  button "Show revoked keys ({revoked.Count})" => "Visa återkallade nycklar ({revoked.Count})";
  /// ApiKeyManager · a button's label · at most ~19 characters
  /// shown through Button.label
  /// beside: "Cancel"
  button "Switch it off" => "Stäng av den";
  /// ApiKeyManager · a description
  /// shown through SettingsPage.description
  description "A key lets a program call this app's API — as an integration of its own, or as the person it was issued to — with exactly what its holder may do. It is shown once, when it is issued." => "En nyckel låter ett program anropa appens API — som en egen integration, eller som personen den utfärdades till — med exakt det dess innehavare får göra. Den visas en gång, när den utfärdas.";
  /// ApiKeyManager · a description
  /// shown through SettingsSection.description
  /// beside: "Keys in use"
  description "A program that works with the app under its own name — what it does is recorded as its own, never as a teammate's. It holds keys and a role, and can never sign in. Switch it off and every key it holds stops working." => "Ett program som arbetar med appen under eget namn — det den gör sparas som dess eget, aldrig som en kollegas. Det har nycklar och en roll och kan aldrig logga in. Stäng av det så slutar alla dess nycklar att fungera.";
  /// ApiKeyManager · a description
  /// shown through SettingsSection.description
  /// beside: "Integrations"
  description "Each acts as its holder and nobody else. Revoke one and the next request that presents it is refused; deactivating a person revokes theirs." => "Varje nyckel agerar som sin innehavare och ingen annan. Återkalla en så nekas nästa anrop som använder den. Inaktiveras en person återkallas personens nycklar.";
  /// ApiKeyManager · a description
  /// shown through SettingsSection.description
  description "Kept so you can see what a key was for and who took it away." => "Sparas så att du ser vad en nyckel var till för och vem som återkallade den.";
  /// ApiKeyManager · a hint under a field
  /// shown through Field.hint
  /// beside: "Cancel"
  hint "How you will recognise it in the list." => "Så känner du igen den i listan.";
  /// ApiKeyManager · a hint under a field
  /// shown through Field.hint
  /// beside: "New owner", "Cancel"
  hint "Kept with the change in the access trail." => "Sparas med ändringen i åtkomstloggen.";
  /// ApiKeyManager · a hint under a field
  /// shown through Field.hint
  /// beside: "What it may do", "Cancel"
  hint "What it is — everything it does is recorded under this name." => "Vad den är — allt den gör sparas under det här namnet.";
  /// ApiKeyManager · a label (a field, a list item, a menu entry) · at most ~9 characters
  /// shown through Dropdown.label
  label "For" => "För";
  /// ApiKeyManager · a label (a field, a list item, a menu entry) · at most ~15 characters
  /// shown through Dropdown.label
  /// beside: "Why", "Cancel"
  label "New owner" => "Ny ägare";
  /// ApiKeyManager · a label (a field, a list item, a menu entry) · at most ~9 characters
  /// shown through Field.label
  /// beside: "New owner", "Cancel"
  /// also in PrivacyRequestPane
  /// also in RetentionEditor
  label "Why" => "Varför";
  /// ApiKeyManager · message
  /// placeholders: {p.DisplayName} = p.DisplayName
  /// shown through HolderName()
  message "{p.DisplayName} (integration)" => "{p.DisplayName} (integration)";
  /// ApiKeyManager · placeholder text inside an empty field · at most ~23 characters
  /// shown through Dropdown.placeholder
  placeholder "Choose a person…" => "Välj en person…";
  /// ApiKeyManager · placeholder text inside an empty field · at most ~20 characters
  /// shown through Field.placeholder
  /// beside: "Cancel"
  placeholder "Nightly export" => "Nattlig export";
  /// ApiKeyManager · placeholder text inside an empty field · at most ~26 characters
  /// shown through Field.placeholder
  /// beside: "New owner", "Cancel"
  placeholder "They left the team" => "De har lämnat teamet";
  /// ApiKeyManager · placeholder text inside an empty field · at most ~12 characters
  /// shown through Field.placeholder
  /// beside: "What it may do", "Cancel"
  placeholder "Zapier" => "Zapier";
  /// ApiKeyManager · a subtitle
  /// shown through Dialog.subtitle
  subtitle "Choose who answers for it from now on: who to ask what it does and whether it is still needed. Its keys and its role stay as they are, and the change is recorded." => "Välj vem som ansvarar för den från och med nu: den man frågar vad den gör och om den fortfarande behövs. Dess nycklar och roll förblir som de är, och ändringen sparas.";
  /// ApiKeyManager · a subtitle
  /// shown through Dialog.subtitle
  subtitle "Every key it holds is refused from its next request. What it already did stays recorded under its name." => "Alla nycklar den har nekas från nästa anrop. Det den redan har gjort finns kvar under dess namn.";
  /// ApiKeyManager · a subtitle
  /// shown through Dialog.subtitle
  subtitle "It acts under its own name with the role you choose, and you answer for it. It gets its first key now." => "Den agerar under eget namn med den roll du väljer, och du ansvarar för den. Den får sin första nyckel nu.";
  /// ApiKeyManager · a subtitle
  /// placeholders: {revokingWhose} = revokingWhose
  /// shown through Dialog.subtitle
  subtitle "The key {revokingWhose}. A program that still uses it is refused from its next request. This cannot be undone — issue a new key instead." => "Nyckeln {revokingWhose}. Ett program som fortfarande använder den nekas från nästa anrop. Det går inte att ångra, skapa en ny nyckel i stället.";
  /// ApiKeyManager · a subtitle
  /// shown through Dialog.subtitle
  subtitle "The program that holds it acts as this person — it can do exactly what they can, and nothing more." => "Programmet som har den agerar som den här personen. Det kan göra exakt det personen kan, och inget mer.";
  /// ApiKeyManager · text on the page
  /// shown through EmptyState.body
  text "Add one for each program that calls the app — Zapier, a nightly export, a partner's system." => "Lägg till en för varje program som anropar appen — Zapier, en nattlig export, en partners system.";
  /// ApiKeyManager · text on the page
  /// shown through addProblem
  text "Choose what it may do — the role it acts with." => "Välj vad den får göra — rollen den agerar med.";
  /// ApiKeyManager · text on the page
  /// shown through reassignProblem
  text "Choose who answers for it from now on." => "Välj vem som ansvarar för den från och med nu.";
  /// ApiKeyManager · text on the page
  /// shown through problem
  text "Choose who the key is for." => "Välj vem nyckeln är till.";
  /// ApiKeyManager · text on the page
  /// beside: "Copy the key", "I have copied it"
  text "Copy it into the program now — it is not shown again. The program sends it in the X-API-Key header." => "Kopiera in den i programmet nu, den visas inte igen. Programmet skickar den i headern X-API-Key.";
  /// ApiKeyManager · text on the page
  /// shown through EmptyState.body
  text "Issue one to let a program call this app's API as somebody on the team." => "Skapa en så kan ett program anropa appens API som någon i teamet.";
  /// ApiKeyManager · text on the page
  /// placeholders: {reassigningFrom} = reassigningFrom
  /// beside: "New owner", "Why", "Cancel"
  text "Owned by {reassigningFrom}" => "Ägs av {reassigningFrom}";
  /// ApiKeyManager · text on the page
  /// placeholders: {revokingWords} = revokingWords
  /// shown through notice
  text "Revoked {revokingWords} — a request that presents it is refused from now on." => "Återkallade {revokingWords}. Ett anrop som använder den nekas från och med nu.";
  /// ApiKeyManager · text on the page
  /// shown through Hint.text
  text "There is nobody to issue a key to — every account on the people list is deactivated." => "Det finns ingen att ge en nyckel till: alla konton i personlistan är inaktiverade.";
  /// ApiKeyManager · text on the page
  text "What it may do" => "Vad den får göra";
  /// ApiKeyManager · text on the page
  /// placeholders: {line.Ending} = line.Ending, {line.Holder} = line.Holder
  /// shown through revokingWhose
  text "{line.Ending} of {line.Holder}" => "{line.Ending} för {line.Holder}";
  /// ApiKeyManager · text on the page
  /// placeholders: {reassigningName} = reassigningName, {HolderName} = HolderName(…)
  /// shown through notice
  text "{reassigningName} is now answered for by {HolderName}. Its keys go on working." => "{HolderName} ansvarar nu för {reassigningName}. Dess nycklar fortsätter att fungera.";
  /// ApiKeyManager · text on the page
  /// placeholders: {switchingOffName} = switchingOffName
  /// shown through notice
  text "{switchingOffName} is switched off — every key it held is refused from now on." => "{switchingOffName} är avstängd — alla nycklar den hade nekas från och med nu.";
  /// ApiKeyManager · text on the page
  /// placeholders: {line.Name} = line.Name, {line.Ending} = line.Ending, {line.Holder} = line.Holder
  /// shown through revokingWords
  text "“{line.Name}” {line.Ending} of {line.Holder}" => "”{line.Name}” {line.Ending} för {line.Holder}";
  /// ApiKeyManager · a title
  /// shown through SettingsPage.title
  /// also in ApiKeysSettings /settings/api-keys
  title "API keys" => "API-nycklar";
  /// ApiKeyManager · a title
  /// shown through Dialog.title
  title "Add an integration" => "Lägg till integration";
  /// ApiKeyManager · a title
  /// shown through SettingsSection.title
  /// beside: "Keys in use"
  title "Integrations" => "Integrationer";
  /// ApiKeyManager · a title
  /// shown through Dialog.title
  title "Issue an API key" => "Skapa en API-nyckel";
  /// ApiKeyManager · a title
  /// shown through SettingsSection.title
  /// beside: "Integrations"
  title "Keys in use" => "Nycklar som används";
  /// ApiKeyManager · a title
  /// shown through EmptyState.title
  title "No integrations yet" => "Inga integrationer än";
  /// ApiKeyManager · a title
  /// shown through EmptyState.title
  title "No keys in use" => "Inga nycklar används";
  /// ApiKeyManager · a title
  /// shown through EmptyState.title
  title "No keys yet" => "Inga nycklar än";
  /// ApiKeyManager · a title
  /// placeholders: {reassigningName} = reassigningName
  /// shown through Dialog.title
  title "Reassign {reassigningName}" => "Ge {reassigningName} en ny ägare";
  /// ApiKeyManager · a title
  /// placeholders: {revokingName} = revokingName
  /// shown through Dialog.title
  title "Revoke {revokingName}?" => "Återkalla {revokingName}?";
  /// ApiKeyManager · a title
  /// shown through SettingsSection.title
  title "Revoked" => "Återkallade";
  /// ApiKeyManager · a title
  /// placeholders: {switchingOffName} = switchingOffName
  /// shown through Dialog.title
  title "Switch off {switchingOffName}?" => "Stäng av {switchingOffName}?";
  /// ApiKeyManager · a title
  /// placeholders: {keyFor} = keyFor
  /// shown through Card.title
  title "The key for {keyFor}" => "Nyckeln för {keyFor}";

