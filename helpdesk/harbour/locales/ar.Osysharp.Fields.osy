// ar (العربية): the words of Helpdesk · Osysharp.Fields, translated.
// Written and kept in step with the source by `osy translate`: a new text arrives as `=> null`, a text
// whose source changed keeps its old translation in a `was` clause. The words are yours to edit.
// Source language: en.

translations ar {
  // ── Osysharp.Fields · AnswerProblem ──
  /// AnswerProblem · an error message
  /// placeholders: {f.Name} = f.Name (string), {Join} = string.Join(…) (string)
  /// shown through AnswerProblem()
  error "{f.Name} is one of: {Join}." => "قيمة {f.Name} واحدة من: {Join}.";
  /// AnswerProblem · an error message
  /// placeholders: {f.Name} = f.Name (string)
  /// shown through AnswerProblem()
  error "{f.Name} is too long — keep it under 1,000 characters." => "{f.Name} طويل جدًا، اجعله أقل من 1,000 حرف.";
  /// AnswerProblem · an error message
  /// placeholders: {f.Name} = f.Name (string)
  /// shown through AnswerProblem()
  error "{f.Name} is yes or no." => "قيمة {f.Name} نعم أو لا.";
  /// AnswerProblem · an error message
  /// placeholders: {f.Name} = f.Name (string)
  /// shown through AnswerProblem()
  error "{f.Name} takes a date, like 2026-10-02." => "يقبل {f.Name} تاريخًا، مثل 2026-10-02.";
  /// AnswerProblem · an error message
  /// placeholders: {f.Name} = f.Name (string)
  /// shown through AnswerProblem()
  error "{f.Name} takes a number, like 42 or 3.5." => "يقبل {f.Name} رقمًا، مثل 42 أو 3.5.";

  // ── Osysharp.Fields · Checked ──
  /// Checked · an error message
  /// placeholders: {form.Name} = form.Name (string)
  /// shown through ValidationException
  error "The form “{form.Name}” does not ask that any more. Reload the page and send it again." => "لم يعد النموذج «{form.Name}» يطلب ذلك. أعد تحميل الصفحة وأرسله مرة أخرى.";
  /// Checked · an error message
  /// shown through ValidationException
  error "This form asks nothing more. Reload the page and send it again." => "لا يسأل هذا النموذج عن شيء آخر. أعد تحميل الصفحة وأرسله مرة أخرى.";

  // ── Osysharp.Fields · CheckedChange ──
