  /// ShownAnswer · a control's name for screen readers
  /// shown through ShownAnswer()
  /// also in CellText
  accessibleName "No" => "لا";
  /// ShownAnswer · a control's name for screen readers
  /// shown through ShownAnswer()
  /// also in CellText
  accessibleName "Yes" => "نعم";

  // ── Osysharp.Fields · SlotProblem ──
  /// SlotProblem · an error message
  /// shown through SlotProblem()
  error "Needs an answer." => "يحتاج إلى إجابة.";

  // ── Osysharp.Fields · UseLine ──
  /// UseLine · text on the page
  /// placeholders: {n} = n (int), {value} = … (string) — {n} is a count: give one text per plural form
  /// shown through UseLine()
  text " · answered on {n} {value}" => { zero: " · أُجيب عنه في {n} {value}", one: " · أُجيب عنه في {n} {value}", two: " · أُجيب عنه في {n} {value}", few: " · أُجيب عنه في {n} {value}", many: " · أُجيب عنه في {n} {value}", other: " · أُجيب عنه في {n} {value}" };
}
