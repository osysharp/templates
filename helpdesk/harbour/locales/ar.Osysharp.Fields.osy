  error "Someone" => "شخص ما";
  /// CheckedChange · an error message
  /// shown through ValidationException
  error "nothing" => "لا شيء";
  /// CheckedChange · an error message
  /// placeholders: {f.Name} = f.Name (string)
  /// shown through ValidationException
  error "{f.Name} is retired: records keep their answers to it, and it takes no new ones." => "تم إيقاف {f.Name}: تحتفظ السجلات بإجاباتها عنه، ولا يقبل إجابات جديدة.";
  /// CheckedChange · an error message
  /// placeholders: {value} = … (string), {f.Name} = f.Name (string), {value2} = … (string)
  /// shown through ValidationException
