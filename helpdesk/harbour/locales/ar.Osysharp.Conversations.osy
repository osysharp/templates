  button "Hide the original" => "إخفاء الأصل";
  /// ThreadMessage · a button's label · at most ~33 characters
  /// shown through Button.label
  button "Hide what they received" => "إخفاء ما وصلهم";
  /// ThreadMessage · a button's label · at most ~24 characters
  /// shown through Button.label
  button "Show the original" => "عرض الأصل";
  /// ThreadMessage · a button's label · at most ~33 characters
  /// shown through Button.label
  button "Show what they received" => "عرض ما وصلهم";
  /// ThreadMessage · text on the page
  /// placeholders: {delivery.To} = delivery.To
  text " at {delivery.To}" => " إلى {delivery.To}";
  /// ThreadMessage · text on the page
  /// placeholders: {delivery.To} = delivery.To
  text " to {delivery.To}" => " إلى {delivery.To}";
  /// ThreadMessage · text on the page
  /// shown through otherLabel
  text "As it was written" => "كما كُتبت";
  /// ThreadMessage · text on the page
  /// placeholders: {LanguageNameOf} = LanguageNameOf(…)
  text "As written, in {LanguageNameOf}" => "كما كُتبت، باللغة: {LanguageNameOf}";
  /// ThreadMessage · text on the page
  /// placeholders: {value} = …, {value2} = …
  text "Did not arrive{value} — {value2}" => "لم تصل{value}: {value2}";
  /// ThreadMessage · text on the page
  /// placeholders: {LanguageNameOf} = LanguageNameOf(…)
  /// beside: "pre-wrap"
  text "In {LanguageNameOf}" => "باللغة: {LanguageNameOf}";
  /// ThreadMessage · text on the page
  /// placeholders: {value} = …
  /// also in SideConversationCard
  text "Not sent — {value}" => "لم تُرسل: {value}";
  /// ThreadMessage · text on the page
  /// placeholders: {delivery.ChannelKey} = delivery.ChannelKey
  text "Sending by {delivery.ChannelKey}…" => "جارٍ الإرسال عبر {delivery.ChannelKey}…";
  /// ThreadMessage · text on the page
  /// placeholders: {delivery.ChannelKey} = delivery.ChannelKey, {value} = …
  text "Sent by {delivery.ChannelKey}{value}" => "أُرسلت عبر {delivery.ChannelKey}{value}";
  /// ThreadMessage · text on the page
  /// placeholders: {Join} = string.Join(…)
  text "Sent in {Join}" => "أُرسلت باللغة: {Join}";
  /// ThreadMessage · text on the page
  /// shown through otherLabel
  text "The original" => "الأصل";
  /// ThreadMessage · text on the page
  /// placeholders: {LanguageNameOf} = LanguageNameOf(…)
  text "Translated from {LanguageNameOf}" => "مترجمة من {LanguageNameOf}";
  /// ThreadMessage · text on the page
  /// placeholders: {delivery.ChannelKey} = delivery.ChannelKey
  text "Translating, then sending by {delivery.ChannelKey}…" => "جارٍ الترجمة ثم الإرسال عبر {delivery.ChannelKey}…";
  /// ThreadMessage · text on the page
  /// shown through otherLabel
  text "What they received" => "ما وصلهم";
  /// ThreadMessage · text on the page
  /// also in SideConversationCard
  /// also in SlaChip
  text "held" => "محتجزة";
  /// ThreadMessage · text on the page
  text "internal note" => "ملاحظة داخلية";
  /// ThreadMessage · text on the page
  text "replied" => "ردّ";
  /// ThreadMessage · text on the page
  /// also in SideConversationCard
  text "the carrier gave it back" => "أعاده خادم البريد";
  /// ThreadMessage · text on the page
  /// placeholders: {message.ChannelKey} = message.ChannelKey
  text "via {message.ChannelKey}" => "عبر {message.ChannelKey}";

  // ── Osysharp.Conversations · TranslateConversationAgain ──
  /// TranslateConversationAgain · an error message
  /// shown through ValidationException
  /// also in TranslateAgain
  error "No translator is set up." => "لم يُضبط أي مترجم.";

  // ── Osysharp.Conversations · TranslatorNotReady ──
  /// TranslatorNotReady · text on the page
  text "The translator is not ready — its settings are not complete." => "المترجم ليس جاهزًا، فإعداداته غير مكتملة.";

  // ── Osysharp.Conversations · Uncopy ──
  /// Uncopy · an error message
  /// shown through ValidationException
  error "Only somebody copied in can be taken off — not the person the conversation is with." => "يمكن إزالة من أُضيف في النسخة فقط، وليس الشخص الذي تجري معه المحادثة.";
  /// Uncopy · an error message
  /// placeholders: {NameOf} = NameOf(…) (string)
  /// shown through ValidationException
  error "{NameOf} is no longer copied in." => "لم يعد {NameOf} في النسخة.";

  // ── Osysharp.Conversations · UnmergeParties ──
  /// UnmergeParties · an error message
  /// shown through ValidationException
  error "Only a merge that went through can be undone." => "لا يمكن التراجع إلا عن دمج تم بالفعل.";

  // ── Osysharp.Conversations · Write ──
  /// Write · an error message
  /// shown through ValidationException
  error "A note is never sent on a channel — post it without one, or post a customer-visible reply." => "لا تُرسل الملاحظة عبر أي قناة أبدًا. انشرها دون قناة، أو انشر ردًا يراه العميل.";
  /// Write · an error message
  /// placeholders: {channel} = channel (string)
  /// shown through ValidationException
  error "No channel '{channel}' is set up — name it in app.Conversations.Channels, or reply on the web." => "لا توجد قناة '{channel}' مُعدّة. سمّها في app.Conversations.Channels، أو رُدّ عبر الويب.";
  /// Write · an error message
  /// placeholders: {said.Length} = said.Length (int), {channel} = channel (string), {MaxLength} = ….MaxLength(…) (int) — {said.Length} is a count: give one text per plural form
  /// shown through ValidationException
  error "This reply is {said.Length} characters, and one {channel} message carries at most {MaxLength} — shorten it, or send it on another channel." => { zero: "يبلغ طول هذا الرد {said.Length} حرف، والحد الأقصى لرسالة {channel} الواحدة {MaxLength}. اختصره، أو أرسله عبر قناة أخرى.", one: "يبلغ طول هذا الرد {said.Length} حرف، والحد الأقصى لرسالة {channel} الواحدة {MaxLength}. اختصره، أو أرسله عبر قناة أخرى.", two: "يبلغ طول هذا الرد {said.Length} حرف، والحد الأقصى لرسالة {channel} الواحدة {MaxLength}. اختصره، أو أرسله عبر قناة أخرى.", few: "يبلغ طول هذا الرد {said.Length} أحرف، والحد الأقصى لرسالة {channel} الواحدة {MaxLength}. اختصره، أو أرسله عبر قناة أخرى.", many: "يبلغ طول هذا الرد {said.Length} حرفًا، والحد الأقصى لرسالة {channel} الواحدة {MaxLength}. اختصره، أو أرسله عبر قناة أخرى.", other: "يبلغ طول هذا الرد {said.Length} حرف، والحد الأقصى لرسالة {channel} الواحدة {MaxLength}. اختصره، أو أرسله عبر قناة أخرى." };
}
