// ar (العربية): the words of Helpdesk · Osysharp.Conversations, translated.
// Written and kept in step with the source by `osy translate`: a new text arrives as `=> null`, a text
// whose source changed keeps its old translation in a `was` clause. The words are yours to edit.
// Source language: en.

translations ar {
  // ── Osysharp.Conversations · AiDraftedNote ──
  /// AiDraftedNote · text on the page
  /// placeholders: {message.ByName} = message.ByName
  text "Drafted by AI, sent by {message.ByName}" => "صاغه الذكاء الاصطناعي، وأرسله {message.ByName}";
  /// AiDraftedNote · text on the page
  /// placeholders: {message.ByName} = message.ByName
  text "Written with AI, checked and sent by {message.ByName}" => "كُتب بمساعدة الذكاء الاصطناعي، وراجعه وأرسله {message.ByName}";

  // ── Osysharp.Conversations · ApproveDraft ──
  /// ApproveDraft · an error message
  /// shown through ValidationException
  error "Only an AI's draft is approved — this entry is not one." => "لا يُعتمد إلا مسودة الذكاء الاصطناعي، وهذا الإدخال ليس مسودة.";

  // ── Osysharp.Conversations · AttachmentCard ──
  /// AttachmentCard · a control's name for screen readers
  /// placeholders: {file.FileName} = file.FileName
  accessibleName "Contents of {file.FileName}" => "محتويات {file.FileName}";
  /// AttachmentCard · a control's name for screen readers
  /// placeholders: {file.FileName} = file.FileName
  accessibleName "Download {file.FileName}" => "تنزيل {file.FileName}";
  /// AttachmentCard · a control's name for screen readers
  /// placeholders: {file.FileName} = file.FileName
  accessibleName "File {file.FileName}" => "الملف {file.FileName}";
  /// AttachmentCard · text on the page
  text "Download" => "تنزيل";
  /// AttachmentCard · text on the page
  text "This archive could not be read — download it to open it." => "تعذّرت قراءة هذا الأرشيف. نزّله لفتحه.";
  /// AttachmentCard · text on the page
  /// placeholders: {preview.MoreEntries} = preview.MoreEntries
  text "…and {preview.MoreEntries} more" => "…و{preview.MoreEntries} أخرى";

  // ── Osysharp.Conversations · CheckSize ──
  /// CheckSize · an error message
  /// placeholders: {Megabytes} = Megabytes(…) (string), {Megabytes2} = Megabytes(…) (string)
  /// shown through ValidationException
  error "These files come to {Megabytes}, and one message may carry at most {Megabytes2}. Send some of them in a second message." => "يبلغ حجم هذه الملفات {Megabytes}، والحد الأقصى للرسالة الواحدة {Megabytes2}. أرسل بعضها في رسالة ثانية.";
  /// CheckSize · an error message
  /// placeholders: {name} = name (string), {Megabytes} = Megabytes(…) (string), {Megabytes2} = Megabytes(…) (string)
  /// shown through ValidationException
  error "{name} is {Megabytes}, and a file may be at most {Megabytes2}. Send a smaller one — a cropped screenshot, or the part of the log that matters." => "حجم {name} هو {Megabytes}، والحد الأقصى لحجم الملف {Megabytes2}. أرسل ملفًا أصغر، مثل لقطة شاشة مقصوصة، أو الجزء المهم من السجل.";

  // ── Osysharp.Conversations · ClaimAddress ──
  /// ClaimAddress · an error message
  /// shown through ValidationException
  error "That does not look like an email address — check it, or leave it empty." => "لا يبدو هذا عنوان بريد إلكتروني. تحقق منه، أو اتركه فارغًا.";

  // ── Osysharp.Conversations · CodeView ──
  /// CodeView · text on the page
  /// placeholders: {lines.Count} = lines.Count, {totalLines} = totalLines
  text "Showing the first {lines.Count} of {totalLines} lines — download the file for the rest." => "يُعرض أول {lines.Count} من أصل {totalLines} سطرًا. نزّل الملف لرؤية الباقي.";

  // ── Osysharp.Conversations · ContinueHere ──
  /// ContinueHere · an error message
  /// shown through ValidationException
  error "This browser cannot keep a conversation — let it keep cookies for this site and open the link again." => "لا يمكن لهذا المتصفح الاحتفاظ بالمحادثة. اسمح له بحفظ ملفات تعريف الارتباط لهذا الموقع وافتح الرابط مجددًا.";

  // ── Osysharp.Conversations · ConversationBubble ──
  /// ConversationBubble · a control's name for screen readers
  /// shown through AiMark.words
  /// also in ThreadMessage
  accessibleName "AI assistant" => "مساعد ذكاء اصطناعي";
  /// ConversationBubble · a control's name for screen readers
  /// shown through AiMark.words
  /// also in ThreadMessage
  accessibleName "AI draft — not sent" => "مسودة ذكاء اصطناعي — لم تُرسل";
  /// ConversationBubble · a control's name for screen readers
  /// shown through AiMark.words
  /// also in ThreadMessage
  accessibleName "Sent by AI" => "أرسله الذكاء الاصطناعي";
  /// ConversationBubble · a button's label · at most ~19 characters
  /// shown through Button.label
  button "Show original" => "عرض الأصل";
  /// ConversationBubble · a button's label · at most ~23 characters
  /// shown through Button.label
  button "Show translation" => "عرض الترجمة";
  /// ConversationBubble · a label (a field, a list item, a menu entry) · at most ~19 characters
  /// shown through Badge.label
  /// also in ConversationComposer
  /// also in Composer
  label "Internal note" => "ملاحظة داخلية";
  /// ConversationBubble · note
  /// placeholders: {LanguageNameOf} = LanguageNameOf(…)
  /// shown through note
  note "Translated from {LanguageNameOf}" => "مترجمة من {LanguageNameOf}";
  /// ConversationBubble · text on the page
  /// also in ThreadMessage
  /// also in ConversationPresenceChip
  text "Support" => "الدعم";
  /// ConversationBubble · text on the page
  text "You" => "أنت";

  // ── Osysharp.Conversations · ConversationChatPage (/conversations/chat) ──
  /// ConversationChatPage · /conversations/chat · a title
  /// shown through [Title]
  title "Your conversation" => "محادثتك";

  // ── Osysharp.Conversations · ConversationComposer ──
  /// ConversationComposer · a button's label · at most ~14 characters
  /// shown through Button.label
  /// beside: "Attach files"
  /// also in Composer
  button "Add note" => "إضافة ملاحظة";
  /// ConversationComposer · a button's label · at most ~10 characters
  /// shown through Button.label
  /// beside: "Attach files"
  /// also in Composer
  button "Send" => "إرسال";
  /// ConversationComposer · a label (a field, a list item, a menu entry) · at most ~23 characters
  /// shown through TextAreaField.label
  /// beside: "Attach files"
  label "Note to the team" => "ملاحظة للفريق";
  /// ConversationComposer · placeholder text inside an empty field · at most ~35 characters
  /// shown through TextAreaField.placeholder
  /// beside: "Attach files"
  /// also in SideConversationCard
  placeholder "Only your team sees this." => "لا يرى هذا إلا فريقك.";
  /// ConversationComposer · placeholder text inside an empty field · at most ~23 characters
  /// shown through ConversationComposer.placeholder
  placeholder "Write a message…" => "اكتب رسالة…";

  // ── Osysharp.Conversations · ConversationContinue ──
  /// ConversationContinue · a control's name for screen readers
  accessibleName "Continue the conversation" => "متابعة المحادثة";
  /// ConversationContinue · a button's label · at most ~19 characters
  /// shown through Button.label
  /// beside: "Carry on where you left off", "The link works once. If you did not ask us anything, you can ignore it."
  button "Continue here" => "المتابعة هنا";
  /// ConversationContinue · text on the page
  /// beside: "The conversation opens here, in this browser, with everything said so far — and stays here when you come back."
  text "Carry on where you left off" => "تابع من حيث توقفت";
  /// ConversationContinue · text on the page
  /// beside: "Carry on where you left off"
  text "The conversation opens here, in this browser, with everything said so far — and stays here when you come back." => "تُفتح المحادثة هنا، في هذا المتصفح، بكل ما قيل حتى الآن، وتبقى هنا عندما تعود.";
  /// ConversationContinue · text on the page
  /// beside: "Carry on where you left off", "Continue here"
  text "The link works once. If you did not ask us anything, you can ignore it." => "يعمل الرابط مرة واحدة. إن لم تسألنا عن شيء، يمكنك تجاهله.";

  // ── Osysharp.Conversations · ConversationContinuePage (/conversations/continue/{link}) ──
  /// ConversationContinuePage · /conversations/continue/{link} · a title
  /// shown through [Title]
  title "Continue the conversation" => "متابعة المحادثة";

  // ── Osysharp.Conversations · ConversationLanguageNotice ──
  /// ConversationLanguageNotice · a button's label · at most ~15 characters
  /// shown through Button.label
  button "Try again" => "حاول مرة أخرى";
  /// ConversationLanguageNotice · message
  /// shown through Alert.message
  message "One message here was not translated — you are reading it as it was written." => "لم تُترجم رسالة واحدة هنا، فأنت تقرؤها كما كُتبت.";
  /// ConversationLanguageNotice · message
  /// placeholders: {status.Untranslated} = status.Untranslated
  /// shown through Alert.message
  message "{status.Untranslated} messages here were not translated — you are reading them as they were written." => "لم تُترجم {status.Untranslated} رسائل هنا، فأنت تقرؤها كما كُتبت.";
  /// ConversationLanguageNotice · text on the page
  /// shown through said
  text "Translating 1 message again." => "جارٍ ترجمة رسالة واحدة مرة أخرى.";
  /// ConversationLanguageNotice · text on the page
  /// placeholders: {again} = again
  /// shown through said
  text "Translating {again} messages again." => "جارٍ ترجمة {again} رسائل مرة أخرى.";
  /// ConversationLanguageNotice · a title
  /// shown through Alert.title
  title "Not translated" => "لم تُترجم";
  /// ConversationLanguageNotice · a title
  /// shown through Alert.title
  title "Translation is off" => "الترجمة متوقفة";

  // ── Osysharp.Conversations · ConversationPresenceChip ──
  /// ConversationPresenceChip · text on the page
  text "The customer is here" => "العميل هنا";
  /// ConversationPresenceChip · text on the page
  /// placeholders: {value} = …
  text "{value} is typing…" => "{value} يكتب…";

  // ── Osysharp.Conversations · ConversationProveAddress ──
  /// ConversationProveAddress · a button's label · at most ~21 characters
  /// shown through Button.label
  /// beside: "Your email"
  button "Email me a code" => "أرسل لي رمزًا بالبريد";
  /// ConversationProveAddress · a button's label · at most ~30 characters
  /// shown through Button.label
  /// beside: "Code"
  button "Show my conversations" => "عرض محادثاتي";
  /// ConversationProveAddress · a button's label · at most ~73 characters
  /// shown through Button.label
  button "Written to us before? Get your earlier conversations" => "راسلتنا من قبل؟ استرجع محادثاتك السابقة";
  /// ConversationProveAddress · a hint under a field
  /// shown through Field.hint
  /// beside: "Email me a code"
  hint "We mail a code to it — the code shows it is yours." => "سنرسل رمزًا إلى بريدك، والرمز يثبت أنه لك.";
  /// ConversationProveAddress · text on the page
  /// shown through done
  text "Done — your earlier conversations with us are here now." => "تم، محادثاتك السابقة معنا موجودة هنا الآن.";
  /// ConversationProveAddress · text on the page
  /// placeholders: {address} = address
  /// beside: "Code", "Show my conversations"
  text "We sent a code to {address}. It works for 15 minutes." => "أرسلنا رمزًا إلى {address}. صالح لمدة 15 دقيقة.";

  // ── Osysharp.Conversations · ConversationThread ──
  /// ConversationThread · a button's label · at most ~16 characters
  /// shown through ConversationThread.splitLabel
  /// also in ThreadMessage
  button "Split off…" => "فصل…";
  /// ConversationThread · text on the page
  /// shown through EmptyState.body
  text "Messages and notes appear here as they are written." => "تظهر الرسائل والملاحظات هنا فور كتابتها.";
  /// ConversationThread · a title
  /// shown through EmptyState.title
  title "Nothing written yet" => "لم يُكتب شيء بعد";

  // ── Osysharp.Conversations · ConversationTranscript ──
  /// ConversationTranscript · a button's label · at most ~18 characters
  /// shown through Button.label
  /// also in ConversationThread
  button "Show earlier" => "عرض الأقدم";
  /// ConversationTranscript · text on the page
  /// shown through EmptyState.body
  text "Messages appear here as they are written." => "تظهر الرسائل هنا فور كتابتها.";
  /// ConversationTranscript · a title
  /// shown through EmptyState.title
  title "No messages yet" => "لا توجد رسائل بعد";

  // ── Osysharp.Conversations · CopyIn ──
  /// CopyIn · an error message
  /// placeholders: {NameOf} = NameOf(…) (string)
  /// shown through ValidationException
  error "{NameOf} is already copied in." => "{NameOf} في النسخة بالفعل.";
  /// CopyIn · an error message
  /// placeholders: {NameOf} = NameOf(…) (string)
  /// shown through ValidationException
  error "{NameOf} is who this conversation is with — every reply goes to them already." => "هذه المحادثة مع {NameOf}، ويصله كل رد بالفعل.";

  // ── Osysharp.Conversations · Describe ──
  /// Describe · text on the page
  /// shown through Describe()
  text "a PDF" => "ملف PDF";
  /// Describe · text on the page
  /// shown through Describe()
  text "a ZIP archive" => "أرشيف ZIP";
  /// Describe · text on the page
  /// shown through Describe()
  text "a file of another kind" => "ملف من نوع آخر";
  /// Describe · text on the page
  /// placeholders: {ToUpper} = ….ToUpper(…) (string)
  /// shown through Describe()
  text "a {ToUpper} picture" => "صورة {ToUpper}";

  // ── Osysharp.Conversations · EventWords ──
  /// EventWords · text on the page
  /// shown through EventWords()
  text "Erased with the conversation's words." => "مُحي مع كلمات المحادثة.";

  // ── Osysharp.Conversations · KeepUpload ──
  /// KeepUpload · an error message
  /// shown through ValidationException
  /// also in KeepPrivately
  error "That file was uploaded somewhere else — in another browser, or before you signed out. Please upload it again." => "رُفع هذا الملف في مكان آخر — في متصفح آخر، أو قبل أن تسجّل الخروج. يُرجى رفعه مرة أخرى.";

