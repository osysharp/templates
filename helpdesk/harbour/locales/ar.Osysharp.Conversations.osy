  // ── Osysharp.Conversations · Megabytes ──
  /// Megabytes · text on the page
  /// placeholders: {ToString} = Convert.ToString(…) (long) — {ToString} is a count: give one text per plural form
  /// shown through Megabytes()
  /// also in SizeOf
  text "{ToString} KB" => { zero: "{ToString} كيلوبايت", one: "{ToString} كيلوبايت", two: "{ToString} كيلوبايت", few: "{ToString} كيلوبايت", many: "{ToString} كيلوبايت", other: "{ToString} كيلوبايت" };
