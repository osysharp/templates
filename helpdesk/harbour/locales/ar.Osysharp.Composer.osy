  /// SavedReplySettings · a description
  /// shown through SettingsPage.description
  description "Replies written once and sent often — find them from the reply box, under Saved replies. The team's are everyone's; your own are yours." => "ردود تُكتب مرة وتُرسل كثيرًا، تجدها من مربع الرد، تحت «الردود المحفوظة». ردود الفريق متاحة للجميع؛ وردودك الخاصة لك وحدك.";
  /// SavedReplySettings · a label (a field, a list item, a menu entry) · at most ~54 characters
  /// shown through Checkbox.label
  /// also in MacroSettings
  label "The whole team's — everyone can use it" => "للفريق كله، يمكن للجميع استخدامه";
  /// SavedReplySettings · placeholder text inside an empty field · at most ~13 characters
  /// shown through Field.placeholder
  /// beside: "Title", "Reply", "Cancel"
  /// also in MacroSettings
  placeholder "Billing" => "الفوترة";
  /// SavedReplySettings · placeholder text inside an empty field · at most ~24 characters
  /// shown through Field.placeholder
  /// beside: "Category", "Reply", "Cancel"
  /// also in MacroSettings
  placeholder "Refund on its way" => "المبلغ المسترد في الطريق";
  /// SavedReplySettings · a subtitle
  /// shown through Dialog.subtitle
  subtitle "Its placeholders are filled from the record each time it is used." => "تُملأ عناصره النائبة من السجل في كل مرة يُستخدم فيها.";
  /// SavedReplySettings · text on the page
  /// shown through EmptyState.body
  text "Write the answers you give again and again once — a reply can greet the customer by name with a placeholder." => "اكتب الإجابات التي تكررها مرة واحدة، ويمكن للرد أن يحيّي العميل باسمه باستخدام عنصر نائب.";
  /// SavedReplySettings · text on the page
  /// placeholders: {value} = …, {Used} = Used(…)
  text "{value} · used {Used}×" => "{value} · استُخدم {Used}×";
  /// SavedReplySettings · text on the page
  /// placeholders: {Trim} = title.Trim(…)
  /// shown through notice
  /// also in MacroSettings
  /// also in AutomationRules
  text "“{Trim}” removed." => "تمت إزالة «{Trim}».";
  /// SavedReplySettings · text on the page
  /// placeholders: {Trim} = title.Trim(…)
  /// shown through notice
  /// also in MacroSettings
  /// also in AutomationRules
  /// also in WebhookSubscriptions
  text "“{Trim}” saved." => "تم حفظ «{Trim}».";
  /// SavedReplySettings · a title
  /// shown through SettingsSection.title
  title "Every saved reply" => "كل الردود المحفوظة";
  /// SavedReplySettings · a title
  /// shown through Dialog.title
  title "New saved reply" => "رد محفوظ جديد";

  // ── Osysharp.Composer · SendFromComposer ──
  /// SendFromComposer · an error message
  /// placeholders: {Join} = string.Join(…) (string)
  /// shown through ValidationException
  error "Replace {Join} before sending — there is nothing on record to put there." => "استبدل {Join} قبل الإرسال، فلا يوجد في السجل ما يُوضع مكانه.";
  /// SendFromComposer · an error message
  /// placeholders: {value} = … (string), {words.Length} = words.Length (int), {setup.MaxLength} = setup.MaxLength (int) — {words.Length} is a count: give one text per plural form
  /// shown through ValidationException
  error "This {value} is {words.Length} characters, and one may be at most {setup.MaxLength}. Shorten it, or send it in two." => { zero: "يبلغ طول {value} {words.Length} حرف، والحد الأقصى {setup.MaxLength}. اختصره، أو أرسله على جزأين.", one: "يبلغ طول {value} {words.Length} حرف، والحد الأقصى {setup.MaxLength}. اختصره، أو أرسله على جزأين.", two: "يبلغ طول {value} {words.Length} حرف، والحد الأقصى {setup.MaxLength}. اختصره، أو أرسله على جزأين.", few: "يبلغ طول {value} {words.Length} أحرف، والحد الأقصى {setup.MaxLength}. اختصره، أو أرسله على جزأين.", many: "يبلغ طول {value} {words.Length} حرفًا، والحد الأقصى {setup.MaxLength}. اختصره، أو أرسله على جزأين.", other: "يبلغ طول {value} {words.Length} حرف، والحد الأقصى {setup.MaxLength}. اختصره، أو أرسله على جزأين." };
  /// SendFromComposer · an error message
  /// shown through ValidationException
  error "Write the note first." => "اكتب الملاحظة أولًا.";
  /// SendFromComposer · an error message
  /// shown through ValidationException
  error "Write the reply first." => "اكتب الرد أولًا.";
  /// SendFromComposer · an error message
  /// shown through ValidationException
  error "note" => "الملاحظة";
  /// SendFromComposer · an error message
  /// shown through ValidationException
  error "reply" => "الرد";
  /// SendFromComposer · text on the page
  /// shown through Said
  text "Note added." => "تمت إضافة الملاحظة.";
  /// SendFromComposer · text on the page
  /// shown through Said
  text "Sent." => "تم الإرسال.";

  // ── Osysharp.Composer · TakePreparedDraft ──
  /// TakePreparedDraft · an error message
  /// shown through ValidationException
  error "That prepared draft is gone — somebody else took it." => "لم تعد تلك المسودة المُعدّة موجودة، فقد أخذها شخص آخر.";

  // ── Osysharp.Composer · TargetFor ──
  /// TargetFor · an error message
  /// placeholders: {kind} = kind (string), {Join} = string.Join(…) (string)
  /// shown through ValidationException
  error "No composer is set up for '{kind}'. The kinds are: {Join}." => "لم يُعدّ محرر لـ '{kind}'. الأنواع المتاحة: {Join}.";
}
