  error "\"{s.Label}\" was not done: {result.Problem}" => "«{s.Label}» لم يُنفَّذ: {result.Problem}";

  // ── Osysharp.Composer · SaveDraft ──
  /// SaveDraft · an error message
  /// placeholders: {text.Length} = text.Length (int), {DraftKeeps} = DraftKeeps (int) — {text.Length} is a count: give one text per plural form
  /// shown through ValidationException
  error "This draft is {text.Length} characters — more than can be kept ({DraftKeeps}). Shorten it." => { zero: "تتكوّن هذه المسودة من {text.Length} حرف، وهذا أكثر مما يمكن حفظه ({DraftKeeps}). اختصرها.", one: "تتكوّن هذه المسودة من {text.Length} حرف، وهذا أكثر مما يمكن حفظه ({DraftKeeps}). اختصرها.", two: "تتكوّن هذه المسودة من {text.Length} حرف، وهذا أكثر مما يمكن حفظه ({DraftKeeps}). اختصرها.", few: "تتكوّن هذه المسودة من {text.Length} أحرف، وهذا أكثر مما يمكن حفظه ({DraftKeeps}). اختصرها.", many: "تتكوّن هذه المسودة من {text.Length} حرفًا، وهذا أكثر مما يمكن حفظه ({DraftKeeps}). اختصرها.", other: "تتكوّن هذه المسودة من {text.Length} حرف، وهذا أكثر مما يمكن حفظه ({DraftKeeps}). اختصرها." };

