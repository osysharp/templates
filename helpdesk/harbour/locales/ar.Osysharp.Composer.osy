  // ── Osysharp.Composer · KeepPrivately ──
  /// KeepPrivately · an error message
  /// placeholders: {name} = name (string), {SizeOf} = SizeOf(…) (string), {SizeOf2} = SizeOf(…) (string)
  /// shown through ValidationException
  error "{name} is {SizeOf}, and a file may be at most {SizeOf2}. Send a smaller one — a cropped screenshot, or the part of the log that matters." => "حجم {name} هو {SizeOf}، والحد الأقصى لحجم الملف {SizeOf2}. أرسل ملفًا أصغر، مثل لقطة شاشة مقصوصة، أو الجزء المهم من السجل.";

  // ── Osysharp.Composer · Linked ──
