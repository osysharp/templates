  // ── Osysharp.Composer · PrepareDraft ──
  /// PrepareDraft · an error message
  /// placeholders: {DraftKeeps} = DraftKeeps (int) — {DraftKeeps} is a count: give one text per plural form
  /// shown through ValidationException
  error "A prepared draft may be at most {DraftKeeps} characters." => { zero: "لا يمكن أن تتجاوز المسودة المُعدّة {DraftKeeps} حرف.", one: "لا يمكن أن تتجاوز المسودة المُعدّة {DraftKeeps} حرف.", two: "لا يمكن أن تتجاوز المسودة المُعدّة {DraftKeeps} حرف.", few: "لا يمكن أن تتجاوز المسودة المُعدّة {DraftKeeps} أحرف.", many: "لا يمكن أن تتجاوز المسودة المُعدّة {DraftKeeps} حرفًا.", other: "لا يمكن أن تتجاوز المسودة المُعدّة {DraftKeeps} حرف." };
  /// PrepareDraft · an error message
  /// shown through ValidationException
  error "A prepared draft needs words." => "تحتاج المسودة المُعدّة إلى نص.";
  /// PrepareDraft · an error message
  /// shown through ValidationException
  error "Say who prepared it — the writer is told." => "اذكر من أعدّها، فسيتم إخبار الكاتب.";

  // ── Osysharp.Composer · ReplyBodyEditor ──
