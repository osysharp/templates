// sv (Svenska): the words of Helpdesk · Osysharp.Conversations, translated.
// Written and kept in step with the source by `osy translate`: a new text arrives as `=> null`, a text
// whose source changed keeps its old translation in a `was` clause. The words are yours to edit.
// Source language: en.

translations sv {
  // ── Osysharp.Conversations · AiDraftedNote ──
  /// AiDraftedNote · text on the page
  /// placeholders: {message.ByName} = message.ByName
  text "Drafted by AI, sent by {message.ByName}" => "Utkast av AI, skickat av {message.ByName}";
  /// AiDraftedNote · text on the page
  /// placeholders: {message.ByName} = message.ByName
  text "Written with AI, checked and sent by {message.ByName}" => "Skrivet med AI, granskat och skickat av {message.ByName}";

  // ── Osysharp.Conversations · ApproveDraft ──
  /// ApproveDraft · an error message
  /// shown through ValidationException
  error "Only an AI's draft is approved — this entry is not one." => "Bara ett AI-utkast kan godkännas, och det här är inte ett.";

  // ── Osysharp.Conversations · AttachmentCard ──
  /// AttachmentCard · a control's name for screen readers
  /// placeholders: {file.FileName} = file.FileName
  accessibleName "Contents of {file.FileName}" => "Innehållet i {file.FileName}";
  /// AttachmentCard · a control's name for screen readers
  /// placeholders: {file.FileName} = file.FileName
  accessibleName "Download {file.FileName}" => "Ladda ner {file.FileName}";
  /// AttachmentCard · a control's name for screen readers
  /// placeholders: {file.FileName} = file.FileName
  accessibleName "File {file.FileName}" => "Filen {file.FileName}";
  /// AttachmentCard · text on the page
  text "Download" => "Ladda ner";
  /// AttachmentCard · text on the page
  text "This archive could not be read — download it to open it." => "Arkivet kunde inte läsas. Ladda ner det för att öppna det.";
  /// AttachmentCard · text on the page
  /// placeholders: {preview.MoreEntries} = preview.MoreEntries
  text "…and {preview.MoreEntries} more" => "…och {preview.MoreEntries} till";

  // ── Osysharp.Conversations · CheckSize ──
  /// CheckSize · an error message
  /// placeholders: {Megabytes} = Megabytes(…) (string), {Megabytes2} = Megabytes(…) (string)
  /// shown through ValidationException
  error "These files come to {Megabytes}, and one message may carry at most {Megabytes2}. Send some of them in a second message." => "Filerna är sammanlagt {Megabytes}, och ett meddelande får innehålla högst {Megabytes2}. Skicka några av dem i ett andra meddelande.";
  /// CheckSize · an error message
  /// placeholders: {name} = name (string), {Megabytes} = Megabytes(…) (string), {Megabytes2} = Megabytes(…) (string)
  /// shown through ValidationException
  error "{name} is {Megabytes}, and a file may be at most {Megabytes2}. Send a smaller one — a cropped screenshot, or the part of the log that matters." => "{name} är {Megabytes}, och en fil får vara högst {Megabytes2}. Skicka en mindre, till exempel en beskuren skärmbild eller den del av loggen som spelar roll.";

  // ── Osysharp.Conversations · ClaimAddress ──
  /// ClaimAddress · an error message
  /// shown through ValidationException
  error "That does not look like an email address — check it, or leave it empty." => "Det ser inte ut som en e-postadress. Kontrollera den eller lämna fältet tomt.";

  // ── Osysharp.Conversations · CodeView ──
  /// CodeView · text on the page
  /// placeholders: {lines.Count} = lines.Count, {totalLines} = totalLines
  text "Showing the first {lines.Count} of {totalLines} lines — download the file for the rest." => "Visar de första {lines.Count} av {totalLines} raderna. Ladda ner filen för att se resten.";

  // ── Osysharp.Conversations · ContinueHere ──
  /// ContinueHere · an error message
  /// shown through ValidationException
  error "This browser cannot keep a conversation — let it keep cookies for this site and open the link again." => "Den här webbläsaren kan inte spara en konversation. Tillåt cookies för den här webbplatsen och öppna länken igen.";

  // ── Osysharp.Conversations · ConversationBubble ──
  /// ConversationBubble · a control's name for screen readers
  /// shown through AiMark.words
  /// also in ThreadMessage
  accessibleName "AI assistant" => "AI-assistent";
  /// ConversationBubble · a control's name for screen readers
  /// shown through AiMark.words
  /// also in ThreadMessage
  accessibleName "AI draft — not sent" => "AI-utkast – inte skickat";
  /// ConversationBubble · a control's name for screen readers
  /// shown through AiMark.words
  /// also in ThreadMessage
  accessibleName "Sent by AI" => "Skickat av AI";
  /// ConversationBubble · a button's label · at most ~19 characters
  /// shown through Button.label
  button "Show original" => "Visa original";
  /// ConversationBubble · a button's label · at most ~23 characters
  /// shown through Button.label
  button "Show translation" => "Visa översättning";
  /// ConversationBubble · a label (a field, a list item, a menu entry) · at most ~19 characters
  /// shown through Badge.label
  /// also in ConversationComposer
  /// also in Composer
  label "Internal note" => "Intern anteckning";
  /// ConversationBubble · note
  /// placeholders: {LanguageNameOf} = LanguageNameOf(…)
  /// shown through note
  note "Translated from {LanguageNameOf}" => "Översatt från {LanguageNameOf}";
  /// ConversationBubble · text on the page
  /// also in ThreadMessage
  /// also in ConversationPresenceChip
  text "Support" => "Support";
  /// ConversationBubble · text on the page
  text "You" => "Du";

  // ── Osysharp.Conversations · ConversationChatPage (/conversations/chat) ──
  /// ConversationChatPage · /conversations/chat · a title
  /// shown through [Title]
  title "Your conversation" => "Din konversation";

  // ── Osysharp.Conversations · ConversationComposer ──
  /// ConversationComposer · a button's label · at most ~14 characters
  /// shown through Button.label
  /// beside: "Attach files"
  /// also in Composer
  button "Add note" => "Lägg till";
  /// ConversationComposer · a button's label · at most ~10 characters
  /// shown through Button.label
  /// beside: "Attach files"
  /// also in Composer
  button "Send" => "Skicka";
  /// ConversationComposer · a label (a field, a list item, a menu entry) · at most ~23 characters
  /// shown through TextAreaField.label
  /// beside: "Attach files"
  label "Note to the team" => "Anteckning till teamet";
  /// ConversationComposer · placeholder text inside an empty field · at most ~35 characters
  /// shown through TextAreaField.placeholder
  /// beside: "Attach files"
  /// also in SideConversationCard
  placeholder "Only your team sees this." => "Bara ditt team ser det här.";
  /// ConversationComposer · placeholder text inside an empty field · at most ~23 characters
  /// shown through ConversationComposer.placeholder
  placeholder "Write a message…" => "Skriv ett meddelande…";

  // ── Osysharp.Conversations · ConversationContinue ──
  /// ConversationContinue · a control's name for screen readers
  accessibleName "Continue the conversation" => "Fortsätt konversationen";
  /// ConversationContinue · a button's label · at most ~19 characters
  /// shown through Button.label
  /// beside: "Carry on where you left off", "The link works once. If you did not ask us anything, you can ignore it."
  button "Continue here" => "Fortsätt här";
  /// ConversationContinue · text on the page
  /// beside: "The conversation opens here, in this browser, with everything said so far — and stays here when you come back."
  text "Carry on where you left off" => "Fortsätt där du slutade";
  /// ConversationContinue · text on the page
  /// beside: "Carry on where you left off"
  text "The conversation opens here, in this browser, with everything said so far — and stays here when you come back." => "Konversationen öppnas här, i den här webbläsaren, med allt som sagts hittills, och finns kvar här när du kommer tillbaka.";
  /// ConversationContinue · text on the page
  /// beside: "Carry on where you left off", "Continue here"
  text "The link works once. If you did not ask us anything, you can ignore it." => "Länken fungerar en gång. Om du inte har frågat oss något kan du strunta i den.";

  // ── Osysharp.Conversations · ConversationContinuePage (/conversations/continue/{link}) ──
  /// ConversationContinuePage · /conversations/continue/{link} · a title
  /// shown through [Title]
  title "Continue the conversation" => "Fortsätt konversationen";

  // ── Osysharp.Conversations · ConversationLanguageNotice ──
  /// ConversationLanguageNotice · a button's label · at most ~15 characters
  /// shown through Button.label
  button "Try again" => "Försök igen";
  /// ConversationLanguageNotice · message
  /// shown through Alert.message
  message "One message here was not translated — you are reading it as it was written." => "Ett meddelande här översattes inte. Du läser det som det skrevs.";
  /// ConversationLanguageNotice · message
  /// placeholders: {status.Untranslated} = status.Untranslated
  /// shown through Alert.message
  message "{status.Untranslated} messages here were not translated — you are reading them as they were written." => "{status.Untranslated} meddelanden här översattes inte. Du läser dem som de skrevs.";
  /// ConversationLanguageNotice · text on the page
  /// shown through said
  text "Translating 1 message again." => "Översätter 1 meddelande igen.";
  /// ConversationLanguageNotice · text on the page
  /// placeholders: {again} = again
  /// shown through said
  text "Translating {again} messages again." => "Översätter {again} meddelanden igen.";
  /// ConversationLanguageNotice · a title
  /// shown through Alert.title
  title "Not translated" => "Inte översatt";
  /// ConversationLanguageNotice · a title
  /// shown through Alert.title
  title "Translation is off" => "Översättning är avstängd";

  // ── Osysharp.Conversations · ConversationPresenceChip ──
  /// ConversationPresenceChip · text on the page
  text "The customer is here" => "Kunden är här";
  /// ConversationPresenceChip · text on the page
  /// placeholders: {value} = …
  text "{value} is typing…" => "{value} skriver…";

  // ── Osysharp.Conversations · ConversationProveAddress ──
  /// ConversationProveAddress · a button's label · at most ~21 characters
  /// shown through Button.label
  /// beside: "Your email"
  button "Email me a code" => "Mejla mig en kod";
  /// ConversationProveAddress · a button's label · at most ~30 characters
  /// shown through Button.label
  /// beside: "Code"
  button "Show my conversations" => "Visa mina konversationer";
  /// ConversationProveAddress · a button's label · at most ~73 characters
  /// shown through Button.label
  button "Written to us before? Get your earlier conversations" => "Har du skrivit till oss förut? Hämta dina tidigare konversationer";
  /// ConversationProveAddress · a hint under a field
  /// shown through Field.hint
  /// beside: "Email me a code"
  hint "We mail a code to it — the code shows it is yours." => "Vi mejlar en kod dit. Koden visar att adressen är din.";
  /// ConversationProveAddress · text on the page
  /// shown through done
  text "Done — your earlier conversations with us are here now." => "Klart. Dina tidigare konversationer med oss finns här nu.";
  /// ConversationProveAddress · text on the page
  /// placeholders: {address} = address
  /// beside: "Code", "Show my conversations"
  text "We sent a code to {address}. It works for 15 minutes." => "Vi har skickat en kod till {address}. Den gäller i 15 minuter.";

  // ── Osysharp.Conversations · ConversationThread ──
  /// ConversationThread · a button's label · at most ~16 characters
  /// shown through ConversationThread.splitLabel
  /// also in ThreadMessage
  button "Split off…" => "Dela av…";
  /// ConversationThread · text on the page
  /// shown through EmptyState.body
  text "Messages and notes appear here as they are written." => "Meddelanden och anteckningar visas här när de skrivs.";
  /// ConversationThread · a title
  /// shown through EmptyState.title
  title "Nothing written yet" => "Inget skrivet än";

  // ── Osysharp.Conversations · ConversationTranscript ──
  /// ConversationTranscript · a button's label · at most ~18 characters
  /// shown through Button.label
  /// also in ConversationThread
  button "Show earlier" => "Visa tidigare";
  /// ConversationTranscript · text on the page
  /// shown through EmptyState.body
  text "Messages appear here as they are written." => "Meddelanden visas här när de skrivs.";
  /// ConversationTranscript · a title
  /// shown through EmptyState.title
  title "No messages yet" => "Inga meddelanden än";

  // ── Osysharp.Conversations · CopyIn ──
  /// CopyIn · an error message
  /// placeholders: {NameOf} = NameOf(…) (string)
  /// shown through ValidationException
  error "{NameOf} is already copied in." => "{NameOf} får redan kopior.";
  /// CopyIn · an error message
  /// placeholders: {NameOf} = NameOf(…) (string)
  /// shown through ValidationException
  error "{NameOf} is who this conversation is with — every reply goes to them already." => "Konversationen förs med {NameOf}, som redan får varje svar.";

