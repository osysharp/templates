  error "This reply is {said.Length} characters, and one {channel} message carries at most {MaxLength} — shorten it, or send it on another channel." => { one: "Svaret är ett tecken långt, och ett {channel}-meddelande rymmer högst {MaxLength}. Korta det eller skicka det via en annan kanal.", other: "Svaret är {said.Length} tecken långt, och ett {channel}-meddelande rymmer högst {MaxLength}. Korta det eller skicka det via en annan kanal." };
