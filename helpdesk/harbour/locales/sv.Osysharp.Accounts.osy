  // ── Osysharp.Accounts · VerifyEmail ──
  /// VerifyEmail · an error message
  /// shown through ValidationException
  error "That link has expired or was already used — sign in to have a new one sent." => "Länken har gått ut eller har redan använts. Logga in för att få en ny skickad.";

  // ── Osysharp.Accounts · VerifyEmailPage (/verify-email/{token}) ──
