  /// SignUpForm · message
  /// placeholders: {facts.AppName} = facts.AppName
  /// shown through Alert.message
  /// beside: "I have an account — sign in"
  message "{facts.AppName} is not open for sign-up. Ask the person who runs it for an account." => "{facts.AppName} är inte öppen för registrering. Be den som driver den om ett konto.";
  /// SignUpForm · placeholder text inside an empty field · at most ~31 characters
  /// shown through Field.placeholder
  /// beside: "Email", "Password", "Create account", "I already have an account"
