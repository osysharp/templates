/// What the desk keeps about each customer in its own "Their plan" field — Starter, Team, Enterprise, Team, in turn by
/// name — on a desk that already holds its month of tickets.
void PlansOnEveryCustomer() {
  runas (Ines) {
    var plan = new CustomerField { Name = "Their plan", Kind = Osysharp.CustomFields.FieldKind.Choice, Options = "Starter\nTeam\nEnterprise",
                                   Position = 0 };
    UnitOfWork.Commit();
    string[] plans = ["Starter", "Team", "Enterprise", "Team"];
    var i = 0;
    foreach (var c in Customer.OrderBy(c => c.DisplayName).ToList()) {
      SetField(c.Id, plan.Id, plans[i % plans.Length]);
      i = i + 1;
    }
  }
}

