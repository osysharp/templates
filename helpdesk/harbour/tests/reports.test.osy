/// Most solved tickets answered, most of those well — the same every run (every third bad, every fourth unanswered).
void RateSolved() {
  var i = 0;
  foreach (var t in Ticket.Where(t => t.Category == StatusCategory.Solved || t.Category == StatusCategory.Closed).OrderBy(t => t.Number).ToList()) {
    i = i + 1;
    if (i % 4 == 0) { continue; }
    t.Rating = i % 7 == 0 ? FeedbackRating.Bad : FeedbackRating.Good;
  }
}
