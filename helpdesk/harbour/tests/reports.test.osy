/// A month of the desk's work (160 tickets, seeded as Ines and caught up), with customers' answers on most solved
/// tickets — built ONCE per run, and cloned for each of the report tests below and in languages/.
[TestFixture(Floor)]
void MonthOfWork() {
  SeedAMonthAsInes();
}

void SeedAMonthAsInes() {
  runas (Ines) { SeedDemoDesk(160); CatchUp(); RateSolved(); }
}

/// The same month, and what the desk keeps about each customer in its own "Their plan" field — built on MonthOfWork.
[TestFixture(MonthOfWork)]
void MonthWithPlans() {
  PlansOnEveryCustomer();
}

