  Ui.Visit("/ar/v/all/t/" + number);
  Assert.Visible("بأن الأمر لم يسر على ما يرام");
  Ui.Shot("feedback timeline wide arabic");
}

[Test(Bells)]
void a_notification_is_said_in_arabic_to_a_teammate_who_reads_the_desk_in_it() {
  MentionedThenHandedOver();
  runas (Rahul) {
    Session.SetLanguage("ar");
    // A Latin name in an Arabic sentence is isolated (U+2068 … U+2069), so it reads in its own direction.
    var arabic = TopOfMyBell().Sentence;
    Assert.True(arabic.StartsWith("إشارة إليك من "), arabic);
    Assert.True(arabic.Contains("Ines Moreau") && arabic.EndsWith(" في ملاحظة."), arabic);
    Session.SetLanguage("en");
  }
}

