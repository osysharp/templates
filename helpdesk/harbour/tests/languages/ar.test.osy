/// A custom field in the Arabic builder: its name is the desk's own words, as an admin wrote it; everything around it is
/// in Arabic, and the tickets group by its options.
[Test(MonthWithPlans)]
void a_customer_field_groups_the_report_in_arabic() {
  Ui.Viewport(1600, 1000);
  Ui.SignInAs(Ines);
  Ui.Visit("/ar/reports/build");
  Ui.Fill("ابحث عن حقل", "plan");
  Ui.Click("Their plan");
  Ui.Click("تجميع حسب");
  Assert.Visible("Enterprise");
  Ui.Shot("reports-builder-customer-field-arabic-wide-light");
}

// ── what an AI wrote ─────────────────────────────────────────────────────────────────────────────────────────────────

[Test(Portal)]
void what_an_ai_wrote_reads_right_to_left_in_arabic() {
  var n = OliviasTicketAnsweredWithAi();
  Ui.SignInAs(Desk);
  Ui.Viewport(1600, 1000);
  Ui.Visit("/ar/v/open/t/" + n);
  Assert.Visible("مسودة ذكاء اصطناعي — لم تُرسل");
  Assert.Visible("صاغه الذكاء الاصطناعي، وأرسله Ines Moreau");
  Ui.Shot("ai-entries-ticket-wide-arabic");
  Ui.SignInAs(Olivia);
  Ui.Viewport(390, 844);
  Ui.Visit("/ar/my/" + n);
  Assert.Visible("كُتب بمساعدة الذكاء الاصطناعي، وراجعه وأرسله Ines Moreau");
  Assert.NoOverflow();
  Ui.Shot("ai-entries-portal-phone-arabic");
}

// ── the leftovers batch, in Arabic ───────────────────────────────────────────────────────────────────────────────────

/// A duplicate's link offers the merge in Arabic, and Settings › Support address reads right to left — wide and on a
/// phone.
[Test(Mailroom)]
void a_duplicates_merge_and_the_support_address_in_arabic() {
  var original = 0;
  var dup = 0;
  runas (Ines) {
    var o = TicketOf(OpenTicket("olivia@larkspur.test", "", "Invoices show the old VAT number", "Since Monday."));
    var d = TicketOf(OpenTicket("sam@larkspur.test", "", "Wrong VAT number on our invoice", "Our March invoice."));
    original = o.Number;
    dup = d.Number;
    Link(d, o, "duplicate");
    UnitOfWork.Commit();
  }
  Ui.Viewport(1600, 1000);
  Ui.SignInAs(Ines);
  Ui.Visit("/ar/v/open/t/" + dup);
  Assert.Visible("دمج في #" + original);
  Ui.Shot("duplicate-merge-arabic-wide");
  Ui.Visit("/ar/settings/support-address");
  Assert.Visible("عنوان الدعم");
  Ui.Shot("settings-support-address-arabic-wide");
  Ui.Viewport(390, 844);
  Assert.NoOverflow();
  Ui.Shot("settings-support-address-arabic-phone");
}
