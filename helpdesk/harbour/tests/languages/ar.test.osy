// HARBOUR IN ARABIC — the same desk, every word from locales/ar.osy (its own and its kits' — the Inbox, the
// Composer, Conversations, Accounts, Privacy …), and every screen reading RIGHT TO LEFT: the rail on the right, the list
// beside it, the ticket at the left; the customer's portal the same. Nothing in the app was written for it. Each screen
// is photographed (`osy test --pixels`), at a desk's width and a phone's, light and dark.
//
// One place for the language: `osy init --template helpdesk` leaves this file out with locales/ar*.osy when Arabic is
// not wanted, so the rest of the suite never reads a page in it. The worlds these tests stand in (`Office`, `Desk`,
// `Bells`, …) and their helpers live beside the English tests.
using Osysharp.Identity;
using Osysharp.UserAccounts;
using Osysharp.Organizations;
using Osysharp.Organizations.ServicePlans;
using Osysharp.UserManagement;
using Osysharp.Workflow;
using Osysharp.Conversations;
using Osysharp.Mail;
using Osysharp.Mail.Receiving;
using Osysharp.WorkQueues;
using Osysharp.KnowledgeBase;
using Osysharp.SatisfactionSurveys;
using Osysharp.Notifications;
using Osysharp.Privacy;
using Osysharp.Reports;
using Osysharp.TimeZone;
using Osysharp.CustomFields;
using Osysharp.Webhooks;
using Osysharp.Http;

/// ⭐ A TICKET ARRIVES BY MAIL AND IS ANSWERED, IN ARABIC: Olivia's mail to support@ becomes a ticket; Ines reads the
/// desk in Arabic — the navigation rail at the RIGHT, the ticket list beside it, the ticket at the LEFT — writes a reply
/// and an internal note, and both land on the one timeline.
[Test(Mailroom)]
void a_ticket_arrives_by_mail_and_is_answered_on_the_desk_in_arabic() {
  runas (Ines) { Watching(); }
  runas (Ines) {
    Deliver(FromOlivia("<ar1@larkspur.test>", "Invoice INV-2041 shows the wrong VAT number",
      "Our VAT number on invoice INV-2041 is SE556677889901, not the old one. Can you send a corrected copy?"));
    TestClock.Advance(TimeSpan.FromMinutes(1));
    ReadMailbox();
  }
  var number = 0;
  runas (Ines) { number = Ticket.Single(t => t.Title == "Invoice INV-2041 shows the wrong VAT number").Number; }

  Ui.Viewport(1600, 1000);
  Ui.SignInAs(Ines);
  Ui.Visit("/v/open/t/" + number);
  Assert.Visible("Send");
  Ui.Shot("rtl twin: a ticket on the desk in English, wide");
  Ui.Visit("/ar/v/open/t/" + number);
  Assert.Visible("كل المفتوحة");                                     // the views, in Arabic
  Assert.Visible("Invoice INV-2041 shows the wrong VAT number");   // the customer's own words stay hers
  // THE DIRECTION, measured: the rail's view names sit to the RIGHT of the ticket's composer.
  Assert.RightOf("كل المفتوحة", "إرسال");
  Assert.Visible("النوع");                                          // the ticket's type, a form, in Arabic
  Assert.Visible("أكتوبر");                                        // its dates in ar-AE: Arabic months, Latin digits
  Ui.Fill("الرد على Olivia Brandt", "شكرًا يا أوليفيا، سنرسل نسخة مصححة من الفاتورة INV-2041 اليوم.");
  Ui.Click("إرسال");
  Assert.Visible("سنرسل نسخة مصححة من الفاتورة INV-2041 اليوم.");
  Ui.Click("ملاحظة داخلية");
  Ui.Fill("ملاحظة داخلية", "رقم ضريبة القيمة المضافة الجديد: SE556677889901.");
  Ui.Click("إضافة ملاحظة");
  Assert.Visible("رقم ضريبة القيمة المضافة الجديد: SE556677889901.");
  Ui.Shot("rtl: a ticket answered on the desk in Arabic, wide");
  Ui.Theme("dark");
  Ui.Shot("rtl: a ticket answered on the desk in Arabic, wide, dark");
  Ui.Theme("light");
  Ui.Visit("/ar/v/open");
  Ui.Shot("rtl: the desk's open tickets in Arabic, wide");
  Ui.Viewport(390, 844);
  Ui.Visit("/ar/v/open");
  Assert.NoOverflow();
  Ui.Shot("rtl: the desk's open tickets in Arabic, phone");
  Ui.Visit("/ar/v/open/t/" + number);
  Assert.NoOverflow();
  Ui.Shot("rtl: a ticket in Arabic, phone");
  runas (Ines) {
    var t = Ticket.Single(x => x.Number == number);
    Assert.Equal(1, Message.Count(m => m.Conversation == t.Conversation && m.Visibility == EntryVisibility.Internal));
  }
}

/// ⭐ THE CUSTOMER'S VIEW IN ARABIC: Olivia reads her requests in Arabic in the portal — the team's reply, never its
/// note — answers, and her reply reopens the ticket; on a phone too.
[Test(Portal)]
void the_customer_reads_and_answers_in_the_portal_in_arabic() {
  var number = 0;
  runas (Desk) {
    var id = OpenTicket("olivia@larkspur.test", "Olivia Brandt", "Refund charged twice for order 88213",
                        "The refund shows twice on the customer's card statement.");
    number = Ticket.Single(t => t.Id == id).Number;
    ReplyToTicket(id, "One of the two is a pending authorisation that drops off within five days.", false,
                  TicketStatus.Single(s => s.Name == "Pending").Id);
    ReplyToTicket(id, "Finance confirmed only one refund settled.", true);
  }
  Ui.Viewport(1280, 900);
  Ui.SignInAs(Olivia);
  Ui.Visit("/ar/my");
  Assert.Visible("طلباتك");
  Assert.Visible("بانتظار ردك");                                    // where it stands, in her words, in Arabic
  Assert.Visible("Refund charged twice for order 88213");
  Ui.Shot("rtl: the customer's requests in Arabic, wide");
  Ui.Click("Refund charged twice for order 88213");
  Assert.Visible("pending authorisation that drops off");
  Assert.Hidden("Finance confirmed");
  Ui.Fill("ردك", "شكرًا، اختفى المبلغ المكرر هذا الصباح.");
  Ui.Click("إرسال الرد");
  Assert.Visible("اختفى المبلغ المكرر هذا الصباح.");
  Ui.Shot("rtl: the customer's request in Arabic, wide");
  Ui.Theme("dark");
  Ui.Shot("rtl: the customer's request in Arabic, wide, dark");
  Ui.Theme("light");
  Ui.Viewport(390, 844);
  Assert.NoOverflow();
  Ui.Shot("rtl: the customer's request in Arabic, phone");
  Ui.Visit("/help");
  Assert.NoOverflow();
  Ui.Shot("rtl: the help page in Arabic, phone");
  runas (Desk) { Assert.Equal(StatusCategory.Open, Ticket.Single(x => x.Number == number).Category); }
}

