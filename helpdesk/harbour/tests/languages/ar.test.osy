// ── a ticket's history ───────────────────────────────────────────────────────────────────────────────────────────────

[Test(Desk)]
void a_tickets_history_reads_in_arabic() {
  var number = TicketWithAHistory();
  Ui.SignInAs(Lena);

  // A desk's width: the timeline between the messages, and how it got here beside it.
  Ui.Viewport(1600, 1000);
  Ui.Visit("/ar/v/open/t/" + number);
  Assert.Visible("سلّمها Ines Moreau إلى Rahul Kapoor.");                  // the inbox's facts, said in Arabic
  Assert.Visible("الأولوية عادية ← عالية.");                               // its priorities' labels too
  Assert.Visible("عُيّنت الحالة: Waiting on a refund.");                   // the team's own status name stays theirs
  Assert.Visible("كيف وصلت إلى هنا");                                     // how it got here — the inbox's trail
  Assert.Visible("English");                                              // the other languages, each in its own name
  Assert.Visible("وصلت إلى Billing بالقاعدة «Money questions».");
  Ui.Shot("history: a ticket's timeline and how it got here in Arabic, wide");

  // …on a phone: the timeline, then how it got here from the queue's chip.
  Ui.Viewport(390, 844);
  Ui.Visit("/ar/v/open/t/" + number);
  Assert.NoOverflow();
  Assert.Visible("سلّمها Ines Moreau إلى Rahul Kapoor.");
  Ui.Shot("history: a ticket's timeline in Arabic, phone");
  // The thread opens on its newest entries; its earlier history is a scroll up.
  Ui.Hover("وصلت إلى Billing بالقاعدة «Money questions».");
  Ui.Shot("history: a ticket's earlier timeline in Arabic, phone");
  Ui.Click("Engineering · L2");
  Assert.Visible("كيف وصلت #" + number + " إلى هنا");
  Assert.Visible("وصلت إلى Billing بالقاعدة «Money questions».");
  Assert.NoOverflow();
  Ui.Shot("history: how a ticket got here in Arabic, phone");
}

/// On a phone English is one press from Arabic. With more than one other language the top bar has no room for every
/// name beside the page's title, so the language it is read in, by its own name, opens the rest.
[Test(Desk)]
void on_a_phone_english_is_one_press_from_arabic() {
  Ui.SignInAs(Lena);
  Ui.Viewport(390, 844);
  Ui.Visit("/ar/v/open");
  if (App.Languages.Count > 2) {
    Assert.Hidden("English");                                            // folded away, out of the title's room
    Ui.Click("العربية");                                                  // the language it is read in, by its own name
    Ui.Shot("history: the language menu on a phone, in Arabic");
  }
  Ui.Click("English");
  Assert.Visible("All open");
  Assert.NoOverflow();
}

