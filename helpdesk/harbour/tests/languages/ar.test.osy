[Test(Office)]
void a_copy_asked_for_in_arabic_reads_in_arabic_and_its_data_file_stays_the_same() {
  PetraWithHistory();
  var id = PetraAskedForACopyAndMiraApproved("ar");
  var arabic = "";
  runas (Mira) {
    var r = PrivacyRequest.Single(x => x.Id == id);
    var page = ReadableExportOf(r);
    Assert.Contains("ما نحتفظ به عنك", page);                       // the page's own words
    Assert.Contains("محادثاتك الأخرى معنا", page);                  // a holder's category
    Assert.Contains("الرد عليك، وتحسين دعمنا", page);                     // …and why it is kept (a filled hole is isolated for direction)
    Assert.Contains("كتبتَ", page);                                 // what a row is
    Assert.Contains("SE556677889901", page);                         // her words stay hers
    Assert.Contains("\"category\":\"conversations.service\"", ExportOf(r));
    arabic = page;
  }
  Ui.Viewport(390, 844);
  Ui.Shot("harbour-your-data-readable-arabic-phone", new RenderedEmail("", "") { Html = arabic });
}

