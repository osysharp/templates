[Test(Solving)]
void the_customers_answer_lands_on_the_timeline_said_in_arabic() {
  var id = SolvedForOlivia("Export to CSV drops the last row");
  AnswerFeedbackByLink(QuestionLinkOf(id), FeedbackRating.Good, "Fixed within the hour — thank you.");
  Background.Settle();
  // Arabic isolates the customer's name and words from the sentence around them, so they read in their own direction.
  Assert.True(TimelineIn(id, "ar").Any(l => l.StartsWith("أجاب") && l.Contains("Olivia Brandt") && l.Contains("بأن الأمر سار على ما يرام")
                                             && l.Contains("Fixed within the hour — thank you.")));
}

[Test(Solving)]
void in_arabic_the_question_and_the_timeline_read_right_to_left() {
  var id = SolvedForOlivia("Invoice PDF is blank", "We regenerated the invoice.");
  AnswerFeedbackByLink(QuestionLinkOf(id), FeedbackRating.Bad, "The PDF is still blank.");
