[Test(Bilingual)]
void the_mail_that_says_his_request_is_solved_is_in_arabic() {
  var o = OmarsInvoice();
  runas (Nadia) {
    // Each value is isolated for right-to-left reading (Unicode isolates around the number and the subject).
    var arabic = TicketSolvedMail(Ticket.Single(x => x.Id == o.Id), null, null).Subject;
    Assert.True(arabic.StartsWith("تم حل طلبك"));
    Assert.Contains(o.Number.ToString(), arabic);
    Assert.Contains("لا أستطيع تنزيل الفاتورة", arabic);
  }
}

[Test(Bilingual)]
void the_solved_mail_in_arabic_says_what_the_team_did_in_his_language() {
  var omar = OmarsInvoice();
  Solves(omar.Id, "We resent the September invoice and fixed the download link.");
  RenderedEmail? ar = null;
  runas (Nadia) {
    var omars = Ticket.Single(x => x.Id == omar.Id);
    ar = TicketSolvedMail(omars, null, null, resolution: ResolutionIn(omars));
  }
  Assert.Contains("أعدنا إرسال فاتورة سبتمبر وأصلحنا رابط التنزيل.", ar!.Text);
  Ui.Shot("mail: request solved, Arabic", ar!);
}

