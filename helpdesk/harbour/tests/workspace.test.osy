  Assert.Visible("Back to the list");
  Assert.Hidden("Filter this view");
  Ui.Shot("workspace-phone-ticket");
  Ui.Visit("/v/open");
  Ui.Click("Ines Moreau", within: "Page header");
  Ui.Click("Appearance");
  Ui.Shot("workspace-phone-list-dark");
}

/// A REAL DESK STARTS EMPTY, AND SAYS SO (Harbour is Osyrin's own support desk from launch day — slice 7 removed the
/// "fill it with a month of sample work" button that sat on every empty desk): where tickets come from, and New ticket.
/// And a teammate in no queue is told why they cannot take anything, and who can change it.
[Test(Floor)]
void an_empty_desk_says_where_tickets_come_from_and_a_teammate_in_no_queue_is_told() {
  runas (Ines) { SetUpTestDesk(); }
  Ui.SignInAs(Ines);
  Ui.Visit("/v/open");
  Assert.Visible("No tickets yet");
  Assert.Hidden("sample work");
  Assert.Hidden("You are not in any queue yet");      // SetUpDesk put the team on its queues
  Ui.Shot("empty-desk");
  Ui.Click("New ticket", within: "Empty desk");
  Assert.OnPage("/new");
  Ui.SignInAs(Kapoor);
  Ui.Visit("/v/open");
  Assert.Hidden("You are not in any queue yet");
  runas (Ines) {
    foreach (var m in QueueMember.Where(m => m.Member.Email == "rahul.kapoor@helpdesk.test").ToList()) { m.Delete(); }
    UnitOfWork.Commit();
  }
  Ui.Visit("/v/open");
  Assert.Visible("You are not in any queue yet");
}
