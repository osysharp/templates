}

[Test(Floor)]
void on_a_phone_the_list_and_the_ticket_are_one_screen_each() {
  var number = 0;
  runas (Ines) { SeedDemoDesk(40); number = Ticket.Where(t => t.Category == StatusCategory.Open).First().Number; }
  Ui.Viewport(390, 844);
  Ui.SignInAs(Ines);
