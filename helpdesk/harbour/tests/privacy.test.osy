}

// ── a legal hold from the ticket's own page, and its review on the Inbox ──

[Test(Office)]
void a_hold_placed_from_the_ticket_is_reviewed_on_the_inbox_when_its_date_comes() {
  var id = Customer("ines.b@kestrel.test", "Ines Berg", "Refund dispute", "I want my money back.");
  var number = 0;
  runas (Mira) { number = Ticket.Single(x => x.Id == id).Number; }
  Ui.Viewport(1720, 1000);
  Ui.SignInAs(Mira);
  Ui.Visit("/v/open/t/" + number);
  Ui.Click("Place a legal hold…");
  Ui.Fill("Matter", "Refund dispute, 2026");
  Ui.Fill("Why it must be kept", "She has said she will take it to court.");
  Ui.Fill("Review by", DateTime.UtcNow.AddDays(30).ToString("yyyy-MM-dd"));
  Ui.Shot("hold-control-dialog");
  Ui.Click("Place the hold");
  Assert.Visible("On legal hold: Refund dispute, 2026");
  Ui.Shot("hold-control-on-the-ticket");
  // An agent who does not place holds sees none of it.
  Ui.SignInAs(Theo);
  Ui.Visit("/v/open/t/" + number);
  Assert.Hidden("Place a legal hold…");
  Assert.Hidden("On legal hold");

  // The review date comes: the review is work on the Inbox, for the people who place holds.
  TestClock.Advance(TimeSpan.FromDays(31));
  runas (Mira) {
    var hold = LegalHold.Single(h => h.CaseLabel == "ticket #" + number);
    Workflow.Settle(hold);
    Assert.Equal(HoldState.ReviewDue, LegalHold.Single(h => h.Id == hold.Id).State);
    Assert.Equal(1, HoldReview.Count(x => x.Hold.Id == hold.Id && x.DoneAt == null));
  }
  runas (Theo) { Assert.Equal(0, HoldReview.Count()); }
  Ui.SignInAs(Mira);
  Ui.Visit("/v/open");
  Ui.Click("Review the legal hold on ticket #" + number);
  Assert.Visible("Refund dispute, 2026");
  Ui.Shot("hold-review-on-the-inbox");
  Ui.Click("Keep it, and review again…");
  Ui.Fill("Next review", DateTime.UtcNow.AddDays(60).ToString("yyyy-MM-dd"));
  Ui.Click("Keep it");
  Assert.Visible("Kept. Somebody looks at it again on");
  // Settled and closed: nothing on it is offered to take any more.
  Assert.Hidden("Take it");
  runas (Mira) {
    Assert.Equal(0, HoldReview.Count(x => x.DoneAt == null));
    Assert.Equal(HoldState.Holding, LegalHold.Single(h => h.CaseLabel == "ticket #" + number).State);
  }
  Ui.Viewport(390, 844);
  Ui.Shot("hold-review-kept-phone");
}

// ── one customer's request, end to end, as osyrin.com's privacy page shows it (D-SITEPRIVACY1) ──
//
// Hanna has a complaint and a question on the desk, and the team wrote down what went wrong on the complaint. An admin
// files her erasure from the ticket: the plan names every kind of data the desk holds about her — the kits' and the
// desk's own — and keeps the complaint for legal claims instead of erasing it. Nothing happens until it is approved.
[Test(Office)]
void her_erasure_is_planned_category_by_category_and_waits_on_the_inbox_until_an_admin_approves_it() {
  var complaint = HannaWithAComplaint();
  var number = 0;
  runas (Mira) {
    var t = Ticket.Single(x => x.Id == complaint);
    t.RootCause = "The gateway billed QUOLL4 twice.";
    UnitOfWork.Commit();
    number = t.Number;
  }
  Ui.Viewport(1600, 1000);
  Ui.SignInAs(Mira);
  Ui.Visit("/v/open/t/" + number);
  Ui.Click("Start a privacy request…");
  Ui.Fill("In your words", "A code to the address she writes from came back on 4 Oct.");
  Ui.Click("Plan the request");
  Assert.Dialog("Planned — nothing has happened yet");
  Assert.Visible("Conversations about a complaint or a dispute", within: "The plan");
  Assert.Visible("What our team wrote on your tickets: what went wrong, and how it was solved", within: "The plan");
  Ui.Shot("site-request-planned");
  Ui.Click("Open it on the Inbox");
  Assert.Visible("Approve and run the plan");
  Ui.Shot("site-request-on-the-desk");
  // Planned, not run: her words and what the team wrote are all still there.
  runas (Mira) {
    Assert.True(Message.Any(m => m.Text.Contains("charged twice")));
    Assert.Equal("The gateway billed QUOLL4 twice.", Ticket.Single(x => x.Id == complaint).RootCause);
  }
  Ui.Viewport(390, 844);
  Ui.Theme("dark");
  Assert.Visible("Approve and run the plan");
  Ui.Shot("site-request-phone-dark");
  Ui.Theme("light");

  // The retention page lists the same categories the plan was made from, the desk's own among them.
  Ui.Viewport(1600, 1000);
  Ui.Visit("/settings/privacy");
  Assert.Visible("Conversations about a complaint or a dispute");
  Assert.Visible("What our team wrote on your tickets: what went wrong, and how it was solved");
  Ui.Shot("site-retention");
}
