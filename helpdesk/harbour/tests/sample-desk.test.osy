// A DESK AT REAL VOLUME — a month of a support team's work, for the tests, the screenshots and measuring the desk.
//
// ⛔ IT LIVES UNDER `tests/`, AND THAT IS THE GATE. Harbour is Osyrin's own support desk: real people's questions and
//   bug reports. Code under `tests/` is compiled only into a test run's throwaway branch, never into what `osy compile`
//   deploys — so a production desk has no function that could fill it with invented customers and tickets, by any
//   caller, through any door (the API, `osyrin run`, a page).
//   A test calls it as `SeedDemoDesk(n)` inside a `runas` of a desk admin; the memory harness fills a desk by running
//   one of those tests (`--seed demo/helpdesk:<test>:N`).
//
// `SeedDemoDesk()` writes ~30 customer companies with
// their people, 8 teammates, and `tickets` tickets over the last 30 days through the same model the desk uses —
// conversations with the customer's words, the team's replies and notes, statuses moved through the workflow. It is
// DETERMINISTIC (a seeded generator), so two runs make the same desk and a screenshot can be retaken.
//
// ⚑ THE HISTORY IS IMPORTED, CLOCKS AND ALL. Messages and events carry the time they happened, and so do the runs:
//   each ticket ARRIVED when its conversation started (`ArrivedAt`, which the inbox's run counts every promise from),
//   it was handed to its agent then (`WorkHandling.RaiseHandOver(…, at: …)`), and every move the seed makes is raised
//   AT the time it happened (`RaiseReply(t, at: …)` — the lifecycle tells the inbox at that same instant) — so each
//   ticket's SLA clock is as far along as its history says, and a desk seeded in one go reads like a month of work
//   rather than five hundred clocks started together.
//
// ⚑ AND NO TWO TICKETS READ ALIKE. Each request is a template rolled with its own details (an order number, a
//   country, an integration, a colleague's name) and a subject is never used twice; the templates are weighted (a
//   password reset comes in far more often than a DPA), and none is used twice within twenty rows of the queue's own
//   due-first order — so a screen of the list never shows the same complaint twice.
//
// ⚑ AND THE DESK IS COPING. An open ticket is timed against ITS OWN promise (its policy, in that policy's hours —
//   business hours are walked as business hours), so most clocks have plenty left, a few are in their last quarter
//   and a handful are past. A first screen of red is a desk in crisis, not a desk.
using Osysharp.Organizations;
using Osysharp.Organizations.ServicePlans;
using Osysharp.Identity;
using Osysharp.UserAccounts;
using Osysharp.Workflow;
using Osysharp.Conversations;
using Osysharp.ServiceHours;
using Osysharp.WorkQueues;
using Osysharp.Privacy;
using Osysharp.CustomFields;

/// A small, deterministic generator — the same seed gives the same desk.
public class Dice {
  public long State = 20261001;
  public int Next(int n) {
    State = (State * 1103515245 + 12345) % 2147483648;
    var v = Convert.ToInt(State / 65536);
    return n <= 0 ? 0 : v % n;
  }
  public string Of(string[] xs) { return xs[Next(xs.Length)]; }
}

/// One request as the desk would receive it.
public class Request {
  public string Subject;
  public string Text;
  public string Reply;
  public string Note;
  public string Tag;
  /// Its type — the key of the form it is filed on (the desk's starting types, `SetUpDesk`).
  public string Type = "question";
  /// How often this kind of request comes in, against the others — a password reset far more often than a DPA.
  public int Weight = 1;
}

List<Request> Requests() {
  return [
    R("Invoice {inv} shows the wrong VAT line", "The invoice {inv} lists 25% VAT on a reverse-charge order. Our accountant needs a corrected copy before {weekday}.", "Thanks for spotting this. The reverse-charge flag was missing on that order; I've corrected it and attached a fresh PDF of {inv}.", "Billing confirmed the flag bug only hits orders edited after checkout.", "billing", "problem", 2),
    R("Card payments failing for customers in {country}", "Since {time} every card payment from our customers in {country} is declined at the last step. Everywhere else is fine and we changed nothing.", "We can see the declines too: the 3-D Secure challenge is timing out with one acquirer for {country}. We've switched you to the fallback route while they fix it.", "3DS challenge timeouts on the primary route, {country} only.", "payments", "incident", 2),
    R("{format} export stuck at {pct}%", "The weekly {format} export has been at {pct}% since {time} and nobody on the team can start a new one.", "The export worker was waiting on a locked file. I've released it and your {format} export finished a minute ago.", "Lock on the export bucket again. Engineering has a ticket open for the retry logic.", "exports", "incident"),
    R("Move the {team} workspace to another account", "We're reorganising and need to move our {team} workspace under the parent company's account. Is that possible without losing history?", "Yes. An owner of both accounts can transfer it from Settings, Workspaces, Transfer. History, files and members all move with it.", "", "workspaces", "question"),
    R("{idp} sign-in lands people in the sandbox", "After signing in with {idp} some of our people end up in our sandbox tenant instead of production.", "The {idp} app still sends the sandbox as its default relay state. Setting it to your production address fixes it; steps below.", "Customer's IdP config, not ours. Sent the relay-state doc.", "sso", "problem"),
    R("Statement for {month} in Japanese", "Our finance team in Osaka would like the {month} statement in Japanese for their records.", "Statements are available in Japanese. I've switched your billing language and re-issued {month}; it's under Billing, Statements.", "", "billing", "question"),
    R("{integration} webhooks arriving twice", "Our endpoint receives each order.paid webhook from {integration} twice, about {n} seconds apart. We return 200 on the first.", "Your endpoint answers after 12 seconds, past our 10-second timeout, so we retry. Answering first and processing afterwards stops the duplicates.", "Their endpoint is slow. Not a bug, but the timeout could be clearer in the docs.", "webhooks", "question"),
    R("Password reset mail not arriving for {person}", "{person} has asked for a reset three times today and nothing arrives, not even in spam.", "Your mail filter is quarantining our reset messages. I've sent {person} a one-time sign-in link by text instead, and the details for your IT team.", "", "login", "problem", 3),
    R("Add {n} seats from 1 {month}", "We're hiring in {month}. Can we add {n} seats starting on the 1st rather than today?", "Done: {n} seats are scheduled from 1 {month}, and the first invoice for them comes with that renewal.", "", "seats", "task"),
    R("Chart labels unreadable in dark mode on {browser}", "In dark mode the axis labels on the revenue chart are dark grey on near-black in {browser}.", "Thanks, that's a bug in our dark theme. It's fixed in tonight's release; until then the light theme shows them correctly.", "Reproduced on {browser}. Linked to the theming fix.", "bug", "problem"),
    R("429s on /v2/orders at {n} requests a minute", "We're at about {n} requests a minute and still get 429s on /v2/orders. Our plan says 600.", "The limit is per token as well as per account, and your integration shares one token across several workers. A token per worker clears it.", "", "api", "question"),
    R("Refund for order {order} shows twice", "The refund for order {order} shows twice on the customer's card statement.", "One of the two is a pending authorisation that drops off within five days; only one refund was settled. The settlement report for {order} is attached.", "Checked with Finance: only one refund settled.", "refunds", "question", 2),
    R("iOS app signs everyone out after an hour", "Since the last update the iOS app signs everyone out roughly every hour. {person} lost a half-filled order twice today.", "Version 4.12 shortened the session by mistake. 4.12.1 is in review with Apple and restores the 30-day session.", "Engineering confirmed. Fix in 4.12.1.", "mobile", "incident"),
    R("CSV import rejects {n} rows with DD/MM/YYYY dates", "Our import file uses DD/MM/YYYY and {n} rows fail with 'invalid date'.", "The importer reads dates in your workspace's locale, which is set to US. Switching it to UK reads your file correctly.", "", "imports", "question", 2),
    R("Audit log export for our {month} ISO audit", "Our auditors arrive in {month} and want every admin action from the last 12 months as a file.", "You can export the audit log from Settings, Security, Audit log: choose the last 12 months and CSV. It includes admin, agent and API actions.", "", "security", "question"),
    R("Alerts still going to {person}", "Order alerts still go to {person}, who left in {month}. We removed them from the team.", "Their address was still on two alert rules. I've removed it from both and added your ops address instead.", "", "notifications", "task"),
    R("Shipping labels printing at A4 on the {site} printer", "Labels from the {site} warehouse come out at A4 instead of 4x6 since yesterday.", "The {site} printer profile reset after the update. Setting the label size back to 4x6 under Printing fixes it; screenshot attached.", "", "printing", "question"),
    R("Restrict {area} exports to admins", "We'd like only admins to be able to export {area} data.", "Yes: Settings, Roles, Members, untick 'Export data'. Admins keep it.", "", "permissions", "question"),
    R("{integration} sync has not run since {weekday}", "The nightly sync to {integration} has not run since {weekday}. No errors in our logs.", "Your {integration} API key expired on {weekday}. Once a new key is entered under Integrations the sync catches up by itself.", "", "integrations", "problem", 2),
    R("Quote for {n} more seats", "We're rolling out to the warehouse teams. What would {n} more seats cost on our plan?", "I've passed this to your account manager, who'll send a quote today; volume pricing starts at 150 seats.", "Sales loop: the account manager owns this account.", "sales", "question"),
    R("Two-step codes rejected for {person}", "{person}'s authenticator codes are rejected every time since they got a new phone.", "The new phone's clock was four minutes off. Turning on automatic time fixed it, and here are the recovery steps in case.", "", "login", "question", 2),
    R("Keep {country} customer data in region", "Can our customers' data in {country} stay in the region? Our DPA requires it.", "Yes. New workspaces can be created in the EU region, and existing ones moved. I've attached our DPA and the region guide.", "", "security", "question"),
    R("{month} report says {n} orders more than the dashboard", "The {month} report shows {n} more orders than the dashboard for the same month.", "The dashboard excludes cancelled orders and the report includes them; {n} were cancelled in {month}. A filter on the report makes them match.", "", "reports", "question"),
    R("Portal still shows our old logo", "Our customer portal still shows the old logo after {person} updated it on {weekday}.", "The new logo was uploaded to the email settings rather than the portal. I've copied it across; a hard refresh shows it.", "", "branding", "task"),
    R("Search finds nothing before {month}", "Searching for any order from before {month} returns no results, though the orders are there.", "Search covers the last 12 months by default. The 'All time' toggle under the search box finds the older ones.", "", "search", "question"),
