  ];
}

/// The details one request is written with — rolled ONCE per ticket (so its subject, its words and the reply agree),
/// and different for every ticket, so no two read alike.
public class Details {
  public string Inv = "";
  public string Order = "";
  public string N = "";
  public string Big = "";
  public string Pct = "";
  public string Mb = "";
  public string V = "";
  public string Time = "";
  public string Weekday = "";
  public string Month = "";
  public string Country = "";
  public string Format = "";
  public string Team = "";
  public string Idp = "";
  public string Integration = "";
  public string Browser = "";
  public string Site = "";
  public string Area = "";
  public string Project = "";
  public string Calendar = "";
  public string Mailhost = "";
  public string Currency = "";
  public string Holiday = "";
  public string Brand = "";
  public string Code = "";
  public string City = "";
  public string Language = "";
  public string Person = "";
  public void Roll(Dice d, string person) {
    Inv = "INV-" + (4100 + d.Next(5800));
    Order = (10000 + d.Next(89999)).ToString();
    N = (3 + d.Next(60)).ToString();
    Big = (1200 + d.Next(8000)).ToString("N0");
    Pct = (80 + d.Next(19)).ToString();
    Mb = (30 + d.Next(70)).ToString();
    V = (2 + d.Next(3)).ToString();
    Time = (7 + d.Next(10)).ToString("00") + ":" + (d.Next(12) * 5).ToString("00");
    Weekday = d.Of(["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]);
    Month = d.Of(["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]);
    Country = d.Of(["Germany", "France", "Spain", "Italy", "the Netherlands", "Poland", "Ireland", "Portugal", "Austria", "Belgium", "Denmark", "Finland"]);
    Format = d.Of(["CSV", "Excel", "PDF", "JSON", "Parquet"]);
    Team = d.Of(["Marketing", "Finance", "Support", "Operations", "Design", "Sales", "Logistics"]);
    Idp = d.Of(["Okta", "Azure AD", "Google Workspace", "OneLogin", "JumpCloud"]);
    Integration = d.Of(["Shopify", "Salesforce", "HubSpot", "NetSuite", "Xero", "QuickBooks", "Zapier", "WooCommerce", "Dynamics 365"]);
    Browser = d.Of(["Safari", "Firefox", "Edge", "Chrome on Android", "Brave"]);
    Site = d.Of(["Leeds", "Rotterdam", "Lyon", "Gdańsk", "Dublin", "Malmö", "Porto"]);
    Area = d.Of(["customer", "order", "invoice", "contact", "product"]);
    Project = d.Of(["Atlas", "Beacon", "Harbour", "Juniper", "Northstar", "Pioneer", "Quarry"]);
    Calendar = d.Of(["Outlook", "Google Calendar", "Apple Calendar"]);
    Mailhost = d.Of(["Gmail", "Outlook.com", "Yahoo Mail", "iCloud Mail", "GMX"]);
    Currency = d.Of(["kr", "€", "£", "zł", "CHF"]);
    Holiday = d.Of(["Easter Monday", "Whit Monday", "Boxing Day", "Ascension Day", "May Day"]);
    Brand = d.Of(["our own name", "the store's name", "our support address"]);
    Code = d.Of(["SPRING", "WELCOME", "AUTUMN", "VIP", "BACK2SCHOOL", "FRIENDS", "LOYAL"]) + (5 + d.Next(45));
    City = d.Of(["Hamburg", "Utrecht", "Bilbao", "Turin", "Kraków", "Cork", "Aarhus", "Tampere", "Graz", "Ghent"]);
    Language = d.Of(["German", "French", "Spanish", "Italian", "Dutch", "Polish", "Swedish", "Portuguese"]);
    Person = person;
  }
  public string Fill(string s) {
    var r = s;
    r = r.Replace("{inv}", Inv);
    r = r.Replace("{order}", Order);
    r = r.Replace("{n}", N);
    r = r.Replace("{big}", Big);
    r = r.Replace("{pct}", Pct);
    r = r.Replace("{mb}", Mb);
    r = r.Replace("{v}", V);
    r = r.Replace("{time}", Time);
    r = r.Replace("{weekday}", Weekday);
    r = r.Replace("{month}", Month);
    r = r.Replace("{country}", Country);
    r = r.Replace("{format}", Format);
    r = r.Replace("{team}", Team);
    r = r.Replace("{idp}", Idp);
    r = r.Replace("{integration}", Integration);
    r = r.Replace("{browser}", Browser);
    r = r.Replace("{site}", Site);
    r = r.Replace("{area}", Area);
    r = r.Replace("{project}", Project);
    r = r.Replace("{calendar}", Calendar);
    r = r.Replace("{mailhost}", Mailhost);
    r = r.Replace("{currency}", Currency);
    r = r.Replace("{holiday}", Holiday);
    r = r.Replace("{brand}", Brand);
    r = r.Replace("{code}", Code);
    r = r.Replace("{city}", City);
    r = r.Replace("{language}", Language);
    r = r.Replace("{person}", Person);
    return r;
  }
}

Request R(string subject, string text, string reply, string note, string tag, string type, int weight = 1) {
  return new Request { Subject = subject, Text = text, Reply = reply, Note = note, Tag = tag, Type = type, Weight = weight };
}

/// Which request template a seeded subject was written from (its index in `Requests()`), or -1 for none — read by
/// matching the template's fixed words in order around its `{…}` holes. The tests use it to check the desk's variety.
int TemplateOf(string subject) {
  var requests = Requests();
  for (var k = 0; k < requests.Count; k++) {
    if (Fits(requests[k].Subject, subject)) { return k; }
  }
  return -1;
}

/// Does `subject` read as `template` with its `{…}` holes filled? Each fixed piece in order: the first at the start,
/// the last at the end, the ones between somewhere after the one before.
bool Fits(string template, string subject) {
  var pieces = new List<string>();
  var rest = template;
  while (rest.Contains("{")) {
    var open = rest.IndexOf("{");
    pieces.Add(rest.Substring(0, open));
    rest = rest.Substring(rest.IndexOf("}") + 1);
  }
  pieces.Add(rest);
  if (pieces.Count == 1) { return subject == template; }
  if (!subject.StartsWith(pieces[0]) || !subject.EndsWith(pieces[pieces.Count - 1])) { return false; }
  var at = pieces[0].Length;
  for (var k = 1; k < pieces.Count - 1; k++) {
    if (pieces[k] == "") { continue; }
    var found = subject.IndexOf(pieces[k], at);
    if (found < 0) { return false; }
    at = found + pieces[k].Length;
  }
  return subject.Length - pieces[pieces.Count - 1].Length >= at;
}

/// The desk as a team that already runs it has it: its starting statuses, queues and promises (`SetUpDesk`), and who is
/// responsible for its customers' data NAMED. A fresh install asks an admin to name that — the banner on every desk page
/// until they do, which is right there and is proven by the privacy tests (they set the desk up without this). A test or
/// a screenshot of the working desk has answered it, so the shots show the product rather than its first-run prompt.
/// Answers false when the desk was already set up.
bool SetUpTestDesk() {
  var made = SetUpDesk();
  if (!PrivacyController.Any(c => c.LegalName != "")) {
    new PrivacyController { LegalName = "Harbour Desk Ltd" };
    UnitOfWork.Commit();
  }
  return made;
}

/// Fill the desk. Answers how many tickets it made; 0 when the desk already has tickets.
int SeedDemoDesk(int tickets = 500) {
  if (Ticket.Any()) { return 0; }
  SetUpTestDesk();
  // A desk that is live reads its mailbox: mail to support@ becomes tickets from the moment the desk is filled.
  WatchSupportMailbox();
  var dice = new Dice();
  // The answers to the desk's fields come from a die of their own: they draw nothing from the desk's die, so adding
  // them changed no request, customer or history the seed rolls.
  var fieldDice = new Dice { State = 20261002 };
  var asking = SeedDeskFields();
  var now = DateTime.UtcNow;
  var me = User.FirstOrDefault(a => a.Id == Session.CurrentUser!.Id);

  // ── the team ─────────────────────────────────────────────────────────────────────────────────────────────────
  // A teammate is an ACCOUNT, and accounts are the sign-in flow's (or an operator's) alone to make — so the team is
  // whoever already has one and a desk role: an invited teammate is an `Agent`, an account an operator added with
  // `osy user add <email> --role Admin` is a `User`. Every one of them is put on the desk's queues.
  var team = User.Where(a => a.IsActive).OrderBy(a => a.Email).ToList()
    .Where(a => RoleGrant.Any(g => g.Member == a && (g.Role == AppRole.Agent || g.Role == AppRole.Lead || g.Role == AppRole.Admin)))
    .ToList();
  if (team.Count == 0) { throw new ValidationException("Nobody on the team has a role yet — give someone the Agent role first."); }
  // Everybody on the team works the desk's queues (only a queue's members may hold its tickets).
  foreach (var a in team) { JoinTheDesk(a); }
  var standard = TierNamed("Standard");
  var premium = TierNamed("Premium");
  var enterprise = TierNamed("Enterprise");

  // ── the customers ────────────────────────────────────────────────────────────────────────────────────────────
  var companyNames = ["Larkspur Freight", "Orbit Labs", "Kestrel Bank", "Alpenglow Outdoors", "Brightline Health",
    "Cobalt Studio", "Driftwood Hotels", "Evergreen Grocers", "Fathom Analytics", "Granite Legal", "Harborview Clinic",
    "Ironbark Logistics", "Juniper Schools", "Keystone Insurance", "Lumen Energy", "Meridian Travel", "Nimbus Cloud",
    "Oakridge Realty", "Pinecrest Foods", "Quill Publishing", "Redwood Outfitters", "Saltmarsh Marine", "Tidewater Ports",
    "Umber Coffee", "Vantage Media", "Willow Care", "Xenon Robotics", "Yardline Sports", "Zephyr Air", "Copperleaf Finance"];
  var first = ["Hanna", "Tomás", "Dev", "Maya", "Jonas", "Aiko", "Ruth", "Pierre", "Sofia", "Liam", "Amara", "Kenji", "Olivia",
    "Mateo", "Priya", "Noah", "Zainab", "Lucas", "Ingrid", "Omar", "Chloé", "Arjun", "Freya", "Diego", "Yara", "Felix",
    "Nia", "Emil", "Leila", "Sam"];
  var last = ["Lindqvist", "Aguirre", "Patel", "Chen", "Weber", "Tanaka", "Okafor", "Laurent", "Rossi", "O'Brien", "Mensah",
    "Sato", "Brandt", "García", "Raman", "Murphy", "Haddad", "Silva", "Nilsen", "Farouk", "Dubois", "Nair", "Holm",
    "Torres", "Saleh", "Becker", "Owusu", "Berg", "Rahimi", "Kowalski"];
  var people = new List<Customer>();
  for (var i = 0; i < companyNames.Count; i++) {
    var cn = companyNames[i];
    var domain = cn.ToLower().Replace(" ", "") + ".test";
    var tier = i % 7 == 1 ? enterprise : (i % 3 == 1 ? premium : standard);
    var company = new Company { Name = cn, Tier = tier, SharesTickets = i % 2 == 0,
                                Notes = i % 4 == 0 ? "Renewal in " + ["March", "June", "September", "November"][i % 4 == 0 ? (i / 4) % 4 : 0] + " — keep the account manager in the loop." : null };
    new OrganizationDomain { Organization = company, Domain = domain };
    if (tier != standard) { AddToAccountTeam(company, team[dice.Next(team.Count)], AccountTeamRole.Owner); }
    var count = 2 + dice.Next(3);
    for (var k = 0; k < count; k++) {
      var f = dice.Of(first);
      var l = dice.Of(last);
      var c = new Customer { DisplayName = f + " " + l, Company = company, CreatedByVisit = null };
      var email = f.ToLower().Replace("á", "a").Replace("é", "e").Replace("í", "i") + "." + l.ToLower().Replace("'", "").Replace("í", "i").Replace("é", "e") + "@" + domain;
      new ContactPoint { Party = c, Kind = ContactPointKind.Email, Value = email, IsPreferred = true };
      people.Add(c);
    }
  }
  UnitOfWork.Commit();

  // ── a month of tickets ───────────────────────────────────────────────────────────────────────────────────────
  // Three passes. (1) PLAN every ticket: who, how urgent, where it ends up, and when each step happened — the open
  // ones timed against their own SLA promise, so the desk is mostly on time, a few tickets at risk and a handful late
  // (as a desk that is coping looks), rather than a first screen of red. (2) WRITE the plans, in the order the queue
  // will show them (due first), each with a request that none of the twenty before it used. (3) MAKE them.
  var requests = Requests();
  var statuses = TicketStatus.ToList();
  var colleagues = ["Anna", "Ben", "Carla", "Dmitri", "Eva", "Femi", "Greta", "Hugo", "Isla", "Jakob", "Kira", "Luis"];
  var followUps = [
    "Thanks, that helped, but it happened again an hour ago. Could you take another look?",
    "Quick follow-up: is there any news on this?",
    "We tried that and nothing changed, I'm afraid.",
    "{person} says it's still happening on their side.",
    "Could you send the steps in writing? Our IT team needs them before {weekday}.",
    "That fixed most of it, but the {month} numbers are still off.",
  ];
  var calendars = new Calendars();
  // Read once: the policies and the default tier (a query per ticket was most of the planning time).
  var policies = Promises();
  var fallbackTier = DefaultTier();
  var plans = new List<Plan>();
  for (var i = 0; i < tickets; i++) {
    var p = new Plan { Index = i, Who = people[dice.Next(people.Count)] };
    // Where it ends up, by age: old work is mostly done; this week's is mostly live.
    // A month of work: most of it spread over the 30 days, a third of it from the last three.
    var ageMinutes = dice.Next(10) < 7 ? dice.Next(60 * 24 * 30) : dice.Next(60 * 24 * 3) + 5;
    // A desk always has work just in: one ticket in ten arrived a moment ago and nobody has picked it up.
    p.JustIn = i % 10 == 0;
    var roll = dice.Next(100);
    p.Stage = ageMinutes > 60 * 24 * 6
      // A week-old ticket is settled: closed, solved, or waiting on its customer — a desk does not leave week-old
      // answers sitting in Open, and a seed that did drew a queue of nothing but long-breached promises.
      ? (roll < 76 ? Stage.Closed : (roll < 93 ? Stage.Solved : Stage.Pending))
      : ageMinutes > 60 * 24
        ? (roll < 40 ? Stage.Solved : (roll < 60 ? Stage.Pending : (roll < 68 ? Stage.OnHold : (roll < 85 ? Stage.Answered : Stage.Open))))
        : (roll < 35 ? Stage.New : (roll < 60 ? Stage.Open : (roll < 80 ? Stage.Answered : (roll < 90 ? Stage.Pending : Stage.Solved))));
    if (p.JustIn) { p.Stage = Stage.New; }
    p.Agent = team[dice.Next(team.Count)];
    if (me != null && p.Stage != Stage.Closed && dice.Next(8) == 0) { p.Agent = me; }
    p.Assigned = p.JustIn ? null
      : (p.Stage == Stage.New ? (dice.Next(3) == 0 ? p.Agent : null) : (dice.Next(9) == 0 && p.Stage == Stage.Open ? null : p.Agent));
    var priorityRoll = dice.Next(100);
    p.Priority = priorityRoll < 6 ? WorkPriority.Urgent : (priorityRoll < 24 ? WorkPriority.High : (priorityRoll < 88 ? WorkPriority.Normal : WorkPriority.Low));
    p.ByMail = dice.Next(10) < 6;
    var tier = p.Who.Company != null && p.Who.Company.Tier != null ? p.Who.Company.Tier : fallbackTier;
    var policy = PolicyIn(policies, p.Priority, tier);
    if (Owed(p.Stage)) { TimeOwed(p, policy, calendars.Of(policy.ServiceHours!), dice, now); }
    else { TimeSettled(p, ageMinutes, dice, now); }
    plans.Add(p);
  }

  // (2) The queue's own order — the inbox's "All open, due first": the tickets being worked (new, owed, answered —
  // on hold is the inbox's Waiting), soonest due first with the missed ones on top, then everything else. Each ticket
  // gets its request as it is MADE (step 3, in plan order, so the desk starts filling at once), and the request is one
  // no ticket within eighteen places of it in THIS order already has — so whichever order the tickets are written in,
  // no screen of the queue shows the same complaint twice. Weighted (a password reset far more often than a DPA), and
  // never a subject the desk already has.
  // A missed promise still owed sorts first (counted from the miss), then every running clock — an answered ticket's
  // is its resolution deadline, which the list counts down too — then everything the view does not hold.
  var order = plans.OrderBy(p => Counting(p) ? (p.Due!.Value < now ? 0 : 1) : 2).ThenBy(p => Counting(p) ? p.Due : null)
    .ThenBy(p => p.Opened).ToList();
  var place = new Dictionary<int, int>();
  for (var q = 0; q < order.Count; q++) { place[order[q].Index] = q; }
  var slot = new List<int>();
  foreach (var x in order) { slot.Add(-1); }
  var used = new HashSet<string>();
  // A spent request (a subject with no details left to vary) is never offered again.
  var spent = new HashSet<int>();

  // (3) Make them, in the order they were planned (so ticket numbers are not sorted by due time).
  var made = 0;
  foreach (var p in plans) {
    var at0 = place[p.Index];
    var near = new HashSet<int>();
    for (var j = Math.Max(0, at0 - 18); j <= Math.Min(order.Count - 1, at0 + 18); j++) {
      if (slot[j] >= 0) { near.Add(slot[j]); }
    }
    p.Details = new Details();
    var tries = 0;
    while (p.Template < 0 && tries < 200) {
      var k = PickRequest(requests, near, spent, dice);
      for (var go = 0; go < 30 && p.Template < 0; go++) {
        p.Details.Roll(dice, dice.Of(colleagues));
        var subject = p.Details.Fill(requests[k].Subject);
        if (!used.Contains(subject)) { p.Template = k; p.Subject = subject; }
      }
      if (p.Template < 0) { spent.Add(k); }
      tries = tries + 1;
    }
    used.Add(p.Subject);
    slot[at0] = p.Template;
    var req = requests[p.Template];
    var who = p.Who;
    var details = p.Details;
    var opened = p.Opened;
    var conversation = new Conversation { Subject = p.Subject, StartedAt = opened, LastEntryAt = opened,
                                          LastCustomerEntryAt = opened, ReplyChannel = p.ByMail ? "email" : "web",
                                          ReplyEndpoint = p.ByMail ? "support@helpdesk.test" : "portal" };
    new Participant { Conversation = conversation, Party = who, Role = ParticipantRole.Customer, JoinedAt = opened };
    new Message { Conversation = conversation, At = opened, Visibility = EntryVisibility.Customer,
                  Direction = MessageDirection.Inbound, ChannelKey = p.ByMail ? "email" : "web",
                  Endpoint = p.ByMail ? "support@helpdesk.test" : "portal", Text = details.Fill(req.Text), ByParty = who, ByName = who.DisplayName };
    var agent = p.Agent;
    var assigned = p.Assigned;
    var ticket = NewTicket(p.Subject, conversation, who, asking.TypeOf(req.Type), p.Priority);
    ticket.ArrivedAt = opened;
    ticket.RootCause = req.Type == "incident" ? "Recorded by the team." : null;
    var at = opened;
    // A month of history is IMPORTED history: each line names the agent who wrote it and claims no member, because
    // an entry made by a member is made by that member (Osysharp.Conversations' an-entry-is-signed-by-its-writer)
    // and this runs as one admin. An importer from another helpdesk writes it the same way.
    if (p.Stage != Stage.New) {
      at = p.Replied;
      new Message { Conversation = conversation, At = at, Visibility = EntryVisibility.Customer, Direction = MessageDirection.Outbound,
                    ChannelKey = p.ByMail ? "email" : "web", Endpoint = p.ByMail ? "support@helpdesk.test" : "portal",
                    Text = dice.Of(["Hi ", "Hello ", "Thanks for writing in, "]) + who.DisplayName.Split(" ")[0] + ",\n\n"
                      + details.Fill(req.Reply) + "\n\n" + agent.DisplayName + "\nHarbour Support",
                    ByName = agent.DisplayName };
      if (req.Note != "" && dice.Next(2) == 0) {
        new Message { Conversation = conversation, At = at.AddMinutes(-6), Visibility = EntryVisibility.Internal,
                      Direction = MessageDirection.Internal, ChannelKey = "internal", Text = details.Fill(req.Note),
                      ByName = agent.DisplayName };
      }
    }
    if (p.Stage == Stage.Open) {
      at = p.Wrote;
      new Message { Conversation = conversation, At = at, Visibility = EntryVisibility.Customer, Direction = MessageDirection.Inbound,
                    ChannelKey = p.ByMail ? "email" : "web", Text = details.Fill(dice.Of(followUps)),
                    ByParty = who, ByName = who.DisplayName };
      conversation.LastCustomerEntryAt = at;
    }
    conversation.LastEntryAt = at;
    if (req.Tag != "" && dice.Next(3) > 0) {
      var tag = Tag.FirstOrDefault(g => g.Name == req.Tag) ?? new Tag { Name = req.Tag };
      new TicketTag { Ticket = ticket, Tag = tag };
    }
    AnswerSeeded(ticket, req, p.Stage, opened, asking, fieldDice);
    UnitOfWork.Commit();
    // Handed to its agent when they picked it up — a few minutes after it arrived (the inbox records the hand-over, and
    // its trail and the ticket's timeline say so, at that time).
    if (assigned != null) {
      var pickedUp = Between(p.Opened, p.Opened.AddMinutes(2 + dice.Next(20)), p.Stage == Stage.New ? now.AddMinutes(-1) : p.Replied);
      WorkHandling.RaiseHandOver(ticket, assigned, null, at: pickedUp);
    }
    MoveSeeded(ticket, p.Stage, statuses, dice,
               new History { Opened = p.Opened, Replied = p.Replied, Wrote = p.Wrote, Moved = p.Moved, Closed = p.Closed });
    made = made + 1;
  }
  return made;
}

/// One seeded ticket before it is written — everything decided about it, in the order it was decided.
public class Plan {
  public int Index;
  public Customer Who;
  public bool JustIn;
  public Stage Stage = Stage.New;
  public User Agent;
  public User? Assigned;
  public WorkPriority Priority = WorkPriority.Normal;
  public bool ByMail;
  public DateTime Opened = DateTime.UtcNow;
  public DateTime Replied = DateTime.UtcNow;
  public DateTime Wrote = DateTime.UtcNow;
  public DateTime Moved = DateTime.UtcNow;
  public DateTime Closed = DateTime.UtcNow;
  /// When the clock the queue shows runs out — set only for a ticket the team owes something.
  public DateTime? Due;
  public int Template = -1;
  public string Subject = "";
  public Details Details;
}

/// Is a ticket in `s` being worked — what the inbox's "All open" lists (on hold waits, under Waiting)?
bool Worked(Stage s) => s == Stage.New || s == Stage.Open || s == Stage.Answered;

/// Does the list show a countdown for this ticket — worked, with a promise still running (a reply, or the resolution of
/// an answered one)?
bool Counting(Plan p) => p.Due != null && Worked(p.Stage);

/// Does the team owe a ticket in `s` something on a clock?
bool Owed(Stage s) => s == Stage.New || s == Stage.Open || s == Stage.Answered || s == Stage.OnHold;

/// Time a ticket the team owes against its own promise, so the queue reads like a desk that is coping: most clocks
/// with plenty left, about one in twelve in their last stretch, and a handful (one in thirty) past. `f` is how much of
/// the promise has been used — counted in the policy's own hours, so business hours are business hours.
void TimeOwed(Plan p, Promised policy, Calendar hours, Dice dice, DateTime now) {
  var band = dice.Next(100);
  var f = band < 89 ? 0.05 + dice.Next(60) / 100.0          // on time: 5–64% used
    : (band < 97 ? 0.78 + dice.Next(17) / 100.0              // at risk: 78–94% used
    : 1.05 + dice.Next(70) / 100.0);                          // late: 5–74% past it
  if (p.JustIn) { f = 0.02 + dice.Next(25) / 100.0; }
  if (p.Stage == Stage.New) {
    // The first-reply clock runs from the moment it arrived.
    p.Opened = hours.Back(now, Scale(policy.FirstReplyWithin, f));
    p.Due = hours.Back(now, Scale(policy.FirstReplyWithin, f - 1.0));
    p.Replied = p.Opened; p.Wrote = p.Opened; p.Moved = p.Opened; p.Closed = p.Opened;
    return;
  }
  if (p.Stage == Stage.Open) {
    // The customer wrote again: the next-reply clock runs from their message. Before it, the request and the team's
    // first answer, close enough together that the resolution clock is not the one in trouble.
    p.Wrote = hours.Back(now, Scale(policy.NextReplyWithin, f));
    p.Opened = p.Wrote.AddMinutes(-(policy.ResolveWithin.TotalMinutes * (0.05 + dice.Next(25) / 100.0)));
    p.Replied = Between(p.Opened, hours.Forward(p.Opened, Scale(policy.FirstReplyWithin, 0.2 + dice.Next(60) / 100.0)), p.Wrote.AddMinutes(-5));
    p.Due = hours.Back(now, Scale(policy.NextReplyWithin, f - 1.0));
    p.Moved = p.Wrote; p.Closed = p.Wrote;
    return;
  }
  // Answered, or on hold: only the resolution clock runs, from the request. The first reply came well inside its own
  // promise, and a hold some while after it.
  p.Opened = hours.Back(now, Scale(policy.ResolveWithin, f));
  p.Replied = Between(p.Opened, hours.Forward(p.Opened, Scale(policy.FirstReplyWithin, 0.2 + dice.Next(60) / 100.0)), now.AddMinutes(-2));
  p.Moved = Later(p.Replied, 2 + dice.Next(90), now);
  p.Wrote = p.Replied; p.Closed = p.Moved;
  p.Due = hours.Back(now, Scale(policy.ResolveWithin, f - 1.0));
}

/// Time a ticket nobody owes anything on a clock — waiting on its customer, solved, or closed — by its age alone.
void TimeSettled(Plan p, int ageMinutes, Dice dice, DateTime now) {
  p.Opened = now.AddMinutes(-ageMinutes);
  p.Replied = Later(p.Opened, 15 + dice.Next(240), now);
  p.Wrote = p.Replied;
  // Where it went next, and when: a pend soon after the reply, a solve some hours later, a close days later.
  p.Moved = p.Stage == Stage.Pending ? Later(p.Replied, 2 + dice.Next(90), now) : Later(p.Replied, 30 + dice.Next(60 * 30), now);
  p.Closed = p.Stage == Stage.Closed ? Later(p.Moved, 60 * 24 + dice.Next(60 * 24 * 3), now) : p.Moved;
}

/// `span` scaled by `f` — negative when `f` is.
TimeSpan Scale(TimeSpan span, double f) => TimeSpan.FromMinutes(span.TotalMinutes * f);

/// `t`, kept between `from` and `to` (and `from` when the two have crossed).
DateTime Between(DateTime from, DateTime t, DateTime to) {
  if (t > to) { t = to; }
  return t < from ? from : t;
}

/// What a policy promises, read once for the whole seed — its three budgets and the hours they count in.
public class Promised {
  public WorkPriority? Priority;
  public Guid? Tier;
  public TimeSpan FirstReplyWithin;
  public TimeSpan NextReplyWithin;
  public TimeSpan ResolveWithin;
  public Osysharp.ServiceHours.ServiceHours? ServiceHours;
}

/// Every active policy with its targets — two reads, however many tickets are planned.
List<Promised> Promises() {
  var targets = SlaTarget.Include(t => t.Policy).ToList();
  var all = new List<Promised>();
  foreach (var x in Osysharp.WorkQueues.SlaPolicy.Where(x => x.Active).Include(x => x.Tier).Include(x => x.Hours).ToList()) {
    var mine = targets.Where(t => t.Policy.Id == x.Id).ToList();
    all.Add(new Promised { Priority = x.Priority, Tier = x.Tier == null ? null : x.Tier.Id, ServiceHours = x.Hours,
      FirstReplyWithin = mine.Where(t => t.Metric == SlaMetric.FirstResponse).Select(t => t.Within).FirstOrDefault(),
      NextReplyWithin = mine.Where(t => t.Metric == SlaMetric.NextResponse).Select(t => t.Within).FirstOrDefault(),
      ResolveWithin = mine.Where(t => t.Metric == SlaMetric.Resolution).Select(t => t.Within).FirstOrDefault() });
  }
  return all;
}

/// The inbox's choice over policies already read — the tier's own policy for the priority, else the default one (the
/// desk's policies state a priority and, sometimes, a tier: the most specific match is exactly this).
Promised PolicyIn(List<Promised> all, WorkPriority priority, OrganizationTier? tier) {
  if (tier != null) {
    foreach (var x in all) { if (x.Priority == priority && x.Tier != null && x.Tier.Value == tier.Id) { return x; } }
  }
  foreach (var x in all) { if (x.Priority == priority && x.Tier == null) { return x; } }
  return all[0];
}

/// A weighted request no ticket `near` this one in the queue has, and not `spent`.
int PickRequest(List<Request> requests, HashSet<int> near, HashSet<int> spent, Dice dice) {
  var total = 0;
  for (var k = 0; k < requests.Count; k++) {
    if (!near.Contains(k) && !spent.Contains(k)) { total = total + requests[k].Weight; }
  }
  var pick = dice.Next(total);
  for (var k = 0; k < requests.Count; k++) {
    if (near.Contains(k) || spent.Contains(k)) { continue; }
    if (pick < requests[k].Weight) { return k; }
    pick = pick - requests[k].Weight;
  }
  return dice.Next(requests.Count);
}

/// An SLA calendar the seed can walk — the policy's service hours as their windows, in their zone. With no windows it
/// is the clock on the wall.
public class Calendar {
  public List<ServiceWindow> Windows = [];
  public Zone Tz;

  /// The instant `span` of working time before `at` (after it, for a negative span) — where a clock that has used
  /// `span` by `at` started.
  public DateTime Back(DateTime at, TimeSpan span) {
    if (span.TotalMinutes < 0.0) { return Forward(at, TimeSpan.FromMinutes(-span.TotalMinutes)); }
    if (Windows.Count == 0) { return at.AddMinutes(-span.TotalMinutes); }
    var left = span.TotalMinutes;
    var day = DateOnly.FromDateTime(at.InZone(Tz));
    for (var d = 0; d < 400; d++) {
      var date = day.AddDays(-d);
      foreach (var w in Windows.Where(x => x.Day == date.DayOfWeek).OrderByDescending(x => x.Start).ToList()) {
        var s = Tz.Resolve(date, TimeOnly.FromTimeSpan(w.Start));
        var e = Tz.Resolve(date, TimeOnly.FromTimeSpan(w.End));
        if (e > at) { e = at; }
        if (s >= e) { continue; }
        var have = (e - s).TotalMinutes;
        if (have >= left) { return e.AddMinutes(-left); }
        left = left - have;
      }
    }
    return at.AddMinutes(-span.TotalMinutes);
  }

  /// The instant `span` of working time after `from`.
  public DateTime Forward(DateTime from, TimeSpan span) {
    if (Windows.Count == 0) { return from.AddMinutes(span.TotalMinutes); }
    var left = span.TotalMinutes;
    var day = DateOnly.FromDateTime(from.InZone(Tz));
    for (var d = 0; d < 400; d++) {
      var date = day.AddDays(d);
      foreach (var w in Windows.Where(x => x.Day == date.DayOfWeek).OrderBy(x => x.Start).ToList()) {
        var s = Tz.Resolve(date, TimeOnly.FromTimeSpan(w.Start));
        var e = Tz.Resolve(date, TimeOnly.FromTimeSpan(w.End));
        if (s < from) { s = from; }
        if (s >= e) { continue; }
        var have = (e - s).TotalMinutes;
        if (have >= left) { return s.AddMinutes(left); }
        left = left - have;
      }
    }
    return from.AddMinutes(span.TotalMinutes);
  }
}

/// Each policy's calendar, read once.
public class Calendars {
  public Dictionary<Guid, Calendar> Known = new Dictionary<Guid, Calendar>();
  public Calendar Of(Osysharp.ServiceHours.ServiceHours hours) {
    if (Known.ContainsKey(hours.Id)) { return Known[hours.Id]; }
    var c = new Calendar { Tz = hours.Zone, Windows = ServiceWindow.Where(w => w.ServiceHours == hours).ToList() };
    Known[hours.Id] = c;
    return c;
  }
}

/// When each step of a seeded ticket's history happened.
public class History {
  public DateTime Opened;
  public DateTime Replied;
  public DateTime Wrote;
  public DateTime Moved;
  public DateTime Closed;
}

/// `minutes` after `after`, but never later than a minute ago — history is in the past.
DateTime Later(DateTime after, int minutes, DateTime now) {
  var t = after.AddMinutes(minutes);
  var latest = now.AddMinutes(-1);
  if (t > latest) { t = latest; }
  return t < after ? after : t;
}

/// Walk a seeded ticket's run to where its history says it is — each move raised AT the time it happened, so the
/// clocks it arms count from then (the run itself started when the conversation did: `StartedAt` in workflow.osy).
void MoveSeeded(Ticket t, Stage stage, List<TicketStatus> statuses, Dice dice, History h) {
  if (stage == Stage.New) { return; }
  SupportTicket.RaiseReply(t, at: h.Replied);
  if (stage == Stage.Open) { SupportTicket.RaiseCustomerWrote(t, at: h.Wrote); }
  if (stage == Stage.Pending) {
    var waiting = statuses.Where(s => s.Category == StatusCategory.Pending).ToList();
    t.Status = waiting[dice.Next(waiting.Count)];
    SupportTicket.RaisePend(t, at: h.Moved);
  }
  if (stage == Stage.OnHold) {
    var holding = statuses.Where(s => s.Category == StatusCategory.OnHold).ToList();
    t.Status = holding[dice.Next(holding.Count)];
    SupportTicket.RaiseHold(t, t.Status.Name, at: h.Moved);
  }
  if (stage == Stage.Solved || stage == Stage.Closed) { SupportTicket.RaiseSolve(t, "Answered.", at: h.Moved); }
  if (stage == Stage.Closed) { SupportTicket.RaiseClose(t, at: h.Closed); }
  UnitOfWork.Commit();
}

// ── the desk's fields ───────────────────────────────────────────────────────────────────────────────────────────────

/// What the sample desk asks, and on which form.
public class SeedAsking {
  public TicketForm Question;
  public TicketForm Problem;
  public TicketForm Outage;
  public TicketForm TeamTask;
  public TicketField Product;
  public TicketField Order;
  public TicketField Worked;
  public TicketField Since;
  public TicketField Area;
  /// The form a request of this type is filed on.
  public TicketForm TypeOf(string type) {
    if (type == "problem") { return Problem; }
    if (type == "incident") { return Outage; }
    if (type == "task") { return TeamTask; }
    return Question;
  }
}

/// A store's support desk asks which part of the product it is about, always; for a problem also the order, whether it
/// worked before and — only then — since when; and the team files the area it lands in.
SeedAsking SeedDeskFields() {
  var product = new TicketField { Name = "Product", Kind = FieldKind.Choice, Public = true, Required = true, Position = 0,
                                  Options = "Storefront\nCheckout and payments\nIntegrations\nReports\nAccount and sign-in" };
  var order = new TicketField { Name = "Order number", Kind = FieldKind.Text, Public = true, Position = 1,
                                Hint = "On the receipt, like 42494." };
  var worked = new TicketField { Name = "Did it work before?", Kind = FieldKind.YesNo, Public = true, Position = 2 };
  var since = new TicketField { Name = "Broken since", Kind = FieldKind.Date, Public = true, Position = 3 };
  var area = new TicketField { Name = "Area", Kind = FieldKind.Choice, Position = 4,
                               Options = "Frontend\nBackend\nPayments provider\nCustomer's setup" };
  // The desk's starting types (`SetUpDesk`) — a question and a problem ask the customer which product; a problem asks
  // more; an outage is the team's to file, with the product it hit.
  var question = TicketForm.Single(f => f.Key == "question");
  new FormField { Form = question, Field = product, Position = 0 };
  var problem = TicketForm.Single(f => f.Key == "problem");
  new FormField { Form = problem, Field = product, Position = 0 };
  new FormField { Form = problem, Field = order, Position = 1 };
  new FormField { Form = problem, Field = worked, Position = 2 };
  new FormField { Form = problem, Field = since, Position = 3, ShowWhen = worked, ShowValue = "yes" };
  new FormField { Form = problem, Field = area, Position = 4 };
  var outage = TicketForm.Single(f => f.Key == "incident");
  new FormField { Form = outage, Field = product, Position = 0 };
  return new SeedAsking { Question = question, Problem = problem, Outage = outage, TeamTask = TicketForm.Single(f => f.Key == "task"),
                          Product = product, Order = order, Worked = worked,
                          Since = since, Area = area };
}

/// The product a request's label points at.
string ProductOf(string tag) {
  if (tag == "billing" || tag == "payments" || tag == "checkout" || tag == "tax" || tag == "sales") { return "Checkout and payments"; }
  if (tag == "api" || tag == "webhooks" || tag == "integrations" || tag == "imports" || tag == "exports") { return "Integrations"; }
  if (tag == "reports" || tag == "performance") { return "Reports"; }
  if (tag == "login" || tag == "sso" || tag == "security" || tag == "permissions") { return "Account and sign-in"; }
  return "Storefront";
}

/// A seeded ticket's answers, as its customer gave them on its form — and the team's area once somebody looked.
void AnswerSeeded(Ticket t, Request req, Stage stage, DateTime opened, SeedAsking a, Dice dice) {
  // A task asks nothing; every other type names the product; only a problem goes on to the order and since when.
  if (req.Type == "task") { return; }
  new TicketFieldValue { Ticket = t, Field = a.Product, Value = ProductOf(req.Tag) };
  if (req.Type != "problem") { return; }
  if (dice.Next(3) > 0) { new TicketFieldValue { Ticket = t, Field = a.Order, Value = (40000 + dice.Next(9000)).ToString() }; }
  var worked = dice.Next(10) < 7;
  new TicketFieldValue { Ticket = t, Field = a.Worked, Value = worked ? "yes" : "no" };
  if (worked) {
    new TicketFieldValue { Ticket = t, Field = a.Since, Value = opened.AddDays(-dice.Next(6)).ToString("yyyy-MM-dd") };
  }
  if (stage != Stage.New && dice.Next(3) > 0) {
    new TicketFieldValue { Ticket = t, Field = a.Area, Value = dice.Of(["Frontend", "Backend", "Payments provider", "Customer's setup"]) };
  }
}
