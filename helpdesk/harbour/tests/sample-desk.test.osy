    R("SLA report counts breaches on {holiday}", "The SLA report counts breaches on {holiday}, when we're closed.", "Your business hours didn't list {holiday}. I've added it, and the report recalculates tonight.", "", "reports", "question"),
    R("Change the sender name on notifications to {brand}", "Notifications come from 'Harbour Notifications'. Can they come from {brand} instead?", "Yes: Settings, Email, Sender name. It applies to every notification from the next one on.", "", "branding", "question"),
    R("Duplicate customer records after {integration} import", "The {integration} import on {weekday} created {n} duplicate customers.", "The import matched on name rather than email. I've merged the {n} duplicates and switched the match to email for next time.", "Merged by script; customer informed.", "imports", "problem"),
    R("Can't attach files over {mb} MB", "{person} can't attach a {mb} MB drawing to an order; it just spins.", "The attachment limit on your plan is 25 MB. I've raised it to 100 MB for your account at no charge.", "", "files", "question"),
    R("{browser} shows a blank page after login", "Since {weekday}, logging in from {browser} shows a blank page. Other browsers work.", "An extension in {browser} was blocking our script. Allowing our domain in it fixes the blank page; details below.", "Ad-blocker list update. Asked the list maintainers to whitelist us.", "bug", "problem"),
