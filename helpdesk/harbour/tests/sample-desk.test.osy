    R("Payout for {month} has not arrived", "Our payout for {month} hasn't reached our bank yet. It usually lands by the 5th.", "The payout went out on the 3rd and was held by your bank for a name check. It should land today; the reference is in Billing, Payouts.", "", "payments", "question", 2),
    R("Checkout in {language}", "Most of our customers in {country} would rather check out in {language}. Is that possible?", "Yes: Settings, Store, Languages, add {language}. The checkout follows the customer's browser language from then on.", "", "checkout", "question"),
    R("Order {order} stuck in 'processing'", "Order {order} has said 'processing' since {weekday}, and the customer is asking where it is.", "The payment for {order} was waiting on a 3-D Secure answer that never came. I've captured it; the order is moving again.", "", "orders", "problem", 2),
