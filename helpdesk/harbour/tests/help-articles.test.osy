// THE FIRST HELP ARTICLES — the ten answers Harbour's help centre opens with, in English, Swedish and Arabic, loaded the
// way the live desk loads them and read the way a stuck developer reads them.
//
// ⚑ WHERE THEY COME FROM. One markdown file per article and language under content/help/. `content/help/build.py`
//   turns them into data/help/*.json, which `osy import` loads into a running desk (categories, sections, articles, and
//   every language's version as a draft), and into the block below, because a test run never imports: the fixture
//   writes the same rows the import writes. `build.py --check` fails when either has fallen behind the markdown.
//
// ⚑ AND THEY ARE PUBLISHED THE WAY EVERY ARTICLE IS. An import writes drafts, never a published version; a lead sends
//   each one through review and publishes it on the desk. The fixture does exactly that.
using Osysharp.Identity;
using Osysharp.Knowledge;

/// Harbour's desk with Hana, an admin who runs the import, and Ravi, a lead who reviews and publishes.
[TestFixture]
void HelpArticles() {
  SetUpTestDesk();
  var hana = new Agent { Email = "hana@helpdesk.test", DisplayName = "Hana Sato" };
  new RoleGrant { Member = hana, Role = AppRole.Admin };
  JoinTheDesk(hana);
  var ravi = new Agent { Email = "ravi@helpdesk.test", DisplayName = "Ravi Menon" };
  new RoleGrant { Member = ravi, Role = AppRole.Lead };
  JoinTheDesk(ravi);
  UnitOfWork.Commit();
}

principal HelpImporter => Agent.Single(a => a.Email == "hana@helpdesk.test");
principal HelpReviewer => Agent.Single(a => a.Email == "ravi@helpdesk.test");

/// The help articles imported (as Hana, as `osy import --as` runs) and published (by Ravi, from the review queue).
void LoadHelpArticles() {
  runas (HelpImporter) { ImportHelpArticles(); }
  runas (HelpImporter) {
    foreach (var d in KnowledgeRevision.Where(r => r.Stage == KnowledgeStage.Draft).ToList()) { SendKnowledgeForReview(d); }
  }
  Background.Settle();
  runas (HelpReviewer) {
    foreach (var r in KnowledgeRevision.Where(r => r.Stage == KnowledgeStage.InReview).ToList()) { PublishKnowledge(r); }
  }
  Background.Settle();
}

[Test(HelpArticles)]
void every_article_is_published_in_english_swedish_and_arabic() {
  LoadHelpArticles();
  var slugs = HelpArticleSlugs();
  Assert.Equal(10, slugs.Count);
  runas (HelpReviewer) {
    Assert.Equal(30, KnowledgeRevision.Count(r => r.Stage == KnowledgeStage.Published));
    Assert.Equal(0, KnowledgeRevision.Count(r => r.Stage != KnowledgeStage.Published));
  }
}

[Test(HelpArticles)]
void the_help_centre_lists_the_categories_and_every_article() {
  LoadHelpArticles();
  // A reader who is not signed in — the help centre is public.
  var shelves = KnowledgeShelves();
  Assert.Equal(["Getting started", "Building your app", "Deploying", "Account & billing"], shelves.Select(s => s.Name).ToList());
  Assert.Equal(10, shelves.Sum(s => s.Count));
  foreach (var slug in HelpArticleSlugs()) {
    var view = KnowledgeArticleView(slug);
    Assert.True(view.Found);
    Assert.Equal("en", view.Language);
  }
  Ui.Viewport(1440, 900);
  Ui.Visit("/help-centre");
  Assert.Visible("Getting started", within: "Categories");
  Assert.Visible("Building your app", within: "Categories");
  Assert.Visible("Deploying", within: "Categories");
  Assert.Visible("Account & billing", within: "Categories");
  Ui.Shot("help-articles-home-wide-light");
  Ui.Viewport(390, 844);
  Ui.Shot("help-articles-home-phone-light");
  Ui.Viewport(1440, 900);
  Ui.Visit("/help-centre/c/deploying");
  Assert.Visible("Deploy your app to Osyrin Cloud");
  Assert.Visible("Use a custom domain");
  Ui.Visit("/help-centre/a/deploy-your-app-to-osyrin-cloud");
  Assert.Visible("Deploy your app to Osyrin Cloud");
  Assert.Visible("osy deploy --env production --server osyrin.app");
  Ui.Shot("help-articles-deploy-wide-light");
  Ui.Viewport(390, 844);
  Ui.Shot("help-articles-deploy-phone-light");
}

[Test(HelpArticles)]
void search_finds_deploy_and_custom_domain() {
  LoadHelpArticles();
  var deploy = SearchKnowledge("deploy").Hits.Select(h => h.Title).ToList();
  Assert.Contains("Deploy your app to Osyrin Cloud", deploy);
  Assert.Equal("Deploy your app to Osyrin Cloud", deploy[0]);
  var domain = SearchKnowledge("custom domain").Hits.Select(h => h.Title).ToList();
  Assert.Equal("Use a custom domain", domain[0]);
  Ui.Viewport(1440, 900);
  Ui.Visit("/help-centre/search/custom%20domain");
  Assert.Visible("Use a custom domain");
  Ui.Shot("help-articles-search-wide-light");
}

