  Assert.Visible("corr-55e1", within: "Fields");
  Assert.Visible("28 Sep 2026", within: "Fields");
  Assert.Visible("Not answered", within: "Fields");      // the team's Area
  Ui.Click("Edit Area");
  Ui.Click("Client", within: "Area");
  Ui.Shot("ticket-fields-editing");
  Ui.Click("Save Area");
  Assert.Visible("Client", within: "Fields");
  Assert.Visible("Area set to Client.", within: "Conversation");
  Ui.Shot("ticket-fields");
  Ui.Theme("dark");
  Ui.Shot("ticket-fields-dark");
  runas (Theo) { Assert.Equal("Client", AnswerOn(n, "Area")); }
}

[Test(Intake)]
void the_tickets_fields_on_a_phone_open_in_a_sheet() {
