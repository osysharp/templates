// TICKET FIELDS AND FORMS IN USE (H1) — the help page asks a form's questions by its conditions, the server checks
// them again and keeps only what the form shows, the ticket shows and edits them with every change on its timeline, a
// retired field keeps its answers, a saved view filters by a field, and the settings page makes, orders and retires
// them. `osy test --pixels` photographs each (Ui.Shot); Docs/OsySharp/design/helpdesk/fields/ keeps the ones worth
// keeping.
using Osysharp.Identity;
using Osysharp.Accounts;
using Osysharp.Organizations;
using Osysharp.Organizations.Accounts;
using Osysharp.Conversations;
using Osysharp.Inbox;
using Osysharp.Fields;

/// Osyrin's own desk, as it asks about a request: what it is about (always), and for a bug report the version, whether
/// an error was shown — and only then its correlation id — and since when; the team adds the area it lands in. Mira
/// runs the desk, Theo works it, Olivia has a portal account.
[TestFixture]
void Intake() {
  SetUpTestDesk();
  var mira = new Agent { Email = "mira@helpdesk.test", DisplayName = "Mira Okafor" };
  new RoleGrant { Member = mira, Role = AppRole.Agent };
  new RoleGrant { Member = mira, Role = AppRole.Admin };
  var theo = new Agent { Email = "theo@helpdesk.test", DisplayName = "Theo Brandt" };
  new RoleGrant { Member = theo, Role = AppRole.Agent };
  JoinTheDesk(mira);
  JoinTheDesk(theo);
  var olivia = new User { Email = "olivia@larkspur.test", DisplayName = "Olivia Brandt", EmailVerifiedAt = DateTime.UtcNow };
  new RoleGrant { Member = olivia, Role = AppRole.Customer };
  var party = new Customer { DisplayName = "Olivia Brandt", Account = olivia, CreatedByVisit = null };
  new ContactPoint { Party = party, Kind = ContactPointKind.Email, Value = "olivia@larkspur.test", IsPreferred = true };

  var about = new TicketField { Name = "Which part", Kind = FieldKind.Choice, Public = true, Required = true, Position = 0,
                                Options = "Osy# the language\nOsyrin Cloud\nThe osy CLI\nA kit" };
  var version = new TicketField { Name = "Platform version", Kind = FieldKind.Text, Public = true, Position = 1,
                                  Hint = "What osy --version prints." };
  var error = new TicketField { Name = "Did you see an error?", Kind = FieldKind.YesNo, Public = true, Position = 2 };
  var corr = new TicketField { Name = "Correlation id", Kind = FieldKind.Text, Public = true, Required = true, Position = 3,
                               Hint = "Printed under the error, starting corr-." };
  var since = new TicketField { Name = "Broken since", Kind = FieldKind.Date, Public = true, Position = 4 };
  var seats = new TicketField { Name = "Seats", Kind = FieldKind.Number, Public = true, Position = 5 };
  var area = new TicketField { Name = "Area", Kind = FieldKind.Choice, Position = 6, Options = "Compiler\nRuntime\nClient\nDocs" };

  var question = TicketForm.Single(f => f.Key == "question");   // the desk's starting type (SetUpDesk), the default
  new FormField { Form = question, Field = about, Position = 0 };
  var bug = new TicketForm { Name = "A bug report", Key = "bug-report", Description = "Something the platform did that it should not.", Position = 1 };
  new FormField { Form = bug, Field = about, Position = 0 };
  new FormField { Form = bug, Field = version, Position = 1 };
  new FormField { Form = bug, Field = error, Position = 2 };
  new FormField { Form = bug, Field = corr, Position = 3, ShowWhen = error, ShowValue = "yes" };
  new FormField { Form = bug, Field = since, Position = 4 };
  new FormField { Form = bug, Field = area, Position = 5 };
  var billing = new TicketForm { Name = "Billing", Key = "billing", Description = "Invoices, seats and plans.", Position = 2 };
  new FormField { Form = billing, Field = seats, Position = 0 };
}


Guid FieldNamed(string name) => TicketField.Single(f => f.Name == name).Id;
Guid FormNamed(string name) => TicketForm.Single(f => f.Name == name).Id;
FieldAnswer A(string field, string value) => new FieldAnswer { Field = FieldNamed(field), Value = value };

/// What a ticket holds for a field, as kept — "" for none.
string AnswerOn(int number, string field) {
  var v = TicketFieldValue.FirstOrDefault(x => x.Ticket.Number == number && x.Field.Name == field);
  return v == null ? "" : v.Value;
}

// ── asking ───────────────────────────────────────────────────────────────────────────────────────────────────────────

/// ⭐ THE CONDITION, DRIVEN AS A CUSTOMER MEETS IT: a bug report asks for the correlation id only once they say they
/// saw an error; the answers land on the ticket in their kept spelling, and the form they chose with them.
[Test(Intake)]
void a_bug_report_asks_for_the_correlation_id_only_once_an_error_was_seen() {
  Ui.Viewport(1280, 1400);
  Ui.Visit("/help");
  Assert.Visible("What is it about?");
  // The default form asks one question; the version is a bug report's.
  Assert.Visible("Which part");
  Assert.Hidden("Platform version");
  Ui.Select("What is it about?", TicketForm.Single(f => f.Name == "A bug report"));
  Assert.Visible("Platform version");
  Assert.Visible("Did you see an error?");
  Assert.Hidden("Correlation id");
  Ui.Click("The osy CLI", within: "Which part");
  Ui.Click("Yes", within: "Did you see an error?");
  Assert.Visible("Correlation id");
  Ui.Fill("Your name", "Pierre Laurent");
  Ui.Fill("Your email", "pierre@example.test");
  Ui.Fill("Subject", "osy compile hangs on a fresh project");
  Ui.Fill("What happened", "It prints Compiling… and never returns.");
  Ui.Fill("Platform version", "0.42.1");
  Ui.Fill("Broken since", "2026-09-30");
  Ui.Shot("help-form-condition");
  // Required and shown: sending without it says so under the question, and nothing is sent.
  Ui.Click("Send request");
  Assert.Visible("Needs an answer.");
  Ui.Fill("Correlation id", "corr-7f3a9c");
  Ui.Click("Send request");
  Assert.Visible("We have your request");
  runas (Mira) {
    var t = Ticket.Single(x => x.Title == "osy compile hangs on a fresh project");
    Assert.Equal("A bug report", t.Form!.Name);
    Assert.Equal("The osy CLI", AnswerOn(t.Number, "Which part"));
    Assert.Equal("0.42.1", AnswerOn(t.Number, "Platform version"));
    Assert.Equal("yes", AnswerOn(t.Number, "Did you see an error?"));
    Assert.Equal("corr-7f3a9c", AnswerOn(t.Number, "Correlation id"));
    Assert.Equal("2026-09-30", AnswerOn(t.Number, "Broken since"));
  }
}

[Test(Intake)]
void the_help_form_on_a_phone_in_the_dark() {
  Ui.Viewport(390, 844);
  Ui.Theme("dark");
  Ui.Visit("/help");
  Ui.Select("What is it about?", TicketForm.Single(f => f.Name == "A bug report"));
  Ui.Click("Yes", within: "Did you see an error?");
  Assert.Visible("Correlation id");
  Ui.Shot("help-form-condition-phone-dark");
}

/// The server keeps what the FORM shows, whatever the browser sent: an answer the condition hides is dropped, a required
/// one left empty is refused naming it, a wrong kind is refused naming it, and a choice is kept in its own spelling.
[Test(Intake)]
void the_server_checks_every_answer_again_and_keeps_only_what_the_form_shows() {
  runas (new Visitor { Id = "visit-1" }) {
    // Required and empty: refused, naming it.
    var missing = Assert.Throws<ValidationException>(() => SubmitRequest("Docs question", "Where is the kit list?", "Ana", "ana@example.test",
                                      formId: FormNamed("A question"), answers: new List<FieldAnswer>()));
    Assert.Equal("Which part needs an answer.", missing.Message);
    // A choice that is not one of the options, and a date that is not a date: both said at once.
    var wrong = Assert.Throws<ValidationException>(() => SubmitRequest("Crash", "It crashed.", "Ana", "ana@example.test",
                                      formId: FormNamed("A bug report"),
                                      answers: [A("Which part", "Kubernetes"), A("Broken since", "last tuesday")]));
    Assert.Equal("Which part is one of: Osy# the language, Osyrin Cloud, The osy CLI, A kit. Broken since takes a date, like 2026-10-02.",
                 wrong.Message);
    // No error seen: the correlation id the browser still sent is NOT kept (the condition hides it), and the choice is
    // kept in its own spelling.
    var n = SubmitRequest("Docs page 404s", "The kits page is gone.", "Ana", "ana@example.test", formId: FormNamed("A bug report"),
                          answers: [A("Which part", "a KIT "), A("Did you see an error?", "No"), A("Correlation id", "corr-stale")]);
    runas (Mira) {
      Assert.Equal("A kit", AnswerOn(n, "Which part"));
      Assert.Equal("no", AnswerOn(n, "Did you see an error?"));
      Assert.Equal("", AnswerOn(n, "Correlation id"));
      Assert.Equal(0, TicketFieldValue.Count(v => v.Ticket.Number == n && v.Field.Name == "Correlation id"));
    }
  }
}

/// ⭐ NOTHING THE BROWSER SAYS ABOUT THE FORM IS TRUSTED: a customer cannot answer the team's own field, nor one from
/// another form, nor a retired one — through the verb or by writing the row — and never on somebody else's ticket.
[Test(Intake)]
void a_customer_can_answer_only_what_they_are_asked_on_their_own_ticket() {
  var theirs = 0;
  runas (Theo) {
    var id = OpenTicket("someone@else.test", "Someone Else", "Their ticket", "Private.");
    theirs = Ticket.Single(t => t.Id == id).Number;
  }
  runas (Olivia) {
    // The team's own field, through the verb.
    var teams = Assert.Throws<ValidationException>(() => SubmitRequest("Crash", "It crashed.", formId: FormNamed("A bug report"),
                                      answers: [A("Which part", "A kit"), A("Area", "Compiler")]));
    Assert.Contains("does not ask that any more", teams.Message);
    // A field from another form.
    var elsewhere = Assert.Throws<ValidationException>(() => SubmitRequest("Seats", "Two more please.", formId: FormNamed("A question"),
                                      answers: [A("Which part", "Osyrin Cloud"), A("Seats", "2")]));
    Assert.Contains("does not ask that any more", elsewhere.Message);
    var mine = SubmitRequest("Cloud login loops", "Login sends me back to login.", formId: FormNamed("A question"),
                             answers: [A("Which part", "Osyrin Cloud")]);
    var t = Ticket.Single(x => x.Number == mine);
    // Writing the rows directly: the team's field on their own ticket…
    Assert.Denied(() => {
      new TicketFieldValue { Ticket = t, Field = TicketField.Single(f => f.Name == "Area"), Value = "Compiler" };
      UnitOfWork.Commit();
    });
    // …changing what they answered…
    Assert.Denied(() => {
      TicketFieldValue.Single(v => v.Ticket.Number == mine).Value = "A kit";
      UnitOfWork.Commit();
    });
    // …and a question they are asked, on somebody else's ticket (which they cannot even read).
    Assert.Equal(0, Ticket.Count(x => x.Number == theirs));
  }
  runas (Mira) {
    TicketField.Single(f => f.Name == "Seats").Active = false;
    UnitOfWork.Commit();
  }
  runas (Olivia) {
    var t = Ticket.Single(x => x.Title == "Cloud login loops");
    // A retired field takes no new answer, even one the customer was once asked.
    Assert.Denied(() => {
      new TicketFieldValue { Ticket = t, Field = TicketField.Single(f => f.Name == "Seats"), Value = "2" };
      UnitOfWork.Commit();
    });
    // What they were asked is theirs to read; the team's own fields are not.
    Assert.Equal("Osyrin Cloud", TicketFieldValue.Single(v => v.Ticket.Id == t.Id).Value);
  }
  runas (Mira) {
    var other = Ticket.Single(x => x.Number == theirs);
    SetTicketField(other.Id, FieldNamed("Area"), "Runtime");
  }
  runas (Olivia) { Assert.Equal(0, TicketFieldValue.Count(v => v.Field.Name == "Area")); }
}

/// ⭐ AN ANSWER IS ITS FIELD'S KIND ON EVERY WRITE — not only through the verbs that check it first. A customer may write
/// an answer row for a question they are asked (their row rule allows it) and the team may write any; neither can keep
/// a date that is not a date, a choice that is not an option, a number that is not a number or a yes that is a maybe.
/// The rules read the FIELD through the answer (D-INVARIANTHOP1), so they hold wherever the row is written.
[Test(Intake)]
void an_answer_is_its_fields_kind_whoever_writes_the_row() {
  runas (Olivia) {
    var n = SubmitRequest("Two more seats", "For the new hires.", formId: FormNamed("Billing"), answers: [A("Seats", "2")]);
    var t = Ticket.Single(x => x.Number == n);
    // A question she is asked, written as a row: the shape of the field's kind, or nothing is kept.
    var notADay = Assert.Throws<ValidationException>(() => {
      new TicketFieldValue { Ticket = t, Field = TicketField.Single(f => f.Name == "Broken since"), Value = "last tuesday" };
      UnitOfWork.Commit();
    });
    Assert.Contains("not a date", notADay.Message);
    var notAnOption = Assert.Throws<ValidationException>(() => {
      new TicketFieldValue { Ticket = t, Field = TicketField.Single(f => f.Name == "Which part"), Value = "The moon" };
      UnitOfWork.Commit();
    });
    Assert.Contains("not one of the field's options", notAnOption.Message);
    var notYesOrNo = Assert.Throws<ValidationException>(() => {
      new TicketFieldValue { Ticket = t, Field = TicketField.Single(f => f.Name == "Did you see an error?"), Value = "maybe" };
      UnitOfWork.Commit();
    });
    Assert.Contains("not yes or no", notYesOrNo.Message);
    // …and the same row in the field's shape is kept: the rule refuses the wrong answer, not the writer.
    new TicketFieldValue { Ticket = t, Field = TicketField.Single(f => f.Name == "Broken since"), Value = "2026-09-28" };
    UnitOfWork.Commit();
    Assert.Equal("2026-09-28", AnswerOn(n, "Broken since"));
  }
  runas (Mira) {
    // The team writing the row directly is held to it too.
    var seats = TicketFieldValue.Single(v => v.Field.Name == "Seats");
    var notANumber = Assert.Throws<ValidationException>(() => { seats.Value = "a few"; UnitOfWork.Commit(); });
    Assert.Contains("not a number", notANumber.Message);
  }
  runas (Mira) { Assert.Equal("2", TicketFieldValue.Single(v => v.Field.Name == "Seats").Value); }
}

/// ⭐ THE FORM IS THE TICKET'S TYPE — one notion. A ticket opened with no form chosen takes the desk's default type; the
/// team changes it from the type menu; the inbox's kind follows (what rules, promises and views name it by); and a type
/// that asks for a root cause (the desk's starting "An outage") shows it on the ticket, and is not solved without it.
[Test(Intake)]
void the_form_is_the_tickets_type_and_an_outage_asks_for_its_root_cause() {
  var n = 0;
  runas (Theo) {
    var id = OpenTicket("olivia@larkspur.test", "", "Checkout is down", "Every card payment fails.");
    var t = Ticket.Single(x => x.Id == id);
    n = t.Number;
    Assert.Equal("A question", t.Form!.Name);                 // the default type
    Assert.Equal("question", t.Kind);
  }
  Ui.Viewport(1600, 1000);
  Ui.SignInAs(Theo);
  Ui.Visit("/v/open/t/" + n);
  Assert.Hidden("Root cause");                                // a question asks for none
  Ui.Click("Type: A question");
  Ui.Click("An outage");
  Assert.Visible("Type set to An outage.", within: "Conversation");
  Assert.Visible("Not recorded yet — solving needs it", within: "Fields");
  Ui.Shot("ticket-type-outage");
  runas (Theo) {
    var t = Ticket.Single(x => x.Number == n);
    Assert.Equal("incident", t.Kind);
    ReplyToTicket(t.Id, "Looking now.");
    Assert.Throws<RequirementsNotMet>(() => SetStatus(t.Id, StatusNamed("Solved").Id));
  }
  Ui.Click("Edit the root cause");
  Ui.Fill("Root cause", "An expired certificate on the card gateway.");
  Ui.Click("Save the root cause");
  Assert.Visible("An expired certificate on the card gateway.", within: "Fields");
  Ui.Shot("ticket-type-root-cause");
  Ui.Theme("dark");
  Ui.Shot("ticket-type-root-cause-dark");
  runas (Theo) {
    var t = Ticket.Single(x => x.Number == n);
    SetStatus(t.Id, StatusNamed("Solved").Id);
    Assert.Equal(StatusCategory.Solved, Ticket.Single(x => x.Number == n).Category);
  }
  // On a phone the type and its root cause are in the Fields sheet.
  Ui.Theme("light");
  Ui.Viewport(390, 844);
  Ui.Visit("/v/open/t/" + n);
  Ui.Click("Fields: None yet");
  Assert.Visible("An outage", within: "Fields");
  Assert.Visible("An expired certificate on the card gateway.", within: "Fields");
  Ui.Shot("ticket-type-phone");
}

// ── on the ticket ────────────────────────────────────────────────────────────────────────────────────────────────────

/// A bug report Olivia raised from the portal, as the desk receives it.
int OliviasBug() {
  var n = 0;
  runas (Olivia) {
    n = SubmitRequest("Kit install fails behind a proxy", "osy kit add times out at the office.", formId: FormNamed("A bug report"),
                      answers: [A("Which part", "A kit"), A("Platform version", "0.42.1"), A("Did you see an error?", "yes"),
                                A("Correlation id", "corr-55e1"), A("Broken since", "2026-09-28")]);
  }
  return n;
}

/// ⭐ EVERY CHANGE IS ON THE TIMELINE, WITH WHO: the team answers its own field, changes the customer's, and clears one —
/// each a line on the ticket's timeline saying what it was and what it is, by name.
[Test(Intake)]
void the_team_edits_a_tickets_fields_and_the_timeline_says_who_changed_what() {
  var n = OliviasBug();
  runas (Theo) {
    var t = Ticket.Single(x => x.Number == n);
    SetTicketField(t.Id, FieldNamed("Area"), "runtime", "");
    SetTicketField(t.Id, FieldNamed("Platform version"), "0.42.2", "0.42.1");
    SetTicketField(t.Id, FieldNamed("Broken since"), "", "2026-09-28");
    // Nothing changed is nothing on the timeline.
    SetTicketField(t.Id, FieldNamed("Which part"), "a kit", "A kit");
    var said = new List<string>();
    foreach (var e in ConversationEvent.Where(e => e.Conversation == t.Conversation && e.Kind == "helpdesk.field")
        .OrderBy(e => e.Sequence).ToList()) {
      said.Add(e.ByName + ": " + EventWords(e));
    }
    Assert.Equal(3, said.Count);
    Assert.Equal("Theo Brandt: Area set to Runtime.", said[0]);
    Assert.Equal("Theo Brandt: Platform version changed from 0.42.1 to 0.42.2.", said[1]);
    Assert.Equal("Theo Brandt: Broken since cleared (was 28 Sep 2026).", said[2]);
    // The kind is checked here too: a choice that is not one is refused, naming the field.
    var wrong = Assert.Throws<ValidationException>(() => SetTicketField(t.Id, FieldNamed("Area"), "Billing"));
    Assert.Equal("Area is one of: Compiler, Runtime, Client, Docs.", wrong.Message);
  }
  // A change of field is the team's: the customer never sees it on their timeline.
  runas (Olivia) {
    var t = Ticket.Single(x => x.Number == n);
    Assert.Equal(0, ConversationEvent.Count(e => e.Conversation == t.Conversation && e.Kind == "helpdesk.field"));
  }
}

/// Two people on one field: the second is told who changed it and to what, and nothing is overwritten unknowingly.
[Test(Intake)]
void a_colleagues_change_to_a_field_stops_yours_with_their_name() {
  var n = OliviasBug();
  Guid id = Guid.Empty;
  runas (Mira) { id = Ticket.Single(x => x.Number == n).Id; SetTicketField(id, FieldNamed("Area"), "Compiler", ""); }
  runas (Theo) {
    // Theo's page still showed no answer.
    var stale = Assert.Throws<ValidationException>(() => SetTicketField(id, FieldNamed("Area"), "Docs", ""));
    Assert.Equal("Mira Okafor changed Area to Compiler just now. Have another look.", stale.Message);
    Assert.Equal("Compiler", AnswerOn(n, "Area"));
  }
}

/// ⭐ RETIRED, NEVER LOST: retiring a field stops it being asked and edited, and every ticket keeps — and shows — its
/// answer; bringing it back makes it a question again.
[Test(Intake)]
void a_retired_field_keeps_every_answer_and_takes_no_new_one() {
  var n = OliviasBug();
  runas (Mira) {
    TicketField.Single(f => f.Name == "Platform version").Active = false;
    UnitOfWork.Commit();
    var t = Ticket.Single(x => x.Number == n);
    Assert.Equal("0.42.1", AnswerOn(n, "Platform version"));
    var refused = Assert.Throws<ValidationException>(() => SetTicketField(t.Id, FieldNamed("Platform version"), "0.43.0"));
    Assert.Equal("Platform version is retired: records keep their answers to it, and it takes no new ones.", refused.Message);
  }
  // The help page no longer asks it…
  Ui.Visit("/help");
  Ui.Select("What is it about?", TicketForm.Single(f => f.Name == "A bug report"));
  Assert.Visible("Did you see an error?");
  Assert.Hidden("Platform version");
  // …and the ticket still shows what it said, marked retired, not pressable.
  Ui.Viewport(1600, 1000);
  Ui.SignInAs(Mira);
  Ui.Visit("/v/open/t/" + n);
  Assert.Visible("0.42.1", within: "Fields");
  Assert.Visible("Retired", within: "Fields");
  Assert.Hidden("Edit Platform version");
}

/// ⭐ THE TICKET'S FIELDS, AS THE TEAM WORKS THEM: the form's questions with the customer's answers, the condition
/// honoured, the team's own field edited in place, and the change on the timeline.
[Test(Intake)]
void the_ticket_shows_its_fields_and_the_team_edits_one_in_place() {
  var n = OliviasBug();
  Ui.Viewport(1600, 1000);
  Ui.SignInAs(Theo);
