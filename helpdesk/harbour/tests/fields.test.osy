  Assert.Hidden("Runtime");
  Ui.Shot("portal-request-told-us");
}

// ── filtering ────────────────────────────────────────────────────────────────────────────────────────────────────────

/// ⭐ A SAVED VIEW NAMES A FIELD: "field:which-part=osyrin cloud" lists the tickets whose answer is Osyrin Cloud — in
/// any case the admin writes it — and "field:correlation-id" every ticket that has one.
[Test(Intake)]
void a_saved_view_lists_the_tickets_with_a_fields_answer() {
  runas (Olivia) {
    SubmitRequest("Cloud deploy stuck at 90%", "It never finishes.", formId: FormNamed("A question"), answers: [A("Which part", "Osyrin Cloud")]);
    SubmitRequest("Cloud bill shows two plans", "We have one.", formId: FormNamed("A question"), answers: [A("Which part", "Osyrin Cloud")]);
    SubmitRequest("How do I name a kit?", "Naming question.", formId: FormNamed("A question"), answers: [A("Which part", "A kit")]);
  }
  OliviasBug();
  runas (Mira) {
    Assert.Equal(2, new DeskViews().Narrow("field:Which-Part=osyrin CLOUD").Count);
    Assert.Equal(1, new DeskViews().Narrow("field:correlation-id").Count);
    Assert.Equal(0, new DeskViews().Narrow("field:which-part=Kubernetes").Count);
    Assert.Equal(0, new DeskViews().Narrow("field:no-such-field=x").Count);
    new InboxView { Name = "Cloud questions", AppFilter = "field:which-part=osyrin cloud", Position = 0 };
    UnitOfWork.Commit();
  }
  var view = Guid.Empty;
  runas (Mira) { view = InboxView.Single(v => v.Name == "Cloud questions").Id; }
  Ui.Viewport(1440, 900);
  Ui.SignInAs(Mira);
  Ui.Visit("/v/v-" + view);
  Assert.Visible("Cloud deploy stuck at 90%", within: "Work");
  Assert.Visible("Cloud bill shows two plans", within: "Work");
  Assert.Hidden("How do I name a kit?");
  Assert.Hidden("Kit install fails behind a proxy");
  Ui.Shot("view-by-field");
  Ui.Theme("dark");
  Ui.Shot("view-by-field-dark");
}

[Test(Intake)]
void a_view_by_field_on_a_phone() {
  runas (Olivia) {
    SubmitRequest("Cloud deploy stuck at 90%", "It never finishes.", formId: FormNamed("A question"), answers: [A("Which part", "Osyrin Cloud")]);
  }
  runas (Mira) { new InboxView { Name = "Cloud questions", AppFilter = "field:which-part=osyrin cloud" }; UnitOfWork.Commit(); }
  var view = Guid.Empty;
  runas (Mira) { view = InboxView.Single(v => v.Name == "Cloud questions").Id; }
  Ui.Viewport(390, 844);
  Ui.SignInAs(Mira);
  Ui.Visit("/v/v-" + view);
  Assert.Visible("Cloud deploy stuck at 90%");
  Ui.Shot("view-by-field-phone");
}

// ── settings ─────────────────────────────────────────────────────────────────────────────────────────────────────────

/// ⭐ AN ADMIN MAKES, ORDERS, CONDITIONS AND RETIRES FIELDS — nothing saved until Save, and no answer lost: a field is
/// added and put on a form, shown only on an earlier answer, moved, and an old one retired while its answers stay.
[Test(Intake)]
void an_admin_adds_a_conditional_field_orders_it_and_retires_another_without_losing_answers() {
  var n = OliviasBug();
  Ui.Viewport(1440, 1000);
  Ui.SignInAs(Mira);
  Ui.Visit("/settings/fields");
  Assert.Visible("Fields and forms");
  Assert.Visible("answered on 1 ticket", within: "Platform version");
  Ui.Click("Add a field to Ticket fields");
  Ui.Fill("Name", "Region", within: "A new field");
  Ui.Select("Kind", FieldKind.Choice);
  Ui.Fill("Options, one per line", "EU\nUS\nAsia");
  Ui.Click("Ask the customer on the help page");
  Ui.Click("Add the field");
  Assert.Visible("Unsaved changes");
  Ui.Click("Add a field to A bug report");
  Ui.Click("Region");
  Ui.Click("Condition of Region on A bug report");
  Ui.Select("Show it only when", TicketField.Single(f => f.Name == "Which part"));
  Ui.Click("Osyrin Cloud", within: "…and its answer is");
  Ui.Viewport(1440, 2200);   // the whole page, down to the condition being written
  Ui.Shot("settings-fields-condition");
  Ui.Viewport(1440, 1000);
  Ui.Click("Retire Platform version");
  Ui.Click("Move Region up");
  Ui.Click("Save");
  Assert.Visible("Fields and forms saved.");
  runas (Mira) {
    var region = TicketField.Single(f => f.Name == "Region");
    Assert.Equal(FieldKind.Choice, region.Kind);
    Assert.True(region.Public);
    var on = FormField.Single(x => x.Field == region && x.Form.Name == "A bug report");
    Assert.Equal("Which part", on.ShowWhen!.Name);
    Assert.Equal("Osyrin Cloud", on.ShowValue);
    Assert.False(TicketField.Single(f => f.Name == "Platform version").Active);
    // The retired field's answer is still on the ticket.
    Assert.Equal("0.42.1", AnswerOn(n, "Platform version"));
    // Moved above Area, the last field before it.
    Assert.True(region.Position < TicketField.Single(f => f.Name == "Area").Position);
  }
  // The new question is asked by its condition.
  Ui.SignOut();
  Ui.Visit("/help");
  Ui.Select("What is it about?", TicketForm.Single(f => f.Name == "A bug report"));
  Assert.Hidden("Region");
  Ui.Click("Osyrin Cloud", within: "Which part");
  Assert.Visible("Region");
}

/// The settings page as it reads, light and dark, wide and on a phone — and a condition that can never be met says so.
[Test(Intake)]
void the_fields_page_says_when_a_condition_can_never_be_met() {
  runas (Mira) {
    // Correlation id's condition names "Did you see an error?" — retire that, and the condition can never be met.
    TicketField.Single(f => f.Name == "Did you see an error?").Active = false;
    UnitOfWork.Commit();
  }
  Ui.Viewport(1440, 1000);
  Ui.SignInAs(Mira);
  Ui.Visit("/settings/fields");
  Assert.Visible("Never shown: Did you see an error? is retired.");
  Ui.Shot("settings-fields");
  Ui.Theme("dark");
  Ui.Shot("settings-fields-dark");
  Ui.Viewport(390, 844);
  Ui.Theme("light");
  Ui.Visit("/settings/fields");
  Ui.Shot("settings-fields-phone");
}

/// ⭐ A NEW TYPE'S KEY IS CHOSEN ONCE: an admin adds a type, gives it the key rules will name it by, and the key is
/// refused until it is lower-case words and hyphens; once saved it is fixed (a rename keeps every rule matching), and the
/// page says what rules name it instead of offering a box the server would refuse.
[Test(Intake)]
void a_new_types_key_is_words_and_hyphens_and_fixed_once_saved() {
  Ui.Viewport(1440, 1000);
  Ui.SignInAs(Mira);
  Ui.Visit("/settings/fields");
  Ui.Click("Add a type");
  Ui.Fill("Name", "A refund", within: "New type");
  Ui.Fill("Key", "Refund Request", within: "A refund");      // the section is named as it is typed
  Ui.Click("Solving it needs a root cause", within: "A refund");
  // Said as it is typed, under the box — before anything is sent.
  Assert.Visible("A key is lower-case words joined by hyphens, like bug-report.", within: "A refund");
  Ui.Fill("Key", "refund", within: "A refund");
  Assert.Hidden("A key is lower-case words joined by hyphens, like bug-report.");
  Ui.Click("Save");
  Assert.Visible("Fields and forms saved.");
  Assert.Visible("Rules name it “refund”.", within: "A refund");
  Ui.Viewport(1440, 1800);
  Ui.Shot("settings-type-key");
  runas (Mira) {
    var refund = TicketForm.Single(f => f.Key == "refund");
    Assert.Equal("A refund", refund.Name);
    Assert.True(refund.AsksRootCause);
    Assert.Throws(() => { refund.Key = "refunds"; UnitOfWork.Commit(); });
  }
  runas (Mira) {
    // …and the form's own invariant holds whoever writes the row, the page or not.
    var bad = Assert.Throws<ValidationException>(() => {
      new TicketForm { Name = "Returns", Key = "Returns Desk", Position = 9 };
      UnitOfWork.Commit();
    });
    Assert.Contains("lower-case words joined by hyphens", bad.Message);
  }
  // On a phone: a new type, its key typed wrong — said under the box as it is typed (the browser scrolls to it).
  Ui.Viewport(390, 844);
  Ui.Visit("/settings/fields");
  Ui.Click("Add a type");
  Ui.Fill("Key", "Returns Desk", within: "New type");
  Assert.Visible("A key is lower-case words joined by hyphens, like bug-report.", within: "New type");
  Ui.Shot("settings-type-key-phone");
  Ui.Click("Discard");
  Assert.Hidden("New type");
}

/// A field's kind is fixed once saved — the page says so instead of offering a menu the server would refuse.
[Test(Intake)]
void a_saved_fields_kind_is_fixed() {
  Ui.Viewport(1440, 1000);
  Ui.SignInAs(Mira);
  Ui.Visit("/settings/fields");
  Ui.Click("Edit Seats");
  Assert.Visible("Fixed once saved");
  runas (Mira) {
    Assert.Throws(() => { TicketField.Single(f => f.Name == "Seats").Kind = FieldKind.Text; UnitOfWork.Commit(); });
  }
}

/// The team opens a ticket with what it already knows: the form's fields, its own too, none of them required.
[Test(Intake)]
void the_team_opens_a_ticket_with_the_forms_fields() {
  Ui.Viewport(1440, 1000);
  Ui.SignInAs(Theo);
  Ui.Visit("/new");
  Ui.Fill("Customer's address", "olivia@larkspur.test");
  Ui.Fill("Subject", "Phoned in: the CLI crashes on Windows");
  Ui.Select("Type", TicketForm.Single(f => f.Name == "A bug report"));
  Ui.Click("Client", within: "Area");
  Ui.Click("Open the ticket");
  Assert.Visible("Phoned in: the CLI crashes on Windows");
  runas (Theo) {
    var t = Ticket.Single(x => x.Title == "Phoned in: the CLI crashes on Windows");
    Assert.Equal("A bug report", t.Form!.Name);
    Assert.Equal("Client", AnswerOn(t.Number, "Area"));
  }
}

// ── the customer and the company (H1b) ───────────────────────────────────────────────────────────────────────────────

/// What the desk keeps about Olivia and Larkspur, in its own fields — her plan, the company's industry and renewal.
void PartyFieldsOfLarkspur() {
  runas (Mira) {
    var larkspur = new Company { Name = "Larkspur" };
    Customer.Single(c => c.DisplayName == "Olivia Brandt").Company = larkspur;
    new CustomerField { Name = "Their plan", Kind = FieldKind.Choice, Options = "Starter\nTeam\nEnterprise", Position = 0 };
    new CustomerField { Name = "Prefers calls", Kind = FieldKind.YesNo, Position = 1 };
    new CompanyField { Name = "Industry", Kind = FieldKind.Text, Position = 0 };
    new CompanyField { Name = "Renews on", Kind = FieldKind.Date, Position = 1 };
    new CompanyField { Name = "Employees", Kind = FieldKind.Number, Position = 2 };
    UnitOfWork.Commit();
  }
}

/// ⭐ THE CUSTOMER PANEL KEEPS WHAT THE DESK KNOWS ABOUT HER AND HER COMPANY: each field edited in place beside the
/// conversation, kept on the customer and the company (not the ticket), so the next ticket from either shows it too —
/// and none of it is hers to read.
[Test(Intake)]
void the_customer_panel_keeps_what_the_desk_knows_about_her_and_her_company() {
  PartyFieldsOfLarkspur();
  var n = OliviasBug();
  Ui.Viewport(1600, 1000);
  Ui.SignInAs(Theo);
  Ui.Visit("/v/open/t/" + n);
  Assert.Visible("Their plan", within: "About them");
  Assert.Visible("Industry", within: "About the company");
  Ui.Click("Edit Their plan");
  Ui.Click("Team", within: "Their plan");
  Ui.Click("Save Their plan");
  Assert.Visible("Team", within: "About them");
  Ui.Click("Edit Industry");
  Ui.Fill("Industry", "Logistics");
  Ui.Click("Save Industry");
  Ui.Click("Edit Renews on");
  Ui.Fill("Renews on", "2027-03-01");
  Ui.Click("Save Renews on");
  Assert.Visible("1 Mar 2027", within: "About the company");
  Ui.Shot("customer-panel-fields");
  Ui.Theme("dark");
  Ui.Shot("customer-panel-fields-dark");
  Ui.Theme("light");
  runas (Theo) {
    Assert.Equal("Team", CustomerFieldValue.Single(v => v.Field.Name == "Their plan").Value);
    Assert.Equal("Logistics", CompanyFieldValue.Single(v => v.Field.Name == "Industry").Value);
    Assert.Equal("2027-03-01", CompanyFieldValue.Single(v => v.Field.Name == "Renews on").Value);
    // Kept on HER, not on the ticket: no ticket answer was written.
    Assert.False(TicketFieldValue.Any(v => v.Field.Name == "Their plan"));
  }
  // The team's notes about her are never hers to read, nor what her company's fields are.
  runas (Olivia) {
    Assert.Equal(0, CustomerFieldValue.Count());
    Assert.Equal(0, CompanyFieldValue.Count());
    Assert.Equal(0, CustomerField.Count());
  }
}

/// A value its field's kind cannot hold is refused under the question, in words, and nothing is kept.
[Test(Intake)]
void a_company_fields_answer_is_its_kind_or_it_is_refused() {
  PartyFieldsOfLarkspur();
  var n = OliviasBug();
  Ui.Viewport(1600, 1000);
  Ui.SignInAs(Theo);
  Ui.Visit("/v/open/t/" + n);
  Ui.Click("Edit Employees");
  Ui.Fill("Employees", "about fifty");
  Ui.Click("Save Employees");
  Assert.Visible("Employees takes a number, like 42 or 3.5.");
  runas (Theo) { Assert.Equal(0, CompanyFieldValue.Count()); }
  // And on the server, whoever writes the row.
  runas (Theo) {
    var larkspur = Company.Single(c => c.Name == "Larkspur");
    var renews = CompanyField.Single(f => f.Name == "Renews on");
    Assert.Throws<ValidationException>(() => { new CompanyFieldValue { Company = larkspur, Field = renews, Value = "soon" }; UnitOfWork.Commit(); });
  }
}

/// An admin defines a customer's and a company's fields on the same page as the ticket's, kept on Save.
[Test(Intake)]
void an_admin_adds_a_customer_field_and_a_company_field() {
  Ui.Viewport(1440, 1000);
  Ui.SignInAs(Mira);
  Ui.Visit("/settings/fields");
  Ui.Click("Add a field to Customer fields");
  Ui.Fill("Name", "Preferred language for calls", within: "A new field");
  Ui.Click("Add the field");
  Ui.Click("Add a field to Company fields");
  Ui.Fill("Name", "Contract number", within: "A new field");
  Ui.Click("Add the field");
  Assert.Visible("Preferred language for calls", within: "Customer fields");
  Assert.Visible("Contract number", within: "Company fields");
  Ui.Click("Save");
  Assert.Visible("Fields and forms saved.");
  runas (Mira) {
    Assert.True(CustomerField.Any(f => f.Name == "Preferred language for calls"));
    Assert.True(CompanyField.Any(f => f.Name == "Contract number"));
    // A customer's field is the team's: never asked of the customer.
    Assert.False(CustomerField.Single(f => f.Name == "Preferred language for calls").Public);
  }
  Ui.Viewport(1440, 2600);
  Ui.Shot("settings-fields-all");
  Ui.Viewport(390, 844);
  Ui.Visit("/settings/fields");
  Assert.NoOverflow();
  Ui.Shot("settings-fields-phone");
}

/// ⭐ A FIELD'S NAME IS UNIQUE AMONG ITS OWN KIND, AND THE DATABASE SAYS SO: a customer field and a company field may
/// both be "Area" beside the ticket's, but a second ticket field called "Area" is refused — by the unique index, with
/// the sentence the desk wrote, whoever writes the row and however.
[Test(Intake)]
void a_fields_name_is_unique_among_its_own_kind_and_the_database_refuses_a_second() {
  runas (Mira) {
    new CustomerField { Name = "Area", Position = 0 };
    new CompanyField { Name = "Area", Position = 0 };
    UnitOfWork.Commit();
    Assert.Equal(1, TicketField.Count(f => f.Name == "Area"));
    Assert.Equal(1, CustomerField.Count(f => f.Name == "Area"));
    Assert.Equal(1, CompanyField.Count(f => f.Name == "Area"));
    var refused = Assert.Throws<ValidationException>(() => {
      new TicketField { Name = "Area", Position = 9 };
      UnitOfWork.Commit();
    });
    Assert.Contains("Another ticket field already has that name", refused.Message);
  }
  runas (Mira) {
    Assert.Equal(1, TicketField.Count(f => f.Name == "Area"));
    Assert.Throws<ValidationException>(() => {
      new CustomerField { Name = "Area", Position = 9 };
      UnitOfWork.Commit();
    });
  }
}

/// ⭐ A FIELD IS READ UNDER ITS OWN KIND'S GRANTS, WHATEVER IT IS REACHED THROUGH. The kit's base grants anybody a
/// public, active field; a customer field is the team's. So a customer field marked public is still nobody else's —
/// not through the base type, not through a form that names it.
[Test(Intake)]
void a_customer_field_is_never_a_customers_to_read_through_the_kits_base() {
  runas (Mira) {
    var plan = new CustomerField { Name = "Their plan", Kind = FieldKind.Text, Public = true, Position = 0 };
    new FormField { Form = TicketForm.Single(f => f.Key == "billing"), Field = plan, Position = 9 };
    UnitOfWork.Commit();
    Assert.Equal(1, CustomField.Count(f => f.Name == "Their plan"));
  }
  runas (Olivia) {
    Assert.Equal(0, CustomField.Count(f => f.Name == "Their plan"));
    Assert.Equal(1, CustomField.Count(f => f.Name == "Seats"));
    Assert.Equal(0, FormField.Where(x => x.Field.Name == "Their plan").Count());
    Assert.Equal(0, FormSpecs().Count(x => x.Name == "Their plan"));
  }
}
