/// A ticket put on another form: its questions change, and every answer it holds stays in sight.
[Test(Intake)]
void moving_a_ticket_to_another_form_keeps_its_answers() {
  var n = OliviasBug();
  runas (Theo) {
    var t = Ticket.Single(x => x.Number == n);
    SetTicketForm(t.Id, FormNamed("Billing"));
    Assert.Equal("Billing", Ticket.Single(x => x.Number == n).Form!.Name);
    Assert.Equal("corr-55e1", AnswerOn(n, "Correlation id"));
    Assert.Equal(1, TimelineOf(t).Count(s => s == "Type set to Billing."));
    Assert.Equal("billing", Ticket.Single(x => x.Number == n).Kind);   // the inbox's kind follows the type
  }
  Ui.Viewport(1600, 1000);
  Ui.SignInAs(Theo);
  Ui.Visit("/v/open/t/" + n);
  Assert.Visible("Billing", within: "Fields");
  Assert.Visible("Seats", within: "Fields");
  Assert.Visible("corr-55e1", within: "Fields");
}

/// The customer reads back what they told us — and only that.
[Test(Intake)]
void the_customer_reads_back_what_they_told_us() {
  var n = OliviasBug();
  runas (Theo) { SetTicketField(Ticket.Single(x => x.Number == n).Id, FieldNamed("Area"), "Runtime"); }
  Ui.Viewport(1280, 900);
