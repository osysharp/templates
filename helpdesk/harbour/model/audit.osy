// THE AUDIT LOG — who changed the desk, in one place for its admins: every change to somebody's access (the People kit's
// `AccessChange`, made by a manager with a reason) and every change to the desk's settings (the platform's own change
// trail, `EntityAuditRecord`, with each field's old and new value). Both are already recorded where they happen; this is
// the place an admin reads them together — "who moved our first-reply promise to eight hours, and when?".
//
// ⚑ THE TRAIL IS OPENED TO ADMINS FOR THE SETTINGS ONLY. `app.Audit`'s read rule names the desk's configuration rows by
//   type, so an admin reads what changed in a status, a queue or an SLA policy — and never the trail of a customer's
//   message, an account's sign-in rows, or anything else the trail keeps. A setting added later is invisible here until
//   it is named below, which is the safe way round.
//
// ⛔ SECURITY-INVARIANT(harbour-audit-trail-is-admins-and-settings-only): `EntityAuditRecord` — every field's old and new
//   value, for every row of every entity — is read only by an admin, and only for the settings types named in the read
//   rule. Widening the rule to "admins" alone hands an admin every customer's messages and contact points, every
//   account's rows and every role grant as a values diff; dropping the admin half hands it to the whole team. Guarded by
//   tests/audit.test.osy (the_trail_opens_to_admins_and_for_the_settings_alone).
using Osysharp.Identity;
using Osysharp.Accounts;
using Osysharp.People;
using Osysharp.Observability;
using Osysharp.Inbox;
using Osysharp.Organizations;
using Osysharp.Organizations.Accounts;
using Osysharp.Composer;
using Osysharp.Fields;

app.Audit = new AuditConfig {
  EntityAuditRecord = new AuditSurface {
    // Row-aware: the admin AND a row of one of the settings types, as the trail names a type — the desk's own by its
    // name, a kit's by its package's (`SettingsArea` below words each; keep the two lists the same).
    Read = user => Osysharp.Identity.RoleGrant.Any(g => g.Member == user && g.Role == AppRole.Admin)
      && (EntityType == "TicketStatus" || EntityType == "TicketField" || EntityType == "TicketForm"
          || EntityType == "Osysharp.Fields.FormField" || EntityType == "CustomerField" || EntityType == "CompanyField"
          || EntityType == "Osysharp.Inbox.Queue" || EntityType == "Osysharp.Inbox.QueueMember"
          || EntityType == "Osysharp.Inbox.RoutingRule" || EntityType == "Osysharp.Inbox.RoutingSkill"
          || EntityType == "Osysharp.Inbox.HeldSkill" || EntityType == "Osysharp.Inbox.InboxView"
          || EntityType == "Osysharp.Inbox.SlaPolicy" || EntityType == "Osysharp.Inbox.SlaTarget"
          || EntityType == "Osysharp.Inbox.SlaEscalation"
          || EntityType == "Osysharp.ServiceHours.ServiceHours" || EntityType == "Osysharp.ServiceHours.ServiceWindow"
          || EntityType == "Osysharp.ServiceHours.ServiceException"
          || EntityType == "Osysharp.Organizations.Accounts.OrganizationTier" || EntityType == "Osysharp.Organizations.Accounts.Entitlement"
          || EntityType == "Osysharp.Composer.SavedReply" || EntityType == "Osysharp.Composer.Macro"
          || EntityType == "Osysharp.Composer.MacroStep" || EntityType == "Osysharp.Mail.Receiving.MailboxWatch"
          || EntityType == "Osysharp.Privacy.RetentionSetting" || EntityType == "Osysharp.Privacy.PrivacyController"),
  },
  // A sign-in secret never lands in the trail at all — not a password's hash, not an authenticator's sealed key.
  Redact = new AuditRedaction { Properties = [User.PasswordHash, User.TotpSecret] },
};

/// The two kinds of change the log lists.
public enum AuditArea {
  [Label("All changes")] Everything,
  [Label("Access")] Access,
  [Label("Desk settings")] Settings,
}

/// How far back the log looks.
public enum AuditPeriod {
  [Label("Last 7 days")] Week,
  [Label("Last 30 days")] Month,
  [Label("Last 90 days")] Quarter,
  [Label("Last year")] Year,
}

/// One line of the log.
public class AuditLine {
  public DateTime At;
  public AuditArea Area = AuditArea.Settings;
  /// What changed, in a sentence — "Statuses · “Pending” changed", "Granted Admin — Lena Berg".
  public string What = "";
  /// The fields and their values — "Name: Pending → Waiting on customer" — or "" when there is nothing more to say.
  public string Detail = "";
  /// Who made the change, as they were named then.
  public string By = "";
  /// Why, when they said (an access change asks).
  public string Reason = "";
  /// The change was asked for and refused — it did not happen.
  public bool Refused;
}

/// The most lines the log reads at once — a page, not an export.
public int AuditTake() { return 200; }

/// The day the period starts.
public DateTime AuditSince(AuditPeriod p, DateTime now) {
  if (p == AuditPeriod.Week) { return now.AddDays(-7); }
  if (p == AuditPeriod.Month) { return now.AddDays(-30); }
  if (p == AuditPeriod.Quarter) { return now.AddDays(-90); }
  return now.AddDays(-365);
}

/// A field's old and new value, as the trail keeps them.
public class AuditDelta {
  [ExternalName("old")] public Json? Old;
  [ExternalName("new")] public Json? New;
}

/// The log, newest first: access changes and settings changes since `since`, by `who` ("" — anybody), at most
/// `AuditTake()`. A change the desk made itself (its starting set, a workflow) has no person behind it and is not listed.
[Authorize(IsAdmin)]
public List<AuditLine> AuditLog(AuditArea area, DateTime since, string who) {
  List<AuditLine> lines = [];
  if (area != AuditArea.Settings) {
    foreach (var c in AccessChange.Where(x => x.At >= since).Include(x => x.By).Include(x => x.Person)
                                  .OrderByDescending(x => x.At).Take(AuditTake()).ToList()) {
      var whom = c.Person.DisplayName != "" ? c.Person.DisplayName : c.Person.Email;
      var by = c.By.DisplayName != "" ? c.By.DisplayName : c.By.Email;
      var refused = c.State == AccessChangeState.Refused;
      lines.Add(new AuditLine {
        At = c.At, Area = AuditArea.Access, What = Osysharp.People.Describe(c) + " — " + whom, By = by, Reason = c.Reason,
        Detail = refused ? "Refused: " + (c.Refusal ?? "") : "", Refused = refused,
      });
    }
  }
  if (area != AuditArea.Access) {
    foreach (var e in EntityAuditRecord.Where(x => x.Timestamp >= since && x.UserId != Guid.Empty)
                                       .OrderByDescending(x => x.Timestamp).Take(AuditTake()).ToList()) {
      lines.Add(SettingsLine(e));
    }
  }
  if (who != "") { lines = lines.Where(l => l.By == who).ToList(); }
  return lines.OrderByDescending(l => l.At).Take(AuditTake()).ToList();
}

/// A settings change as a line of the log.
AuditLine SettingsLine(EntityAuditRecord e) {
  var deltas = JsonSerializer.Deserialize<Dictionary<string, AuditDelta>>(e.Changes ?? "{}");
  var name = "";
  var named = deltas.ContainsKey("Name") ? "Name" : deltas.ContainsKey("Title") ? "Title" : "";
  if (named != "") {
    var d = deltas[named];
    name = e.Action == "Delete" ? Shown(d.Old) : Shown(d.New);
  }
  if (name == "" || name == "—") { name = RowName(e.EntityType, e.EntityId); }
  var verb = e.Action == "Create" ? "added" : e.Action == "Delete" ? "removed" : "changed";
  var what = SettingsArea(e.EntityType) + " · " + (name != "" ? "“" + name + "” " : "") + verb;
  var parts = new List<string>();
  if (e.Action == "Update") {
    foreach (var field in deltas.Keys) {
      if (field == "ModifiedAt" || field == "ModifiedBy" || field == "CreatedAt" || field == "CreatedBy") { continue; }
      var d = deltas[field];
      var before = Shown(d.Old);
      var after = Shown(d.New);
      // A reference changes from one row's id to another's — the field's name says what moved.
      if (LooksLikeAnId(before) || LooksLikeAnId(after)) { parts.Add(Spaced(field) + " changed"); }
      else { parts.Add(Spaced(field) + ": " + before + " → " + after); }
    }
  }
  return new AuditLine {
    At = e.Timestamp ?? DateTime.UtcNow, Area = AuditArea.Settings, What = what,
    Detail = string.Join(" · ", parts), By = e.UserName ?? "",
  };
}

/// A value from the trail as a person reads it: the text without its quotes, "—" for none, cut at 80 characters.
string Shown(Json? value) {
  if (value == null) { return "—"; }
  var text = value.ToString().Trim();
  if (text == "null" || text == "") { return "—"; }
  if (text.StartsWith("\"") && text.EndsWith("\"") && text.Length >= 2) { text = text.Substring(1, text.Length - 2); }
  if (text == "") { return "—"; }
  return text.Length > 80 ? text.Substring(0, 79) + "…" : text;
}

bool LooksLikeAnId(string text) {
  return Regex.IsMatch(text, "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$");
}

/// "FirstReply" → "First reply".
string Spaced(string field) {
  var words = Regex.Replace(field, "([a-z0-9])([A-Z])", "$1 $2");
  return words.Substring(0, 1) + words.Substring(1).ToLower();
}

/// A type as the trail names it, without its package — "Osysharp.Inbox.Queue" → "Queue".
string BareType(string type) {
  return type.Contains(".") ? type.Substring(type.LastIndexOf(".") + 1) : type;
}

/// The settings page a type of row is edited on, as the area names it.
string SettingsArea(string trailType) {
  var type = BareType(trailType);
  if (type == "TicketStatus") { return "Statuses"; }
  if (type == "TicketField" || type == "TicketForm" || type == "FormField" || type == "CustomerField" || type == "CompanyField") {
    return "Fields and forms";
  }
  if (type == "Queue" || type == "QueueMember") { return "Queues"; }
  if (type == "RoutingRule") { return "Routing"; }
  if (type == "RoutingSkill" || type == "HeldSkill") { return "Skills"; }
  if (type == "InboxView") { return "Views"; }
  if (type == "SlaPolicy" || type == "SlaTarget" || type == "SlaEscalation") { return "SLA policies"; }
  if (type == "ServiceHours" || type == "ServiceWindow" || type == "ServiceException") { return "Business hours"; }
  if (type == "OrganizationTier" || type == "Entitlement") { return "Tiers"; }
  if (type == "SavedReply") { return "Saved replies"; }
  if (type == "Macro" || type == "MacroStep") { return "Macros"; }
  if (type == "MailboxWatch") { return "Mailboxes"; }
  if (type == "RetentionSetting") { return "Data retention"; }
  if (type == "PrivacyController") { return "Who is responsible"; }
  return type;
}

/// The name of the row a change was made to, while it still exists — "" for a row with no name, or one since removed.
string RowName(string trailType, Guid id) {
  var type = BareType(trailType);
  if (type == "TicketStatus") { return TicketStatus.Where(r => r.Id == id).Select(r => r.Name).FirstOrDefault() ?? ""; }
  if (type == "TicketField") { return TicketField.Where(r => r.Id == id).Select(r => r.Name).FirstOrDefault() ?? ""; }
  if (type == "TicketForm") { return TicketForm.Where(r => r.Id == id).Select(r => r.Name).FirstOrDefault() ?? ""; }
  if (type == "CustomerField") { return CustomerField.Where(r => r.Id == id).Select(r => r.Name).FirstOrDefault() ?? ""; }
  if (type == "CompanyField") { return CompanyField.Where(r => r.Id == id).Select(r => r.Name).FirstOrDefault() ?? ""; }
  if (type == "Queue") { return Queue.Where(r => r.Id == id).Select(r => r.Name).FirstOrDefault() ?? ""; }
  if (type == "SlaPolicy") { return SlaPolicy.Where(r => r.Id == id).Select(r => r.Name).FirstOrDefault() ?? ""; }
  if (type == "OrganizationTier") { return OrganizationTier.Where(r => r.Id == id).Select(r => r.Name).FirstOrDefault() ?? ""; }
  if (type == "SavedReply") { return SavedReply.Where(r => r.Id == id).Select(r => r.Title).FirstOrDefault() ?? ""; }
  if (type == "Macro") { return Macro.Where(r => r.Id == id).Select(r => r.Title).FirstOrDefault() ?? ""; }
  return "";
}
