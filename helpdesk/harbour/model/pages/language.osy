// THE DESK IN ARABIC TOO — Harbour speaks English and Arabic: every word of the desk, the portal and the
// kits' screens is in locales/ar.osy, and in Arabic the whole app reads right to left. A reader picks the language
// here (the desk's top bar, the portal's); the page re-renders in place, mirrored, and the choice holds on this device.

/// The other languages, each by its own name, in the top bar beside the account. On a phone, with more than one other
/// language, the bar has no room for every name beside the page's title (three languages would squeeze the
/// desk's "All open" to its first letter) — so the language it is read in, by its own name, opens the rest. `compact`:
/// the bar it sits in is a phone's (the frame says so — it knows its own width).
[Composable]
[AllowAnonymous]
component LanguageChoice(bool compact = false) {
  bool open = false;
  live var others = App.Languages.Where(l => l != Session.Language).ToList();
  action Choose(string lang) { open = false; Session.SetLanguage(lang); }
  action Toggle() { open = !open; }
  action Close() { open = false; }
  render {
    if (!compact || others.Count <= 1) {
      Row(gap: 1, align: Align.Center, label: "Language") {
        foreach (var lang in others) {
          Pressable(onClick: () => Choose(lang), label: LanguageName(lang),
                    px: 2, py: 1, bg: Colors.Transparent, color: Colors.TextMuted,
                    cursor: Cursor.Pointer) {
            Text(LanguageName(lang), fontSize: FontSize.Label, fontWeight: FontWeight.Semibold);
          }
        }
      }
    } else {
      Box(position: Position.Relative) {
        Pressable(onClick: Toggle, label: "Language", px: 2, py: 1, bg: Colors.Transparent, color: Colors.TextMuted,
                  cursor: Cursor.Pointer) {
          Row(gap: 1, align: Align.Center) {
            Text(LanguageName(Session.Language), fontSize: FontSize.Label, fontWeight: FontWeight.Semibold);
            Icon(Icons.ChevronDown, size: 12);
          }
        }
        if (open) {
          Backdrop(Close);
          Menu(from: MenuFrom.BelowEnd, label: "Language") {
            foreach (var lang in others) { MenuItem(LanguageName(lang), () => Choose(lang)); }
          }
        }
      }
    }
  }
}

/// A language as it names itself — what the switch shows, so a reader who cannot read the page can still find theirs.
/// Keyed apart from "English" the language NAME (the Conversations kit's "Sent in English", which Arabic says as
/// "الإنجليزية"): an endonym is the same in every language.
/// A language the desk is given later (`osy init --languages de`, `osy translate --to fr`) is named the same way; one this
/// list does not know is named by its code rather than taken for English.
string LanguageName(string code) {
  var b = code.Split("-")[0].ToLower();
  if (b == "en") { return Translate("English", key: "endonym"); }
  if (b == "ar") { return Translate("العربية", key: "endonym"); }
  if (b == "sv") { return Translate("Svenska", key: "endonym"); }
  if (b == "de") { return Translate("Deutsch", key: "endonym"); }
  if (b == "fr") { return Translate("Français", key: "endonym"); }
  if (b == "es") { return Translate("Español", key: "endonym"); }
  if (b == "it") { return Translate("Italiano", key: "endonym"); }
  if (b == "nl") { return Translate("Nederlands", key: "endonym"); }
  if (b == "pt") { return Translate("Português", key: "endonym"); }
  if (b == "da") { return Translate("Dansk", key: "endonym"); }
  if (b == "fi") { return Translate("Suomi", key: "endonym"); }
  if (b == "nb" || b == "no") { return Translate("Norsk", key: "endonym"); }
  if (b == "pl") { return Translate("Polski", key: "endonym"); }
  if (b == "ja") { return Translate("日本語", key: "endonym"); }
  if (b == "zh") { return Translate("中文", key: "endonym"); }
  return code;
}
