// ── tiers ───────────────────────────────────────────────────────────────────────────────────────────────────────────

[Route("/settings/tiers")] [Layout(SettingsFrame)] [Authorize(IsAdmin)] [Render(CSR)] [Title("Tiers")]
component TierSettings() {
  // The Accounts add-on's editor, in the desk's words: a tier chooses a company's SLA policy as well.
  render { TierEditor(description: "The levels of service a company can be on. A company's tier chooses its SLA policy and what it is entitled to; a company's own contract can add more (on the company)."); }
}
